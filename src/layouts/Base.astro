---
/**
 * Base — the site shell every page renders into.
 *
 * Props
 *   locale       Locale (from localeFromParam(Astro.params.lang))
 *   title        page title; the site name is appended automatically
 *   description  meta description (falls back to the site description)
 *   ogImage      path under /public for the share image (default per-locale card)
 *   noindex      true for utility pages such as the styleguide
 *   home         true on the landing page: <title> is "site name — tagline"
 *
 * Slots
 *   default  page content, rendered inside <main id="main">
 *   head     extra <head> tags
 *   credits  passed through to the footer credits line
 *
 * Usage
 *   <Base locale={locale} title={t.title} description={t.description}> … </Base>
 */
import '@/styles/fonts.css';
import '@/styles/tokens.css';
import '@/styles/global.css';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
// The CJK headline font's CSS is ~100 @font-face rules. Loaded as its own
// non-blocking stylesheet so it never delays first paint (see fonts.css).
import cjkDisplayCss from '@fontsource/noto-sans-tc/900.css?url';

import { asset, htmlLang, locales, switchLocalePath, type Locale } from '@/i18n';
import { site, ui } from '@/i18n/ui';
import Header from '@/components/shell/Header.astro';
import Footer from '@/components/shell/Footer.astro';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  home?: boolean;
}

const { locale, title, description = site.description[locale], ogImage, noindex = false, home = false } = Astro.props;

const siteName = site.name[locale];
const fullTitle = home ? `${siteName} — ${site.tagline[locale]}` : `${title} — ${siteName}`;
const abs = (p: string) => new URL(p, Astro.site).href;
const canonical = abs(Astro.url.pathname);
const image = abs(asset(ogImage ?? (locale === 'en' ? '/og-en.png' : '/og-zh.png')));
const ogLocale = { 'zh-TW': 'zh_TW', en: 'en_US' } as const;
const other: Locale = locale === 'en' ? 'zh-TW' : 'en';
---

<!doctype html>
<html lang={htmlLang[locale]} id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f3f5f3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101416" />
    <script is:inline>
      // Runs before first paint: apply a stored theme choice and flag JS support.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('sa-theme');
          if (t === 'light' || t === 'dark') {
            d.dataset.theme = t;
            var c = t === 'dark' ? '#101416' : '#f3f5f3';
            document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
              m.content = c;
            });
          }
        } catch (e) {}
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={abs(switchLocalePath(Astro.url.pathname, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(switchLocalePath(Astro.url.pathname, 'zh-TW'))} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={home ? fullTitle : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={home ? fullTitle : title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    {locale === 'zh-TW' && (
      <Fragment>
        <link rel="stylesheet" href={cjkDisplayCss} media="print" onload={"this.media='all'"} />
        <noscript><link rel="stylesheet" href={cjkDisplayCss} /></noscript>
      </Fragment>
    )}
    <link rel="sitemap" href={asset('/sitemap-index.xml')} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skipToContent[locale]}</a>
    <Header locale={locale} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale}>
      {Astro.slots.has('credits') && <slot name="credits" slot="credits" />}
    </Footer>
  </body>
</html>
