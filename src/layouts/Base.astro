---
/**
 * Base — the site shell every page renders into.
 *
 * Props
 *   locale       Locale (from localeFromParam(Astro.params.lang))
 *   title        page title; the site name is appended automatically
 *   description  meta description (falls back to the site description)
 *   share        id of a generated share card (V44): 'home' (default), 'brief', or a
 *                question slug ('smell', 'my-child', …). See src/lib/share-cards.ts.
 *                Sets og:image (1200 × 630), a square second image for LINE, and the
 *                image alt text — the card carries its caveat inside the picture.
 *   ogImage      path under /public for a hand-made share image (overrides `share`)
 *   noindex      true for utility pages such as the styleguide
 *   home         true on the landing page: <title> is "site name — tagline"
 *   money        true on pages with date-dependent subsidy copy (home, /electric/,
 *                /act/): prints the date-state snapshot and loads its runtime once.
 *                See src/lib/site-state.ts
 *
 * Every page gets a three-line pre-paint script that sets <html data-money-phase>
 * from today's date, so [data-money-when] variants are right before first paint.
 *
 * Slots
 *   default  page content, rendered inside <main id="main">
 *   rail     the countdown rail: <CountdownRail slot="rail" … />. It sits between the
 *            header and <main>, and is the only pinned element on the site
 *   head     extra <head> tags
 *   credits  passed through to the footer credits line
 *
 * Usage
 *   <Base locale={locale} title={t.title} description={t.description}> … </Base>
 */
import '@/styles/fonts.css';
import '@/styles/tokens.css';
import '@/styles/global.css';
import archivoUrl from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
// The CJK headline font, two ways (see fonts.css and scripts/display-font.mjs):
// one small file holding exactly the characters the site's headlines use, and behind it the
// package's ~100 slices for any character that file does not have yet. The slice list is a
// non-blocking stylesheet, and the build removes its link from every page the small file
// fully covers (the `data-cjk-slices` marker is how it finds it).
import cjkDisplayCss from '@fontsource/noto-sans-tc/900.css?url';
import cjkHeadlineUrl from '@/styles/fonts/noto-sans-tc-900-headline.woff2?url';
// Keep the range in step with UNICODE_RANGE in scripts/display-font.mjs.
const cjkHeadlineFace = `@font-face{font-family:'Noto Sans TC Headline';font-style:normal;font-weight:900;font-display:swap;src:url(${cjkHeadlineUrl}) format('woff2');unicode-range:U+00B7,U+2000-2BFF,U+2E80-FFEF}`;

import { asset, htmlLang, locales, switchLocalePath, type Locale } from '@/i18n';
import { site, ui } from '@/i18n/ui';
import Header from '@/components/shell/Header.astro';
import Footer from '@/components/shell/Footer.astro';
import MoneySnapshot from '@/components/ui/MoneySnapshot.astro';
import { prePaintScript, snapshot } from '@/lib/site-state.data';
import { shareCard, type ShareCardId } from '@/lib/share-cards';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  share?: ShareCardId;
  ogImage?: string;
  noindex?: boolean;
  home?: boolean;
  money?: boolean;
}

const { locale, title, description = site.description[locale], share = 'home', ogImage, noindex = false, home = false, money = false } = Astro.props;
const hasRail = Astro.slots.has('rail');
const card = shareCard(share, locale);

const siteName = site.name[locale];
const fullTitle = home ? `${siteName} — ${site.tagline[locale]}` : `${title} — ${siteName}`;
const abs = (p: string) => new URL(p, Astro.site).href;
const canonical = abs(Astro.url.pathname);
const image = abs(asset(ogImage ?? card.wide));
const square = ogImage ? null : abs(asset(card.square));
const ogLocale = { 'zh-TW': 'zh_TW', en: 'en_US' } as const;
const other: Locale = locale === 'en' ? 'zh-TW' : 'en';
---

<!doctype html>
<html lang={htmlLang[locale]} id="top" class:list={[hasRail && 'has-rail']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f3f5f3" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#101416" />
    <script is:inline>
      // Runs before first paint: apply a stored theme choice and flag JS support.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var t = localStorage.getItem('sa-theme');
          if (t === 'light' || t === 'dark') {
            d.dataset.theme = t;
            var c = t === 'dark' ? '#101416' : '#f3f5f3';
            document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) {
              m.content = c;
            });
          }
        } catch (e) {}
      })();
    </script>
    <script is:inline set:html={prePaintScript(snapshot)} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={abs(switchLocalePath(Astro.url.pathname, l))} />)}
    <link rel="alternate" hreflang="x-default" href={abs(switchLocalePath(Astro.url.pathname, 'zh-TW'))} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={home ? fullTitle : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {!ogImage && <meta property="og:image:alt" content={card.alt} />}
    {square && (
      <Fragment>
        <meta property="og:image" content={square} />
        <meta property="og:image:width" content="1080" />
        <meta property="og:image:height" content="1080" />
        <meta property="og:image:alt" content={card.alt} />
      </Fragment>
    )}
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={home ? fullTitle : title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {!ogImage && <meta name="twitter:image:alt" content={card.alt} />}

    {/* Icons, all drawn from public/favicon.svg: .ico for browsers that take no SVG icon (and
        for anything that asks for /favicon.ico), the SVG for the rest, a full-bleed tile for
        iOS, and the manifest's 192 / 512 / maskable PNGs for Android. */}
    <link rel="icon" href={asset('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />
    <link rel="manifest" href={asset('/manifest.webmanifest')} />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    {locale === 'zh-TW' && (
      <Fragment>
        <link rel="preload" href={cjkHeadlineUrl} as="font" type="font/woff2" crossorigin />
        <style is:inline set:html={cjkHeadlineFace} />
        <link rel="stylesheet" href={cjkDisplayCss} media="print" onload={"this.media='all'"} data-cjk-slices />
        <noscript data-cjk-slices><link rel="stylesheet" href={cjkDisplayCss} /></noscript>
      </Fragment>
    )}
    <link rel="sitemap" href={asset('/sitemap-index.xml')} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skipToContent[locale]}</a>
    <Header locale={locale} />
    <slot name="rail" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {money && <MoneySnapshot />}
    <Footer locale={locale}>
      {Astro.slots.has('credits') && <slot name="credits" slot="credits" />}
    </Footer>
  </body>
</html>
