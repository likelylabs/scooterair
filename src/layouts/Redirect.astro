---
/**
 * Redirect — a static redirect page for a route that has moved (a meta refresh,
 * a canonical link and a plain link for readers without either). Static hosting
 * has no server redirects, so this is the redirect.
 *
 * Props
 *   locale  Locale
 *   to      locale-neutral path of the new home, e.g. '/questions/' (goes through href())
 *   label   link text shown to a reader whose browser does not follow the refresh
 *
 *   src/pages/[...lang]/problem.astro → <Redirect locale={locale} to="/questions/" label={…} />
 */
import { href, htmlLang, type Locale } from '@/i18n';
import { site } from '@/i18n/ui';

interface Props {
  locale: Locale;
  to: string;
  label: string;
}
const { locale, to, label } = Astro.props;
const target = href(to, locale);
const abs = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{label} — {site.name[locale]}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={abs} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p><a href={target}>{label}</a></p>
  </body>
</html>
