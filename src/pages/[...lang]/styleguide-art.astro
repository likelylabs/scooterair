---
/**
 * /styleguide-art/ — every scene of the redesign on one page (brief 5.2), for `astro dev` only.
 * Not built in production (brief section 2): getStaticPaths returns nothing when PROD.
 *
 * The scenes are shown as the pages use them, outside a Screen, so each carries its own tag.
 * Copy here is a developer's caption, not reader copy (the file is in the copy guard's
 * inlineCopyAllowed list).
 */
import Base from '@/layouts/Base.astro';
import { localeFromParam, localeStaticPaths } from '@/i18n';
import { chipWhere } from '@/i18n/ui';
import HeroStreet from '@/components/art/HeroStreet.astro';
import TailpipeMarks from '@/components/art/TailpipeMarks.astro';
import ApproachPlan from '@/components/art/ApproachPlan.astro';
import KerbScene from '@/components/art/KerbScene.astro';
import BodyFigure from '@/components/art/BodyFigure.astro';
import RoadOfTime from '@/components/art/RoadOfTime.astro';
import HeightsScene from '@/components/art/HeightsScene.astro';
import RiderScene from '@/components/art/RiderScene.astro';
import MaskScene from '@/components/art/MaskScene.astro';
import SwapScene from '@/components/art/SwapScene.astro';
import TenScooters from '@/components/art/TenScooters.astro';
import StationScene from '@/components/art/StationScene.astro';
import SmellStrip from '@/components/art/SmellStrip.astro';
import MeasurementDiagram from '@/components/art/MeasurementDiagram.astro';
import Signal from '@/components/art/Signal.astro';

export const getStaticPaths = () => (import.meta.env.PROD ? [] : localeStaticPaths());
const locale = localeFromParam(Astro.params.lang);
const L = (zh: string, en: string) => (locale === 'en' ? en : zh);
const posts = [
  { when: L('5 分鐘', '5 minutes'), text: L('心跳的節奏小小變了一下', 'The heart’s rhythm shifted a little'), kind: 'study', where: chipWhere.taiwan[locale] },
  { when: L('2 小時', '2 hours'), text: L('氣喘的人，肺功能小幅下降', 'Lung function dipped slightly'), kind: 'study', where: chipWhere.abroad[locale] },
  { when: L('很多年', 'Many years'), text: L('氣喘、心臟病、肺癌比較多', 'More asthma, heart disease, lung cancer'), kind: 'study', where: chipWhere.international[locale] },
] as const;
const scenes = [
  { id: 'g1', name: 'G1 · HeroStreet (red)' },
  { id: 'g14', name: 'G14 · HeroStreet (green)' },
  { id: 'g2', name: 'G2 · TailpipeMarks' },
  { id: 'g3', name: 'G3 · ApproachPlan' },
  { id: 'g4', name: 'G4 · KerbScene (all scenarios)' },
  { id: 'g6', name: 'G6 · BodyFigure' },
  { id: 'g7', name: 'G7 · RoadOfTime' },
  { id: 'g8', name: 'G8 · HeightsScene' },
  { id: 'g9', name: 'G9 · RiderScene' },
  { id: 'g17', name: 'G17 · MaskScene' },
  { id: 'g10', name: 'G10 · SwapScene' },
  { id: 'g11', name: 'G11 · TenScooters' },
  { id: 'other', name: 'StationScene · SmellStrip · MeasurementDiagram · Signal' },
];
---

<Base locale={locale} title={L('場景樣張', 'Scene sheet')} noindex>
  <div class="container sg">
    <h1>{L('場景樣張（只在開發時）', 'Scene sheet (development only)')}</h1>
    <ol class="sg__toc">{scenes.map((s) => <li><a href={`#${s.id}`}>{s.name}</a></li>)}</ol>

    <section id="g1"><h2>G1</h2><HeroStreet locale={locale} tag="street" /></section>
    <section id="g14"><h2>G14</h2><HeroStreet locale={locale} phase="green" tag="street" /></section>
    <section id="g2"><h2>G2</h2><TailpipeMarks locale={locale} tag="street" /></section>
    <section id="g3"><h2>G3</h2><ApproachPlan locale={locale} tag="street" /></section>
    <section id="g4">
      <h2>G4</h2>
      <KerbScene locale={locale} scenario="dozen" tag="street" />
    </section>
    <section id="g6"><h2>G6</h2><BodyFigure locale={locale} tag="body" /></section>
    <section id="g7"><h2>G7</h2><RoadOfTime locale={locale} posts={posts as any} /></section>
    <section id="g8"><h2>G8</h2><HeightsScene locale={locale} tag="street" /></section>
    <section id="g9"><h2>G9</h2><RiderScene locale={locale} tag="street" /></section>
    <section id="g17"><h2>G17</h2><MaskScene locale={locale} tag="street" /></section>
    <section id="g10"><h2>G10</h2><SwapScene locale={locale} tag="street" /></section>
    <section id="g11"><h2>G11</h2><TenScooters locale={locale} tag="street" /></section>
    <section id="other">
      <h2>{L('其他', 'Others')}</h2>
      <StationScene locale={locale} tag="street" />
      <SmellStrip locale={locale} />
      <MeasurementDiagram locale={locale} />
      <Signal state="red" count={90} label={L("紅燈", "Red")} />
    </section>
  </div>
</Base>

<style>
  .sg section {
    margin-block: 2.5rem;
    max-width: 40rem;
  }
  .sg__toc {
    columns: 2 14rem;
  }
  .sg__row {
    display: flex;
    gap: 1rem;
  }
</style>
