        <WaffleChart locale={locale} title={L('電動機車占比方格圖', 'Waffle chart of the electric share')} parts={[{ value: 7, label: series2[1].label, tone: 'clean' }]} restLabel={series2[0].label} categoryLabel={L('車種', 'Type')} valueLabel={L('輛', 'Count')} />
