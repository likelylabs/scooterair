<script>
  // Reference calculator wiring. Copy this pattern for the real tool.
  import { updateChart } from '@/components/charts/core/client';
  import { renderWaterfall } from '@/components/charts/core/waterfall';
  import { breakEvenMonth, renderBreakEven } from '@/components/charts/core/breakeven';

  const dataEl = document.getElementById('sg-calc-data');
  const root = document.getElementById('sg-calc');
  if (dataEl && root) {
    const d = JSON.parse(dataEl.textContent ?? '{}');
    const T = d.text as Record<string, string>;
    const nf = new Intl.NumberFormat(d.locale === 'en' ? 'en-US' : 'zh-TW');
    const money = (v: number) => `NT$ ${nf.format(v)}`;
    const $ = <E extends Element>(sel: string) => document.querySelector<E>(sel);
    const setRow = (id: string, text: string) => {
      const el = $(`[data-row="${id}"] [data-amount]`);
      if (el) el.textContent = text;
    };

    const update = () => {
      const city = d.cities.find((c: { value: string }) => c.value === $<HTMLSelectElement>('#sg-city')?.value) ?? d.cities[0];
      const scrap = $<HTMLInputElement>('input[name="sg-scrap"]:checked')?.value === 'yes' ? d.scrap : 0;
      const km = Math.max(0, Number($<HTMLInputElement>('#sg-km')?.value) || 0);
      const net = d.list - d.central - city.local - scrap;
      const gap = net - d.gas;
      const ev = { label: T.ev, tone: 'clean' as const, upfront: net, monthly: km * d.evPerKm + d.evFixed };
      const gas = { label: T.gasShort, tone: 'exhaust' as const, upfront: d.gas, monthly: km * d.gasPerKm + d.gasFixed };
      const even = breakEvenMonth(ev, gas);

      setRow('local', money(city.local));
      setRow('scrap', money(scrap));
      setRow('net', money(net));
      setRow('gap', `${gap < 0 ? '−' : '+'}${money(Math.abs(gap))}`);
      const value = $('#sg-result [data-part="value"]');
      const note = $('#sg-result [data-part="note"]');
      if (value) value.textContent = nf.format(net);
      const ahead = ev.upfront <= gas.upfront && ev.monthly <= gas.monthly;
      if (note) note.textContent = (ahead ? T.noteAhead : even !== null && even <= 60 ? T.noteEven : T.noteNever).replace('{km}', nf.format(km));

      const wf = $('#sg-waterfall');
      if (wf)
        updateChart(
          wf,
          renderWaterfall({
            locale: d.locale,
            start: { label: T.list, value: d.list },
            steps: [
              { label: T.central, value: d.central },
              { label: T.local, value: city.local },
              ...(scrap ? [{ label: T.scrap, value: scrap }] : []),
            ],
            totalLabel: T.net,
            compare: { label: T.gas, value: d.gas },
            gapLabel: T.gap,
            categoryLabel: d.cat,
            valueLabel: d.val,
          }),
        );
      const be = $('#sg-breakeven');
      if (be)
        updateChart(
          be,
          renderBreakEven({
            locale: d.locale,
            a: ev,
            b: gas,
            months: 60,
            tickLabel: (m) => (m === 0 ? T.purchase : T.year.replace('{n}', String(m / 12))),
            breakEvenLabel: (m) => T.even.replace('{n}', String(m)),
            noBreakEvenLabel: T.never,
            aheadLabel: T.ahead,
            xLabel: T.month,
          }),
        );
    };
    root.addEventListener('input', update);
    root.addEventListener('change', update);
  }
</script>
