          <tr><th scope="row">{L('第 4 環', 'Link 4')}</th><td><code>link-4</code></td><td><code>link={'{4}'}</code></td><td>50 → 38</td><td>K2 kerb</td><td>✓</td></tr>
          <tr><th scope="row">{L('第 5 環', 'Link 5')}</th><td><code>link-5</code></td><td><code>link={'{5}'} tone="sunken"</code></td><td>{L('停在 38', 'held at 38')}</td><td>K3 paused</td><td>–</td></tr>
          <tr><th scope="row">{L('第 6 環', 'Link 6')}</th><td><code>link-6</code></td><td><code>link={'{6}'}</code></td><td>38 → 05</td><td>K2 kerb</td><td>✓</td></tr>
          <tr><th scope="row">{L('綠燈', 'Green')}</th><td><code>green</code></td><td><code>phase="green" size="auto"</code></td><td>05 → 00</td><td>K4 green</td><td>✓</td></tr>
