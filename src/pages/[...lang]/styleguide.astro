import LineChart from '@/components/charts/LineChart.astro';
import PictogramRow from '@/components/charts/PictogramRow.astro';
import RangePlot from '@/components/charts/RangePlot.astro';
import StackedBar from '@/components/charts/StackedBar.astro';
import WaffleChart from '@/components/charts/WaffleChart.astro';
import WaterfallChart from '@/components/charts/WaterfallChart.astro';

import Haze from '@/components/art/Haze.astro';
import PollutantKey from '@/components/art/PollutantKey.astro';
import SceneCompare from '@/components/art/SceneCompare.astro';
