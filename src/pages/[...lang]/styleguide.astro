          <tr><th scope="row">{L('第 7 環', 'Link 7')}</th><td><code>link-7</code></td><td><code>link={'{7}'} tone="clear"</code></td><td>{L('回到 90', 'back to 90')}</td><td>K5 clean</td><td>–</td></tr>
          <tr><th scope="row">{L('算錢', 'The money')}</th><td><code>money</code></td><td><code>budget={'{false}'}</code></td><td>–</td><td>–</td><td>–</td></tr>
