  <Section id="charts" eyebrow="13" title={L('圖表', 'Charts')} rule lead={L('在 src/components/charts/。伺服器端產生的內嵌 SVG，沒有圖表函式庫；寬度用百分比、文字是固定大小的真文字，所以從 300px 到桌機都是同一張圖。每張圖都有 title、可展開的資料表，以及滑鼠或觸控的數值提示。', 'In src/components/charts/. Server-rendered inline SVG, no charting library. Widths are percentages and text is real fixed-size text, so one chart works from 300px to desktop. Every chart has a title, an expandable data table and a hover / touch readout.')}>
    <Callout label={L('圖表規則', 'Chart rules')}>
      <ul class="sg-list">
        <li>{L('先選形式，最後才選顏色。一個數字用 Stat，不要畫一根長條。', 'Pick the form first and the colour last. One number is a Stat, not a one-bar chart.')}</li>
        <li>{L('一張圖只有一個 y 軸。不同單位就畫兩張圖。', 'One y axis per chart. Two units means two charts.')}</li>
        <li>{L('直接標示數值，少用圖例；兩個以上數列才需要圖例。', 'Label values directly and lean on legends as little as possible; a legend appears only for two or more series.')}</li>
        <li>{L('不用圓餅圖與甜甜圈圖：占比用 StackedBar 或 WaffleChart。', 'No pies or donuts: use StackedBar or WaffleChart for shares.')}</li>
        <li>{L('標籤請短：中文 30 字、英文 60 字元以內（會自動折成兩行）。', 'Keep labels short: under 30 Chinese characters or 60 Latin (they wrap to two lines).')}</li>
      </ul>
    </Callout>

    <div class="sg-charts">
      <Figure locale={locale} number={1} title={L('騎車與走路的人，|吸到的最多', 'People riding and walking |breathe the most')} subtitle={L(`各種通勤方式的平均暴露濃度（${units.ugm3}）`, `Average exposure by commuting mode (${units.ugm3})`)} caption={L('BarChart，emphasis 模式：故事裡的兩根用色，其他淡化。直線是參考值。', 'BarChart in emphasis mode: the two bars the story is about take the colour, the rest recede. The vertical line is a reference value.')} sample>
        <BarChart locale={locale} title={L('各種通勤方式的暴露濃度長條圖', 'Bar chart of exposure by commuting mode')} desc={L('騎機車與步行最高，捷運最低。', 'Highest when riding a scooter or walking, lowest on the metro.')} data={barData} unit={units.ugm3} emphasis reference={{ value: 15, label: L('指引值（示意）', 'Guideline (sample)') }} categoryLabel={L('通勤方式', 'Mode')} valueLabel={L('濃度', 'Concentration')} />
      </Figure>

      <Figure locale={locale} number={2} title={L('同一條路，|兩種機車', 'Same street, |two kinds of scooter')} subtitle={L('每公里排放量（公克）', 'Emissions per kilometre (grams)')} caption={L('GroupedBarChart：每個類別裡比較同樣的兩到四個數列。', 'GroupedBarChart: the same two to four series compared inside each category.')} sample>
        <GroupedBarChart locale={locale} title={L('燃油與電動機車排放量分組長條圖', 'Grouped bar chart of gasoline and electric scooter emissions')} series={series2} groups={[{ label: L('一氧化碳', 'Carbon monoxide'), values: [1.8, 0] }, { label: L('碳氫化合物', 'Hydrocarbons'), values: [0.6, 0] }, { label: L('氮氧化物', 'Nitrogen oxides'), values: [0.2, 0] }]} unit="g/km" decimals={1} categoryLabel={L('污染物', 'Pollutant')} />
      </Figure>

      <Figure locale={locale} number={3} title={L('平均值看不到的：|高低差可以很大', 'What an average hides: |the spread is wide')} subtitle={L(`個人暴露濃度的範圍與中位數（${units.ugm3}）`, `Range and median of personal exposure (${units.ugm3})`)} caption={L('RangePlot：圓點是中位數，橫條是最小到最大。', 'RangePlot: the dot is the median, the bar runs from minimum to maximum.')} sample>
        <RangePlot locale={locale} title={L('個人暴露範圍圖', 'Range plot of personal exposure')} data={[{ label: L('走在人行道', 'Walking on the sidewalk'), min: 10, mid: 40, max: 180 }, { label: L('路口等紅燈', 'Waiting at the crossing'), min: 22, mid: 71, max: 240 }, { label: L('公園內', 'Inside a park'), min: 6, mid: 14, max: 21, tone: 'clean' }]} unit={units.ugm3} labels={{ min: ui.chart.min[locale], mid: ui.chart.median[locale], max: ui.chart.max[locale] }} categoryLabel={L('地點', 'Place')} />
