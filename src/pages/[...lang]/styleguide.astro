export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const en = locale === 'en';
/** Pick the string for this locale. */
const L = (zh: string, enText: string) => (en ? enText : zh);
const S = ui.sampleData[locale];

const toc = [
  ['concept', L('設計概念', 'Concept')],
  ['start', L('快速上手', 'Quick start')],
  ['colour', L('色彩', 'Colour')],
  ['type', L('文字', 'Typography')],
  ['layout', L('間距與版面', 'Space and layout')],
  ['motifs', L('街道語彙', 'Street motifs')],
  ['components', L('元件', 'Components')],
  ['recipe', L('怎麼做一個章節', 'How to build a chapter')],
  ['redlight', L('紅燈示範與倒數軌', 'The red light and the rail')],
  ['chain', L('證據與證據鏈', 'Evidence and the chain')],
  ['forms', L('表單與試算', 'Forms and calculator')],
  ['money', L('日期狀態與補助', 'Date state and subsidies')],
  ['charts', L('圖表', 'Charts')],
  ['art', L('插畫', 'Illustration')],
  ['copy', L('文案與分享圖', 'Copy and share cards')],
];

// ---- sample data (invented) ------------------------------------------------
const cat = ui.chart.category[locale];
const val = ui.chart.value[locale];
const barData = [
  { label: L('騎機車通勤', 'Riding a scooter'), value: 62, highlight: true },
  { label: L('走在騎樓與人行道', 'Walking under arcades and on sidewalks'), value: 44, highlight: true },
  { label: L('騎自行車', 'Cycling'), value: 38 },
  { label: L('搭公車', 'Taking the bus'), value: 27 },
  { label: L('搭捷運', 'Taking the metro'), value: 16 },
];
const series2 = [
  { label: L('燃油機車', 'Gasoline scooter'), tone: 'exhaust' as const },
  { label: L('電動機車', 'Electric scooter'), tone: 'clean' as const },
];
const calc = {
  list: 98000,
  central: 7000,
  scrap: 5000,
  gas: 68000,
  cities: [
    { value: 'a', label: L('示意城市甲', 'Sample city A'), local: 12000 },
    { value: 'b', label: L('示意城市乙', 'Sample city B'), local: 8000 },
    { value: 'c', label: L('示意城市丙', 'Sample city C'), local: 3000 },
  ],
  km: 600,
  gasPerKm: 2.2,
  gasFixed: 250,
  evPerKm: 0.5,
  evFixed: 320,
  text: {
    list: L('建議售價', 'List price'),
    central: L('中央補助', 'Central subsidy'),
    local: L('地方補助', 'City subsidy'),
    scrap: L('汰舊加碼', 'Scrappage bonus'),
    net: L('實付價格', 'What you pay'),
    gas: L('同級燃油機車', 'Comparable gasoline scooter'),
    gap: L('和燃油機車的差距', 'Gap to the gasoline scooter'),
    ev: L('電動機車', 'Electric scooter'),
    gasShort: L('燃油機車', 'Gasoline scooter'),
    purchase: L('購買時', 'Purchase'),
    year: L('第 {n} 年', 'Year {n}'),
    even: L('第 {n} 個月打平', 'Even at month {n}'),
    never: L('五年內不會打平', 'No break-even within five years'),
    ahead: L('買和騎都比較便宜', 'Cheaper to buy and to run'),
    noteAhead: L('實付價格已經低於燃油機車，每個月的開銷也比較少。', 'The net price is already below the gasoline scooter, and it costs less to run each month.'),
    monthsUnit: L('個月', 'months'),
    noteEven: L('以每月 {km} 公里計算，省下的油錢與保養費約在這時補回價差。', 'At {km} km a month, running-cost savings make up the price gap at about this point.'),
    noteNever: L('以每月 {km} 公里計算，五年內補不回價差。', 'At {km} km a month, savings do not make up the price gap within five years.'),
    month: L('時間', 'Time'),
  },
};
const local0 = calc.cities[0].local;
const net0 = calc.list - calc.central - local0 - calc.scrap;
const nf = (v: number) => new Intl.NumberFormat(en ? 'en-US' : 'zh-TW').format(v);
const evLine = { label: calc.text.ev, tone: 'clean' as const, upfront: net0, monthly: calc.km * calc.evPerKm + calc.evFixed };
const gasLine = { label: calc.text.gasShort, tone: 'exhaust' as const, upfront: calc.gas, monthly: calc.km * calc.gasPerKm + calc.gasFixed };
const tickLabel = (m: number) => (m === 0 ? calc.text.purchase : calc.text.year.replace('{n}', String(m / 12)));

// Sample content for the chain board. Placeholders, not findings.
const boardDemo = [
  { strength: 'official-tw' as const, body: L('示意文字：這一環說明排氣管排出哪些氣體。', 'Placeholder: this link says which gases leave the tailpipe.'), cites: [{ id: 'sample-a', n: 1 }] },
  { strength: ['international', 'official-tw'] as ('international' | 'official-tw')[], body: L('示意文字：排放的位置與情境。', 'Placeholder: where and when it is emitted.'), cites: [{ id: 'sample-b', n: 2 }] },
  { strength: 'measured-tw' as const, body: L('示意文字：測站的數字跟得上什麼、跟不上什麼。', 'Placeholder: what a station does and does not track.'), cites: [{ id: 'sample-c', n: 3 }, { id: 'sample-d', n: 4 }] },
  { strength: 'international' as const, body: L('示意文字：國際機構對這些物質的分類。', 'Placeholder: how international bodies classify these compounds.'), cites: [{ id: 'sample-e', n: 5 }] },
  { strength: 'modelled-tw' as const, secondary: true, body: L('示意文字：模式推估，來源是次級來源。', 'Placeholder: a modelled figure resting on a secondary source.'), cites: [{ id: 'sample-f', n: 6 }] },
  { strength: 'derived' as const, body: L('示意文字：本站根據引用數字做的計算。', 'Placeholder: our own arithmetic on cited figures.'), cites: [{ id: 'sample-g', n: 7 }] },
];
const classicDemo = [
  { strength: 'official-tw' as const, body: L('示意文字。', 'Placeholder.') },
  { strength: 'international' as const, body: L('示意文字。', 'Placeholder.') },
  { strength: 'gap' as const, body: L('示意文字：沒人量過的一環，軌道在這裡用虛線以外的方式標出。', 'Placeholder: the link nobody has measured.') },
  { strength: 'international' as const },
  { strength: 'international' as const },
  { strength: 'measured-tw' as const },
  { body: L('示意文字：拿掉排氣管。', 'Placeholder: remove the tailpipe.') },
];
const ladderDemo = [
  { time: L('90 秒', '90 seconds'), empty: true },
  { time: L('1 小時', '1 hour'), body: L('示意文字：一項研究、多少人、量了什麼、看到什麼關聯。', 'Placeholder: one study, how many people, what was measured, what moved with it.'), badge: 'measured-tw' as const, scope: 'all-sources' },
  { time: L('2 小時', '2 hours'), body: L('示意文字：另一項研究的一句話結果。', 'Placeholder: one line from another study.'), badge: 'international' as const, scope: 'traffic' },
  { time: L('很多年', 'Many years'), body: L('示意文字：長期世代研究的一句話結果。', 'Placeholder: one line from a long-term cohort.'), badge: 'measured-tw' as const, scope: 'all-sources' },
];
const decisionDemo = {
  steps: [
    { id: 'charge', legend: L('停車的地方能不能充電？', 'Can you charge where you park?'), options: [{ value: 'yes', label: L('可以', 'Yes') }, { value: 'no', label: L('不行', 'No') }] },
    { id: 'km', legend: L('一個月大概騎多少？', 'How far do you ride a month?'), options: [{ value: 'low', label: L('示意：少', 'Sample: little') }, { value: 'high', label: L('示意：多', 'Sample: a lot') }] },
    { id: 'plate', legend: L('一定要白牌嗎？', 'Must it be a white plate?'), options: [{ value: 'yes', label: L('要', 'Yes') }, { value: 'no', label: L('綠牌也行', 'Green is fine') }] },
  ],
  outcomes: [
    { when: { charge: 'yes' }, title: L('示意結果甲：在家充電', 'Sample result A: charge at home'), body: L('示意說明：一句話講為什麼。', 'Placeholder: one line on why.'), value: 'sample-home' },
    { when: { charge: 'no', km: 'low' }, title: L('示意結果乙：用多少付多少', 'Sample result B: pay as you go'), body: L('示意說明。', 'Placeholder.'), value: 'sample-payg' },
    { when: {}, title: L('示意結果丙：月租', 'Sample result C: a monthly plan'), body: L('示意說明。', 'Placeholder.'), value: 'sample-monthly' },
  ],
};
const cityOptions = [{ value: '', label: L('還沒選', 'Not chosen') }, ...jurisdictionIds.map((id) => ({ value: id, label: snapshot.cities[id].name[locale] }))];
const cardZh = shareCard('smell', 'zh-TW');
const cardEn = shareCard('smell', 'en');
---

<Base locale={locale} title={L('設計系統', 'Design system')} description={L('行人呼吸網站的設計系統：色彩、文字、元件、圖表與插畫。', 'The ScooterAir design system: colour, type, components, charts and illustration.')} noindex money>
  <CountdownRail slot="rail" locale={locale} page="/styleguide/" items={[{ href: '#connect', label: L('接起來', 'Joining it up') }, { href: '#money', label: L('算錢（日期狀態）', 'The money (date state)') }, { href: '#recipe', label: L('章節做法', 'Chapter recipe') }]} />
  <div class="sg-hero">
    <div class="container">
      <p class="eyebrow">{site.name[locale]} · {L('設計系統', 'Design system')}</p>
      <h1 class="display"><Phrased text={L('貼著地面的|那一層', 'The low |layer')} /></h1>
      <p class="lead">
        {L(
          '這一頁是所有頁面製作者的起點：每個色彩、文字樣式、元件、圖表與插畫都在這裡，附上用法。頁面上所有數字都是示意數據。',
          'Start here if you are building a page. Every colour, type style, component, chart and illustration is on this page with its usage. Every number on it is invented sample data.',
        )}
      </p>
      <p><Tag tone="sample">{ui.sampleDataLong[locale]}</Tag></p>
      <nav class="sg-toc" aria-label={L('本頁目錄', 'On this page')}>
        <ul>
          {toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
        </ul>
      </nav>
    </div>
  </div>

  <!-- ================================================================ CONCEPT -->
  <Section id="concept" eyebrow="01" title={L('設計概念：|貼著地面的那一層', 'Concept: |the low layer')} rule>
    <div class="sg-two">
      <div class="prose">
        <p>
          {L(
            '機車的排氣管離地不到一公尺，就在斑馬線旁邊；站在旁邊的人吸進多少，台灣還沒有人量過。整個網站的視覺都圍繞「高度」和這一格空白：頁面是陰天的街道，冷色的柏油灰代表乾淨的空氣；所有暖色（赭黃到煤褐）都是廢氣，而且永遠貼著畫面底部；行人號誌的綠是出口，紅燈的紅只用在「等紅燈的那一刻」。沒量過的東西畫成斜線，不畫成濃度。',
            'A scooter’s tailpipe sits under a metre off the ground, beside the crosswalk, and nobody in Taiwan has measured what the person standing next to it breathes. So the whole site is organised by height, and around that blank: the page is an overcast street, and its cool asphalt greys are clean air; everything warm (ochre to soot) is exhaust and always hugs the bottom of the frame; pedestrian-signal green is the way out; signal red is reserved for the red-light moment. What has not been measured is drawn as hatching, never as a density.',
          )}
        </p>
        <p>
          {L(
            '邊緣像標線一樣銳利：小圓角、沒有陰影、沒有漸層卡片，只用細線和粗的「漆線」分隔。數字用又高又窄的字，像漆在路面上的字。整個首頁是一個紅燈：倒數從 90 走到 00，底部的斜線帶濃度固定，不跟著倒數變。',
            'Edges are crisp like road paint: small radii, no shadows, no gradient cards, only hairlines and thick painted rules. Numerals are tall and condensed, like figures painted on asphalt. The home page is one red light: the countdown runs from 90 to 00, and the hatched band along the bottom has one fixed density that never follows the clock.',
          )}
        </p>
        <ul>
          <li>{L('語氣：站在同一個路口、讀過論文的鄰居。騎士不是反派，是在車陣裡待最久的人。', 'Tone: a neighbour at the same crossing who has read the papers. Riders are not the villains; they are the people who spend longest in the pack.')}</li>
          <li>{L('這不是電動車廣告：不出現任何品牌或實際車款。', 'This is not an EV advert: no brands, no real models.')}</li>
          <li>{L('每個數字都要有來源標記；沒有來源的只能是標示清楚的示意數據。', 'Every number carries a citation marker; anything without one must be visibly labelled sample data.')}</li>
        </ul>
      </div>
      <div class="sg-marks">
        <div class="sg-mark-row"><Mark size="4rem" /><span class="sg-wordmark">{site.name[locale]}</span></div>
        <p class="meta">{L('標誌：一顆在乾淨空氣裡的綠點（也是行人綠燈），下面是愈近地面愈厚的三層廢氣。名稱只定義在 src/i18n/ui.ts。', 'The mark: a green dot in clear air (and the green pedestrian signal) above three exhaust strata that thicken toward the ground. Names are defined once, in src/i18n/ui.ts.')}</p>
        <div class="cluster">
          <img src={asset('/favicon.svg')} width="48" height="48" alt="favicon" />
          <Signal state="red" count={18} size="4.5rem" label={ui.phaseRed[locale]} />
          <Signal state="green" size="2.8rem" label={ui.phaseGreen[locale]} />
        </div>
      </div>
    </div>
  </Section>

  <!-- ================================================================ QUICK START -->
  <Section id="start" eyebrow="02" title={L('快速上手', 'Quick start')} tone="sunken">
    <div class="sg-two">
      <div class="prose">
        <p>{L('每一頁只寫一次，放在 src/pages/[...lang]/，同時輸出中文（/）與英文（/en/）。', 'Each page is written once under src/pages/[...lang]/ and renders both Chinese (/) and English (/en/).')}</p>
        <ol>
          <li>{L('用 Base 包住頁面；內部連結一律經過 href()，/public 的檔案用 asset()。', 'Wrap the page in Base. Every internal link goes through href(); files in /public through asset().')}</li>
          <li>{L('長篇敘事用 Chapter，一般區塊用 Section；文字放進 .prose。', 'Use Chapter for the scroll narrative and Section for ordinary blocks; put running text in .prose.')}</li>
          <li>{L('每張圖表都放在 Figure 裡：標題寫「發現」，副標寫「畫了什麼、單位」。', 'Every chart sits in a Figure: the title states the finding, the subtitle says what is plotted and in what unit.')}</li>
          <li>{L('只用語意色票（--ink、--exhaust、--clean…），不要直接寫色碼。', 'Use semantic tokens only (--ink, --exhaust, --clean…). Never write a hex value.')}</li>
          <li>{L('中文一律用全形標點；中英文、數字之間打一個半形空格。', 'Chinese text uses full-width punctuation; put one normal space between Chinese and Latin letters or digits.')}</li>
          <li>{L('示意數字必須加上 sample 屬性（Figure、Stat、ResultPanel 都有）。', 'Placeholder numbers must set the sample prop (Figure, Stat and ResultPanel all have it).')}</li>
          <li>{L('頁面文案不寫在 .astro 裡：放在 src/i18n/pages/<頁面>.ts，每個字串中英都要有。npm run check 會逐句檢查（見「文案與分享圖」）。', 'Page copy is not written in the .astro file: it lives in src/i18n/pages/<page>.ts, every string in both languages. npm run check reads every one (see Copy and share cards).')}</li>
          <li>{L('每個說法都帶證據標記（EvidenceBadge）；沒人量過的就說沒人量過，並且接著說誰量得出來。', 'Every claim wears its evidence badge; what nobody has measured is said to be unmeasured, followed by who could measure it.')}</li>
        </ol>
      </div>
      <pre class="sg-code" tabindex="0"><code>{`---
import Base from '@/layouts/Base.astro';
import Section from '@/components/ui/Section.astro';
import Figure from '@/components/ui/Figure.astro';
import Cite from '@/components/ui/Cite.astro';
import BarChart from '@/components/charts/BarChart.astro';
import { asset, localeFromParam, localeStaticPaths } from '@/i18n';
import { ui, units } from '@/i18n/ui';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
---
<Base locale={locale} title="…" description="…">
  <Section id="exposure" eyebrow="…" title="…|…" lead="…">
    <Figure locale={locale} number={1} title="…" subtitle={units.ugm3}>
      <BarChart locale={locale} title="…" data={rows} unit={units.ugm3}
        categoryLabel={ui.chart.category[locale]}
        valueLabel={ui.chart.value[locale]} />
      <Cite slot="source" locale={locale} id="wu-2021" n={3} variant="chip" />
    </Figure>
  </Section>
</Base>`}</code></pre>
    </div>
  </Section>

  <!-- ================================================================ COLOUR -->
  <Section id="colour" eyebrow="03" title={L('色彩', 'Colour')} lead={L('兩個主題同等重要：跟隨系統設定，右上角可手動切換並記住。所有文字與底色的組合都通過 WCAG AA。', 'Both themes are first-class: the site follows the system setting, and the toggle in the header overrides and remembers it. Every text and background pair passes WCAG AA.')}>
    <h3 class="sg-h">{L('表面與文字', 'Surfaces and ink')}</h3>
    <div class="sg-swatches">
      <Swatch token="--bg" note={L('頁面：陰天', 'Page: overcast')} />
      <Swatch token="--bg-sunken" note={L('凹陷區塊', 'Recessed bands')} />
      <Swatch token="--surface" note={L('卡片、輸入框', 'Cards, inputs')} />
      <Swatch token="--line" note={L('細線', 'Hairlines')} />
      <Swatch token="--line-strong" note={L('控制項邊框 ≥3:1', 'Control borders ≥3:1')} />
      <Swatch token="--ink" text note={L('主要文字', 'Primary text')} />
      <Swatch token="--ink-2" text note={L('次要文字', 'Secondary text')} />
      <Swatch token="--ink-3" text note={L('圖說、註記', 'Captions, meta')} />
    </div>

    <h3 class="sg-h">{L('語意色：廢氣、乾淨、紅燈', 'Semantic: exhaust, clean, red phase')}</h3>
    <div class="sg-swatches">
      <Swatch token="--exhaust" note={L('廢氣：標記、線條', 'Exhaust: marks, rules')} />
      <Swatch token="--exhaust-ink" text note={L('廢氣：可當文字', 'Exhaust: text-safe')} />
      <Swatch token="--exhaust-wash" note={L('廢氣：底色', 'Exhaust: wash')} />
      <Swatch token="--clean" note={L('乾淨/電動：標記', 'Clean / electric: marks')} />
      <Swatch token="--clean-ink" text note={L('乾淨：可當文字', 'Clean: text-safe')} />
      <Swatch token="--clean-wash" note={L('乾淨：底色', 'Clean: wash')} />
      <Swatch token="--accent" note={L('連結與主要按鈕（綠燈）', 'Links and primary action (go)')} />
      <Swatch token="--signal-red" note={L('紅燈：只用在「等紅燈」', 'Red phase only')} />
      <Swatch token="--signal-red-ink" text note={L('紅燈：可當文字', 'Red: text-safe')} />
      <Swatch token="--paint-yellow" note={L('標線黃：插畫、示意標籤', 'Paint yellow: art, sample tag')} />
    </div>

    <h3 class="sg-h">{L('圖表：類別色（順序固定）', 'Charts: categorical set (fixed order)')}</h3>
    <div class="sg-swatches">
      <Swatch token="--chart-exhaust" note={L('1 燃油/廢氣', '1 gasoline / exhaust')} />
      <Swatch token="--chart-clean" note={L('2 電動/乾淨', '2 electric / clean')} />
      <Swatch token="--chart-blue" note="3 blue" />
      <Swatch token="--chart-lime" note="4 lime" />
      <Swatch token="--chart-magenta" note="5 magenta" />
      <Swatch token="--chart-violet" note="6 violet" />
      <Swatch token="--chart-neutral" note={L('其他/淡化', 'Other / de-emphasis')} />
      <Swatch token="--chart-signal" note={L('保留：超過限值', 'Reserved: over a limit')} />
    </div>
    <div class="prose sg-note">
      <p>
        {L(
          '六個類別色在兩個主題下都用 dataviz 驗證程式檢查過（紅綠色盲模擬下相鄰色差 ΔE 至少 11.8；一般視覺至少 16.4；對底色對比全部 ≥3:1）。前三色兩兩之間也通過，所以散佈圖與小倍數圖最多用三色。順序是安全機制的一部分：不要重排、不要循環、不要自己加第七色，超過就併成「其他」。',
          'The six categorical colours were checked with the dataviz validator in both themes (adjacent ΔE at least 11.8 under red-green colour-blindness simulation, at least 16.4 for normal vision, all ≥3:1 against the surface). The first three also pass pairwise, so scatter plots and small multiples may use at most three. The order is part of the safety mechanism: never reorder, cycle, or add a seventh. Fold the tail into “other”.',
        )}
      </p>
      <p>{L('顏色跟著「對象」走，不跟著排名走：燃油永遠是赭黃，電動永遠是綠。文字永遠用墨色，不用數列色。', 'Colour follows the entity, never its rank: gasoline is always ochre, electric always green. Text always wears ink, never a series colour.')}</p>
    </div>

    <h3 class="sg-h">{L('圖表：順序色階（少 → 多）', 'Charts: ordinal ramps (less → more)')}</h3>
    <div class="sg-ramps">
      <div class="sg-ramp">{[1, 2, 3, 4, 5].map((i) => <span style={`background:var(--exhaust-s${i})`}><code>--exhaust-s{i}</code></span>)}</div>
      <div class="sg-ramp">{[1, 2, 3, 4, 5].map((i) => <span style={`background:var(--clean-s${i})`}><code>--clean-s{i}</code></span>)}</div>
    </div>
    <p class="meta sg-note">{L('深色主題下色階方向相反（愈多愈亮）。對比兩極時用廢氣 ↔ 乾淨，中點用 --chart-neutral。', 'In the dark theme the ramps run the other way (more is lighter). For diverging scales use exhaust ↔ clean with --chart-neutral at the midpoint.')}</p>

    <h3 class="sg-h">{L('區塊色調', 'Tones')}</h3>
    <div class="grid sg-tones">
      {(['sunken', 'surface', 'exhaust', 'clean', 'inverse'] as const).map((tone) => (
        <div class={`tone-${tone} sg-tone`}>
