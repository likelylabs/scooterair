---
/**
 * Styleguide — the reference for everyone building pages on this system.
 * Every token, component, chart and illustration, in both languages, with
 * usage notes. noindex; excluded from the sitemap in astro.config.mjs.
 *
 * ALL NUMBERS ON THIS PAGE ARE INVENTED SAMPLE DATA.
 */
import Base from '@/layouts/Base.astro';
import { asset, href, localeFromParam, localeStaticPaths } from '@/i18n';
import { chain, evidenceKinds, questions, site, ui, units } from '@/i18n/ui';
