    <Block name="EvidenceChain / ChainLink" file="ui/EvidenceChain.astro · ui/ChainLink.astro" code={`{/* 證據板（V15）：六件事 + 一格空白 + 關著的推論 */}
<EvidenceChain locale={locale} links={sixFacts} collapseSources
