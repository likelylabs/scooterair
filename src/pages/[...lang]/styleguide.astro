---
/**
 * /styleguide/ — the shared components of the redesign (brief 5.4) on one page, for `astro dev`
 * only. Not built in production (brief section 2): getStaticPaths returns nothing when PROD.
 *
 * Every number shown is read from src/data/estimate.ts or the calculator exactly as a page reads
 * it. Captions here are a developer's notes, not reader copy (the file is in the copy guard's
 * inlineCopyAllowed list). The scenes have their own sheet: /styleguide-art/.
 */
import Base from '@/layouts/Base.astro';
import { href, localeFromParam, localeStaticPaths } from '@/i18n';
import { chipWhere, kSentences } from '@/i18n/ui';
import { est, estimateText, formatReference, kerbSentence, scenarioKeys } from '@/data/estimate';
import Screen from '@/components/ui/Screen.astro';
import ScreenRail from '@/components/ui/ScreenRail.astro';
import KindChip from '@/components/ui/KindChip.astro';
import EstimateValue from '@/components/ui/EstimateValue.astro';
import HowSheet from '@/components/ui/HowSheet.astro';
import ScenarioSwitch from '@/components/ui/ScenarioSwitch.astro';
import Segmented from '@/components/ui/Segmented.astro';
import Range from '@/components/ui/Range.astro';
import KerbScene from '@/components/art/KerbScene.astro';
import MeasuredVsEstimate from '@/components/charts/MeasuredVsEstimate.astro';
import WorkingSum from '@/components/charts/WorkingSum.astro';
import { workingKerbFlow, workingPerRed } from '@/components/charts/core/workingSum';

export const getStaticPaths = () => (import.meta.env.PROD ? [] : localeStaticPaths());
const locale = localeFromParam(Astro.params.lang);
const L = (zh: string, en: string) => (locale === 'en' ? en : zh);
const kinds = ['measured', 'estimate', 'official', 'study', 'derived'] as const;
---

<Base locale={locale} title={L('元件樣張', 'Component sheet')} noindex>
  <ScreenRail slot="rail" locale={locale} total={2} chapter={L('吸進多少', 'How much')} />

  <div class="container sg">
    <h1>{L('元件樣張（只在開發時）', 'Component sheet (development only)')}</h1>
    <p><a href={href('/styleguide-art/', locale)}>{L('場景樣張 →', 'Scene sheet →')}</a></p>

    <h2>{L('五種標記', 'The five chips')}</h2>
    <p class="sg__row">{kinds.map((k) => <KindChip locale={locale} kind={k} where={k === 'estimate' || k === 'derived' ? undefined : chipWhere.taiwan[locale]} />)}</p>

    <h2>{L('推估的數字', 'Estimated values')}</h2>
    <div class="sg__col">
      {scenarioKeys.map((s) => <EstimateValue locale={locale} slotId={`co.${s}.add`} label={estimateText.addedByPack[locale]} sheet="how-1" />)}
      <EstimateValue locale={locale} slotId="co.dozen.total" size="lg" sheet="how-1" />
      <p>{estimateText.alreadyThere[locale]} {formatReference(est.bg.co.traffic.shown, 'ppm', locale)} <KindChip locale={locale} kind="measured" /></p>
    </div>

    <h2>{L('拉桿（一定有值）', 'Range (always has a value)')}</h2>
    <Range id="sg-range" name="sg-range" label={L('每月騎幾公里', 'Kilometres a month')} min={50} max={1500} step={50} value={300} />

    <h2>{L('K 句', 'K sentences')}</h2>
    <ul>{Object.entries(kSentences).map(([id, s]) => <li><b>{id}</b> {s[locale]}</li>)}</ul>

    <h2>{L('算法圖', 'The working, drawn')}</h2>
    <WorkingSum {...workingPerRed(locale)} />
    <WorkingSum {...workingKerbFlow(locale)} />

    <h2>{L('量到的，和算的', 'Measured beside estimated')}</h2>
    <MeasuredVsEstimate locale={locale} sheet="how-1" />
  </div>

  <Screen locale={locale} n={1} total={2} chapter={L('吸進多少', 'How much')} headline={L('一排機車停在旁邊，|路邊多一層廢氣', 'A row of scooters beside you |adds a layer of exhaust at the kerb')} illustration next={{ label: L('有人實際量過嗎？', 'Has anyone actually measured it?') }}>
    <KerbScene slot="picture" locale={locale} />
    <ScenarioSwitch slot="controls" locale={locale} />
    <p slot="body">{est.meta.gloss[locale]}{locale === 'en' ? ' ' : ''}{scenarioKeys.map((s) => <span data-when-scenario={s}>{kerbSentence(s, locale)}</span>)}</p>
    <KindChip slot="chips" locale={locale} kind="estimate" />
    <HowSheet slot="sheet" id="how-1" locale={locale} kind="estimate" pollutant="co" anchor="recipe">
      <p slot="block1">{L('運研所在行人等候區量過一氧化碳。', 'The Institute of Transportation measured carbon monoxide where pedestrians wait.')}</p>
      <ol slot="block2">{estimateText.flow.map((f) => <li>{f[locale]}</li>)}</ol>
      <p slot="block3">{est.meta.appliesTo[locale]} {est.confidence.co.why[locale]}</p>
    </HowSheet>
  </Screen>

  <Screen locale={locale} n={2} total={2} chapter={L('每個月', 'Each month')} headline={L('分段按鈕', 'A segmented switch')} next={{ label: L('回到上面', 'Back to the top'), href: '#top' }}>
    <Segmented slot="controls" name="km" legend={L('每月騎幾公里', 'Kilometres a month')} value="300" options={[150, 300, 500, 800].map((n) => ({ value: String(n), label: String(n) }))} />
  </Screen>
</Base>

<style>
  .sg h2 {
    margin-block-start: 2rem;
  }
  .sg__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sg__col {
    display: grid;
    gap: 0.5rem;
    max-width: 30rem;
  }
</style>
