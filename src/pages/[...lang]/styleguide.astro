      <Figure locale={locale} number={5} title={L('電動機車變多了，|但還是少數', 'Electric scooters are growing, |but still few')} subtitle={L('每年新掛牌機車數（萬輛）', 'New scooter registrations per year (ten thousands)')} caption={L('LineChart：多個數列時線尾直接標數值，寬螢幕再加上名稱。滑鼠移過會出現十字線。', 'LineChart: with several series the line ends carry their values, and their names too on wide screens. Hover for a crosshair.')} sample>
        <LineChart locale={locale} title={L('新掛牌機車數折線圖', 'Line chart of new scooter registrations')} x={[2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025]} series={[{ label: series2[0].label, tone: 'exhaust', values: [84, 96, 78, 73, 94, 72, 65, 78, 71, 69] }, { label: series2[1].label, tone: 'clean', values: [2, 4, 8, 17, 10, 9, 9, 8, 7, 9] }]} unit={L('萬輛', '×10k')} xLabel={L('年', 'Year')} />
      </Figure>

      <Figure locale={locale} number={6} title={L('單一數列：|加上淡淡的面積', 'A single series |gets a soft area')} subtitle={L(`路口年平均濃度（${units.ugm3}）`, `Annual mean at a crossing (${units.ugm3})`)} caption={L('LineChart，單一數列加參考線。', 'LineChart, one series with a reference line.')} sample>
