---
/**
 * /sources/ — 資料來源 / Sources (redesign brief 7.4; blueprint 4.8). A reference list only,
 * reached from the footer and from /evidence/. The full bibliography from the registry: every
 * source with its stable number, its citation in the reader's language, a working link (DOI or
 * URL), how far it was read, and every fact, chart dataset and answer that cites it. Sources the
 * site's own estimate rests on (estimateSourceIds) say so and link to /estimate/#recipe; the
 * mask facts' sources are ordinary entries (link 3). The old gap section is gone.
 * Citation markers across the site link to /sources/#<source id>.
 *
 * The filter (by link of the chain and by kind of source) is two groups of radio buttons and
 * CSS :has(), so it works without JavaScript; a short script only updates the count. Where :has()
 * is not supported, every source stays listed.
 *
 * Copy: src/i18n/pages/sources.ts.
 */
import Base from '@/layouts/Base.astro';
import Phrased from '@/components/ui/Phrased.astro';
import Tag from '@/components/ui/Tag.astro';
import KindChip from '@/components/ui/KindChip.astro';
import Icon from '@/components/ui/Icon.astro';
import Mixed from '@/components/pages/evidence/Mixed.astro';
import { citeN, dataAnchor, lf, ls, neverSmokerFacts, readLabel, sourceShort, sourceUses } from '@/components/pages/evidence/ev';
import evidenceCopy from '@/i18n/pages/evidence';
import { href, htmlLang, localeFromParam, localeStaticPaths } from '@/i18n';
import { readerText, ui } from '@/i18n/ui';
import sourcesCopy from '@/i18n/pages/sources';
import { fill, localize } from '@/i18n/pages/_copy';
import { answerList, chainLinks, facts, formatCitation, getSource, localizeAnswer, readLevelLabels, readLevels, sourceIds, sourceKindLabels, sourceKinds, sourceUrl, type AnswerId, type SourceId } from '@/data';
import { estimateSourceIds } from '@/data/estimate';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const T = localize(sourcesCopy, locale);
const plain = (s: string) => s.replaceAll('|', '');
const uses = sourceUses();
/** Percent-encoded Chinese in a URL, shown as characters (the link itself is unchanged). */
const readableUrl = (u: string) => {
  try {
    return decodeURI(u);
  } catch {
    return u;
  }
};
const total = sourceIds.length;
/** A link of the chain is named by its topic ("排氣管排出什麼"), not its number. */
const TE = localize(evidenceCopy, locale);
const topic = (n: number) => { const t = TE.answerLink.topics[n - 1]; return t.charAt(0).toUpperCase() + t.slice(1); };

/** The answers (former gaps) that rest on a source, through their facts or their own sources. */
const answersBySource = new Map<SourceId, AnswerId[]>();
for (const a of answerList) {
  const srcs = new Set<SourceId>([...(a.sources ?? []), ...a.facts.flatMap((f) => facts[f].sources)]);
  for (const id of srcs) answersBySource.set(id, [...(answersBySource.get(id) ?? []), a.id]);
}
const estimateSet = new Set<string>(estimateSourceIds);
/**
 * The citation is written in the reader's language; only the original title (and the journal or
 * series name) are in the source's. Split those out so each part carries the right lang (WCAG 3.1.2).
 */
const citeParts = (citation: string, s: ReturnType<typeof getSource>): { text: string; lang?: string }[] => {
  if (s.language === locale) return [{ text: citation }];
  const lang = htmlLang[s.language];
  const foreign = [s.title, s.container].filter((x): x is string => !!x && !s.titleIsDescriptive).map((x) => readerText(x));
  let parts: { text: string; lang?: string }[] = [{ text: citation }];
  for (const f of foreign) {
    parts = parts.flatMap((p) => {
      if (p.lang || !f || !p.text.includes(f)) return [p];
      const i = p.text.indexOf(f);
      return [{ text: p.text.slice(0, i) }, { text: f, lang }, { text: p.text.slice(i + f.length) }].filter((x) => x.text);
    });
  }
  return parts;
};
const entries = sourceIds.map((id) => {
  const s = getSource(id);
  const u = uses.get(id)!;
  // The address and the date we checked it are shown by the link and the line under it, so the
  // printed citation stops before the address (a long URL is unreadable on a phone).
  const full = readerText(formatCitation(id, locale)).replace(sourceUrl(id), readableUrl(sourceUrl(id)));
  const at = full.indexOf(readableUrl(sourceUrl(id)));
  const citation = at > 0 ? full.slice(0, at).trim() : full;
  return {
    id,
    n: citeN(id),
    s,
    u,
    answers: answersBySource.get(id) ?? [],
    estimate: estimateSet.has(id),
    citation,
    parts: citeParts(citation, s),
    url: sourceUrl(id),
    kind: readerText(sourceKindLabels[s.kind][locale]),
    read: readLabel(s, locale),
    count: u.facts.length + u.series.length + (answersBySource.get(id)?.length ?? 0),
  };
});
const kindsUsed = sourceKinds.filter((k) => entries.some((e) => e.s.kind === k));
const linkCount = (n: number) => entries.filter((e) => (n === 0 ? e.u.links.length === 0 : e.u.links.includes(n as never))).length;
const readCounts = readLevels.map((lvl) => ({ label: readerText(readLevelLabels[lvl][locale]), n: entries.filter((e) => e.s.readLevel === lvl).length })).filter((r) => r.n > 0);

// No-JS filter: hide what does not match the checked radio in each group.
const css = [
  ...chainLinks.map((n) => `.sx:has(#sx-l-${n}:checked) .sx-src:not([data-l${n}]){display:none}`),
  `.sx:has(#sx-l-0:checked) .sx-src:not([data-l0]){display:none}`,
  `.sx:has(#sx-l-est:checked) .sx-src:not([data-est]){display:none}`,
  ...kindsUsed.map((k) => `.sx:has(#sx-k-${k}:checked) .sx-src:not([data-kind="${k}"]){display:none}`),
  `.sx .sx-src:target{display:grid !important}`,
].join('');
---

<Base locale={locale} title={T.meta.title} description={T.meta.description} share="brief">
  <Fragment slot="head" set:html={`<style>${css}</style>`} />
  <header class="sx-head">
    <div class="container"><div class="sx-head__inner">
      <p class="eyebrow">{T.head.kicker}</p>
      <h1 class="display"><Phrased text={T.head.title} /></h1>
      <p class="lead">{fill(T.head.lead, { n: total })}</p>
      <p>{T.head.evidence}</p>
      <div><a class="sx-go" href={href('/evidence/', locale)}>{T.head.evidenceLink}<Icon name="arrow-right" size="1.05em" /></a></div>
      <details class="sx-reads">
        <summary><span>{T.reads.title}</span><Icon name="chevron-down" size="1.25rem" /></summary>
        <p>{T.reads.lead}</p>
        <ul>
          {readCounts.map((r) => <li><span>{r.label}</span><b>{fill(T.reads.count, { n: r.n })}</b></li>)}
        </ul>
      </details>
    </div></div>
  </header>

  <div class="sx">
    <form class="sx-filter container" id="filter" aria-labelledby="sx-filter-title" onsubmit="return false">
      <h2 class="sx-filter__title" id="sx-filter-title">{T.filter.title}</h2>
      <p class="sx-filter__hint">{T.filter.hint}</p>
      <fieldset>
        <legend>{T.filter.link}</legend>
        <div class="sx-chips">
          <span class="sx-chip"><input type="radio" name="link" id="sx-l-all" value="" checked /><label for="sx-l-all">{T.filter.all} <span>{total}</span></label></span>
          {chainLinks.map((n) => (
            <span class="sx-chip"><input type="radio" name="link" id={`sx-l-${n}`} value={String(n)} /><label for={`sx-l-${n}`}>{topic(n)} <span>{linkCount(n)}</span></label></span>
          ))}
          <span class="sx-chip"><input type="radio" name="link" id="sx-l-0" value="0" /><label for="sx-l-0">{T.filter.none} <span>{linkCount(0)}</span></label></span>
          <span class="sx-chip"><input type="radio" name="link" id="sx-l-est" value="est" /><label for="sx-l-est">{T.filter.estimate} <span>{entries.filter((e) => e.estimate).length}</span></label></span>
        </div>
      </fieldset>
      <fieldset>
        <legend>{T.filter.kind}</legend>
        <div class="sx-chips">
          <span class="sx-chip"><input type="radio" name="kind" id="sx-k-all" value="" checked /><label for="sx-k-all">{T.filter.all} <span>{total}</span></label></span>
          {kindsUsed.map((k) => (
            <span class="sx-chip"><input type="radio" name="kind" id={`sx-k-${k}`} value={k} /><label for={`sx-k-${k}`}>{readerText(sourceKindLabels[k][locale])} <span>{entries.filter((e) => e.s.kind === k).length}</span></label></span>
          ))}
        </div>
      </fieldset>
      <p class="sx-count" aria-live="polite" data-sx-count data-template={T.filter.showing} hidden></p>
    </form>

    <div class="container">
      <ol class="sx-list" aria-label={plain(T.meta.title)}>
        {entries.map((e) => (
          <li
            class="sx-src"
            id={e.id}
            data-kind={e.s.kind}
            data-l0={e.u.links.length === 0 ? '' : undefined}
            data-l1={e.u.links.includes(1) ? '' : undefined}
            data-l2={e.u.links.includes(2) ? '' : undefined}
            data-l3={e.u.links.includes(3) ? '' : undefined}
            data-l4={e.u.links.includes(4) ? '' : undefined}
            data-l5={e.u.links.includes(5) ? '' : undefined}
            data-l6={e.u.links.includes(6) ? '' : undefined}
            data-l7={e.u.links.includes(7) ? '' : undefined}
            data-est={e.estimate ? '' : undefined}
          >
            <p class="sx-src__n"><span class="vh">{fill(T.entry.number, { n: '' }).trim()} </span>{e.n}</p>
            <div class="sx-src__body">
              <p class="sx-src__tags">
                <Tag>{e.kind}</Tag>
                <span class="sx-src__read"><span class="vh">{T.entry.read} </span>{e.read}</span>
                {e.s.titleIsDescriptive && <Tag tone="signal">{T.entry.descriptive}</Tag>}
                {e.estimate && <KindChip locale={locale} kind="estimate" size="sm" />}
              </p>
              <p class="sx-src__cite">{e.parts.map((p) => (p.lang ? <span lang={p.lang}>{p.text}</span> : p.text))}</p>
              {e.s.titleIsDescriptive && <p class="sx-src__hint">{T.entry.descriptiveHelp}</p>}
              <div class="sx-src__actions">
                <a href={e.url} rel="noopener noreferrer" target="_blank">{e.s.doi && !e.s.url ? `${T.entry.doi} ${e.s.doi}` : T.entry.open}<span class="vh">{locale === 'en' ? ': ' : '：'}{sourceShort(e.id, locale)} {ui.externalLink[locale]}</span> ↗</a>
                <span class="sx-src__checked">{fill(T.entry.checked, { date: e.s.accessed })}</span>
              </div>
              <div class="sx-src__links">
                <b>{T.entry.links}</b>
                {e.u.links.length ? e.u.links.map((n) => <a href={href(`/evidence/#link-${n}`, locale)}>{topic(n)}</a>) : !e.estimate && <span>{T.entry.noLink}</span>}
                {e.estimate && <a href={href('/estimate/#recipe', locale)}>{T.entry.estimate}</a>}
              </div>
              {e.count > 0 && (
                <details class="sx-src__uses">
                  <summary>{fill(T.entry.uses, { n: e.count })}</summary>
                  {e.u.facts.length > 0 && (
                    <Fragment>
                      <p class="sx-src__ulabel">{T.entry.facts}</p>
                      <ul>
                        {e.u.facts.map((f) => {
                          const x = lf(f, locale);
                          // R14: the never-smoker figures are printed only on /evidence/#not-used
                          if (neverSmokerFacts.includes(f)) return <li><a href={href(`/evidence/#${f}`, locale)}>{evidenceCopy.row.neverSmokerPointer[locale]}</a> <span class="sx-src__st">{evidenceCopy.row.alsoNotUsed[locale]}</span></li>;
                          return <li><a href={href(`/evidence/#${f}`, locale)}>{x.display}</a> <KindChip locale={locale} kind={x.evidence} size="sm" /> <span class="sx-src__st"><Mixed text={x.statement} locale={locale} /></span></li>;
                        })}
                      </ul>
                    </Fragment>
                  )}
                  {e.u.series.length > 0 && (
                    <Fragment>
                      <p class="sx-src__ulabel">{T.entry.series}</p>
                      <ul>{e.u.series.map((x) => <li><a href={href(`/evidence/#${dataAnchor(x)}`, locale)}>{ls(x, locale).title}</a></li>)}</ul>
                    </Fragment>
                  )}
                  {e.answers.length > 0 && (
                    <Fragment>
                      <p class="sx-src__ulabel">{T.entry.answers}</p>
                      <ul>{e.answers.map((a) => <li><a href={href(`/evidence/#${a}`, locale)}>{localizeAnswer(a, locale).question}</a></li>)}</ul>
                    </Fragment>
                  )}
                </details>
              )}
            </div>
          </li>
        ))}
      </ol>
      <div class="sx-top"><a href="#filter">{T.top}</a></div>
    </div>
  </div>

</Base>

<script>
  // Enhancement only: say how many sources the filter leaves.
  const form = document.querySelector<HTMLFormElement>('.sx-filter');
  const out = document.querySelector<HTMLElement>('[data-sx-count]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('.sx-src'));
  if (form && out && CSS.supports('selector(:has(*))')) {
    const update = () => {
      const shown = items.filter((el) => el.offsetParent !== null || getComputedStyle(el).display !== 'none').length;
      out.textContent = (out.dataset.template ?? '').replace('{n}', String(shown)).replace('{total}', String(items.length));
      out.hidden = false;
    };
    form.addEventListener('change', update);
    update();
  }
</script>

<style>
  .sx-head {
    padding-block: clamp(1.5rem, 5vw, 3.5rem) var(--sp-6);
  }
  .sx-head__inner {
    display: grid;
    gap: var(--sp-4);
    max-inline-size: 52rem;
  }
  .sx-reads {
    font-size: var(--fs-sm);
    border-block: 1px solid var(--line-strong);
  }
  .sx-reads summary {
    min-block-size: var(--tap, 44px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    font-weight: var(--fw-bold);
    color: var(--accent);
    cursor: pointer;
    list-style: none;
  }
  .sx-reads summary::-webkit-details-marker {
    display: none;
  }
  .sx-reads[open] summary :global(svg) {
    transform: rotate(180deg);
  }
  .sx-reads p {
    color: var(--ink-2);
    margin-block-end: var(--sp-3);
  }
  .sx-reads ul {
    list-style: none;
    margin: 0 0 var(--sp-3);
    padding: 0;
  }
  .sx-reads li {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-3);
    padding-block: var(--sp-1);
    border-block-end: 1px solid var(--line);
  }
  .sx-filter {
    display: grid;
    gap: var(--sp-4);
    padding-block: var(--sp-5);
    scroll-margin-block-start: calc(var(--header-h) + var(--sp-4));
  }
  .sx-filter__title {
    font-size: var(--fs-lg);
  }
  .sx-filter__hint {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .sx-filter fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-inline-size: 0;
  }
  .sx-filter legend {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    margin-block-end: var(--sp-2);
  }
  .sx-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .sx-chip {
    position: relative;
  }
  .sx-chip input {
    position: absolute;
    opacity: 0;
    inline-size: 1px;
    block-size: 1px;
  }
  .sx-chip label {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-block-size: var(--tap, 44px);
    padding: 0 0.85em;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    cursor: pointer;
    max-inline-size: 100%;
  }
  .sx-chip label span {
    font-size: var(--fs-xs);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .sx-chip input:checked + label {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
    font-weight: var(--fw-bold);
  }
  .sx-chip input:checked + label span {
    color: var(--bg);
  }
  .sx-chip input:focus-visible + label {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .sx-count {
    font-weight: var(--fw-bold);
  }
  .sx-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sx-src {
    display: grid;
    /* wide enough for three heavy digits (sources 100–222) on one line */
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--sp-3);
    padding-block: var(--sp-5);
    border-block-start: 1px solid var(--line);
    scroll-margin-block-start: calc(var(--header-h) + var(--sp-4));
  }
  .sx-src:target {
    background: var(--mark-bg);
    box-shadow: 0 0 0 var(--sp-2) var(--mark-bg);
  }
  @media (max-width: 40em) {
    .sx-src {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-1);
    }
    .sx-src__n {
      font-size: var(--fs-lg) !important;
    }
  }
  .sx-src__n {
    font-family: var(--font-en-display, inherit);
    font-size: var(--fs-xl);
    font-weight: var(--fw-black, 900);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .sx-src__body {
    display: grid;
    gap: var(--sp-2);
    min-inline-size: 0;
  }
  .sx-go {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-block-size: var(--tap);
    font-weight: var(--fw-bold);
  }
  .sx-src__tags :global(.tag) {
    white-space: normal;
  }
  .sx-src__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1) var(--sp-2);
  }
  .sx-src__read {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .sx-src__cite {
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    overflow-wrap: anywhere;
  }
  .sx-src__hint {
    font-size: var(--fs-xs);
    color: var(--ink-2);
    padding-inline-start: var(--sp-3);
    border-inline-start: 2px dashed var(--line-strong);
  }
  .sx-src__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-4);
    font-size: var(--fs-sm);
  }
  .sx-src__actions a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap, 44px);
    font-weight: var(--fw-bold);
    color: var(--accent);
    overflow-wrap: anywhere;
  }
  .sx-src__checked {
    font-size: var(--fs-xs);
    color: var(--ink-2);
  }
  .sx-src__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--tap-gap) var(--sp-3);
    font-size: var(--fs-sm);
  }
  .sx-src__links a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
    min-inline-size: var(--tap);
  }
  .sx-src__uses {
    font-size: var(--fs-sm);
  }
  .sx-src__uses summary {
    min-block-size: var(--tap, 44px);
    display: flex;
    align-items: center;
    color: var(--accent);
    font-weight: var(--fw-bold);
    cursor: pointer;
  }
  .sx-src__ulabel {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
    margin-block: var(--sp-2) var(--sp-1);
  }
  .sx-src__uses ul {
    margin: 0;
    padding-inline-start: 1.2em;
    display: grid;
    gap: var(--sp-2);
  }
  .sx-src__uses li a {
    font-weight: var(--fw-bold);
  }
  .sx-src__st {
    display: block;
    color: var(--ink-2);
    line-height: var(--lh-snug);
  }
  .sx-top {
    padding-block: var(--sp-5);
    font-weight: var(--fw-bold);
  }
  .sx-top a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
  }
  .sx-gaps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
  }
  @media (min-width: 48em) {
    .sx-gaps {
      grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    }
  }
  .sx-gap {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    padding: var(--sp-4);
    border: 2px dashed var(--ink-3);
    border-radius: var(--radius-2);
    background: var(--bg);
    scroll-margin-block-start: calc(var(--header-h) + var(--sp-4));
  }
  .sx-gap:target {
    border-color: var(--accent);
  }
  .sx-gap__title {
    font-size: var(--fs-md);
    line-height: var(--lh-snug);
  }
  .sx-gap__who {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .sx-gap__who b {
    color: var(--ink);
  }
  .sx-gap__more {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap, 44px);
  }
</style>
