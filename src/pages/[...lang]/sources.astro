---
/**
 * /sources/ — 資料來源 / Sources (redesign brief 7.4). A reference list, reached from the footer,
 * from /evidence/ and from every citation marker on the site (/sources/#<source id>).
 *
 * Layout: a short plain introduction (what a source is, what the read-level labels mean, the
 * hard words), a text filter, then the sources grouped by the question they help answer: the
 * seven links of the chain, our estimate, masks, money, background
 * (src/components/pages/sources/groups.ts says how a source's group is chosen). Each group is a
 * closed <details> with its count and a one-line summary. A source used by several groups is
 * listed once, under its main group; the entry names its other groups and each of those groups
 * links back to it.
 *
 * Deep links: /sources/#<source id> lands on the entry. Without JavaScript the browser opens the
 * closed group around the target itself (fragment navigation reveals a closed <details>); with
 * JavaScript the script below does the same on arrival, on hashchange and on in-page links, and
 * keeps the entry in view. The filter is shown only when JavaScript runs; without it every group
 * reads as before.
 *
 * Copy: src/i18n/pages/sources.ts (including one plain sentence per source: what we use it for).
 */
import Base from '@/layouts/Base.astro';
import Phrased from '@/components/ui/Phrased.astro';
import Tag from '@/components/ui/Tag.astro';
import KindChip from '@/components/ui/KindChip.astro';
import Icon from '@/components/ui/Icon.astro';
import WordHelp from '@/components/ui/WordHelp.astro';
import Mixed from '@/components/pages/evidence/Mixed.astro';
import { citeN, dataAnchor, lf, ls, neverSmokerFacts, readLabel, sourceShort, sourceUses } from '@/components/pages/evidence/ev';
import { groupAnchor, groupOrder, sourceGroups, sourceWhen, sourceWhere, sourceWho, type GroupId } from '@/components/pages/sources/groups';
import evidenceCopy from '@/i18n/pages/evidence';
import { href, htmlLang, localeFromParam, localeStaticPaths } from '@/i18n';
import { readerText, ui } from '@/i18n/ui';
import sourcesCopy from '@/i18n/pages/sources';
import { fill, localize } from '@/i18n/pages/_copy';
import { answerList, facts, getSource, localizeAnswer, readLevelLabels, readLevels, sourceIds, sourceKindLabels, sourceUrl, type AnswerId, type SourceId } from '@/data';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const T = localize(sourcesCopy, locale);
const uses = sourceUses();
const groupsOf = sourceGroups();
const total = sourceIds.length;
const colon = locale === 'en' ? ': ' : '：';
const dot = locale === 'en' ? ' · ' : '・';
const sp = locale === 'en' ? ' ' : '';

/** A link of the chain is named by its topic ("排氣管排出什麼"), not its number. */
const TE = localize(evidenceCopy, locale);
const topic = (n: number) => { const t = TE.answerLink.topics[n - 1]; return t.charAt(0).toUpperCase() + t.slice(1); };
const groupName = (g: GroupId): string => (/^\d$/.test(g) ? topic(Number(g)) : T.group.names[g as 'estimate' | 'masks' | 'money' | 'background']);
const groupSummary = (g: GroupId): string => (T.group.summary as Record<string, string>)[g];

/** The answers (former gaps) that rest on a source, through their facts or their own sources. */
const answersBySource = new Map<SourceId, AnswerId[]>();
for (const a of answerList) {
  const srcs = new Set<SourceId>([...(a.sources ?? []), ...a.facts.flatMap((f) => facts[f].sources)]);
  for (const id of srcs) answersBySource.set(id, [...(answersBySource.get(id) ?? []), a.id]);
}

const usedFor = sourcesCopy.usedFor as Record<string, { 'zh-TW': string; en: string }>;
const entries = sourceIds.map((id) => {
  const s = getSource(id);
  const u = uses.get(id)!;
  const g = groupsOf.get(id)!;
  const foreign = s.language !== locale;
  const title = readerText(s.title);
  const translated = s.titleTranslated && foreign ? readerText(s.titleTranslated) : undefined;
  const who = sourceWho(s, locale);
  // a document that prints no year shows none here (its 檢索日期 / Accessed line is under it)
  const when = sourceWhen(s, '');
  const where = sourceWhere(s, locale);
  const use = usedFor[id]?.[locale];
  if (!use) throw new Error(`/sources/: no usedFor sentence for source "${id}" in src/i18n/pages/sources.ts`);
  const answers = answersBySource.get(id) ?? [];
  const search = [title, s.titleTranslated, who, s.org?.['zh-TW'], s.org?.en, ...(s.authors ?? []), s.container, s.year, s.date, use, id]
    .filter(Boolean)
    .join(' ')
    .replaceAll('\u81fa', '\u53f0')
    .toLowerCase();
  return {
    id,
    n: citeN(id),
    s,
    u,
    g,
    title,
    titleLang: foreign && !s.titleIsDescriptive ? htmlLang[s.language] : undefined,
    translated,
    who,
    when,
    where,
    use,
    answers,
    search,
    url: sourceUrl(id),
    kind: readerText(sourceKindLabels[s.kind][locale]),
    read: readLabel(s, locale),
    count: u.facts.length + u.series.length + answers.length,
  };
});
type Entry = (typeof entries)[number];
const groups = groupOrder
  .map((g) => ({
    g,
    list: entries.filter((e) => e.g.main === g),
    alsoHere: entries.filter((e) => e.g.also.includes(g)),
  }))
  .filter((x) => x.list.length > 0);
const readCounts = readLevels.map((lvl) => ({ label: readerText(readLevelLabels[lvl][locale]), n: entries.filter((e) => e.s.readLevel === lvl).length })).filter((r) => r.n > 0);
const siteLinks = (e: Entry) => [
  ...(e.g.main === 'estimate' || e.g.also.includes('estimate') ? [{ href: href('/estimate/#recipe', locale), label: T.entry.estimate }] : []),
  ...(e.g.main === 'money' || e.g.also.includes('money') ? [{ href: href('/electric/#cities', locale), label: T.entry.electric }] : []),
];
---

<Base locale={locale} title={T.meta.title} description={T.meta.description} share="brief">
  <header class="sx-head">
    <div class="container"><div class="sx-head__inner">
      <p class="eyebrow">{T.head.kicker}</p>
      <h1 class="display"><Phrased text={T.head.title} /></h1>
      <p class="lead">{fill(T.head.lead, { n: total })}</p>
      <p>{T.head.labels}</p>
      <WordHelp locale={locale} words={['pm25', 'ufp', 'benzene', 'ppm']} />
      <details class="sx-reads">
        <summary><span>{T.reads.title}</span><Icon name="chevron-down" size="1.25rem" /></summary>
        <ul>
          {readCounts.map((r) => <li><span>{r.label}</span><b>{fill(T.reads.count, { n: r.n })}</b></li>)}
        </ul>
      </details>
      <p class="sx-head__ev">{T.head.evidence} <a class="sx-go" href={href('/evidence/', locale)}><span>{T.head.evidenceLink}</span><Icon name="arrow-right" size="1.05em" /></a></p>
    </div></div>
  </header>

  <div class="container sx" data-sx>
    <div class="sx-find" data-sx-find hidden>
      <label class="sx-find__label" for="sx-q">{T.find.label}</label>
      <p class="sx-find__hint" id="sx-q-hint">{T.find.hint}</p>
      <div class="sx-find__row">
        <input class="sx-find__input" id="sx-q" type="search" autocomplete="off" aria-describedby="sx-q-hint" />
        <button class="sx-find__clear" type="button" data-sx-clear>{T.find.clear}</button>
      </div>
      <p class="sx-find__out" role="status" aria-live="polite" data-sx-out data-found={T.find.found} data-none={T.find.none}></p>
    </div>

    <h2 class="sx-groups__title" id="groups">{T.groupsTitle}</h2>
    <p class="sx-groups__hint">{T.groupsHint}</p>

    {groups.map(({ g, list, alsoHere }) => (
      <section class="sg" id={groupAnchor(g)} aria-labelledby={`${groupAnchor(g)}-h`} data-sg>
        <details class="sg__fold">
          <summary class="sg__sum">
            <span class="sg__text">
              <h3 class="sg__name" id={`${groupAnchor(g)}-h`}>{groupName(g)}</h3>
              <span class="sg__count">{list.length === 1 ? T.group.countOne : fill(T.group.count, { n: list.length })}</span>
              <span class="sg__line">{groupSummary(g)}</span>
            </span>
            <svg class="sg__chev" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
          </summary>
          <div class="sg__start" id={`${groupAnchor(g)}-list`}></div>
          <ol class="sx-list" aria-label={groupName(g)}>
            {list.map((e) => (
              <li class="sx-src" id={e.id} data-search={e.search}>
                <p class="sx-src__title">
                  <span class="sx-src__n"><span class="vh">{fill(T.entry.number, { n: '' }).trim()} </span>{e.n}</span>
                  {e.s.titleIsDescriptive ? <span>[{e.title}]</span> : <cite lang={e.titleLang}>{e.title}</cite>}
                  {e.translated && <span class="sx-src__tr">{locale === 'en' ? ` [${e.translated}]` : `〔${e.translated}〕`}</span>}
                </p>
                <p class="sx-src__meta">
                  <Mixed text={[e.who, e.when, ...e.where].filter(Boolean).join(dot)} locale={locale} />
                </p>
                {e.s.titleIsDescriptive && (
                  <p class="sx-src__hint"><Tag tone="signal">{T.entry.descriptive}</Tag> {T.entry.descriptiveHelp}</p>
                )}
                <p class="sx-src__use"><b>{T.entry.usedFor}</b>{sp}{e.use}</p>
                <p class="sx-src__read"><b>{T.entry.read}</b>{sp}{e.read}<span class="sx-src__kind">{dot}{e.kind}</span></p>
                {e.s.readerNote && <p class="sx-src__hint">{readerText(e.s.readerNote[locale])}</p>}
                <p class="sx-src__actions">
                  <a href={e.url} rel="noopener noreferrer" target="_blank">{e.s.doi && !e.s.url ? `${T.entry.doi} ${e.s.doi}` : T.entry.open}<span class="vh">{colon}{sourceShort(e.id, locale)} {ui.externalLink[locale]}</span> ↗</a>
                  <span class="sx-src__checked">{fill(T.entry.checked, { date: e.s.accessed })}</span>
                </p>
                {siteLinks(e).length > 0 && (
                  <p class="sx-src__links"><b>{T.entry.where}</b>{siteLinks(e).map((l) => <a href={l.href}>{l.label}</a>)}</p>
                )}
                {e.g.also.length > 0 && (
                  <p class="sx-src__links sx-src__also"><b>{T.entry.also}</b>{e.g.also.map((o) => <a href={`#${groupAnchor(o)}-list`}>{groupName(o)}</a>)}</p>
                )}
                {e.count > 0 && (
                  <details class="sx-src__uses">
                    <summary>{fill(T.entry.uses, { n: e.count })}</summary>
                    {e.u.facts.length > 0 && (
                      <Fragment>
                        <p class="sx-src__ulabel">{T.entry.facts}</p>
                        <ul>
                          {e.u.facts.map((f) => {
                            const x = lf(f, locale);
                            // R14: the never-smoker figures are printed only on /evidence/#not-used
                            if (neverSmokerFacts.includes(f)) return <li><a href={href(`/evidence/#${f}`, locale)}>{evidenceCopy.row.neverSmokerPointer[locale]}</a> <span class="sx-src__st">{evidenceCopy.row.alsoNotUsed[locale]}</span></li>;
                            return <li><a href={href(`/evidence/#${f}`, locale)}>{x.display}</a> <KindChip locale={locale} kind={x.evidence} size="sm" /> <span class="sx-src__st"><Mixed text={x.statement} locale={locale} /></span></li>;
                          })}
                        </ul>
                      </Fragment>
                    )}
                    {e.u.series.length > 0 && (
                      <Fragment>
                        <p class="sx-src__ulabel">{T.entry.series}</p>
                        <ul>{e.u.series.map((x) => <li><a href={href(`/evidence/#${dataAnchor(x)}`, locale)}>{ls(x, locale).title}</a></li>)}</ul>
                      </Fragment>
                    )}
                    {e.answers.length > 0 && (
                      <Fragment>
                        <p class="sx-src__ulabel">{T.entry.answers}</p>
                        <ul>{e.answers.map((a) => <li><a href={href(`/evidence/#${a}`, locale)}>{localizeAnswer(a, locale).question}</a></li>)}</ul>
                      </Fragment>
                    )}
                  </details>
                )}
              </li>
            ))}
          </ol>
          <div class="sg__end">
            {alsoHere.length > 0 && (
              <p class="sx-src__links sg__also" data-sg-also>
                <b>{T.group.alsoHere}</b>{sp}
                {alsoHere.map((e) => <a href={`#${e.id}`}>{sourceShort(e.id, locale)}</a>)}
              </p>
            )}
          </div>
        </details>
      </section>
    ))}
    <div class="sx-top"><a href="#groups">{T.top}</a></div>
  </div>
</Base>

<script>
  // 1. Opening a group for a link: /sources/#<source id>, #topic-<group>(-list), on arrival, on
  //    hashchange and on in-page links. 2. The text filter (shown only when this script runs).
  const root = document.querySelector<HTMLElement>('[data-sx]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('.sx-src'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-sg]'));
  const input = document.querySelector<HTMLInputElement>('#sx-q');
  const out = document.querySelector<HTMLElement>('[data-sx-out]');
  const autoOpened = new Set<HTMLDetailsElement>();
  let filtering = false;

  const clearFilter = () => {
    if (!input || !filtering) return;
    input.value = '';
    applyFilter();
  };

  const openFor = (hash: string, settle = false) => {
    if (!hash || hash === '#') return;
    let el: HTMLElement | null = null;
    try {
      el = document.getElementById(decodeURIComponent(hash.slice(1)));
    } catch {
      return;
    }
    if (!el || !root?.contains(el)) return;
    if (filtering && (el.hidden || el.closest('[hidden]'))) clearFilter();
    const own = el.matches('[data-sg]') ? el.querySelector<HTMLDetailsElement>('details.sg__fold') : null;
    if (own) own.open = true;
    for (let d = el.closest('details'); d; d = d.parentElement?.closest('details') ?? null) (d as HTMLDetailsElement).open = true;
    const target = el.matches('.sg__start') ? (el.closest('[data-sg]') as HTMLElement) : el;
    const go = () => target.scrollIntoView({ behavior: 'instant' as ScrollBehavior, block: 'start' });
    requestAnimationFrame(go);
    if (!settle) return;
    // fonts and the header may still settle after arrival: keep the entry in view a moment
    let stop = false;
    for (const ev of ['wheel', 'touchstart', 'keydown', 'mousedown']) addEventListener(ev, () => (stop = true), { once: true, passive: true });
    const ro = new ResizeObserver(() => !stop && go());
    ro.observe(document.body);
    setTimeout(() => ro.disconnect(), 3000);
  };
  openFor(location.hash, true);
  addEventListener('hashchange', () => openFor(location.hash));
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.('a[href*="#"]') as HTMLAnchorElement | null;
    if (a && a.pathname === location.pathname && a.hash) openFor(a.hash);
  });

  // printing prints every group: the shell opens every fold (Header.astro)

  // --- filter ---
  let timer = 0;
  function applyFilter() {
    if (!input || !out) return;
    const words = input.value.replaceAll('\u81fa', '\u53f0').toLowerCase().trim().split(/\s+/).filter(Boolean);
    filtering = words.length > 0;
    let found = 0;
    for (const li of items) {
      const ok = !filtering || words.every((w) => (li.dataset.search ?? '').includes(w));
      li.hidden = !ok;
      if (ok) found++;
    }
    for (const sec of sections) {
      const d = sec.querySelector<HTMLDetailsElement>('details.sg__fold')!;
      const n = sec.querySelectorAll('.sx-src:not([hidden])').length;
      sec.hidden = filtering && n === 0;
      sec.querySelectorAll<HTMLElement>('[data-sg-also]').forEach((x) => (x.hidden = filtering));
      if (filtering && n > 0 && !d.open) {
        d.open = true;
        autoOpened.add(d);
      }
      if (!filtering && autoOpened.has(d)) {
        d.open = false;
        autoOpened.delete(d);
      }
    }
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      out.textContent = !filtering ? '' : found ? (out.dataset.found ?? '').replace('{n}', String(found)) : (out.dataset.none ?? '');
    }, 250);
  }
  const box = document.querySelector<HTMLElement>('[data-sx-find]');
  if (box && input) {
    box.hidden = false;
    input.addEventListener('input', applyFilter);
    document.querySelector('[data-sx-clear]')?.addEventListener('click', () => {
      input.value = '';
      applyFilter();
      input.focus();
    });
  }
</script>

<style>
  .sx-head {
    padding-block: clamp(1.5rem, 5vw, 3.5rem) var(--sp-5);
  }
  .sx-head__inner {
    display: grid;
    gap: var(--sp-4);
    max-inline-size: 46rem;
  }
  .sx-head__ev {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--sp-2);
  }
  .sx-go {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-block-size: var(--tap);
    font-weight: var(--fw-bold);
  }
  .sx-reads {
    font-size: var(--fs-sm);
    border-block: 1px solid var(--line-strong);
  }
  .sx-reads summary {
    min-block-size: var(--tap);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    font-weight: var(--fw-bold);
    color: var(--accent);
    cursor: pointer;
    list-style: none;
  }
  .sx-reads summary::-webkit-details-marker {
    display: none;
  }
  .sx-reads[open] summary :global(svg) {
    transform: rotate(180deg);
  }
  .sx-reads ul {
    list-style: none;
    margin: 0 0 var(--sp-3);
    padding: 0;
  }
  .sx-reads li {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-3);
    padding-block: var(--sp-1);
    border-block-end: 1px solid var(--line);
  }
  .sx-reads li b {
    flex: none;
  }

  .sx {
    padding-block-end: var(--sp-6);
  }
  .sx-find {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-2);
    padding: var(--sp-4);
    margin-block-end: var(--sp-5);
    background: var(--bg-sunken);
    border-radius: var(--radius-3);
    max-inline-size: 46rem;
  }
  .sx-find[hidden] {
    display: none;
  }
  .sx-find__label {
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
  }
  .sx-find__hint {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .sx-find__row {
    display: flex;
    gap: var(--tap-gap);
  }
  .sx-find__input {
    flex: 1;
    min-inline-size: 0;
    min-block-size: var(--tap);
    padding: 0 var(--sp-3);
    font: inherit;
    font-size: var(--fs-base);
    color: var(--ink);
    background: var(--surface);
    border: 2px solid var(--line-strong);
    border-radius: var(--radius-2);
  }
  .sx-find__input:focus-visible,
  .sx-find__clear:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .sx-find__clear {
    flex: none;
    min-block-size: var(--tap);
    min-inline-size: var(--tap);
    padding: 0 var(--sp-4);
    font: inherit;
    font-size: var(--fs-btn);
    font-weight: var(--fw-bold);
    color: var(--ink);
    background: var(--surface);
    border: 2px solid var(--line-strong);
    border-radius: var(--radius-2);
    cursor: pointer;
  }
  .sx-find__out {
    font-weight: var(--fw-bold);
  }
  .sx-find__out:empty {
    display: none;
  }

  .sx-groups__title {
    font-size: var(--fs-xl);
    scroll-margin-block-start: calc(var(--header-h) + var(--sp-4));
  }
  .sx-groups__hint {
    color: var(--ink-2);
    margin-block: var(--sp-2) var(--sp-4);
    max-inline-size: 46rem;
  }

  .sg {
    border-block-start: 1px solid var(--line-strong);
    scroll-margin-block-start: calc(var(--header-h) + var(--sp-2));
  }
  .sg:last-of-type {
    border-block-end: 1px solid var(--line-strong);
  }
  .sg[hidden] {
    display: none;
  }
  .sg__sum {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    min-block-size: var(--tap);
    margin-block: var(--sp-1);
    padding-block: var(--sp-3);
    cursor: pointer;
    list-style: none;
  }
  .sg__sum::-webkit-details-marker {
    display: none;
  }
  .sg__sum:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .sg__text {
    display: grid;
    gap: var(--sp-1);
    min-inline-size: 0;
  }
  .sg__name {
    font-size: var(--fs-lg);
    line-height: 1.35;
    margin: 0;
    color: var(--ink);
  }
  .sg__count {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .sg__line {
    font-size: var(--fs-base);
    line-height: var(--lh-read);
    color: var(--ink);
  }
  .sg__chev {
    flex: none;
    color: var(--accent);
    transition: transform 0.2s;
  }
  .sg__fold[open] .sg__chev {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .sg__chev {
      transition: none;
    }
  }
  .sg__end {
    padding-block-end: var(--sp-4);
  }
  .sg__start {
    /* the target of "also used for" links: lands just under the group's own title */
    scroll-margin-block-start: calc(var(--header-h) + 9rem);
  }

  .sx-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sx-src {
    display: grid;
    gap: var(--sp-2);
    padding-block: var(--sp-4);
    border-block-start: 1px solid var(--line);
    scroll-margin-block-start: calc(var(--header-h) + var(--sp-4));
    max-inline-size: 46rem;
  }
  .sx-src[hidden] {
    display: none;
  }
  .sx-src:target {
    background: var(--mark-bg);
    box-shadow: 0 0 0 var(--sp-2) var(--mark-bg);
  }
  .sx-src__title {
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .sx-src__title cite {
    font-style: normal;
  }
  .sx-src__n {
    display: inline-block;
    min-inline-size: 2.4em;
    margin-inline-end: var(--sp-2);
    padding: 0 0.35em;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-2);
    font-size: var(--fs-sm);
