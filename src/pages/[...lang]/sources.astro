---
/**
 * /sources/ — 資料來源 / Sources (blueprint 4.8). The full bibliography from the registry: every
 * source with its stable number, its citation in the reader's language, a working link (DOI or
 * URL), how far it was read, and every fact, chart dataset, gap and writing rule that cites it.
 * Citation markers across the site link to /sources/#<source id>.
 *
 * The filter (by link of the chain and by kind of source) is two groups of radio buttons and
 * CSS :has(), so it works without JavaScript; a short script only updates the count. Where :has()
 * is not supported, every source stays listed. Research gaps are entries too (#<gap id>).
 *
 * Copy: src/i18n/pages/sources.ts.
 */
import Base from '@/layouts/Base.astro';
import Section from '@/components/ui/Section.astro';
import Phrased from '@/components/ui/Phrased.astro';
import Tag from '@/components/ui/Tag.astro';
import EvidenceBadge from '@/components/ui/EvidenceBadge.astro';
import Mixed from '@/components/pages/evidence/Mixed.astro';
import { citeN, dataAnchor, lf, lg, ls, readLabel, sourceUses } from '@/components/pages/evidence/ev';
import { href, htmlLang, localeFromParam, localeStaticPaths } from '@/i18n';
import { readerText, ui } from '@/i18n/ui';
import sourcesCopy from '@/i18n/pages/sources';
import { fill, localize } from '@/i18n/pages/_copy';
import { chainLinks, claimRules, formatCitation, gapList, getSource, readLevelLabels, readLevels, sourceIds, sourceKindLabels, sourceKinds, sourceUrl, type ClaimRuleId } from '@/data';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const T = localize(sourcesCopy, locale);
const plain = (s: string) => s.replaceAll('|', '');
const uses = sourceUses();
/** Percent-encoded Chinese in a URL, shown as characters (the link itself is unchanged). */
const readableUrl = (u: string) => {
  try {
    return decodeURI(u);
  } catch {
    return u;
  }
};
const total = sourceIds.length;

const entries = sourceIds.map((id) => {
  const s = getSource(id);
  const u = uses.get(id)!;
  return {
    id,
    n: citeN(id),
    s,
    u,
    citation: readerText(formatCitation(id, locale)).replace(sourceUrl(id), readableUrl(sourceUrl(id))),
    url: sourceUrl(id),
    lang: s.language !== locale ? htmlLang[s.language] : undefined,
    kind: readerText(sourceKindLabels[s.kind][locale]),
    read: readLabel(s, locale),
    count: u.facts.length + u.series.length + u.gaps.length + u.rules.length,
  };
});
const kindsUsed = sourceKinds.filter((k) => entries.some((e) => e.s.kind === k));
const linkCount = (n: number) => entries.filter((e) => (n === 0 ? e.u.links.length === 0 : e.u.links.includes(n as never))).length;
const readCounts = readLevels.map((lvl) => ({ label: readerText(readLevelLabels[lvl][locale]), n: entries.filter((e) => e.s.readLevel === lvl).length })).filter((r) => r.n > 0);

// No-JS filter: hide what does not match the checked radio in each group.
const css = [
  ...chainLinks.map((n) => `.sx:has(#sx-l-${n}:checked) .sx-src:not([data-l${n}]){display:none}`),
  `.sx:has(#sx-l-0:checked) .sx-src:not([data-l0]){display:none}`,
  ...kindsUsed.map((k) => `.sx:has(#sx-k-${k}:checked) .sx-src:not([data-kind="${k}"]){display:none}`),
  `.sx .sx-src:target{display:grid !important}`,
].join('');
const ruleText = (id: string) => readerText(claimRules[id as ClaimRuleId].rule[locale]);
---

<Base locale={locale} title={T.meta.title} description={T.meta.description} share="brief">
  <Fragment slot="head" set:html={`<style>${css}</style>`} />
  <header class="sx-head">
    <div class="container"><div class="sx-head__inner">
      <p class="eyebrow">{T.head.kicker}</p>
      <h1 class="display"><Phrased text={T.head.title} /></h1>
      <p class="lead">{fill(T.head.lead, { n: total })}</p>
      <p>{T.head.evidence} <a href={href('/evidence/', locale)}>{T.head.evidenceLink} →</a></p>
      <details class="sx-reads">
        <summary>{T.reads.title}</summary>
        <p>{T.reads.lead}</p>
        <ul>
          {readCounts.map((r) => <li><span>{r.label}</span><b>{fill(T.reads.count, { n: r.n })}</b></li>)}
        </ul>
      </details>
    </div></div>
  </header>

  <div class="sx">
    <form class="sx-filter container" id="filter" aria-labelledby="sx-filter-title" onsubmit="return false">
      <h2 class="sx-filter__title" id="sx-filter-title">{T.filter.title}</h2>
      <p class="sx-filter__hint">{T.filter.hint}</p>
      <fieldset>
        <legend>{T.filter.link}</legend>
        <div class="sx-chips">
          <span class="sx-chip"><input type="radio" name="link" id="sx-l-all" value="" checked /><label for="sx-l-all">{T.filter.all} <span>{total}</span></label></span>
          {chainLinks.map((n) => (
            <span class="sx-chip"><input type="radio" name="link" id={`sx-l-${n}`} value={String(n)} /><label for={`sx-l-${n}`}>{fill(T.filter.linkN, { n })} <span>{linkCount(n)}</span></label></span>
          ))}
          <span class="sx-chip"><input type="radio" name="link" id="sx-l-0" value="0" /><label for="sx-l-0">{T.filter.none} <span>{linkCount(0)}</span></label></span>
        </div>
      </fieldset>
      <fieldset>
        <legend>{T.filter.kind}</legend>
        <div class="sx-chips">
          <span class="sx-chip"><input type="radio" name="kind" id="sx-k-all" value="" checked /><label for="sx-k-all">{T.filter.all} <span>{total}</span></label></span>
          {kindsUsed.map((k) => (
            <span class="sx-chip"><input type="radio" name="kind" id={`sx-k-${k}`} value={k} /><label for={`sx-k-${k}`}>{readerText(sourceKindLabels[k][locale])} <span>{entries.filter((e) => e.s.kind === k).length}</span></label></span>
          ))}
        </div>
      </fieldset>
      <p class="sx-count" aria-live="polite" data-sx-count data-template={T.filter.showing} hidden></p>
    </form>

    <div class="container">
      <ol class="sx-list" aria-label={plain(T.meta.title)}>
        {entries.map((e) => (
          <li
            class="sx-src"
            id={e.id}
            data-kind={e.s.kind}
            data-l0={e.u.links.length === 0 ? '' : undefined}
            data-l1={e.u.links.includes(1) ? '' : undefined}
            data-l2={e.u.links.includes(2) ? '' : undefined}
            data-l3={e.u.links.includes(3) ? '' : undefined}
            data-l4={e.u.links.includes(4) ? '' : undefined}
            data-l5={e.u.links.includes(5) ? '' : undefined}
            data-l6={e.u.links.includes(6) ? '' : undefined}
            data-l7={e.u.links.includes(7) ? '' : undefined}
          >
            <p class="sx-src__n" aria-label={fill(T.entry.number, { n: e.n })}>{e.n}</p>
            <div class="sx-src__body">
              <p class="sx-src__tags">
                <Tag>{e.kind}</Tag>
                <span class="sx-src__read"><span class="vh">{T.entry.read} </span>{e.read}</span>
                {e.s.titleIsDescriptive && <Tag tone="signal">{T.entry.descriptive}</Tag>}
              </p>
              <p class="sx-src__cite" lang={e.lang}>{e.citation}</p>
              {e.s.titleIsDescriptive && <p class="sx-src__help">{T.entry.descriptiveHelp}</p>}
              <p class="sx-src__actions">
                <a href={e.url} rel="noopener noreferrer" target="_blank">{e.s.doi && !e.s.url ? `${T.entry.doi} ${e.s.doi}` : T.entry.open}<span class="vh"> {ui.externalLink[locale]}</span> ↗</a>
                <span class="sx-src__checked">{fill(T.entry.checked, { date: e.s.accessed })}</span>
              </p>
              <p class="sx-src__links">
                <b>{T.entry.links}</b>
                {e.u.links.length ? e.u.links.map((n, i) => <Fragment>{i > 0 && ' · '}<a href={href(`/evidence/#link-${n}`, locale)}>{fill(T.entry.linkN, { n })}</a></Fragment>) : T.entry.noLink}
              </p>
              {e.count > 0 && (
                <details class="sx-src__uses">
                  <summary>{fill(T.entry.uses, { n: e.count })}</summary>
                  {e.u.facts.length > 0 && (
                    <Fragment>
                      <p class="sx-src__ulabel">{T.entry.facts}</p>
                      <ul>
                        {e.u.facts.map((f) => {
                          const x = lf(f, locale);
                          return <li><a href={href(`/evidence/#${f}`, locale)}>{x.display}</a> <EvidenceBadge locale={locale} kind={x.evidence} variant="icon" /> <span class="sx-src__st"><Mixed text={x.statement} locale={locale} /></span></li>;
                        })}
                      </ul>
                    </Fragment>
                  )}
                  {e.u.series.length > 0 && (
                    <Fragment>
                      <p class="sx-src__ulabel">{T.entry.series}</p>
                      <ul>{e.u.series.map((x) => <li><a href={href(`/evidence/#${dataAnchor(x)}`, locale)}>{ls(x, locale).title}</a></li>)}</ul>
                    </Fragment>
                  )}
                  {e.u.gaps.length > 0 && (
                    <Fragment>
                      <p class="sx-src__ulabel">{T.entry.gaps}</p>
                      <ul>{e.u.gaps.map((g) => <li><a href={`#${g}`}>{lg(g, locale).title}</a></li>)}</ul>
                    </Fragment>
                  )}
                  {e.u.rules.length > 0 && (
                    <Fragment>
                      <p class="sx-src__ulabel">{T.entry.rules}</p>
                      <ul>{e.u.rules.map((r) => <li><a href={href(`/evidence/#rule-${r}`, locale)}>{ruleText(r)}</a></li>)}</ul>
                    </Fragment>
                  )}
                </details>
              )}
            </div>
          </li>
        ))}
      </ol>
      <p class="sx-top"><a href="#filter">{T.top}</a></p>
    </div>
  </div>

  <Section id="gaps" title={T.gaps.title} lead={T.gaps.lead} tone="sunken">
    <ol class="sx-gaps">
      {gapList.map((g) => {
        const x = lg(g.id, locale);
        return (
          <li id={g.id} class="sx-gap">
            <p class="sx-src__tags"><EvidenceBadge locale={locale} kind="gap" /> <span class="sx-src__checked">{fill(T.gaps.searched, { date: x.searchedOn })}</span></p>
            <h3 class="sx-gap__title">{x.title}</h3>
            <p>{x.statement}</p>
            {x.whoCouldMeasure && <p class="sx-gap__who"><b>{T.gaps.who}</b>{x.whoCouldMeasure}</p>}
            <p><a href={href(`/evidence/#${g.id}`, locale)}>{T.gaps.more} →</a></p>
          </li>
        );
      })}
    </ol>
  </Section>
</Base>

<script>
  // Enhancement only: say how many sources the filter leaves.
  const form = document.querySelector<HTMLFormElement>('.sx-filter');
  const out = document.querySelector<HTMLElement>('[data-sx-count]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('.sx-src'));
  if (form && out && CSS.supports('selector(:has(*))')) {
    const update = () => {
      const shown = items.filter((el) => el.offsetParent !== null || getComputedStyle(el).display !== 'none').length;
      out.textContent = (out.dataset.template ?? '').replace('{n}', String(shown)).replace('{total}', String(items.length));
      out.hidden = false;
    };
    form.addEventListener('change', update);
    update();
  }
</script>

<style>
  .sx-head {
    padding-block: clamp(1.5rem, 5vw, 3.5rem) var(--sp-6);
  }
  .sx-head__inner {
    display: grid;
    gap: var(--sp-4);
    max-inline-size: 52rem;
  }
  .sx-reads {
    font-size: var(--fs-sm);
    border-block: 1px solid var(--line-strong);
  }
  .sx-reads summary {
    min-block-size: var(--tap, 44px);
    display: flex;
    align-items: center;
    font-weight: var(--fw-bold);
    cursor: pointer;
  }
  .sx-reads p {
    color: var(--ink-2);
    margin-block-end: var(--sp-3);
  }
  .sx-reads ul {
    list-style: none;
    margin: 0 0 var(--sp-3);
    padding: 0;
  }
  .sx-reads li {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-3);
    padding-block: var(--sp-1);
    border-block-end: 1px solid var(--line);
  }
  .sx-filter {
    display: grid;
    gap: var(--sp-4);
    padding-block: var(--sp-5);
    scroll-margin-block-start: calc(var(--header-h) + var(--sp-4));
  }
  .sx-filter__title {
    font-size: var(--fs-lg);
  }
  .sx-filter__hint {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .sx-filter fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-inline-size: 0;
  }
  .sx-filter legend {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    margin-block-end: var(--sp-2);
  }
  .sx-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .sx-chip {
    position: relative;
  }
  .sx-chip input {
    position: absolute;
    opacity: 0;
    inline-size: 1px;
    block-size: 1px;
  }
  .sx-chip label {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-block-size: var(--tap, 44px);
    padding: 0 0.85em;
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    cursor: pointer;
    white-space: nowrap;
  }
  .sx-chip label span {
    font-size: var(--fs-xs);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .sx-chip input:checked + label {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
    font-weight: var(--fw-bold);
  }
  .sx-chip input:checked + label span {
    color: var(--bg);
  }
  .sx-chip input:focus-visible + label {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .sx-count {
    font-weight: var(--fw-bold);
  }
  .sx-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .sx-src {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: var(--sp-3);
    padding-block: var(--sp-5);
    border-block-start: 1px solid var(--line);
    scroll-margin-block-start: calc(var(--header-h) + var(--sp-4));
  }
  .sx-src:target {
    background: var(--mark-bg);
    box-shadow: 0 0 0 var(--sp-2) var(--mark-bg);
  }
  .sx-src__n {
    font-family: var(--font-en-display, inherit);
    font-size: var(--fs-xl);
    font-weight: var(--fw-black, 900);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }
  .sx-src__body {
    display: grid;
    gap: var(--sp-2);
    min-inline-size: 0;
  }
  .sx-src__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1) var(--sp-2);
  }
  .sx-src__read {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .sx-src__cite {
    font-size: var(--fs-sm);
    line-height: var(--lh-body);
    overflow-wrap: anywhere;
  }
  .sx-src__help {
    font-size: var(--fs-xs);
    color: var(--ink-2);
    padding-inline-start: var(--sp-3);
    border-inline-start: 2px dashed var(--line-strong);
  }
  .sx-src__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-4);
    font-size: var(--fs-sm);
  }
  .sx-src__actions a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap, 44px);
    font-weight: var(--fw-bold);
    color: var(--accent);
    overflow-wrap: anywhere;
  }
  .sx-src__checked {
    font-size: var(--fs-xs);
    color: var(--ink-2);
  }
  .sx-src__links {
    font-size: var(--fs-sm);
  }
  .sx-src__links b {
    margin-inline-end: 0.3em;
  }
  .sx-src__uses {
    font-size: var(--fs-sm);
  }
  .sx-src__uses summary {
    min-block-size: var(--tap, 44px);
    display: flex;
    align-items: center;
    color: var(--accent);
    font-weight: var(--fw-bold);
    cursor: pointer;
  }
  .sx-src__ulabel {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
    margin-block: var(--sp-2) var(--sp-1);
  }
  .sx-src__uses ul {
    margin: 0;
    padding-inline-start: 1.2em;
    display: grid;
    gap: var(--sp-2);
  }
  .sx-src__uses li a {
    font-weight: var(--fw-bold);
  }
  .sx-src__st {
    display: block;
    color: var(--ink-2);
    line-height: var(--lh-snug);
  }
  .sx-top {
    padding-block: var(--sp-5);
    font-weight: var(--fw-bold);
  }
  .sx-gaps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
  }
  @media (min-width: 48em) {
    .sx-gaps {
      grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    }
  }
  .sx-gap {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    padding: var(--sp-4);
    border: 2px dashed var(--ink-3);
    border-radius: var(--radius-2);
    background: var(--bg);
    scroll-margin-block-start: calc(var(--header-h) + var(--sp-4));
  }
  .sx-gap:target {
    border-color: var(--accent);
  }
  .sx-gap__title {
    font-size: var(--fs-md);
    line-height: var(--lh-snug);
  }
  .sx-gap__who {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .sx-gap__who b {
    color: var(--ink);
  }
</style>
