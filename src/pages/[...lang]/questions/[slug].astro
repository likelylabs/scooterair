---
/**
 * /questions/<slug>/ — one question at the crossing (redesign brief 7.5). Seven pages, one
 * shape, each written to stand alone for a reader who arrives from a LINE share:
 *
 *   the question (h1)  →  one picture  →  the answer in one sentence (large)  →  at most two
 *   more sentences and one quiet line  →  怎麼知道的？ (the sheet)  →  at most two more pictures
 *   →  the next question  →  the share block
 *
 * Each page is its own component in src/components/pages/questions/ (QSmell, QBesideMe, …),
 * built from lane B's <Screen>, lane C's scenes and lane D's charts. Copy:
 * src/i18n/pages/questions.ts; every number is filled from the estimate or the registry by
 * questionNumbers() in src/components/pages/questions/q.ts.
 *
 * /questions/how-much/ and /questions/electric/ moved: they are redirect pages beside this file.
 */
import Base from '@/layouts/Base.astro';
import Phrased from '@/components/ui/Phrased.astro';
import QSmell from '@/components/pages/questions/QSmell.astro';
import QBesideMe from '@/components/pages/questions/QBesideMe.astro';
import QApp from '@/components/pages/questions/QApp.astro';
import QOneRedLight from '@/components/pages/questions/QOneRedLight.astro';
import QMyChild from '@/components/pages/questions/QMyChild.astro';
import QRider from '@/components/pages/questions/QRider.astro';
import QMask from '@/components/pages/questions/QMask.astro';
import ShareBlock from '@/components/pages/questions/ShareBlock.astro';
import { filler, nextQuestion, plain, slugs, type Slug } from '@/components/pages/questions/q';
import { href, localeFromParam, localeStaticPaths } from '@/i18n';
import { colon, typeset } from '@/i18n/ui';
import questions from '@/i18n/pages/questions';

export function getStaticPaths() {
  return localeStaticPaths().flatMap(({ params }) => slugs.map((slug) => ({ params: { ...params, slug } })));
}

const locale = localeFromParam(Astro.params.lang);
const slug = Astro.params.slug as Slug;
const item = questions.items[slug];
const P = questions.page;
const f = filler(locale);
const next = nextQuestion(slug, locale);
const pages = { smell: QSmell, 'beside-me': QBesideMe, app: QApp, 'one-red-light': QOneRedLight, 'my-child': QMyChild, rider: QRider, mask: QMask } satisfies Record<Slug, unknown>;
const Page = pages[slug];
---

<Base locale={locale} title={typeset(plain(item.q[locale]), locale)} description={f(item.card[locale])} share={slug}>
  <div class="qp">
    <header class="qp-head">
      <a class="qp-back" href={href('/questions/', locale)}><svg class="qp-back__arrow" viewBox="0 0 24 24" width="1.1em" height="1.1em" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 12H5M11 6l-6 6 6 6" /></svg>{P.back[locale]}</a>
      <h1 class="qp-q"><span class="vh">{P.questionLabel[locale]}{colon(locale)}</span><Phrased text={typeset(item.q[locale], locale)} locale={locale} /></h1>
    </header>

    <Page locale={locale} next={next} />

    <ShareBlock locale={locale} id={slug} />
  </div>
</Base>

<style>
  .qp {
    padding-block-end: var(--sp-7);
  }
  /* the question: above the picture, in the same column as the screens below it */
  .qp-head {
    display: grid;
    gap: var(--sp-1);
    justify-items: start;
    inline-size: min(100% - 2 * var(--gutter), var(--screen-max));
    margin-inline: auto;
    padding-block: var(--sp-2) var(--sp-3);
  }
  .qp-back {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-block-size: var(--tap);
    min-inline-size: var(--tap);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--ink);
    text-decoration: none;
  }
  .qp-back:hover {
    text-decoration: underline;
  }
  .qp-q {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--fs-md);
    font-weight: var(--fw-black);
    line-height: 1.3;
    letter-spacing: 0;
    text-wrap: balance;
  }
  /* a small signal lamp before the question, so it reads as "the question", the answer follows */
  .qp-q::before {
    content: '';
    display: inline-block;
    inline-size: 0.6em;
    block-size: 0.6em;
    margin-inline-end: 0.45em;
    border-radius: 50%;
    background: var(--signal-red);
    vertical-align: 0.05em;
  }

  /* pictures that are not drawings (a chart, a table, the smell strip): keep the page's gutter
     on a phone, where a drawing runs edge to edge */
  .qp :global(.q-plate) {
    box-sizing: border-box;
    padding: var(--sp-3) var(--gutter) 0;
  }
  /* a screen that borrows another screen's sheet puts its own 怎麼知道的？ beside the chip:
     keep the button at the end of the row, where every other screen has it */
  .qp :global(.screen__chips:has(> .howbtn)) {
    flex: 1 1 auto;
  }
  .qp :global(.screen__chips > .howbtn) {
    margin-inline-start: auto;
  }
  @media (min-width: 56.25em) {
    .qp-head {
      padding-block: var(--sp-5) 0;
    }
    .qp-q {
      font-size: 1.5rem;
    }
    .qp :global(.q-plate) {
      padding: 0;
    }
    /* the second and third pictures are part of the same answer: no rule between them */
    .qp :global(.screen + .screen) {
      border-block-start: 0;
      padding-block-start: var(--sp-3);
    }
  }
</style>
