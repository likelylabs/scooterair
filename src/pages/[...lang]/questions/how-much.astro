---
/**
 * /questions/how-much/ moved to /questions/smell/#how-much (decision 2026-11-28): "how much is
 * there when you can smell it" is answered there; the carbon monoxide estimate stays on /estimate/. Kept as a redirect in both languages so old links and shares still land; its share card
 * stays in public/share/ so an old share still shows a picture.
 */
import Redirect from '@/layouts/Redirect.astro';
import { localeFromParam, localeStaticPaths } from '@/i18n';
import questions from '@/i18n/pages/questions';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
---

<Redirect locale={locale} to="/questions/smell/#how-much" label={questions.page.moved.howMuch[locale]} share="how-much" />
