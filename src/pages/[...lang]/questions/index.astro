---
/**
 * /questions/ — 路口的七個問題 / Seven questions at the crossing (redesign brief 7.5).
 * A grid of seven picture cards, in the order the home page tells the story: each card is the
 * question's own picture, the question and a one-line answer with its chip. No prose index.
 * Two buttons under the grid lead to the working (/estimate/) and to the money (/electric/).
 *
 * Copy: src/i18n/pages/questions.ts.
 */
import Base from '@/layouts/Base.astro';
import IllustrationTag from '@/components/ui/IllustrationTag.astro';
import KindChip from '@/components/ui/KindChip.astro';
import NextButton from '@/components/ui/NextButton.astro';
import Phrased from '@/components/ui/Phrased.astro';
import CardPicture from '@/components/pages/questions/CardPicture.astro';
import { cardChip, filler, plain, questionHref, slugs } from '@/components/pages/questions/q';
import { href, localeFromParam, localeStaticPaths } from '@/i18n';
import { colon, typeset } from '@/i18n/ui';
import { fact } from '@/data/facts';
import { readerKind, readerPlace, readerPlaceLabels } from '@/data/types';
import questions from '@/i18n/pages/questions';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const I = questions.index;
const f = filler(locale);
// The card's chip names the kind of answer; the fact itself, with its caveat and its sheet, is
// on the question's own page, so the card does not print `data-fact`.
const chipOf = (slug: (typeof slugs)[number]) => {
  const c = cardChip[slug];
  if (!c.fact) return { kind: c.kind, where: undefined };
  const place = readerPlace(fact(c.fact));
  return { kind: readerKind(fact(c.fact)), where: place ? readerPlaceLabels[place][locale] : undefined };
};
const cards = slugs.map((slug) => ({
  slug,
  q: typeset(questions.items[slug].q[locale], locale),
  answer: f(questions.items[slug].card[locale]),
  chip: chipOf(slug),
  href: questionHref(slug, locale),
}));
---

<Base locale={locale} title={plain(I.title[locale])} description={I.description[locale]} share="brief">
  <div class="qi">
    <header class="qi-head">
      <h1 class="qi-title"><Phrased text={I.title[locale]} locale={locale} /></h1>
      <p class="qi-lead">{I.lead[locale]}</p>
    </header>

    <ol class="qi-grid" aria-label={I.listLabel[locale]}>
      {
        cards.map((c) => (
          <li class="qi-card">
            <div class="qi-card__pic" data-screen-picture>
              <CardPicture locale={locale} slug={c.slug} />
              <IllustrationTag locale={locale} kind={c.slug === 'one-red-light' ? 'body' : 'street'} />
            </div>
            <div class="qi-card__text">
              <h2 class="qi-card__q">
                <a href={c.href}><Phrased text={c.q} locale={locale} /></a>
              </h2>
              <p class="qi-card__a"><span class="vh">{I.answerLabel[locale]}{colon(locale)}</span>{c.answer}</p>
              <p class="qi-card__chip"><KindChip locale={locale} kind={c.chip.kind} where={c.chip.where} size="sm" /></p>
            </div>
          </li>
        ))
      }
    </ol>

    <nav class="qi-more" aria-labelledby="qi-more-h">
      <h2 class="qi-more__title" id="qi-more-h">{I.more.title[locale]}</h2>
      <NextButton href={href('/estimate/', locale)}>{I.more.estimate[locale]}</NextButton>
      <NextButton href={href('/electric/', locale)} variant="primary">{I.more.electric[locale]}</NextButton>
    </nav>
  </div>
</Base>

<style>
  .qi {
    inline-size: min(100% - 2 * var(--gutter), 72rem);
    margin-inline: auto;
    padding-block: var(--sp-4) var(--sp-7);
  }
  .qi-head {
    display: grid;
    gap: var(--sp-2);
    padding-block-end: var(--sp-5);
  }
  .qi-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.6875rem, 7.5vw, 2.5rem);
    font-weight: var(--fw-black);
    line-height: 1.2;
    letter-spacing: 0;
    text-wrap: balance;
  }
  .qi-lead {
    margin: 0;
    font-size: var(--fs-base);
    line-height: var(--lh-read);
    color: var(--ink);
  }

  .qi-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 44em) {
    .qi-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 68em) {
    .qi-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* one card: the picture, then the question (the link, stretched over the whole card) */
  .qi-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    min-inline-size: 0;
    border: 2px solid var(--ink);
    border-radius: var(--radius-3);
    background: var(--surface);
    overflow: hidden;
  }
  .qi-card:hover {
    background: var(--bg-sunken);
  }
  .qi-card:focus-within {
    outline: 3px solid var(--focus, var(--ink));
    outline-offset: 3px;
  }
  .qi-card__pic {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: end;
    min-inline-size: 0;
    border-block-end: 2px solid var(--ink);
    background: var(--bg);
    --here: var(--bg);
  }
  .qi-card__pic > :global(figure) {
    inline-size: 100%;
    margin: 0;
  }
  .qi-card__pic > :global(.ill-tag) {
    display: block;
    padding: 0.2rem var(--sp-3);
    border-radius: 0;
    background: none;
  }
  .qi-card__text {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    padding: var(--sp-3) var(--sp-4) var(--sp-4);
  }
  .qi-card__q {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: var(--fw-black);
    line-height: 1.28;
    letter-spacing: 0;
    text-wrap: balance;
  }
  .qi-card__q a {
    color: var(--ink);
    text-decoration: none;
  }
  .qi-card__q a:focus-visible {
    outline: none;
  }
  .qi-card__q a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .qi-card:hover .qi-card__q a {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }
  .qi-card__a {
    margin: 0;
    font-size: var(--fs-base);
    line-height: var(--lh-read);
    color: var(--ink);
  }
  .qi-card__chip {
    margin: 0;
  }

  .qi-more {
    display: grid;
    gap: var(--tap-gap);
    max-inline-size: 36rem;
    margin-block-start: var(--sp-7);
  }
  .qi-more__title {
    margin: 0 0 var(--sp-1);
    font-size: var(--fs-md);
    font-weight: var(--fw-black);
  }
  @media (min-width: 44em) {
    .qi-more {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-inline-size: none;
    }
    .qi-more__title {
      grid-column: 1 / -1;
    }
  }
</style>
