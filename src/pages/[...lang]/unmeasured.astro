---
/**
 * /unmeasured/ moved to /estimate/ (redesign brief 2). Kept as a redirect in both locales so old
 * links and shares still land; an old #ask (the measurement request) lands on /estimate/#measure,
 * and /estimate/ also carries an empty id="ask" at that section for readers without JavaScript.
 */
import Redirect from '@/layouts/Redirect.astro';
import { localeFromParam, localeStaticPaths } from '@/i18n';
import { nav } from '@/i18n/ui';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const label = nav.find((n) => n.path === '/estimate/')!.label[locale];
---

<Redirect locale={locale} to="/estimate/" label={label} hashMap={{ ask: 'measure' }} />
