---
/**
 * /unmeasured/ — 沒有人量過的事 / What nobody has measured (blueprint 4.4, V8 reused, V35).
 *
 *   1 the empty chart (V8), with the home page's Link 3 deck, and who could fill it
 *   2 five blanks on the ninety seconds (registry gaps), led by the central one; then the rest
 *   3 what to measure (V35, the art layer's MeasurementDiagram), stamped as our proposal
 *   4 why a home sensor cannot answer it (the wrong ruler)
 *   5 what would change our mind, and the promise to publish any result
 *   6 #ask 請來量我家路口: the request, composed in the browser (nothing stored)
 *   7 for researchers, agencies and journalists: the one-page brief (V47, /print/brief/)
 *
 * Copy: src/i18n/pages/unmeasured.ts. Gaps and facts come from the registry.
 */
import Base from '@/layouts/Base.astro';
import Section from '@/components/ui/Section.astro';
import Figure from '@/components/ui/Figure.astro';
import Details from '@/components/ui/Details.astro';
import EvidenceBadge from '@/components/ui/EvidenceBadge.astro';
import Icon from '@/components/ui/Icon.astro';
import Phrased from '@/components/ui/Phrased.astro';
import PullQuote from '@/components/ui/PullQuote.astro';
import StanceBox from '@/components/ui/StanceBox.astro';
import Button from '@/components/ui/Button.astro';
import EmptyChart from '@/components/charts/EmptyChart.astro';
import MeasurementDiagram from '@/components/art/MeasurementDiagram.astro';
import Claim from '@/components/pages/action/Claim.astro';
import Composer from '@/components/pages/action/Composer.astro';
import { lg } from '@/components/pages/action/ev';
import { href, localeFromParam, localeStaticPaths } from '@/i18n';
import { gapList, type GapId } from '@/data';
import unmeasured from '@/i18n/pages/unmeasured';
import { fill, localize } from '@/i18n/pages/_copy';
import { formatDate } from '@/lib/site-state.data';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const t = localize(unmeasured, locale);
const whoFallback = t.whoFallback as Record<string, string>;

const fmtDate = (iso: string) => formatDate(iso, locale, true);

// The five blanks on the ninety seconds, in the blueprint's order; the central gap first.
const five: GapId[] = ['gap-pedestrian-red-light-exposure', 'gap-idle-emission-rate', 'gap-pull-away-spike', 'gap-scooters-per-red-light', 'gap-electrification-street-air'];
const rest = gapList.map((g) => g.id).filter((id) => !five.includes(id));
const gapView = (id: GapId) => {
  const g = lg(id, locale);
  return { ...g, who: g.whoCouldMeasure ?? whoFallback[id], whoIsProposal: !g.whoCouldMeasure };
};
const central = gapView('gap-pedestrian-red-light-exposure');
---

<Base locale={locale} title={t.meta.title} description={t.meta.description} share="home">
  <Section id="blank" tone="inverse" pad="normal" class="um-hero">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1 class="display"><Phrased text={t.hero.title} /></h1>
    <p class="lead um-deck">{t.hero.deck}</p>
    <div class="um-empty">
      <Figure locale={locale} empty title={t.hero.figure.title} subtitle={t.hero.figure.subtitle} level={2}>
        <EmptyChart locale={locale} title={t.hero.figure.chart} desc={t.hero.figure.desc} panelHeight={96} />
        <Fragment slot="who">{central.who} <a href="#ask">{t.hero.figure.ask}</a></Fragment>
      </Figure>
    </div>
    <p class="um-handoff">{t.hero.handoff}</p>
  </Section>

  <Section id="five" eyebrow={t.five.eyebrow} title={t.five.title} lead={t.five.lead} rule>
    <ol class="gaps">
      {
        five.map((id, i) => {
          const g = gapView(id);
          return (
            <li class:list={['gap', i === 0 && 'gap--first']}>
              {i === 0 && <p class="gap__flag">{t.five.first}</p>}
              <h3 class="gap__title">
                <span class="gap__n" aria-hidden="true">{i + 1}</span>
                {g.title}
              </h3>
              <EvidenceBadge locale={locale} kind="gap" />
              <Claim locale={locale} text={g.statement} gaps={[id]} badge={[]} />
              <dl class="gap__dl">
                <div>
                  <dt>{g.whoIsProposal ? t.five.whoProposal : t.five.who}</dt>
                  <dd>{g.who}</dd>
                </div>
                <div>
                  <dt>{t.five.close}</dt>
                  <dd>{g.wouldClose}</dd>
                </div>
              </dl>
              <p class="gap__meta">{fill(t.five.searched, { date: fmtDate(g.searchedOn) })}</p>
            </li>
          );
        })
      }
    </ol>

    <h3 class="more__title">{fill(t.five.moreTitle, { n: rest.length })}</h3>
    <p class="more__lead">{t.five.moreLead}</p>
    <div class="more">
      {
        rest.map((id) => {
          const g = gapView(id);
          return (
            <Details summary={g.title} name="more-gaps">
              <div class="more__body">
                <EvidenceBadge locale={locale} kind="gap" />
                <Claim locale={locale} text={g.statement} gaps={[id]} badge={[]} />
                <p><b>{t.five.why}</b> {g.whyItMatters}</p>
                <p><b>{g.whoIsProposal ? t.five.whoProposal : t.five.who}</b> {g.who}</p>
                <p><b>{t.five.close}</b> {g.wouldClose}</p>
              </div>
            </Details>
          );
        })
      }
    </div>
    <p class="more__link"><a href={href('/evidence/#gaps', locale)}>{t.five.evidenceLink}<Icon name="arrow-right" size="1.05em" /></a></p>
  </Section>

  <Section id="plan" eyebrow={t.plan.eyebrow} title={t.plan.title} tone="sunken" rule>
    <div class="plan">
      <p class="plan__lead">{t.plan.lead}</p>
      <p class="plan__long"><b>{t.plan.howLong}</b></p>
      <Figure locale={locale} title={t.plan.figTitle} frame="none" level={3} class="plan__fig">
        <MeasurementDiagram locale={locale}>
          <p>{t.plan.stamp}</p>
        </MeasurementDiagram>
      </Figure>
      <div class="plan__nearest">
        <p class="plan__label">{t.plan.nearest}</p>
        <Claim locale={locale} facts={['iot-study-design']} size="sm" />
      </div>
      <p class="plan__print">
        <Button href={href('/print/brief/', locale)} variant="secondary" arrow>{t.plan.print}</Button>
        <span class="meta">{t.plan.printNote}</span>
      </p>
    </div>
  </Section>

  <Section id="sensors" eyebrow={t.sensors.eyebrow} title={t.sensors.title} lead={t.sensors.lead} width="wide">
    <div class="stack-claims">
      <Claim locale={locale} text={t.sensors.fumes} facts={['teds13-mc-gas-vs-particle-contrast']} />
      <Claim locale={locale} facts={['taipei-traffic-station-gap']} />
      <Claim locale={locale} text={t.sensors.stations} facts={['wu2021-station-correlation']} />
      <div class="handheld">
        <p class="plan__label">{t.sensors.handheld}</p>
        <Claim locale={locale} facts={['commute-walking-wang2021']} size="sm" />
      </div>
      <p class="sensors__close">{t.sensors.close} <a href="#ask">{t.hero.figure.ask}<Icon name="arrow-right" size="1.05em" /></a></p>
    </div>
  </Section>

  <Section id="promise" eyebrow={t.promise.eyebrow} title={t.promise.title} tone="sunken" width="wide" rule>
    <div class="promise">
      <PullQuote tone="clean">
        {t.promise.pledge}
        <Fragment slot="attribution">{t.promise.pledgeBy}</Fragment>
      </PullQuote>
      <p class="promise__small">{t.promise.small}</p>
      <StanceBox locale={locale} kind="change-mind">{t.promise.changeMind}</StanceBox>
    </div>
  </Section>

  <Section id="ask" eyebrow={t.ask.eyebrow} title={t.ask.title} lead={t.ask.lead} width="wide" rule>
    <noscript><p class="ask__noscript">{t.ask.noScript}</p></noscript>
    <Composer
      locale={locale}
      id="ask-letter"
      title={t.ask.title2}
      fields={[
        { key: 'city', label: t.ask.city, hint: t.ask.cityHint },
        { key: 'place', label: t.ask.place, hint: t.ask.placeHint },
      ]}
      subject={t.ask.subject}
      body={t.ask.body}
      labels={{ subject: t.ask.subjectLabel, copy: t.ask.copy, copied: t.ask.copied, failed: t.ask.failed, mail: t.ask.mail, fields: t.ask.fields, noStore: t.ask.noStore }}
    />
    <div class="ask__to">
      <h3 class="ask__h">{t.ask.toWhom}</h3>
      <p>{t.ask.toWhomBody}</p>
      <p class="meta">{t.ask.notFund}</p>
    </div>
  </Section>

  <Section id="kit" eyebrow={t.kit.eyebrow} title={t.kit.title} lead={t.kit.lead} tone="sunken" width="wide">
    <p class="kit__actions">
      <Button href={href('/print/brief/', locale)} arrow>{t.kit.print}</Button>
    </p>
    <p class="meta">{t.kit.reuse} <a href={href('/about/#who', locale)}>{t.kit.about}</a></p>
  </Section>
</Base>

<style>
  .um-hero :global(.display) {
    margin-block: var(--sp-2) var(--sp-4);
  }
  .um-deck {
    max-inline-size: 40rem;
  }
  .um-empty {
    margin-block: var(--sp-6) var(--sp-5);
  }
  .um-handoff {
    max-inline-size: 40rem;
    font-weight: var(--fw-bold);
  }
  .gaps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
  }
  .gap {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
    padding: var(--sp-4);
    border: 2px dashed var(--line-strong);
    border-radius: var(--radius-2);
    background: var(--surface);
  }
  .gap--first {
    grid-column: 1 / -1;
    border: var(--rule-paint) solid var(--ink);
  }
  .gap__flag {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-black);
    color: var(--signal-red-ink);
    letter-spacing: 0.06em;
  }
  .gap__title {
    margin: 0;
    font-size: var(--fs-lg);
    line-height: var(--lh-heading);
    display: flex;
    gap: var(--sp-2);
    align-items: baseline;
  }
  .gap__n {
    font-family: var(--font-en-display, var(--font-heading));
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .gap__dl {
    margin: 0;
    display: grid;
    gap: var(--sp-2);
  }
  .gap__dl dt {
    font-weight: var(--fw-bold);
    font-size: var(--fs-sm);
  }
  .gap__dl dd {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--ink-2);
  }
  .gap__meta {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }
  .more__title {
    margin-block: var(--sp-7) var(--sp-2);
    font-size: var(--fs-lg);
  }
  .more__lead {
    margin-block-end: var(--sp-4);
    color: var(--ink-2);
    max-inline-size: 40rem;
  }
  .more {
    max-inline-size: 48rem;
  }
  .more__body {
    display: grid;
    gap: var(--sp-3);
    justify-items: start;
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
  }
  .more__body p {
    margin: 0;
  }
  .more__link {
    margin-block-start: var(--sp-4);
  }
  .more__link a,
  .sensors__close a {
    font-weight: var(--fw-bold);
  }
  .plan {
    display: grid;
    gap: var(--sp-4);
  }
  .plan__lead,
  .plan__long {
    max-inline-size: 44rem;
    margin: 0;
  }
  .plan__nearest,
  .handheld {
    display: grid;
    gap: var(--sp-2);
    max-inline-size: 44rem;
  }
  .plan__label {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
  }
  .plan :global(.plan__fig) {
    max-inline-size: 52rem;
  }
  .plan__print {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
  }
  .stack-claims {
    display: grid;
    gap: var(--sp-5);
  }
  .sensors__close {
    margin: 0;
    font-weight: var(--fw-bold);
  }
  .promise {
    display: grid;
    gap: var(--sp-5);
  }
  .promise__small {
    margin: 0;
    font-weight: var(--fw-bold);
  }
  .ask__noscript {
    padding: var(--sp-3);
    border-inline-start: var(--rule-paint) solid var(--ink);
    margin-block-end: var(--sp-4);
  }
  .ask__to {
    margin-block-start: var(--sp-6);
    display: grid;
    gap: var(--sp-2);
  }
  .ask__to p {
    margin: 0;
  }
  .ask__h {
    margin: 0;
    font-size: var(--fs-lg);
  }
  .kit__actions {
    margin-block-end: var(--sp-3);
  }
</style>
