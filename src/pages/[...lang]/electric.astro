---
/**
 * /electric/ — 換電動，把帳攤開 / Going electric: the full bill (blueprint 4.3).
 *
 * A worked result first (ElectricOpening: the price on the day and each month, brief 7.7), then the reader's own sums (#status, #calc, #result), worked examples that
 * are complete results without JavaScript (#examples), how to get closer (#closer), the dated
 * checklist (#checklist), running costs on their own (#monthly), the honest limits (#no-socket,
 * #who, #risks), what to do if not this year (#not-yet), the 22 places (#cities), our asks
 * (#asks), questions (#faq) and sources.
 *
 * Every number comes from the calculator engine (src/lib/calc) or the registry (src/data), via
 * src/components/pages/electric/. Date-dependent copy follows src/lib/site-state.ts: each
 * variant is printed with the phases it is true in (data-money-when), and the browser picks
 * one from today's date; without JavaScript the "static" variants, true whenever read, show.
 * Copy: src/i18n/pages/electric.ts (and ./money.ts for the shared banner and timeline).
 */
import Base from '@/layouts/Base.astro';
import Section from '@/components/ui/Section.astro';
import Phrased from '@/components/ui/Phrased.astro';
import Button from '@/components/ui/Button.astro';
import Callout from '@/components/ui/Callout.astro';
import Select from '@/components/ui/Select.astro';
import MoneyBanner from '@/components/ui/MoneyBanner.astro';
import SubsidyTimeline from '@/components/ui/SubsidyTimeline.astro';
import Tabs from '@/components/ui/Tabs.astro';
import TabPanel from '@/components/ui/TabPanel.astro';
import Figure from '@/components/ui/Figure.astro';
import CompareTable from '@/components/ui/CompareTable.astro';
import TileMap from '@/components/ui/TileMap.astro';
import Details from '@/components/ui/Details.astro';
import EvidenceBadge from '@/components/ui/EvidenceBadge.astro';
import Tag from '@/components/ui/Tag.astro';
import RangePlot from '@/components/charts/RangePlot.astro';
import GroupedBarChart from '@/components/charts/GroupedBarChart.astro';
import Calculator from '@/components/pages/electric/Calculator.astro';
import ElectricResult from '@/components/pages/electric/ElectricResult.astro';
import ElectricOpening from '@/components/pages/electric/ElectricOpening.astro';
import { afterDate, cityDetails, citeMap, data, examples, F, factIds, factValue, flagsByCity, pageLinks, runningTables, seriesIds, surveyChart, today, yearEnd } from '@/components/pages/electric/electric-data';
import { money } from '@/components/pages/electric/model';
import { DEFAULTS, defaultScrap } from '@/lib/home-money';
import { formatCitation, sourcesFor, sourceUrl } from '@/data';
import { cityMoney, formatDate, snapshot } from '@/lib/site-state.data';
import { href, localeFromParam, localeStaticPaths } from '@/i18n';
import { readerText, ui, evidenceBadge, type EvidenceKind } from '@/i18n/ui';
import electric from '@/i18n/pages/electric';
import { fill, localize } from '@/i18n/pages/_copy';
import type { JurisdictionId } from '@/data/econ/types';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const T = localize(electric, locale);
const plain = (s: string) => s.replaceAll('|', '');
const d = (iso: string) => formatDate(iso, locale, true);
const deadline = d(yearEnd);
const checked = d(data.meta.checkedOn);
const filing = d(snapshot.filingEnd);
const nf = (v: number, digits = 0) => new Intl.NumberFormat(locale === 'en' ? 'en-GB' : 'zh-TW', { maximumFractionDigits: digits, minimumFractionDigits: digits }).format(v);
const perKm = (v: number) => fill(T.fmt.perKm, { n: nf(v, 2) });
const links = pageLinks(locale);

// ---- city select (#status): every place with how far we could check it ----------------------
const ids = Object.keys(data.jurisdictions) as JurisdictionId[];
const statusWord = (id: JurisdictionId) => {
  const j = data.jurisdictions[id];
  const m = cityMoney(id, today, snapshot);
  if (j.status !== 'not-verified' && m.status === 'exhausted') return T.status.cityStatus.exhausted;
  if (j.status !== 'not-verified' && m.status === 'ended') return T.status.cityStatus.ended;
  return T.status.cityStatus[j.status];
};
const cityOptions = [...ids.map((id) => ({ value: id, label: `${readerText(data.jurisdictions[id].name[locale])}${locale === 'en' ? ' (' : '（'}${statusWord(id)}${locale === 'en' ? ')' : '）'}` }))];

// ---- the calculator's settings ---------------------------------------------------------------
const cfg = {
  locale,
  cites: citeMap(locale),
  flags: flagsByCity(),
  remote: Object.fromEntries(ids.map((id) => [id, data.jurisdictions[id].remoteDistricts ? readerText(data.jurisdictions[id].remoteDistricts![locale]) : ''])),
  cityNames: Object.fromEntries(ids.map((id) => [id, readerText(data.jurisdictions[id].name[locale])])),
  cityNotes: Object.fromEntries(ids.map((id) => [id, { note: readerText(data.jurisdictions[id].statusNote[locale]), links: data.jurisdictions[id].officialLinks.map((l) => ({ label: readerText(l.label[locale]), url: l.url })) }])),
  links,
  tableLabel: ui.dataTable[locale],
  statusWords: T.status.moneyWords,
  yearEnd,
  text: {
    working: T.result.working,
    invalid: T.result.invalid,
    dayCount: T.result.dayCount,
    dayCountLast: T.result.dayCountLast,
    dayCountNone: T.result.dayCountNone,
    levers: T.closer.levers,
    worth: T.closer.worth,
    leverPlanNote: T.closer.leverPlanNote,
    nothing: T.closer.nothing,
    noCity: T.closer.noCity,
    statusNote: T.status.statusNote,
    officialLinks: T.status.officialLinks,
    announce: T.result.announce,
    barEmpty: T.calc.bar.empty,
    barFix: T.calc.bar.fix,
  },
  examples: [] as { key: string; answers: unknown; before: boolean; after: string; full: boolean }[],
  built: today,
};

// ---- worked examples, running costs, cities, facts -------------------------------------------
const ex = examples(locale);
// The first worked example ships complete (it is the no-JavaScript answer too); the others ship
// their verdict only, and the browser builds their working when one is opened, for the reader's day.
const lazy = (i: number) => i > 0;
cfg.examples = ex.map((x, i) => ({ key: x.key, answers: x.answers, before: !!x.before, after: afterDate, full: !lazy(i) }));
// (the chart comes with the working: it is drawn in the browser too)
const headOnly = (r: (typeof ex)[number]['after']['rendered'], i: number) => (lazy(i) ? { ...r, answersHtml: r.answersHtml.replace(/<figure class="el-fig">[\s\S]*?<\/figure>/g, ''), bodyHtml: '' } : r);
const run = runningTables(locale);
const { cities, central } = cityDetails(locale);
const survey = surveyChart(locale);
const fx = Object.fromEntries(factIds.map((id) => [id, F(id, locale)])) as Record<(typeof factIds)[number], ReturnType<typeof F>>;
const badgeOf = (id: (typeof factIds)[number]) => evidenceBadge(fx[id].evidence, fx[id].confidence);
const factSources = (id: (typeof factIds)[number]) => fx[id].citations;
const share = factValue('econ-ev-brand-share-2026-07', 'gogoroShare');
const stations = factValue('econ-gogoro-network', 'stations');
const pageSources = sourcesFor({ facts: [...factIds], series: [...seriesIds] });
// the checklist's dates, earliest first
const foreignDates = data.programmes.flatMap((p) => p.conditions.flatMap((c) => (c.kind === 'applicant-deadline' ? [c.date] : []))).filter((x, i, a) => a.indexOf(x) === i);
const dateItems = [
  { date: yearEnd, text: fill(T.checklist.dates.purchase, { date: deadline }) },
  { date: snapshot.filingEnd, text: fill(T.checklist.dates.filing, { date: filing }) },
  ...foreignDates.map((date) => ({ date, text: fill(T.checklist.dates.foreign, { date: d(date) }) })),
].sort((a, b) => a.date.localeCompare(b.date));
// places whose own money closes before the central deadline (Keelung and Kinmen: 30 November)
const earlyByDate = new Map<string, string[]>();
for (const p of data.programmes) {
  if (p.jurisdiction === 'central' || p.calculator !== true || p.validTo >= yearEnd) continue;
  const name = readerText(data.jurisdictions[p.jurisdiction as JurisdictionId].name[locale]);
  const list = earlyByDate.get(p.validTo) ?? [];
  if (!list.includes(name)) list.push(name);
  earlyByDate.set(p.validTo, list);
}
const early = [...earlyByDate.entries()].map(([date, places]) => fill(T.risks.early, { places: places.join(locale === 'en' ? ' and ' : '、'), date: d(date) })).join(' ');
// a row whose low and high are the same figure is one value: say it once, not 「1.64 元到 1.64 元」
const rangeDesc = run.range.map((r) => (perKm(r.min) === perKm(r.max) ? fill(T.monthly.rangeDescOne, { label: r.label, v: perKm(r.min) }) : fill(T.monthly.rangeDescItem, { label: r.label, mid: perKm(r.mid), min: perKm(r.min), max: perKm(r.max) }))).join(locale === 'en' ? '; ' : '；');

// running-cost table: one row per distance, a column per way of powering it (CompareTable stacks on phones)
const homeCols = run.homeModels.map((m) => ({ id: m.id, label: `${T.monthly.rows.home} · ${readerText(m.name[locale]).replace(/[（(].*$/, '')} · ${T.result.plate[m.plateClass]}` }));
const monthlyLabels = [fill(T.monthly.rows.petrol, { model: run.gasModelName }), T.monthly.rows.sub, T.monthly.rows.payg, ...homeCols.map((c) => c.label)];
// the examples' answers, for the "use this" buttons
const useOf = (x: (typeof ex)[number]) => JSON.stringify({ ...x.answers, charge: x.charge });
const notYetBadge = (k: string) => k as EvidenceKind;
---

<Base locale={locale} title={T.meta.title} description={T.meta.description} share="money" money>
  <header class="el-head">
    <div class="container container--wide el-head__inner">
      <p class="eyebrow">{T.head.eyebrow}</p>
      <h1 class="display el-title"><Phrased text={T.head.title} /></h1>
      <p class="lead">{T.head.lead}</p>

      <ElectricOpening locale={locale} />
      <div data-money-when="B">
        <div class="el-actions">
          <Button href="#checklist" variant="secondary" size="lg">{T.answer.boughtLink}</Button>
        </div>
      </div>
      <div data-money-when="C D">
        <div class="el-actions">
          <Button href={href('/act/#policy', locale)} variant="secondary" size="lg">{T.answer.askLink}</Button>
        </div>
      </div>
    </div>
  </header>

  <!-- 1. Is there money where you live? -->
  <Section fold class="el-fold-sec" title={T.status.title} lead={T.status.lead} width="wide" pad="tight" tone="sunken">
    <!-- the anchor sits inside the fold, so a link to it opens the fold, with or without JavaScript -->
    <div id="status" class="el-anchor"></div>
    <div class="el-status">
      <div class="stack" style="--stack: var(--sp-4)">
        <div data-js-only>
          <Select id="el-city" label={T.status.cityLabel} options={cityOptions} value={DEFAULTS.county} hint={T.status.cityHint} data-money-city />
        </div>
        <MoneyBanner locale={locale} tone="box" />
        <div class="el-citynote" data-el-citynote hidden></div>
      </div>
      <SubsidyTimeline locale={locale} />
    </div>
  </Section>

  <!-- 2–3. The calculator and the live result -->
  <Section id="calc" title={T.calc.title} width="wide">
    <p id="el-calc-lead" class="el-calc-lead" data-js-only>{fill(T.calc.lead, { date: '\u0000', checked }).split('\u0000')[0]}<span data-money-fill="today">{d(today)}</span>{fill(T.calc.lead, { date: '\u0000', checked }).split('\u0000')[1]}</p>
    <div class="el-calc-grid">
      <Calculator locale={locale} cfg={cfg} today={today} cityOptions={cityOptions} defaults={{ county: DEFAULTS.county, km: DEFAULTS.km, scrap: defaultScrap(today) }} />
    </div>
  </Section>

  <!-- How to get closer: the levers for the chosen place, from the engine -->
  <Section fold class="el-fold-sec" title={T.closer.title} lead={T.closer.lead} width="wide" tone="sunken">
    <!-- the anchor sits inside the fold, so a link to it opens the fold, with or without JavaScript -->
    <div id="closer" class="el-anchor"></div>
    <div class="el-two">
      <div>
        <p class="el-small" data-js-only>{T.closer.leverNote}</p>
        <p class="el-small el-nojs">{T.closer.noJs}</p>
        <p class="el-small" data-el-levers-empty data-js-only>{T.closer.noCity}</p>
        <ol class="el-levers" data-el-levers hidden></ol>
      </div>
      <Callout tone="exhaust" label={T.closer.pitfallsTitle}>
        <ul class="el-list">
          {T.closer.pitfalls.map((p) => <li>{p}</li>)}
        </ul>
      </Callout>
    </div>
  </Section>

  <!-- Worked examples: complete results without JavaScript, on both sides of the deadline -->
  <Section fold class="el-fold-sec" title={T.examples.title} lead={T.examples.lead} width="wide">
    <!-- the anchor sits inside the fold, so a link to it opens the fold, with or without JavaScript -->
    <div id="examples" class="el-anchor"></div>
    <Tabs label={T.examples.tabsLabel}>
      {ex.map((x, i) => (
        <TabPanel id={`example-${x.key}`} label={x.tab}>
          <div class="el-example">
            <p class="el-example__who">{x.who}</p>
            <p class="el-small">{T.examples.voice}</p>
            {lazy(i) && (
              <p class="el-small" data-el-more>
                <span data-js-only>{T.examples.more}</span>
                <span class="el-nojs">{T.examples.moreNoJs}</span>
              </p>
            )}
            {x.before && (
              <div data-money-when="A static">
                <div class="el-example__phase">
                  <h4 class="el-example__when">{fill(T.examples.before, { deadline, checked })}</h4>
                  <ElectricResult id={`ex-${x.key}-a`} locale={locale} rendered={headOnly(x.before.rendered, i)} city={x.answers.jurisdiction} />
                </div>
              </div>
            )}
            <div data-money-when={x.before ? 'B C D static' : 'A B C D static'}>
              <div class="el-example__phase">
                <h4 class="el-example__when">{fill(T.examples.after, { from: d(afterDate) })}</h4>
                <ElectricResult id={`ex-${x.key}-c`} locale={locale} rendered={headOnly(x.after.rendered, i)} city={x.answers.jurisdiction} />
              </div>
            </div>
            <p data-js-only><Button variant="secondary" data-el-use={useOf(x)}>{T.examples.useThis}</Button></p>
          </div>
        </TabPanel>
      ))}
    </Tabs>
  </Section>

  <!-- What to do next: the ordered, dated checklist -->
  <Section fold class="el-fold-sec" title={T.checklist.title} lead={T.checklist.lead} width="wide" tone="sunken">
    <!-- the anchor sits inside the fold, so a link to it opens the fold, with or without JavaScript -->
    <div id="checklist" class="el-anchor"></div>
    <p data-money-when="B" class="el-phase-note">{fill(T.checklist.phaseB, { deadline, filing })}</p>
    <p data-money-when="C" class="el-phase-note">{T.checklist.phaseC}</p>
    <ol class="el-steps">
      {T.checklist.steps.map((s) => (
        <li>
          <h3 class="el-steps__title">{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
    <h3 class="el-h3">{T.checklist.datesTitle}</h3>
    <ul class="el-dates">
      {dateItems.map((x) => <li>{x.text}</li>)}
      <li>{fill(T.checklist.dates.next, { date: checked })}</li>
    </ul>
    <p class="el-small">{T.checklist.yourDates}</p>
    <p data-js-only><Button variant="secondary" data-el-print="checklist">{T.checklist.print}</Button></p>
  </Section>

  <!-- Running costs, on their own -->
  <Section fold class="el-fold-sec" title={T.monthly.title} width="wide">
    <!-- the anchor sits inside the fold, so a link to it opens the fold, with or without JavaScript -->
    <div id="monthly" class="el-anchor"></div>
    <p class="el-opener">{T.monthly.opener}</p>
    <p class="lead">{run.suitsFrom !== null ? fill(T.monthly.leadFrom, { km: nf(run.suitsFrom) }) : T.monthly.lead}</p>

    <Figure locale={locale} title={T.monthly.tableTitle} subtitle={T.monthly.tableSub} caption={fill(T.monthly.tableCaption, { checked })} badge={['derived', 'market-tw']} secondary>
      <div class="el-kms">
        {run.rows.map((r) => (
          <section class="el-km">
            <h4 class="el-km__title">{fill(T.monthly.km, { km: nf(r.km) })}</h4>
            <dl class="el-km__list">
              {monthlyLabels.map((label, i) => {
                const b = [r.petrol, r.sub.cost, r.payg.cost, ...r.home.map((h) => h.cost)][i];
                return (
                  <div class:list={['el-km__row', i === 0 && 'el-km__row--petrol', i > 0 && b.typical > r.petrol.typical && 'el-km__row--dearer']}>
                    <dt>{label}</dt>
                    <dd><b>{money(locale, b.typical)}</b> <span>{fill(T.monthly.perKm, { v: perKm(b.typical / r.km) })}</span>{i > 0 && <span class="el-km__cmp">{b.typical > r.petrol.typical ? T.monthly.dearerThanPetrol : T.monthly.cheaperThanPetrol}</span>}</dd>
                  </div>
                );
              })}
            </dl>
            <p class="el-small">{fill(T.monthly.rows.subPlan, { plan: run.planName(r.sub.p) })}</p>
          </section>
        ))}
      </div>
    </Figure>

    <div class="el-two">
      <Figure locale={locale} title={T.monthly.rangeTitle} subtitle={`${T.monthly.rangeSub}${locale === 'en' ? '; ' : '；'}${fill(T.monthly.rangeAt, { km: nf(run.REF) })}`} badge="derived" secondary>
        <RangePlot
          locale={locale}
          title={plain(T.monthly.rangeTitle)}
          data={run.range}
          labels={{ min: T.monthly.rangeLabels.min, mid: T.monthly.rangeLabels.mid, max: T.monthly.rangeLabels.max }}
          decimals={2}
          unit={T.monthly.rangeUnit}
          categoryLabel={T.monthly.rangeCategory}
          desc={rangeDesc}
        />
      </Figure>
      <div class="stack" style="--stack: var(--sp-4)">
        <h3 class="el-h3">{T.monthly.statementsTitle}</h3>
        <ul class="el-facts">
          <li><b>{T.monthly.statements.petrol}</b>{fx['econ-petrol-cost-per-km'].statement} <EvidenceBadge locale={locale} {...badgeOf('econ-petrol-cost-per-km')} variant="icon" /></li>
          <li><b>{T.monthly.statements.swap}</b>{fx['econ-swap-vs-petrol-low-mileage'].statement} <EvidenceBadge locale={locale} {...badgeOf('econ-swap-vs-petrol-low-mileage')} variant="icon" /></li>
          <li><b>{T.monthly.statements.payg}</b>{fx['econ-swap-vs-petrol-low-mileage'].caveat}</li>
          <li><b>{T.monthly.statements.home}</b>{fx['econ-home-charging-cost-per-km'].statement} <EvidenceBadge locale={locale} {...badgeOf('econ-home-charging-cost-per-km')} variant="icon" /></li>
        </ul>
        <p class="el-small">{fx['econ-home-charging-cost-per-km'].caveat}</p>
      </div>
    </div>

    <div class="el-two">
      <div class="stack" style="--stack: var(--sp-3)">
        <h3 class="el-h3">{T.monthly.whoTitle}</h3>
        <p class="el-small">{T.monthly.whoLead}</p>
        <ul class="el-list">
          <li>{run.suitsFrom !== null ? fill(T.monthly.whoSuits, { km: nf(run.suitsFrom) }) : fill(T.monthly.whoSuitsNone, { km: nf(run.maxScan) })}</li>
          {run.suitsFrom !== null && <li>{fill(T.monthly.whoNot, { km: nf(run.suitsFrom) })}</li>}
        </ul>
        <h3 class="el-h3">{T.monthly.smoothingTitle}</h3>
        <p>{fill(T.monthly.smoothingBody, { km: nf(run.REF), delta: money(locale, run.smoothingDelta) })}</p>
        <p class="el-small">{fx['econ-petrol-price-smoothing'].statement} {fx['econ-petrol-price-smoothing'].caveat}</p>
        <p class="el-small">{run.smoothingMechanism}</p>
        <p class="el-small"><b>{T.monthly.electricityNote}</b>{run.electricityNote}</p>
      </div>
      <div class="stack" style="--stack: var(--sp-3)">
        <h3 class="el-h3">{T.monthly.fixedTitle}</h3>
        <p class="el-small">{fill(T.monthly.fixedLead, { km: nf(run.REF) })}</p>
        <CompareTable
          caption={T.monthly.fixedTitle}
          hideCaption
          rowHeader={T.monthly.fixedCols.item}
          columns={[{ label: T.monthly.fixedCols.ev, tone: 'clean' }, { label: T.monthly.fixedCols.gas, tone: 'exhaust' }]}
          rows={run.fixed.map((f) => ({ label: f.label, values: [fill(T.monthly.perYear, { v: money(locale, f.ev) }), fill(T.monthly.perYear, { v: money(locale, f.gas) })], note: f.note.join(' ') }))}
        />
        <p class="el-small">{fx['econ-fixed-fees'].statement}</p>
      </div>
    </div>

    <Figure locale={locale} title={survey.s.title} subtitle={T.monthly.surveySub} caption={survey.s.caveat} badge="official-tw" source={survey.s.citations.map((c) => c.short).join(' · ')}>
      <GroupedBarChart
        locale={locale}
        title={survey.s.title}
        desc={survey.s.description}
        series={survey.m.columns.map((c, i) => ({ label: c.label, tone: (['exhaust', 'neutral', 'blue'] as const)[i] ?? 'neutral' }))}
        groups={survey.m.rows.map((r) => ({ label: r.label, values: r.values.map((v) => v ?? 0) }))}
        unit={T.monthly.unitYear}
        categoryLabel={T.monthly.fixedCols.item}
      />
    </Figure>
    <p class="el-small">{fx['econ-motc-annual-spend'].statement} {fx['econ-motc-annual-spend'].caveat}</p>
  </Section>

  <!-- No socket where you park -->
  <Section fold class="el-fold-sec" title={T.noSocket.title} width="wide" tone="sunken">
    <!-- the anchor sits inside the fold, so a link to it opens the fold, with or without JavaScript -->
    <div id="no-socket" class="el-anchor"></div>
    <p class="lead">{T.noSocket.body}</p>
    <h3 class="el-h3">{T.noSocket.modelsTitle}</h3>
    <p>{T.noSocket.modelsLead}</p>
    <ul class="el-list">
      {run.homeModels.map((m) => (
        <li>
          {fill(T.noSocket.modelLine, { name: readerText(m.name[locale]), maker: readerText(m.brand[locale]), plate: T.result.plate[m.plateClass], price: money(locale, m.listPrice.value), performance: readerText(m.performance.text[locale]) })}{' '}
          <span class="el-small">{fill(T.noSocket.plateNote, { text: readerText(m.plateClassBasis.text[locale]) })}</span>
          {m.plateClassBasis.confidence === 'secondary' && <Tag>{T.result.confidence.secondary}</Tag>}
        </li>
      ))}
    </ul>
    <p>{T.noSocket.swapNote}</p>
    <p><a href={href('/act/', locale)}>{T.noSocket.askLink} →</a></p>
  </Section>

  <!-- Who it adds up for -->
  <Section fold class="el-fold-sec" title={T.who.title} width="wide">
    <!-- the anchor sits inside the fold, so a link to it opens the fold, with or without JavaScript -->
    <div id="who" class="el-anchor"></div>
    <CompareTable
      caption={T.who.caption}
      hideCaption
      numeric={false}
      rowHeader={T.who.rowHeader}
      columns={[{ label: T.who.cols.good, tone: 'clean' }, { label: T.who.cols.bad, tone: 'exhaust' }]}
      rows={T.who.rows.map((r) => ({ label: r.label, values: [r.good, r.bad] }))}
    />
    <p class="el-small">{T.who.note}</p>
    <p><a href="#not-yet">{T.who.youLink} →</a></p>
  </Section>

  <!-- Before you buy -->
  <Section fold class="el-fold-sec" title={T.risks.title} width="wide" tone="sunken">
    <!-- the anchor sits inside the fold, so a link to it opens the fold, with or without JavaScript -->
    <div id="risks" class="el-anchor"></div>
    <ul class="el-facts">
      <li>{T.risks.class}</li>
      <li>
        {fill(T.risks.network, { month: fx['econ-ev-brand-share-2026-07'].period, share: `${nf(share ?? 0, 0)}%` })}
        <EvidenceBadge locale={locale} {...badgeOf('econ-ev-brand-share-2026-07')} variant="icon" />
        <span class="el-small">{factSources('econ-ev-brand-share-2026-07').map((c) => c.short).join(' · ')}</span>
        {' '}{fill(T.risks.stations, { stations: nf(stations ?? 0) })}
        <EvidenceBadge locale={locale} {...badgeOf('econ-gogoro-network')} variant="icon" />
        <span class="el-small">{factSources('econ-gogoro-network').map((c) => c.short).join(' · ')}</span>
        {' '}{fill(T.risks.networkTail, { checked })}
      </li>
      <li>
        <b>{T.risks.finance}</b>{fx['econ-gogoro-finances-2026'].statement} {fx['econ-gogoro-finances-2026'].caveat}
        <EvidenceBadge locale={locale} {...badgeOf('econ-gogoro-finances-2026')} variant="icon" />
        <span class="el-small">{factSources('econ-gogoro-finances-2026').map((c) => c.short).join(' · ')}</span>
      </li>
      <li><b>{T.risks.next}</b>{readerText(data.meta.nextYear[locale])} {T.risks.nextCaveat} {early}</li>
    </ul>
  </Section>

  <!-- Not this year -->
  <Section fold class="el-fold-sec" title={T.notYet.title} lead={T.notYet.lead} width="wide">
    <!-- the anchor sits inside the fold, so a link to it opens the fold, with or without JavaScript -->
    <div id="not-yet" class="el-anchor"></div>
    <ul class="el-cards">
      {T.notYet.items.map((it, i) => (
        <li class="el-card">
          <h3 class="el-card__title">{it.title}</h3>
          <p>{it.body}</p>
          <EvidenceBadge locale={locale} kind={notYetBadge(electric.notYet.items[i].badge)} />
        </li>
      ))}
    </ul>
    <p class="el-actions">
      <Button href={href('/act/#ride', locale)} variant="secondary" arrow>{T.notYet.act}</Button>
    </p>
  </Section>

  <!-- 22 places -->
  <Section fold class="el-fold-sec" title={T.cities.title} lead={T.cities.lead} width="wide" tone="sunken">
    <!-- the anchor sits inside the fold, so a link to it opens the fold, with or without JavaScript -->
    <div id="cities" class="el-anchor"></div>
    <TileMap locale={locale} name="el-city-tile">
      {ids.map((id) => (
        <Fragment slot={id}>
          <Details summary={T.status.statusNote.replace(/[：:]\s*$/, '')}><p class="el-small">{cities[id].statusNote}</p></Details>
          {cities[id].lines.length ? (
            <ul class="el-citylines">
              {cities[id].lines.map((l) => (
                <li>
                  {fill(T.cities.line, { name: l.name, amount: l.amount })} <span class="el-small">({l.side === 'gasoline' ? T.result.side.gasoline : T.result.side.electric}{l.when && `; ${l.when}`})</span>
                  <br /><span class="el-small">{T.cities.quota}{l.quota}</span>
                  {l.excluded && <><br /><span class="el-small">{T.cities.notCountedWhy}{l.excluded}</span></>}
                </li>
              ))}
            </ul>
          ) : (
            <p class="el-small">{T.cities.none}</p>
          )}
          <p class="el-small">{cities[id].links.map((l) => <a href={l.url} rel="noopener" target="_blank">{l.label}</a>)}</p>
        </Fragment>
      ))}
    </TileMap>
    <Details summary={T.cities.centralTitle}>
      <ul class="el-citylines">
        {central.map((l) => (
          <li>
            {fill(T.cities.line, { name: l.name, amount: l.amount })} {l.when && <span class="el-small">({l.when})</span>}
            <br /><span class="el-small">{l.condition}</span>
            {l.excluded && <><br /><span class="el-small">{T.cities.notCountedWhy}{l.excluded}</span></>}
          </li>
        ))}
      </ul>
    </Details>
  </Section>

  <!-- Our asks -->
  <Section fold class="el-fold-sec" title={T.asks.title} lead={T.asks.lead} width="wide">
    <!-- the anchor sits inside the fold, so a link to it opens the fold, with or without JavaScript -->
    <div id="asks" class="el-anchor"></div>
    <ol class="el-list">
      {T.asks.items.map((a) => <li>{fill(a, { deadline })}</li>)}
    </ol>
    <EvidenceBadge locale={locale} kind="inference" />
    <p class="el-actions"><Button href={href('/act/#policy', locale)} variant="secondary" arrow>{T.asks.link}</Button></p>
  </Section>

  <!-- Questions -->
  <Section fold class="el-fold-sec" title={T.faq.title} width="prose" tone="sunken">
    <!-- the anchor sits inside the fold, so a link to it opens the fold, with or without JavaScript -->
    <div id="faq" class="el-anchor"></div>
    {T.faq.items.map((f, i) => (
      <Details summary={f.q} name="el-faq">
        <p>{f.a}</p>
        {i === T.faq.items.length - 1 && (
          <ul class="el-list el-small">
            {run.plans.map((p) => (
              <li>
                <b>{readerText(p.name[locale])}</b>{locale === 'en' ? ': ' : '：'}{readerText(p.terms[locale])}
              </li>
            ))}
          </ul>
        )}
      </Details>
    ))}
  </Section>

  <Section fold class="el-fold-sec" title={T.sources.title} lead={T.sources.lead} width="prose">
    <!-- the anchor sits inside the fold, so a link to it opens the fold, with or without JavaScript -->
    <div id="sources" class="el-anchor"></div>
    <ol class="el-sources">
      {pageSources.map((s) => (
        <li><a href={sourceUrl(s)} rel="noopener" target="_blank">{readerText(formatCitation(s, locale))}</a></li>
      ))}
    </ol>
  </Section>
</Base>

<style is:global>
  /* Reading and touch rules (brief 6.1, 6.3) for the detailed calculator below the opening.
     The result is drawn by script (electric/render.ts), so its rows are styled here. */
  #calc .el-calc-lead,
  #calc .el-live__status,
  #calc .el-asof,
  #calc .el-plan {
    font-size: var(--fs-base);
  }
  #el-live-panel .el-src a,
  #el-live-panel .el-next__links a,
  #status .el-citynote a,
  #calc .el-nosocket a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
    /* 8 px from the next link, also on the next line (brief 6.3) */
    margin-block: 0.25rem;
    margin-inline-end: 0.5rem;
  }
  #calc .el-num {
    font-size: var(--fs-base);
  }
  #el-live-panel .el-next__links a {
    color: var(--ink);
  }
  #el-live-panel .el-jump {
    gap: 0.5rem;
  }
  #el-live-panel .el-jump a,
  #el-live-panel .el-row__more > summary {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
    min-inline-size: var(--tap);
    justify-content: center;
  }
  /* a select sizes itself to its longest option; in a one-column grid that pushed the opening
     past a 320 px screen at the largest text size */
  .el-head .op :is(.op-grid, .op-county) {
    grid-template-columns: minmax(0, 1fr);
