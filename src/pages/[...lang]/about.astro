---
/**
 * /about/ — 關於 / About (redesign brief 7.8).
 *
 *   #who          who made the site (the owner's own words: components/pages/action/owner.ts)
 *   #chips        the five chips, with their shapes (KindChip) and what each means
 *   #estimate     K1; 本站沒有自己去量；我們推估，並把算法攤開; a link to /estimate/
 *   #rules        the wording table and the editorial rules (brief 4.2, 4.6); the promise
 *   #method       how the evidence was gathered and checked; the levels of checking
 *   #update       how subsidy figures date
 *   #report       error reports go to the owner's X account
 *   #corrections  the corrections log, newest first, linked from the footer
 *
 * Contact (beyond X), licence and funding sections are left out until the owner supplies them.
 * Copy: src/i18n/pages/about.ts. Dates and the corrections' wording come from the data.
 */
import Base from '@/layouts/Base.astro';
import Section from '@/components/ui/Section.astro';
import CompareTable from '@/components/ui/CompareTable.astro';
import Details from '@/components/ui/Details.astro';
import KindChip from '@/components/ui/KindChip.astro';
import Icon from '@/components/ui/Icon.astro';
import Phrased from '@/components/ui/Phrased.astro';
import Claim from '@/components/pages/action/Claim.astro';
import { lf, rule } from '@/components/pages/action/ev';
import { corrections } from '@/components/pages/action/corrections';
import { OWNER } from '@/components/pages/action/owner';
import { href, localeFromParam, localeStaticPaths } from '@/i18n';
import { chips, kSentences, readerText } from '@/i18n/ui';
import { confidenceLabels, readerKinds, type FactId } from '@/data';
import { formatDate, snapshot, STALE_DAYS } from '@/lib/site-state.data';
import about from '@/i18n/pages/about';
import { fill, localize } from '@/i18n/pages/_copy';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const t = localize(about, locale);

const claims = t.corrections.claims as Record<string, string>;
const ownInstead = t.corrections.ownInstead as Record<string, string>;
const ownWhy = t.corrections.ownWhy as Record<string, string>;
const log = corrections
  .map((c) => {
    if ('own' in c) return { key: c.key, date: c.date, said: claims[c.key], instead: ownInstead[c.key], why: ownWhy[c.key], facts: c.facts, own: true };
    const r = rule(c.rule, locale);
    const facts = (c.facts ?? r.facts) as FactId[];
    return { key: c.key, date: c.date, said: claims[c.key], instead: r.instead ?? lf(facts[0], locale).statement, why: r.why, facts, own: false };
  })
  .sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));
---

<Base locale={locale} title={t.meta.title} description={t.meta.description} share="home">
  <Section id="about" pad="normal" width="wide" class="ab-hero">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1 class="display"><Phrased text={t.hero.title} /></h1>
    <p class="ab-lead">{t.hero.deck}</p>
    <nav class="toc" aria-label={t.hero.toc}>
      <ul>
        {about.toc.map((x) => <li><a href={`#${x.id}`}>{x.label[locale]}</a></li>)}
      </ul>
    </nav>
  </Section>

  <!-- ===================================================== WHO -->
  <Section id="who" width="wide" pad="tight">
    <div class="maker">
      <h2 class="maker__t">{t.owner.title}</h2>
      <p class="maker__body">
        {t.owner.madeBy}<a href={OWNER.url} rel="me noopener">{OWNER.handle}</a>{t.owner.onX}
      </p>
    </div>
  </Section>

  <!-- ===================================================== CHIPS -->
  <Section id="chips" eyebrow={t.chips.eyebrow} title={t.chips.title} lead={t.chips.lead} width="wide" rule>
    <dl class="chips">
      {readerKinds.map((k) => (
        <div class="chips__row">
          <dt><KindChip locale={locale} kind={k} /></dt>
          <dd>{chips[k].help[locale]}</dd>
        </div>
      ))}
    </dl>
    <p class="ab-p ab-quiet">{t.chips.market}</p>
  </Section>

  <!-- ===================================================== ESTIMATE -->
  <Section id="estimate" eyebrow={t.estimate.eyebrow} title={t.estimate.title} width="wide" tone="sunken" rule>
    <div class="prose">
      <p class="ab-p ab-k1">{kSentences.K1[locale]}</p>
      <p class="ab-p">{t.estimate.p1}</p>
      <p><a class="ab-btn" href={href('/estimate/', locale)}>{t.estimate.link}<Icon name="arrow-right" size="1.05em" /></a></p>
    </div>
  </Section>

  <!-- ===================================================== RULES -->
  <Section id="rules" eyebrow={t.rules.eyebrow} title={t.rules.title} lead={t.rules.lead} width="wide" rule>
    <h3 class="rules__t">{t.rules.tableCaption}</h3>
    <CompareTable
      caption={t.rules.tableCaption}
      hideCaption
      rowHeader={t.rules.colKind}
      columns={[{ label: t.rules.colWrite, tone: 'clean' }, { label: t.rules.colNever, tone: 'exhaust' }]}
      rows={t.rules.verbs.map((v) => ({ label: v.kind, values: [v.write, v.never] }))}
      numeric={false}
    />
    <ol class="rules">
      {t.rules.list.map((x) => <li>{x}</li>)}
    </ol>
    <h3 class="rules__t">{t.rules.promiseTitle}</h3>
    <p class="ab-p ab-pledge">{t.rules.pledge}</p>
  </Section>

  <!-- ===================================================== METHOD -->
  <Section id="method" eyebrow={t.method.eyebrow} title={t.method.title} width="wide" tone="sunken" rule>
    <div class="prose">
      <p class="ab-p">{t.method.p1}</p>
      <p class="ab-p">{t.method.p2}</p>
      <p class="ab-p">{t.method.levels}</p>
      <dl class="levels">
        {(['verified', 'secondary'] as const).map((k) => (
          <div>
            <dt>{readerText(confidenceLabels[k].label[locale])}</dt>
            <dd>{readerText(confidenceLabels[k].description[locale])}</dd>
          </div>
        ))}
      </dl>
      <p class="ab-quiet">{fill(t.method.checked, { money: formatDate(snapshot.checkedOn, locale, true) })}</p>
      <p><a class="ab-btn" href={href('/sources/', locale)}>{t.method.sources}<Icon name="arrow-right" size="1.05em" /></a></p>
    </div>
  </Section>

  <!-- ===================================================== UPDATE -->
  <Section id="update" eyebrow={t.update.eyebrow} title={t.update.title} width="wide">
    <p class="prose ab-p">{fill(t.update.body, { days: STALE_DAYS, deadline: formatDate(snapshot.yearEnd, locale, true) })}</p>
  </Section>

  <!-- ===================================================== REPORT -->
  <Section id="report" eyebrow={t.report.eyebrow} title={t.report.title} width="wide" tone="sunken" rule>
    <p class="prose ab-p">{t.report.body}</p>
    <p class="contact">{t.report.contact}<a href={OWNER.url} rel="noopener">{OWNER.handle}</a></p>
  </Section>

  <!-- ===================================================== CORRECTIONS -->
  <Section id="corrections" eyebrow={t.corrections.eyebrow} title={t.corrections.title} lead={t.corrections.lead} width="wide" rule>
    <ol class="log">
      {
        log.map((e) => (
          <li class="log__item" id={`correction-${e.key}`}>
            <p class="log__meta">
              <time datetime={e.date}>{formatDate(e.date, locale, true)}</time>
              <span class="log__own">{e.own ? t.corrections.ours : t.corrections.common}</span>
            </p>
            <p class="log__said">
              <span class="log__l">{t.corrections.said}</span>
              <span class="vh">{t.corrections.saidSr}</span>
              <s>{e.said}</s>
            </p>
            <p class="log__instead">
              <span class="log__l">{t.corrections.instead}</span>
              {e.instead}
            </p>
            <Details summary={`${t.corrections.why} · ${t.corrections.basis}`}>
              <div class="log__why">
                <p>{e.why}</p>
                {e.facts.map((f) => <Claim locale={locale} facts={[f]} size="sm" />)}
              </div>
            </Details>
          </li>
        ))
      }
    </ol>
  </Section>
</Base>

<style>
  .ab-hero :global(.display) {
    margin-block: var(--sp-2) var(--sp-4);
  }
  .ab-lead,
  .ab-p {
    font-size: var(--fs-base);
    line-height: var(--lh-read, 1.6);
    max-inline-size: 42rem;
  }
  .ab-lead {
    margin: 0;
  }
  .ab-quiet {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .ab-k1 {
    font-weight: var(--fw-bold);
  }
  .ab-pledge {
    font-weight: var(--fw-bold);
    padding-inline-start: var(--sp-3);
    border-inline-start: 6px solid var(--clean);
  }
  .ab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-block-size: var(--tap, 3rem);
    padding: 0 var(--sp-3);
    border: 2px solid var(--ink);
    border-radius: var(--radius-2);
    color: var(--ink);
    font-size: var(--fs-btn, 1.0625rem);
    font-weight: var(--fw-bold);
    text-decoration: none;
  }
  .ab-btn:hover {
    background: var(--bg-sunken);
  }
  .toc ul {
    list-style: none;
    margin: var(--sp-5) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--tap-gap, 0.5rem);
  }
  .toc a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap, 3rem);
    padding: 0 var(--sp-3);
    border: 2px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--fs-btn, 1.0625rem);
    font-weight: var(--fw-bold);
    color: var(--ink);
    text-decoration: none;
  }
  .maker {
    display: grid;
    gap: var(--sp-2);
    padding-block: var(--sp-4);
    border-block: 1px solid var(--line);
  }
  .maker__t {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .maker__body {
    margin: 0;
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
  }
  .maker__body a,
  .contact a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap, 3rem);
  }
  .chips {
    margin: 0;
    display: grid;
    gap: var(--sp-3);
    max-inline-size: 42rem;
  }
  .chips__row {
    display: grid;
    gap: var(--sp-1) var(--sp-4);
    grid-template-columns: minmax(0, 1fr);
    padding-block-end: var(--sp-3);
    border-block-end: 1px solid var(--line);
  }
  @media (min-width: 36em) {
    .chips__row {
      grid-template-columns: 9rem minmax(0, 1fr);
      align-items: baseline;
    }
  }
  .chips dt {
    margin: 0;
  }
  .chips dd {
    margin: 0;
    font-size: var(--fs-base);
    line-height: var(--lh-read, 1.6);
  }
  .levels {
    display: grid;
    gap: var(--sp-2);
  }
  .levels dt {
    font-weight: var(--fw-bold);
  }
  .levels dd {
    margin: 0;
    color: var(--ink-2);
  }
  .rules {
    margin-block: var(--sp-6);
    padding-inline-start: 1.5em;
    display: grid;
    gap: var(--sp-3);
    max-inline-size: 42rem;
    font-size: var(--fs-base);
    line-height: var(--lh-read, 1.6);
  }
  .rules__t {
    font-size: var(--fs-lg);
    margin: 0 0 var(--sp-3);
  }
  .contact {
    margin-block-start: var(--sp-4);
    font-weight: var(--fw-bold);
    font-size: var(--fs-base);
  }
  .log {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
  }
  .log__item {
    display: grid;
    gap: var(--sp-2);
    padding-block-start: var(--sp-3);
    border-block-start: 2px solid var(--line-strong);
  }
  .log__item p {
    margin: 0;
  }
  .log__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .log__own {
    font-weight: var(--fw-bold);
  }
  .log__l {
    display: block;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .log__said,
  .log__instead {
    font-size: var(--fs-base);
    line-height: var(--lh-read, 1.6);
  }
  .log__said s {
    text-decoration-thickness: 2px;
  }
  .log__instead {
    font-weight: var(--fw-bold);
  }
  .log__why {
    display: grid;
    gap: var(--sp-3);
    font-size: var(--fs-base);
  }
</style>
