---
/**
 * /about/ — 關於 / About (blueprint 4.9; Appendix B item 1).
 *
 *   #who          who made the site (components/pages/action/owner.ts)
 *   #what         what the site is and is not; the scene is illustration, the charts are data
 *   #method       how the evidence was gathered and checked, including the automated part
 *   #badges       the eight evidence badges and how each is drawn on the chain
 *   #rules        the wording rules, the promise to publish any result, what would change our mind
 *   #update       how subsidy figures date
 *   #report       how to report an error
 *   #corrections  the corrections log, linked from the footer
 *
 * Copy: src/i18n/pages/about.ts. Counts, dates and the corrections' wording come from the data.
 */
import Base from '@/layouts/Base.astro';
import Section from '@/components/ui/Section.astro';
import CompareTable from '@/components/ui/CompareTable.astro';
import Details from '@/components/ui/Details.astro';
import EvidenceLegend from '@/components/ui/EvidenceLegend.astro';
import Icon from '@/components/ui/Icon.astro';
import Phrased from '@/components/ui/Phrased.astro';
import PullQuote from '@/components/ui/PullQuote.astro';
import StanceBox from '@/components/ui/StanceBox.astro';
import Claim from '@/components/pages/action/Claim.astro';
import { lf, rule } from '@/components/pages/action/ev';
import { corrections } from '@/components/pages/action/corrections';
import { OWNER, warnIfPlaceholder } from '@/components/pages/action/owner';
import { href, localeFromParam, localeStaticPaths } from '@/i18n';
import { readerText } from '@/i18n/ui';
import { confidenceLabels, factList, gapList, sourceIds, type FactId } from '@/data';
import { formatDate, snapshot, STALE_DAYS } from '@/lib/site-state.data';
import about from '@/i18n/pages/about';
import { fill, localize } from '@/i18n/pages/_copy';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const t = localize(about, locale);
warnIfPlaceholder();

const evidenceChecked = gapList.map((g) => g.searchedOn).sort().at(-1)!;
const counts = { sources: sourceIds.length, facts: factList.length, gaps: gapList.length };
const pm25 = lf('teds13-mc-pm25-share', locale);

const claims = t.corrections.claims as Record<string, string>;
const ownInstead = t.corrections.ownInstead as Record<string, string>;
const ownWhy = t.corrections.ownWhy as Record<string, string>;
const log = corrections.map((c) => {
  if ('own' in c) return { key: c.key, date: c.date, said: claims[c.key], instead: ownInstead[c.key], why: ownWhy[c.key], facts: c.facts, own: true };
  const r = rule(c.rule, locale);
  const facts = (c.facts ?? r.facts) as FactId[];
  return { key: c.key, date: c.date, said: claims[c.key], instead: r.instead ?? lf(facts[0], locale).statement, why: r.why, facts, own: false };
});
---

<Base locale={locale} title={t.meta.title} description={t.meta.description} share="home">
  <Section id="about" pad="normal" width="wide" class="ab-hero">
    <p class="eyebrow">{t.hero.eyebrow}</p>
    <h1 class="display"><Phrased text={t.hero.title} /></h1>
    <p class="lead">{t.hero.deck}</p>
    <nav class="toc" aria-label={t.hero.toc}>
      <ul>
        {about.toc.map((x) => <li><a href={`#${x.id}`}>{x.label[locale]}</a></li>)}
      </ul>
    </nav>
  </Section>

  <!-- ===================================================== WHO -->
  <Section id="who" width="wide" pad="tight">
    <div class="maker">
      <h2 class="maker__t">{t.owner.title}</h2>
      <p class="maker__body">
        {t.owner.madeBy}<a href={OWNER.url} rel="me noopener">{OWNER.handle}</a>{t.owner.onX}
      </p>
    </div>
  </Section>

  <!-- ===================================================== WHAT -->
  <Section id="what" eyebrow={t.what.eyebrow} title={t.what.title} width="wide" rule>
    <div class="isnot">
      <div>
        <h3 class="isnot__t">{t.what.isTitle}</h3>
        <ul class="isnot__list isnot__list--is">{t.what.is.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div>
        <h3 class="isnot__t">{t.what.isNotTitle}</h3>
        <ul class="isnot__list isnot__list--not">{t.what.isNot.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
    <p class="scene-rule">{t.what.scene}</p>
  </Section>

  <!-- ===================================================== METHOD -->
  <Section id="method" eyebrow={t.method.eyebrow} title={t.method.title} width="wide" tone="sunken" rule>
    <div class="prose">
      <p>{t.method.p1}</p>
      <p>{t.method.p2}</p>
      <p>{t.method.p3}</p>
      <p><b>{fill(t.method.counts, counts)}</b></p>
      <p>{t.method.levels}</p>
      <dl class="levels">
        {(['verified', 'secondary'] as const).map((k) => (
          <div>
            <dt>{readerText(confidenceLabels[k].label[locale])}</dt>
            <dd>{readerText(confidenceLabels[k].description[locale])}</dd>
          </div>
        ))}
      </dl>
      <p class="meta">{fill(t.method.checked, { evidence: formatDate(evidenceChecked, locale, true), money: formatDate(snapshot.checkedOn, locale, true) })}</p>
      <p><a href={href('/sources/', locale)}>{t.method.sources}<Icon name="arrow-right" size="1.05em" /></a></p>
    </div>
  </Section>

  <!-- ===================================================== BADGES -->
  <Section id="badges" eyebrow={t.badges.eyebrow} title={t.badges.title} lead={t.badges.lead} width="wide" rule>
    <EvidenceLegend locale={locale} lines />
  </Section>

  <!-- ===================================================== RULES -->
  <Section id="rules" eyebrow={t.rules.eyebrow} title={t.rules.title} lead={t.rules.lead} width="wide" tone="sunken" rule>
    <h3 class="rules__t">{t.rules.tableCaption}</h3>
    <CompareTable
      caption={t.rules.tableCaption}
      hideCaption
      rowHeader={t.rules.colKind}
      columns={[{ label: t.rules.colWrite, tone: 'clean' }, { label: t.rules.colNever, tone: 'exhaust' }]}
      rows={t.rules.verbs.map((v) => ({ label: v.kind, values: [v.write, v.never] }))}
      numeric={false}
    />
    <ol class="rules">
      {t.rules.list.map((x, i) => (
        <li>
          {x}
          {i === 3 && <Claim locale={locale} text={fill(t.rules.against, { share: pm25.display })} facts={['teds13-mc-pm25-share']} size="sm" />}
        </li>
      ))}
    </ol>
    <h3 class="rules__t">{t.rules.promiseTitle}</h3>
    <div class="promise">
      <PullQuote tone="clean">{t.rules.pledge}</PullQuote>
      <StanceBox locale={locale} kind="change-mind">{t.rules.changeMind}</StanceBox>
    </div>
  </Section>

  <!-- ===================================================== UPDATE -->
  <Section id="update" eyebrow={t.update.eyebrow} title={t.update.title} width="wide">
    <p class="prose">{fill(t.update.body, { days: STALE_DAYS, deadline: formatDate(snapshot.yearEnd, locale, true) })}</p>
  </Section>

  <!-- ===================================================== REPORT -->
  <Section id="report" eyebrow={t.report.eyebrow} title={t.report.title} width="wide" tone="sunken" rule>
    <p class="prose">{t.report.body}</p>
    <p class="contact">{t.report.contact}<a href={OWNER.url} rel="noopener">{OWNER.handle}</a></p>
  </Section>

  <!-- ===================================================== CORRECTIONS -->
  <Section id="corrections" eyebrow={t.corrections.eyebrow} title={t.corrections.title} lead={t.corrections.lead} width="wide" rule>
    <ol class="log">
      {
        log.map((e) => (
          <li class="log__item" id={`correction-${e.key}`}>
            <p class="log__meta">
              <time datetime={e.date}>{formatDate(e.date, locale, true)}</time>
              {e.own && <span class="log__own">{t.corrections.ours}</span>}
            </p>
            <p class="log__said">
              <span class="log__l">{t.corrections.said}</span>
              <span class="vh">{t.corrections.saidSr}</span>
              <s>{e.said}</s>
            </p>
            <p class="log__instead">
              <span class="log__l">{t.corrections.instead}</span>
              {e.instead}
            </p>
            <Details summary={`${t.corrections.why} · ${t.corrections.basis}`}>
              <div class="log__why">
                <p>{e.why}</p>
                {e.facts.map((f) => <Claim locale={locale} facts={[f]} size="sm" />)}
              </div>
            </Details>
          </li>
        ))
      }
    </ol>
  </Section>
</Base>

<style>
  .ab-hero :global(.display) {
    margin-block: var(--sp-2) var(--sp-4);
  }
  .toc ul {
    list-style: none;
    margin: var(--sp-5) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  .toc a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding: var(--sp-1) var(--sp-3);
    border: 2px solid var(--line-strong);
    border-radius: var(--radius-pill);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--ink);
    text-decoration: none;
  }
  .maker {
    display: grid;
    gap: var(--sp-2);
    padding-block: var(--sp-4);
    border-block: 1px solid var(--line);
  }
  .maker__t {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .maker__body {
    font-size: var(--fs-xl);
    font-weight: var(--fw-bold);
  }
  .maker__body a,
  .contact a {
    display: inline-block;
    padding-block: 0.6em;
  }
  .isnot {
    display: grid;
    gap: var(--sp-5);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .isnot__t {
    margin: 0 0 var(--sp-2);
    font-size: var(--fs-lg);
  }
  .isnot__list {
    margin: 0;
    padding-inline-start: 1.3em;
    display: grid;
    gap: var(--sp-2);
  }
  .isnot__list--not li::marker {
    content: '× ';
    color: var(--signal-red-ink);
  }
  .scene-rule {
    margin-block-start: var(--sp-5);
    max-inline-size: 44rem;
    padding-inline-start: var(--sp-3);
    border-inline-start: var(--rule-paint) solid var(--ink);
  }
  .levels {
    display: grid;
    gap: var(--sp-2);
  }
  .levels dt {
    font-weight: var(--fw-bold);
  }
  .levels dd {
    margin: 0;
    color: var(--ink-2);
  }
  .rules {
    margin-block: var(--sp-6);
    padding-inline-start: 1.5em;
    display: grid;
    gap: var(--sp-3);
    max-inline-size: 44rem;
  }
  .rules li :global(.claim) {
    margin-block-start: var(--sp-2);
  }
  .promise {
    display: grid;
    gap: var(--sp-5);
  }
  .rules__t {
    font-size: var(--fs-lg);
    margin: 0 0 var(--sp-3);
  }
  .contact {
    margin-block-start: var(--sp-4);
    font-weight: var(--fw-bold);
  }
  .log {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-4);
  }
  .log__item {
    display: grid;
    gap: var(--sp-2);
    padding-block-start: var(--sp-3);
    border-block-start: 2px solid var(--line-strong);
  }
  .log__item p {
    margin: 0;
  }
  .log__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    font-size: var(--fs-xs);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .log__own {
    font-weight: var(--fw-bold);
  }
  .log__l {
    display: block;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .log__said s {
    text-decoration-thickness: 2px;
  }
  .log__instead {
    font-weight: var(--fw-bold);
  }
  .log__why {
    display: grid;
    gap: var(--sp-3);
    font-size: var(--fs-sm);
  }
</style>
