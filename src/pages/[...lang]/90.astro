---
/**
 * /90/ — the film (redesign brief, section 8). Menu name 短片 / Film. The address stays /90/
 * because it has been shared.
 *
 * Copy: src/i18n/pages/film.ts. The clock: src/components/pages/film/timeline.ts. The picture:
 * scene.ts. The page (player, stills, transcript, sheets): Film.astro.
 * Its share card is lane J's (`share="film"`: src/lib/share-cards.ts). The vertical MP4 is
 * rendered from this same page by scripts/film-export.mjs into public/film/.
 */
import Base from '@/layouts/Base.astro';
import Film from '@/components/pages/film/Film.astro';
import { localeFromParam, localeStaticPaths } from '@/i18n';
import { localize } from '@/i18n/pages/_copy';
import film from '@/i18n/pages/film';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const t = localize(film, locale);
---

<Base locale={locale} title={t.meta.title} description={t.meta.description} share="film">
  <Fragment slot="head">
    <script is:inline>
      // Before first paint: lay the film out as a stage, unless the reader asked for less motion
      // (the system setting, or the 動畫 switch in the menu). If the player script never arrives,
      // fall back to the frames laid out in order.
      (function () {
        var d = document.documentElement;
        try {
          var m = d.getAttribute('data-motion');
          var exporting = /[?&]export\b/.test(location.search);
          if (!exporting && (m === 'off' || (m !== 'on' && window.matchMedia('(prefers-reduced-motion: reduce)').matches))) return;
          d.classList.add('film-live');
          if (exporting) d.classList.add('film-export');
          setTimeout(function () {
            if (!d.hasAttribute('data-film-ready')) d.classList.remove('film-live');
          }, 8000);
        } catch (e) {}
      })();
    </script>
  </Fragment>
  <Film locale={locale} />
</Base>
