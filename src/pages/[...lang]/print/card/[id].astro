---
/**
 * /print/card/<id>/ — one share card laid out as a page, for scripts/build-share-cards.mjs to
 * photograph at 1200 × 630 (the og:image). Never in the production build: getStaticPaths
 * returns nothing unless SA_SHARE_CARDS=1 (the generator sets it for its own scratch build).
 *
 * A poster seen at thumbnail size (brief 7.9): one picture that fills the card, one short
 * headline in the headline face, and the 示意圖 plate, large enough to read in a chat preview.
 * No site name: in a preview it was a speck, and the chat already shows where the link goes. The picture
 * is a composition of src/components/art/card-art.ts, drawn with the scenes' own figures and
 * the one air rule; its layout puts the headline and the people inside the central square
 * (LINE crops to it) and keeps everything 60 px from the edges. The generator shrinks the
 * headline until it fits its box.
 *
 * Words: src/lib/share-cards.ts (shareCardContent) and src/i18n/pages/share.ts.
 */
import PrintPage from '@/components/pages/action/PrintPage.astro';
import Phrased from '@/components/ui/Phrased.astro';
import { localeFromParam, localeStaticPaths } from '@/i18n';
import { est } from '@/data/estimate';
import { fact } from '@/data/facts';
import { CARD, cardArt } from '@/components/art/card-art';
import { shareCardContent, shareCardIds, type ShareCardId } from '@/lib/share-cards';

export function getStaticPaths() {
  if (process.env.SA_SHARE_CARDS !== '1') return [];
  return localeStaticPaths().flatMap((l) => shareCardIds.map((id) => ({ params: { lang: l.params.lang, id } })));
}
const locale = localeFromParam(Astro.params.lang);
const id = Astro.params.id as ShareCardId;
const c = shareCardContent(id, locale);

const station = fact('taipei-roadside-co-2024').data as Record<string, { value: number; unit: string }>;
const art = cardArt(c.art, { inlet: { lo: station.inletLow.value, hi: station.inletHigh.value }, red: est.signal.redLength_s });
const { head, tag } = art.layout;
const box = `${art.box.x} ${art.box.y} ${art.box.w} ${art.box.h}`;
const headStyle = `left:${head.x}px;top:${head.y}px;width:${head.w}px;height:${head.h}px;--align:${head.align}`;
const tagStyle = tag.end ? `right:${CARD.w - tag.x}px;top:${tag.y}px` : `left:${tag.x}px;top:${tag.y}px`;
---

<PrintPage locale={locale} title={c.title.replaceAll('|', '')} canonical={false} bare>
  <div class="card" data-card={id} data-art={c.art} style="--k:1">
    <svg class="card__art" viewBox={box} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false" data-air-scn="dozen" set:html={art.svg} />
    <div class="card__veil" style={`left:${head.x - 140}px;width:${head.w + 280}px;height:${head.y + head.h + 40}px`}></div>
    <div class="card__head" style={headStyle}>
      <h1 class="card__title"><Phrased text={c.title} locale={locale} /></h1>
    </div>
    {
      art.play && (
        <span class="card__play" style={`left:${art.play.x - art.play.r}px;top:${art.play.y - art.play.r}px;width:${art.play.r * 2}px;height:${art.play.r * 2}px`} aria-hidden="true">
          <svg viewBox="0 0 40 40">
            <path d="M15,11 L30,20 L15,29 Z" />
          </svg>
        </span>
      )
    }
    <p class="card__tag" style={tagStyle}>{c.tag}</p>
  </div>
</PrintPage>

<style is:global>
  html.print-page--bare,
  html.print-page--bare body {
    margin: 0;
    overflow: hidden;
    background: var(--art-fill);
  }
  .card {
    position: relative;
    inline-size: 1200px;
    block-size: 630px;
    overflow: hidden;
    background: var(--art-fill);
    color: var(--ink);
    --here: var(--art-fill);
  }
  .card p,
  .card h1 {
    margin: 0;
  }
  .card__art {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }
  /* the wall behind the headline fades to paper, so the words stand clear of the shopfront lines */
  .card__veil {
    position: absolute;
    top: 0;
    background: radial-gradient(farthest-side at 50% 35%, var(--art-fill) 0, color-mix(in srgb, var(--art-fill) 90%, transparent) 55%, transparent 100%);
  }
  .card__head {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: var(--align);
    text-align: var(--align);
    gap: calc(10px * var(--k));
    box-sizing: border-box;
  }
  .card__title {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: calc(96px * var(--k));
    line-height: 1.08;
    letter-spacing: 0.01em;
    color: var(--ink);
    text-wrap: balance;
    /* a paper glow, so a stroke of the drawing never cuts a letter */
    text-shadow:
      0 0 6px var(--art-fill),
      0 0 14px var(--art-fill);
  }
  .card__title:lang(en) {
    font-stretch: var(--display-stretch);
    font-size: calc(104px * var(--k));
    line-height: 0.98;
    letter-spacing: 0;
  }
  /* one phrase to a line: a headline is two phrases at most, set as large as its box allows */
  .card__title .phrase {
    display: block;
    /* a phrase never wraps inside itself: the generator shrinks the headline until each fits */
    white-space: nowrap;
  }
  .card__tag {
    position: absolute;
    box-sizing: border-box;
    block-size: 58px;
    padding: 6px 16px;
    font-size: 38px;
    font-weight: 800;
    line-height: 46px;
    color: var(--ink);
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    border: 2px solid var(--ink);
    border-radius: 10px;
  }
  .card__play {
    position: absolute;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--signal-red-led, #e0402f);
    box-shadow:
      0 0 0 8px color-mix(in srgb, var(--bg) 80%, transparent),
      0 10px 30px rgb(0 0 0 / 0.25);
  }
  .card__play svg {
    inline-size: 62%;
    block-size: 62%;
    fill: #fff;
  }
</style>
