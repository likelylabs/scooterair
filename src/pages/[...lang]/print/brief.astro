---
/**
 * /print/brief/ — 一頁說明 / the one-page brief for a borough chief or a councillor (brief 7.9).
 *
 * One A4 page: G4 (the kerb, dozen) with what the street holds and what the pack adds; G5
 * (measured beside estimated, with the zoom-out strip, headline chosen by the written rule);
 * the numbers table of /estimate/#numbers (three scenarios × carbon monoxide, benzene, PM2.5);
 * G8 with home screen 8's sentence; K1; the ask and the promise; short references.
 * Light tokens on paper and no site chrome (PrintPage).
 *
 * Copy: src/i18n/pages/act.ts (`brief`). Numbers: src/data/estimate.ts.
 */
import PrintPage from '@/components/pages/action/PrintPage.astro';
import Picture from '@/components/pages/action/Picture.astro';
import CheckChart from '@/components/pages/action/CheckChart.astro';
import Phrased from '@/components/ui/Phrased.astro';
import KindChip from '@/components/ui/KindChip.astro';
import EstimateValue from '@/components/ui/EstimateValue.astro';
import { href, localeFromParam, localeStaticPaths } from '@/i18n';
import { kSentences, site } from '@/i18n/ui';
import { checkHeadline, est, estimateText, farBelowWho, formatEstimate, formatReference, scenarioKeys } from '@/data/estimate';
import act from '@/i18n/pages/act';
import { fill, localize } from '@/i18n/pages/_copy';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const t = localize(act, locale);
const b = t.brief;
const estimatePage = new URL(href('/estimate/', locale), Astro.site).href;
const shortUrl = estimatePage.replace(/^https?:\/\//, '');
const child = formatEstimate('child.airPerKg', locale);
const pollutants = [
  { key: 'co', name: b.co, street: formatReference(est.bg.co.traffic.shown, 'ppm', locale), conf: est.confidence.co.word[locale] },
  { key: 'benzene', name: b.benzene, street: `${locale === 'en' ? 'about' : '約'} ${est.bg.benzene.lo}${locale === 'en' ? ' to ' : ' 到 '}${est.bg.benzene.hi} ppb`, conf: est.confidence.benzene.word[locale] },
  { key: 'pm25', name: b.pm25, street: formatReference(est.bg.pm25.shown, 'ug/m3', locale), conf: est.confidence.pm25.word[locale] },
] as const;
---

<PrintPage locale={locale} title={b.metaTitle} description={b.metaDescription}>
  <div class="toolbar">
    <p>{b.screenNote}</p>
    <p class="toolbar__row">
      <button type="button" class="toolbar__btn" data-print hidden>{b.printButton}</button>
      <a class="toolbar__link" href={href('/act/#policy', locale)}>{b.back}</a>
    </p>
  </div>

  <article class="sheet" aria-labelledby="brief-t">
    <header class="sheet__head">
      <p class="sheet__kicker">{b.kicker}</p>
      <h1 id="brief-t" class="sheet__title"><Phrased text={b.title} /></h1>
    </header>

    <div class="sheet__cols">
      <div class="sheet__col">
        <section class="blk">
          <h2 class="blk__h">{b.kerbHead}</h2>
          <Picture locale={locale} kind="kerb" scenario="dozen" />
          <div class="kv">
            <p class="kv__row"><span class="kv__k">{estimateText.alreadyThere[locale]}</span><span class="kv__v">{formatReference(est.bg.co.traffic.shown, 'ppm', locale)}</span><KindChip locale={locale} kind="measured" size="sm" /></p>
            <div class="kv__row"><span class="kv__k">{estimateText.addedByPack[locale]}</span><EstimateValue locale={locale} slotId="co.dozen.add" /></div>
            <p class="kv__note">{estimateText.ppmGloss[locale]}</p>
          </div>
        </section>

        <section class="blk">
          <h2 class="blk__h">{checkHeadline(locale)}</h2>
          {farBelowWho() && <p class="blk__p">{fill(b.checkLead, { sites: est.meas.iot.sites.value })}</p>}
          <CheckChart locale={locale} />
        </section>
      </div>

      <div class="sheet__col">
        <section class="blk">
          <h2 class="blk__h">{b.tableHead}</h2>
          <table class="nt">
            <thead>
              <tr>
                <th scope="col">{b.tableScenario}</th>
                {pollutants.map((p) => <th scope="col">{p.name}</th>)}
              </tr>
            </thead>
            <tbody>
              {scenarioKeys.map((s) => (
                <tr>
                  <th scope="row">
                    {est.scn[s].name[locale]}
                    <span class="nt__sub">{est.scn[s].count.lo}–{est.scn[s].count.hi}</span>
                  </th>
                  {pollutants.map((p) => (
                    <td>
                      <EstimateValue locale={locale} slotId={`${p.key}.${s}.add`} />
                    </td>
                  ))}
                </tr>
              ))}
              <tr class="nt__street">
                <th scope="row">{b.tableStreet} <KindChip locale={locale} kind="measured" size="sm" /></th>
                {pollutants.map((p) => <td>{p.street}</td>)}
              </tr>
              <tr class="nt__conf">
                <th scope="row">{b.tableConfidence}</th>
                {pollutants.map((p) => <td>{p.conf}</td>)}
              </tr>
            </tbody>
          </table>
          <p class="blk__small">{b.tableNote}</p>
        </section>

        <section class="blk">
          <h2 class="blk__h">{b.heightsHead}</h2>
          <Picture locale={locale} kind="heights" />
          <p class="blk__p">
            {fill(b.heightsBody, { lo: child.lo, hi: child.hi })}
            <KindChip locale={locale} kind="study" size="sm" />
          </p>
        </section>

        <section class="blk blk--ask">
          <p class="blk__k1">{kSentences.K1[locale]}</p>
          <h2 class="blk__h">{b.askHead}</h2>
          <p class="blk__ask">{b.ask}</p>
          <p class="blk__p">{b.promise}</p>
        </section>
      </div>
    </div>

    <footer class="sheet__foot">
      <p>{fill(b.refs, { stamp: est.meta.stamp[locale] })}</p>
      <p>{b.more} <span class="sheet__url">{shortUrl}</span></p>
      <p><b>{site.name[locale]}</b> · {site.tagline[locale]}</p>
    </footer>
  </article>
</PrintPage>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-print]');
  if (btn) {
    btn.hidden = false;
    btn.addEventListener('click', () => window.print());
  }
</script>

<style>
  .toolbar {
    box-sizing: border-box;
    inline-size: min(210mm, calc(100% - 2 * var(--gutter, 16px)));
    margin: 0 auto;
    padding-block: var(--sp-5) var(--sp-4);
    display: grid;
    gap: var(--sp-3);
    font-size: var(--fs-base);
  }
  .toolbar p {
    margin: 0;
  }
  .toolbar__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    align-items: center;
  }
  .toolbar__btn,
  .toolbar__link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap, 3rem);
    padding: 0 var(--sp-4);
    border: 2px solid var(--ink);
    border-radius: var(--radius-2);
    font: inherit;
    font-size: var(--fs-btn, 1.0625rem);
    font-weight: var(--fw-bold);
    color: var(--ink);
    background: var(--surface);
    text-decoration: none;
    cursor: pointer;
  }
  .toolbar__btn {
    background: var(--ink);
    color: var(--bg);
  }

  .sheet {
    --here: #fff;
    box-sizing: border-box;
    inline-size: min(210mm, calc(100% - 2 * var(--gutter, 16px)));
    margin: 0 auto var(--sp-8);
    padding: clamp(16px, 5vw, 11mm);
    background: #fff;
    color: var(--ink);
    box-shadow: 0 2px 18px rgb(0 0 0 / 0.14);
    display: grid;
    gap: 14px;
    border-block-start: 6mm solid var(--signal-red, #c62828);
  }
  .sheet p,
  .sheet h2 {
    margin: 0;
  }
  .sheet__kicker {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .sheet__title {
    margin: 4px 0 0;
    font-family: var(--font-heading);
    font-weight: var(--fw-black);
    font-size: clamp(1.5rem, 5.4vw, 2rem);
    line-height: 1.25;
    text-wrap: balance;
  }
  .sheet__cols {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 46em) {
    .sheet__cols {
      grid-template-columns: 1fr 1fr;
      gap: 7mm;
    }
  }
  .sheet__col {
    display: grid;
    gap: 14px;
    align-content: start;
    min-inline-size: 0;
  }
  .blk {
    display: grid;
    gap: 8px;
    min-inline-size: 0;
  }
  .blk__h {
    font-size: 1.0625rem;
    font-weight: var(--fw-black);
    line-height: 1.35;
    padding-block-start: 6px;
    border-block-start: 2px solid var(--ink);
  }
  .blk__p,
  .blk__ask {
    font-size: var(--fs-sm);
    line-height: 1.55;
  }
  .blk__p :global(.chip) {
    margin-inline-start: 0.3em;
    vertical-align: 0.1em;
  }
  .blk__ask {
    font-weight: var(--fw-bold);
  }
  .blk__small {
    font-size: var(--fs-xs);
    color: var(--ink-2);
    line-height: 1.5;
  }
  .blk__k1 {
    font-size: var(--fs-sm);
    line-height: 1.55;
    padding: 8px 10px;
    background: var(--bg-sunken);
    border-inline-start: 4px solid var(--estimate, #c98a1e);
  }
  .kv {
    display: grid;
    gap: 2px;
  }
  .kv__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 10px;
    font-size: var(--fs-sm);
  }
  .kv__k {
    flex: 1 1 8em;
    font-weight: var(--fw-bold);
  }
  .kv__v {
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
  }
  .kv__note {
    font-size: var(--fs-xs);
    color: var(--ink-2);
  }
  .nt {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--fs-xs);
    line-height: 1.35;
    table-layout: fixed;
  }
  .nt th,
  .nt td {
    padding: 4px 3px;
    border-block-end: 1px solid var(--line);
    text-align: start;
    vertical-align: top;
  }
  .nt thead th {
    font-weight: var(--fw-bold);
    border-block-end: 1.5px solid var(--ink);
  }
  .nt tbody th {
    font-weight: var(--fw-bold);
  }
  .nt__sub {
    display: block;
    font-weight: normal;
    color: var(--ink-2);
  }
  .nt__street td,
  .nt__conf td {
    color: var(--ink-2);
  }
  /* on paper an estimate is text with its chip: no tap target, no arrow */
  .sheet :global(.est) {
    min-block-size: 0;
    padding: 0;
    margin: 0;
    font-size: inherit;
  }
  .sheet :global(.est__go) {
    display: none;
  }
  .nt :global(.est__line) {
    gap: 2px;
  }
  .nt :global(.est__value) {
    text-underline-offset: 0.22em;
  }
  .sheet__foot {
    display: grid;
    gap: 2px;
    padding-block-start: 8px;
    border-block-start: 1.5px solid var(--line-strong);
    font-size: var(--fs-xs);
    color: var(--ink-2);
    line-height: 1.5;
  }
  .sheet__url {
    overflow-wrap: anywhere;
    color: var(--ink);
    font-weight: var(--fw-bold);
  }

  @media print {
    .toolbar {
      display: none !important;
    }
    .sheet {
      inline-size: 210mm;
      block-size: 297mm;
      margin: 0;
      padding: 9mm 11mm 8mm;
      gap: 3.5mm;
      box-shadow: none;
      overflow: hidden;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .sheet__cols {
      grid-template-columns: 1fr 1fr;
      gap: 6mm;
    }
    .sheet__col {
      gap: 3mm;
    }
    .sheet__title {
      font-size: 19pt;
    }
    .sheet :global(.scene__art) {
      max-block-size: 52mm;
      inline-size: auto;
      margin-inline: auto;
    }
  }
</style>
