---
import { absUrl } from '../../../lib/abs-url.ts';
/**
 * /print/brief/ — 一頁說明 / the one-page brief for a borough chief or a councillor (brief 7.9).
 *
 * One A4 page: home screen 2 (what you smell is not benzene, but benzene comes with it; G2 with its
 * three word labels); home screen 5's words (people who stay an hour at the junction) with the
 * benzene chart against California's 1-hour reference (no picture: the page must stay one A4); G8 with home screen 8's sentence; K1; the ask and the
 * promise; short references. No carbon monoxide (it stays on /estimate/) and no seconds-long level:
 * the only benzene figure is the 1-hour one. Light tokens on paper and no site chrome (PrintPage).
 *
 * Copy: src/i18n/pages/act.ts (`brief`) and home screens 2 and 5 (src/i18n/pages/home.ts).
 * Numbers: src/data/estimate.ts and src/data/simulation.ts.
 */
import PrintPage from '@/components/pages/action/PrintPage.astro';
import Picture from '@/components/pages/action/Picture.astro';
import TailpipeMarks from '@/components/art/TailpipeMarks.astro';
import SimAbove from '@/components/charts/SimAbove.astro';
import SimText from '@/components/pages/estimate/SimText.astro';
import Phrased from '@/components/ui/Phrased.astro';
import KindChip from '@/components/ui/KindChip.astro';
import { href, localeFromParam, localeStaticPaths } from '@/i18n';
import { kSentences, site } from '@/i18n/ui';
import { formatEstimate } from '@/data/estimate';
import { sim, simMeta } from '@/data/simulation';
import act from '@/i18n/pages/act';
import home from '@/i18n/pages/home';
import { fill, localize } from '@/i18n/pages/_copy';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const t = localize(act, locale);
const h = localize(home, locale);
const b = t.brief;
const plain = (s: string) => s.replace(/\|/g, '');
const estimatePage = absUrl(href('/estimate/', locale), Astro.site);
const shortUrl = estimatePage.replace(/^https?:\/\//, '');
const child = formatEstimate('child.airPerKg', locale);
const basis = { h: sim.benzene.referenceBasis_h, lo: sim.benzene.emissionUncertain.lo, hi: sim.benzene.emissionUncertain.hi };
---

<PrintPage locale={locale} title={b.metaTitle} description={b.metaDescription} share="brief">
  <div class="toolbar">
    <p>{b.screenNote}</p>
    <div class="toolbar__row">
      <button type="button" class="toolbar__btn" data-print hidden>{b.printButton}</button>
      <a class="toolbar__link" href={href('/act/#policy', locale)}>{b.back}</a>
    </div>
  </div>

  <article class="sheet" aria-labelledby="brief-t">
    <header class="sheet__head">
      <p class="sheet__kicker">{b.kicker}</p>
      <h1 id="brief-t" class="sheet__title"><Phrased text={b.title} /></h1>
    </header>

    <div class="sheet__cols">
      <div class="sheet__col">
        <section class="blk">
          <h2 class="blk__h">{b.smellHead}</h2>
          <div class="pic pic--labels" data-fit><TailpipeMarks locale={locale} tag="street" /></div>
          <div class="blk__p has-chip">
            <p>{h.s2.body[0]}{locale === 'en' ? ' ' : ''}{h.s2.body[1]}</p>
            <KindChip locale={locale} kind="estimate" size="sm" />
          </div>
          <p class="blk__small">{b.smellOlder}</p>
        </section>

        <section class="blk">
          <h2 class="blk__h">{b.heightsHead}</h2>
          <div class="pic" data-fit><Picture locale={locale} kind="heights" /></div>
          <div class="blk__p has-chip">
            <p>{fill(b.heightsBody, { lo: child.lo, hi: child.hi })}</p>
            <KindChip locale={locale} kind="study" size="sm" />
          </div>
        </section>
      </div>

      <div class="sheet__col">
        <section class="blk">
          <h2 class="blk__h">{plain(h.s5.headline)}</h2>
          <p class="blk__small">{fill(h.s5.caption, basis)}</p>
          <SimText locale={locale} text={h.s5.body} slots={{ times: 'sim.benzene.stay1hTimes' }} class="blk__p" />
          <SimAbove locale={locale} only="benzene" />
          <p class="blk__small">{h.s5.quiet}</p>
        </section>

        <section class="blk blk--ask">
          <p class="blk__k1">{kSentences.K1[locale]}</p>
          <h2 class="blk__h">{b.askHead}</h2>
          <p class="blk__ask">{b.ask}</p>
          <p class="blk__p">{b.promise}</p>
        </section>
      </div>
    </div>

    <footer class="sheet__foot">
      <p>{fill(b.refs, { stamp: simMeta.stamp[locale] })}</p>
      <p>{b.more} <span class="sheet__url">{shortUrl}</span></p>
      <p><b>{site.name[locale]}</b> · {site.tagline[locale]}</p>
    </footer>
  </article>
</PrintPage>

<script>
  // print: size each picture by its height (its shape comes from the svg's viewBox)
  for (const box of document.querySelectorAll<HTMLElement>('[data-fit]')) {
    const v = box.querySelector('svg.scene__art')?.getAttribute('viewBox')?.split(/[\s,]+/).map(Number);
    if (v && v[3]) box.style.setProperty('--ar', String(v[2] / v[3]));
  }
  const btn = document.querySelector<HTMLButtonElement>('[data-print]');
  if (btn) {
    btn.hidden = false;
    btn.addEventListener('click', () => window.print());
  }
</script>

<style>
  .toolbar {
    box-sizing: border-box;
    inline-size: min(210mm, calc(100% - 2 * var(--gutter, 16px)));
    margin: 0 auto;
    padding-block: var(--sp-5) var(--sp-4);
    display: grid;
    gap: var(--sp-3);
    font-size: var(--fs-base);
  }
  .toolbar p {
    margin: 0;
  }
  .toolbar__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    align-items: center;
  }
  .toolbar__btn,
  .toolbar__link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap, 3rem);
    padding: 0 var(--sp-4);
    border: 2px solid var(--ink);
    border-radius: var(--radius-2);
    font: inherit;
    font-size: var(--fs-btn, 1.0625rem);
    font-weight: var(--fw-bold);
    color: var(--ink);
    background: var(--surface);
    text-decoration: none;
    cursor: pointer;
  }
  .toolbar__btn {
    background: var(--ink);
    color: var(--bg);
  }

  .sheet {
    --here: #fff;
    box-sizing: border-box;
    inline-size: min(210mm, calc(100% - 2 * var(--gutter, 16px)));
    margin: 0 auto var(--sp-8);
    padding: clamp(16px, 5vw, 11mm);
    background: #fff;
    color: var(--ink);
    box-shadow: 0 2px 18px rgb(0 0 0 / 0.14);
    display: grid;
    gap: 14px;
    border-block-start: 6mm solid var(--signal-red, #c62828);
    overflow-x: clip;
  }
  .sheet p,
  .sheet h2 {
    margin: 0;
  }
  .sheet__kicker {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .sheet__title {
    margin: 4px 0 0;
    font-family: var(--font-heading);
    font-weight: var(--fw-black);
    font-size: clamp(1.5rem, 5.4vw, 2rem);
    line-height: 1.25;
    text-wrap: balance;
  }
  .sheet__cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  @media (min-width: 46em) {
    .sheet__cols {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 7mm;
    }
  }
  .sheet__col {
    display: grid;
    gap: 14px;
    align-content: start;
    min-inline-size: 0;
  }
  .blk {
    display: grid;
    gap: 8px;
    min-inline-size: 0;
  }
  .blk__h {
    font-size: 1.0625rem;
    font-weight: var(--fw-black);
    line-height: 1.35;
    padding-block-start: 6px;
    border-block-start: 2px solid var(--ink);
  }
  .has-chip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
  }
  .blk__p,
  .blk__ask {
    font-size: var(--fs-base);
    line-height: 1.55;
  }
  .blk__p :global(.chip) {
    margin-inline-start: 0.3em;
    vertical-align: 0.1em;
  }
  .blk__ask {
    font-weight: var(--fw-bold);
  }
  .blk__small {
    font-size: var(--fs-xs);
    color: var(--ink-2);
    line-height: 1.5;
  }
  .blk__k1 {
    font-size: var(--fs-base);
    line-height: 1.55;
    padding: 8px 10px;
    background: var(--bg-sunken);
    border-inline-start: 4px solid var(--estimate, #c98a1e);
  }
  .kv {
    display: grid;
    gap: 2px;
  }
  .kv__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 10px;
    font-size: var(--fs-sm);
  }
  .kv__label {
    flex: 1 1 8em;
    font-weight: var(--fw-bold);
  }
  .kv__v {
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
  }
  .kv__note {
    font-size: var(--fs-xs);
    color: var(--ink-2);
  }
  .nt-wrap {
    position: relative;
    overflow-x: auto;
  }

  .nt {
    inline-size: 100%;
    min-inline-size: 34rem;
    border-collapse: collapse;
    font-size: var(--fs-xs);
    line-height: 1.35;
    table-layout: fixed;
  }
  .nt th,
  .nt td {
    padding: 6px 5px;
    border-block-end: 1px solid var(--line);
    text-align: start;
    vertical-align: top;
  }
  .nt thead th {
    font-weight: var(--fw-bold);
    border-block-end: 1.5px solid var(--ink);
  }
  .nt tbody th {
    font-weight: var(--fw-bold);
  }
  .nt__sub {
    display: block;
    font-weight: normal;
    color: var(--ink-2);
  }
  .nt__street td,
  .nt__conf td {
    color: var(--ink-2);
  }
  /* in the table an estimate is text with its chip; on paper, everywhere: no tap target, no arrow */
  .nt :global(.est) {
    min-block-size: var(--tap, 3rem);
    padding: 0;
    margin: 0;
    font-size: inherit;
  }
  @media print {
    .sheet :global(.est) {
      min-block-size: 0;
      padding: 0;
      margin: 0;
    }
  }
  .sheet :global(.est__go) {
    display: none;
  }
  .nt :global(.est__line) {
    gap: 2px;
  }
  .nt :global(.est__value) {
    text-underline-offset: 0.22em;
  }
  .sheet__foot {
    display: grid;
    gap: 2px;
    padding-block-start: 8px;
    border-block-start: 1.5px solid var(--line-strong);
    font-size: var(--fs-xs);
    color: var(--ink-2);
    line-height: 1.5;
  }
  .sheet__url {
    overflow-wrap: anywhere;
    color: var(--ink);
    font-weight: var(--fw-bold);
  }

  @media print {
    .toolbar {
      display: none !important;
    }
    .sheet {
      inline-size: 210mm;
      block-size: 297mm;
      margin: 0;
      padding: 9mm 11mm 8mm;
      gap: 3.5mm;
      box-shadow: none;
      overflow: hidden;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .sheet__cols {
      grid-template-columns: 1fr 1fr;
      gap: 6mm;
    }
    .nt {
      min-inline-size: 0;
    }
    .sheet__col {
      gap: 3mm;
    }
    .sheet__title {
      font-size: 19pt;
    }
    /* paper is read at arm's length, not on a phone: the whole sheet at 10pt body */
    :global(html) {
      font-size: 72%;
    }
    :global(html:lang(en)) {
      font-size: 68%;
    }
    .pic {
      --fit-h: 50mm;
    }
    .sheet:lang(en) .pic {
      --fit-h: 40mm;
    }
    [data-fit] :global(.scene) {
      inline-size: min(100%, calc(var(--fit-h) * var(--ar, 1.3)));
      margin-inline: auto;
    }
    /* the tailpipe's three word labels need the drawing at about the column's width */
    .pic--labels {
      --fit-h: 66mm;
    }
    .sheet:lang(en) .pic--labels {
      --fit-h: 66mm;
    }
    /* on paper the benzene chart keeps its bars, its reference line and its axis: its data table
       and its long caption (said by the words above and below it) are left to the screen */
    .sheet :global(.hc-above details),
    .sheet :global(.hc-above .hc-sim__caption) {
      display: none;
    }
  }
  /* the print button works only with JavaScript: until the script shows it, it stays hidden */
  .toolbar__btn[hidden] {
    display: none;
  }
</style>
