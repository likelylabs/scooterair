---
import { absUrl } from '../../../lib/abs-url.ts';
/**
 * /print/poster/ — 校門口海報 / the school-gate poster (brief 7.9), one A4 page per language.
 *
 * G4 at the dozen scenario; the poster's headline; three lines with no number (what you smell is
 * not benzene, but benzene comes with it; home screen 2's first line; no smell does not mean clean
 * air, with the older-scooters caveat), under one 推估 chip; the mask line; the sentence a reader should repeat; a QR code to the home page (drawn at build
 * time by components/pages/action/qr.ts, with the address printed beside it); one request.
 * Light tokens on paper and no site chrome (PrintPage). On screen a small toolbar sits above
 * the sheet; in print only the sheet prints.
 *
 * Copy: src/i18n/pages/act.ts (`poster`) and home screen 2 (src/i18n/pages/home.ts).
 */
import PrintPage from '@/components/pages/action/PrintPage.astro';
import Picture from '@/components/pages/action/Picture.astro';
import Phrased from '@/components/ui/Phrased.astro';
import KindChip from '@/components/ui/KindChip.astro';
import { qrSvg } from '@/components/pages/action/qr';
import { href, localeFromParam, localeStaticPaths } from '@/i18n';
import { site } from '@/i18n/ui';
import act from '@/i18n/pages/act';
import home from '@/i18n/pages/home';
import { fill, localize } from '@/i18n/pages/_copy';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const t = localize(act, locale);
const p = t.poster;
const h = localize(home, locale);
const target = absUrl(href('/', locale), Astro.site);
const shortUrl = target.replace(/^https?:\/\//, '').replace(/\/$/, '');
const qr = qrSvg(target, fill(p.qrAlt, { url: shortUrl }));
---

<PrintPage locale={locale} title={p.metaTitle} description={p.metaDescription} share="how-much">
  <div class="toolbar">
    <p>{p.screenNote}</p>
    <div class="toolbar__row">
      <button type="button" class="toolbar__btn" data-print hidden>{p.printButton}</button>
      <a class="toolbar__link" href={href('/act/#community', locale)}>{p.back}</a>
    </div>
  </div>

  <article class="poster" aria-labelledby="poster-t">
    <header class="poster__head">
      <p class="poster__kicker">{p.kicker}</p>
      <h1 id="poster-t" class="poster__title"><Phrased text={p.title} /></h1>
    </header>

    <div class="poster__numbers">
      <p class="poster__line poster__line--lead">{p.smell}</p>
      <p class="poster__line">{h.s2.body[0]}</p>
      <p class="poster__line">{p.clean}</p>
      <KindChip locale={locale} kind="estimate" />
    </div>

    <div class="poster__pic" data-fit>
      <Picture locale={locale} kind="kerb" scenario="dozen" />
    </div>

    <p class="poster__mask">{t.walk.mask}</p>
    <p class="poster__sentence">{site.sentence[locale]}</p>

    <footer class="poster__foot">
      <div class="poster__qr">
        <div class="poster__code" set:html={qr} />
        <div class="poster__qrtext">
          <p class="poster__qrlabel">{p.qr}</p>
          <p class="poster__url">{shortUrl}</p>
          <p class="poster__site"><b>{site.name[locale]}</b> · {site.tagline[locale]}</p>
        </div>
      </div>
      <p class="poster__engine">{p.engine}</p>
    </footer>
  </article>
</PrintPage>

<script>
  // print: size each picture by its height (its shape comes from the svg's viewBox)
  for (const box of document.querySelectorAll<HTMLElement>('[data-fit]')) {
    const v = box.querySelector('svg.scene__art')?.getAttribute('viewBox')?.split(/[\s,]+/).map(Number);
    if (v && v[3]) box.style.setProperty('--ar', String(v[2] / v[3]));
  }
  const b = document.querySelector<HTMLButtonElement>('[data-print]');
  if (b) {
    b.hidden = false;
    b.addEventListener('click', () => window.print());
  }
</script>

<style>
  .toolbar {
    box-sizing: border-box;
    inline-size: min(210mm, calc(100% - 2 * var(--gutter, 16px)));
    margin: 0 auto;
    padding-block: var(--sp-5) var(--sp-4);
    display: grid;
    gap: var(--sp-3);
    font-size: var(--fs-base);
  }
  .toolbar p {
    margin: 0;
  }
  .toolbar__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    align-items: center;
  }
  .toolbar__btn,
  .toolbar__link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap, 3rem);
    padding: 0 var(--sp-4);
    border: 2px solid var(--ink);
    border-radius: var(--radius-2);
    font: inherit;
    font-size: var(--fs-btn, 1.0625rem);
    font-weight: var(--fw-bold);
    color: var(--ink);
    background: var(--surface);
    text-decoration: none;
    cursor: pointer;
  }
  .toolbar__btn {
    background: var(--ink);
    color: var(--bg);
  }

  /* The sheet: an A4 page on screen, and the only thing that prints. */
  .poster {
    --here: #fff;
    box-sizing: border-box;
    inline-size: min(210mm, calc(100% - 2 * var(--gutter, 16px)));
    margin: 0 auto var(--sp-8);
    padding: clamp(16px, 5vw, 13mm);
    background: #fff;
    color: var(--ink);
    box-shadow: 0 2px 18px rgb(0 0 0 / 0.14);
    display: grid;
    gap: clamp(12px, 3vw, 5mm);
    align-content: start;
    border-block-start: 9mm solid var(--signal-red, #c62828);
  }
  .poster p {
    margin: 0;
  }
  .poster__kicker {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .poster__title {
    margin: 4px 0 0;
    font-family: var(--font-heading);
    font-weight: var(--fw-black);
    font-size: clamp(1.6875rem, 6.4vw, 2.75rem);
    line-height: 1.22;
    text-wrap: balance;
  }
  .poster__numbers {
    display: grid;
    gap: 6px;
    padding: 12px 14px;
    border: 2px solid var(--ink);
    border-radius: 6px;
  }
  .poster__numbers > :global(.kind-chip),
  .poster__numbers > :global(*:last-child) {
    justify-self: start;
  }
  .poster__line {
    margin: 0;
    font-size: var(--fs-base);
    line-height: 1.55;
  }
  .poster .poster__line--lead {
    font-weight: var(--fw-black);
    font-size: 1.25rem;
    line-height: 1.35;
  }
  .poster__pic :global(.scene) {
    margin: 0;
  }
  .poster__mask {
    padding: 10px 14px;
    border-inline-start: 6px solid var(--ink);
    background: var(--bg-sunken);
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    line-height: 1.55;
  }
  .poster__sentence {
    font-family: var(--font-heading);
    font-weight: var(--fw-black);
    font-size: clamp(1.125rem, 3.6vw, 1.5rem);
    line-height: 1.5;
  }
  .poster__foot {
    display: grid;
    gap: 10px;
    padding-block-start: 12px;
    border-block-start: 2px solid var(--line-strong);
  }
  .poster__qr {
    display: flex;
    gap: 14px;
    align-items: center;
  }
  .poster__code {
    inline-size: clamp(88px, 22vw, 32mm);
    flex: none;
  }
  .poster__code :global(svg) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  .poster__qrtext {
    display: grid;
    gap: 4px;
    min-inline-size: 0;
  }
  .poster__qrlabel {
    font-weight: var(--fw-bold);
    font-size: var(--fs-base);
  }
  .poster__url {
    font-size: var(--fs-sm);
    overflow-wrap: anywhere;
    color: var(--ink-2);
  }
  .poster__site,
  .poster__engine {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }

  @media print {
    .toolbar {
      display: none !important;
    }
    .poster {
      inline-size: 210mm;
      block-size: 297mm;
      margin: 0;
      padding: 12mm 14mm 10mm;
      gap: 4.5mm;
      box-shadow: none;
      overflow: hidden;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .poster__title {
      font-size: 30pt;
    }
    .poster__title:lang(en) {
      font-size: 26pt;
    }
    :global(html:lang(en)) {
      font-size: 92%;
    }
    .poster__pic {
      --fit-h: 92mm;
    }
    .poster:lang(en) .poster__pic {
      --fit-h: 82mm;
    }
    [data-fit] :global(.scene) {
      inline-size: min(100%, calc(var(--fit-h) * var(--ar, 1.3)));
      margin-inline: auto;
    }
    .poster__sentence {
      font-size: 15pt;
    }
    .poster__code {
      inline-size: 30mm;
    }
  }
  /* the print button works only with JavaScript: until the script shows it, it stays hidden */
  .toolbar__btn[hidden] {
    display: none;
  }
</style>
