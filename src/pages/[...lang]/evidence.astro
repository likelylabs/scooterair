<script>
  // A link to anything inside a closed fold opens every fold around it and brings it into view
  // (current browsers open the fold natively; this covers the rest, and a second tap on a link
  // whose address is already in the bar, which fires no hashchange).
  const open = (hash: string) => {
    let id = '';
    try {
      id = decodeURIComponent(hash.slice(1));
    } catch {
      return;
    }
    if (!id) return;
    const el = document.getElementById(id);
    if (!el) return;
    let changed = false;
    for (let p = el.parentElement; p; p = p.parentElement) {
      if (p instanceof HTMLDetailsElement && !p.open) {
        p.open = true;
        changed = true;
      }
    }
    if (changed) requestAnimationFrame(() => el.scrollIntoView({ block: 'start' }));
  };
  window.addEventListener('hashchange', () => open(location.hash));
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.('a[href*="#"]') as HTMLAnchorElement | null;
    if (a && a.pathname === location.pathname && a.hash && a.hash === location.hash) open(a.hash);
  });
  open(location.hash);
</script>

