<script>
  // A link to a row inside a closed fold opens the fold (current browsers do this natively;
  // this covers the rest) and brings the row into view.
  const open = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const el = document.getElementById(id);
    if (!el) return;
    let p: HTMLElement | null = el.parentElement;
    let changed = false;
    while (p) {
      if (p instanceof HTMLDetailsElement && !p.open) {
        p.open = true;
        changed = true;
      }
      p = p.parentElement;
    }
    if (changed) el.scrollIntoView({ block: 'start' });
  };
  window.addEventListener('hashchange', open);
  open();
</script>

