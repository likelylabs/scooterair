---
/**
 * /evidence/ — 證據 / Evidence (redesign brief 7.3; blueprint 4.5, Part 5 V5, V9, V13, V17,
 * V20–V26, V28–V34). The adults' page: the one a sceptic, a journalist or a scientist uses to
 * check the site. Data register only: no scene art.
 *
 *   top            the seven-line connect board, each line with its chip(s) (chain.summary)
 *   #map           the evidence map: kinds of evidence × links, and a 推估 column
 *   #link-1 … 7    charts, then the answers for that link (AnswerCard, former gap ids kept as
 *                  anchors), then the evidence table; link 3 carries the estimate and K2 and the
 *                  mask line, link 5 carries K5
 *   #answers       (also #gaps) where the former gap list went
 *   #not-claimed   what we will not say (brief 4.6) and what would change our mind
 *   #not-used, #studies, #context, #method
 *
 * Built from the registry: every fact and chart dataset that evidenceForLink(n) returns for
 * each link appears, ordered by kind of evidence (Taiwan measurements first; src/data/chain.ts),
 * with its badge, citations and caveat. A fact appears in
 * full once (anchor #<fact id>); where it also serves another link, that link points to it.
 * Exceptions, by rule: the never-smoker figures (R14), the 94% day, the regional ranking and the
 * single idle particle datum have their full rows in #not-used; the three-scooter case study is
 * shown only in its own hatched panel (R13).
 *
 * Copy: src/i18n/pages/evidence.ts. Helpers and charts: src/components/pages/evidence/.
 */
import Base from '@/layouts/Base.astro';
import Section from '@/components/ui/Section.astro';
import Callout from '@/components/ui/Callout.astro';
import Card from '@/components/ui/Card.astro';
import Cite from '@/components/ui/Cite.astro';
import CompareTable from '@/components/ui/CompareTable.astro';
import EvidenceBadge from '@/components/ui/EvidenceBadge.astro';
import EvidenceLegend from '@/components/ui/EvidenceLegend.astro';
import Figure from '@/components/ui/Figure.astro';
import Icon from '@/components/ui/Icon.astro';
import KindChip from '@/components/ui/KindChip.astro';
import EstimateValue from '@/components/ui/EstimateValue.astro';
import Phrased from '@/components/ui/Phrased.astro';
import Stat from '@/components/ui/Stat.astro';
import EvidenceMap from '@/components/pages/evidence/EvidenceMap.astro';
import FactList from '@/components/pages/evidence/FactList.astro';
import FactRow from '@/components/pages/evidence/FactRow.astro';
import AnswerCard from '@/components/pages/evidence/AnswerCard.astro';
import SeriesFigure from '@/components/pages/evidence/SeriesFigure.astro';
import Fold from '@/components/pages/evidence/Fold.astro';
import Mixed from '@/components/pages/evidence/Mixed.astro';
import { seriesView, strollerView, sgn } from '@/components/pages/evidence/figures';
import {
  casePanelFacts,
  casePanelSeries,
  cites,
  dataAnchor,
  homeOf,
  lf,
  neverSmokerFacts,
  notUsedSeries,
  readLabel,
  sourceShort,
  sourceUses,
} from '@/components/pages/evidence/ev';
import { asset, href, localeFromParam, localeStaticPaths, htmlLang } from '@/i18n';
import { chain, kSentences, readerText } from '@/i18n/ui';
import { estimateText } from '@/data/estimate';
import evidenceCopy from '@/i18n/pages/evidence';
import { fill, localize } from '@/i18n/pages/_copy';
import {
  answerList,
  answersForLink,
  chainLinkLabels,
  chainLinks,
  contextItems,
  facts,
  factsForLink,
  getSource,
  localizeAnswer,
  readerKindLabels,
  readerKinds,
  readLevelLabels,
  readLevels,
  seriesForLink,
  sourceIds,
  type ChainLink,
  type FactId,
  type SeriesId,
  type SourceId,
} from '@/data';
import { smellEvidenceGroups } from '@/data/facts-smell';
import { smellFiles } from '@/data/simulation';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const en = locale === 'en';
const T = localize(evidenceCopy, locale);
const plain = (s: string) => s.replaceAll('|', '');
const colon = en ? ': ' : '：';
const nf = (v: number, d = 2) => new Intl.NumberFormat(en ? 'en' : 'zh-TW', { maximumFractionDigits: d }).format(v);
const pct = (v: number, d = 0) => `${nf(v, d)}%`;
const D = (id: FactId, key: string) => (facts[id].data as Record<string, { value: number }>)[key].value;
/** A fact's short label for a link to it; R14: never the never-smoker numbers outside #not-used. */
const factLabel = (id: FactId) => (neverSmokerFacts.includes(id) ? T.row.neverSmokerPointer : lf(id, locale).display);
/** The name of link n as the eyebrows print it (link 7 is "the link you can break"). */
const linkName = (n: number) => (n === chain.links.length ? chain.breakable[locale] : chain.links[n - 1][locale]);

// ---- per link -------------------------------------------------------------------------
/** Charts drawn as the link's featured visuals (blueprint Part 5); the rest go behind a fold. */
const featured: Record<ChainLink, SeriesId[]> = {
  1: ['teds13-motorcycle-share', 'tunnel-co-by-vehicle-class-ting2023', 'tsai2023-benzene-by-class', 'tsai2023-hc-by-class', 'tsai2018-older-phase-excess', 'tsai2018-by-mileage', 'idle-test-limits-by-build-date', 'inspection-2025-per-100'],
  2: ['wu2021-quiet-route'],
  3: ['taipei-traffic-vs-general-stations', 'wu2021-station-correlation', 'scooter-lane-vs-cyclist-wu2021', 'commute-pm25-chuang2020', 'commute-pm25-wang2021'],
  4: ['odour-thresholds'],
  5: ['hei-sr23-outcomes', 'chuang2020-effects-per-iqr'],
  6: ['stroller-height-studies'],
  7: ['ev-share-new-registrations'],
};
/** The fact each link's summary line rests on (for the chain overview's citations). */
const keyFacts: Record<ChainLink, FactId[]> = {
  1: ['teds13-mc-pm25-share', 'teds13-mc-co-share'],
  2: ['first-metre-sharma-kumar-2018', 'marking-rules-turn-box'],
  3: ['wu2021-station-correlation'],
  4: ['co-odourless', 'odour-thresholds'],
  5: ['hei-sr23-trap-associations'],
  6: ['commute-scooter-vs-subway-chuang2020', 'who-children-vulnerable'],
  7: ['teds13-electric-mc-pm25'],
};

const links = chainLinks.map((n) => {
  const all = factsForLink(n);
  let own = all.filter((f) => f.chainLink === n && homeOf(f.id) === n && !casePanelFacts.includes(f.id)).map((f) => f.id);
  // Link 5 leads with the international review (blueprint 3.7, 4.5)
  if (n === 5) own = ['hei-sr23-trap-associations' as FactId, ...own.filter((id) => id !== 'hei-sr23-trap-associations')];
  const pointers = all
    .filter((f) => !own.includes(f.id) && !(n === 1 && casePanelFacts.includes(f.id)))
    .map((f) => {
      const home = homeOf(f.id);
      return {
        id: f.id,
        // R14: the never-smoker figures are printed only in #not-used
        display: neverSmokerFacts.includes(f.id) ? T.row.neverSmokerPointer : lf(f.id, locale).display,
        where: home === 'not-used' ? T.row.alsoNotUsed : fill(T.row.alsoIn, { n: home ?? '' }),
      };
    })
    // both never-smoker rows point to the same place: one pointer is enough
    .filter((p, i, arr) => !neverSmokerFacts.includes(p.id) || arr.findIndex((q) => neverSmokerFacts.includes(q.id)) === i);
  const series = seriesForLink(n, { primaryOnly: true }).map((s) => s.id);
  const others = series.filter((id) => !featured[n].includes(id) && !notUsedSeries.includes(id) && !casePanelSeries.includes(id));
  return {
    n,
    title: fill(T.links[n - 1].title, n === 2 ? { cm: nf(D('marking-rules-turn-box', 'turnBoxGap') * 100) } : {}),
    question: 'question' in T.links[n - 1] ? (T.links[n - 1] as { question: string }).question : readerText(chainLinkLabels[n].question[locale]),
    own,
    pointers,
    others,
    answers: answersForLink(n).map((a) => a.id),
  };
});
const V = (id: SeriesId) => seriesView(id, locale, T);
/** Charts each link keeps behind its fold (the hand-placed ones below the lead chart), plus the rest of its data. */
const foldFigures: Record<ChainLink, number> = { 1: 9, 2: 0, 3: 4, 4: 1, 5: 1, 6: 1, 7: 0 };
const foldCount = (n: ChainLink, others: number) => foldFigures[n] + others;

// ---- the connect board: seven lines, each with its chip(s) (brief 7.3) -------------------------
const board = chainLinks.map((n) => {
  const line = chain.summary[n - 1];
  return { n, name: linkName(n), text: line.text[locale], chips: line.chips };
});

// ---- featured values -----------------------------------------------------------------
const v21 = { benzene: `${sgn(locale, -D('tsai2023-trend-2013-2021', 'benzeneDrop'), 0)}%`, hc: `${sgn(locale, -D('tsai2023-trend-2013-2021', 'hcDrop'), 0)}%` };
const fleetN = (n: number) => (en ? (n >= 1e6 ? { value: nf(n / 1e6, 2), unit: T.v34.unitBig } : { value: nf(n, 0), unit: '' }) : { value: nf(n / 1e4, 1), unit: T.v34.unitBig });
const v34 = [
  { id: 'fleet-registered-2024' as FactId, label: T.v34.registered, ...fleetN(D('fleet-registered-2024', 'total') * 1e6) },
  { id: 'fleet-electric-registered-2024' as FactId, label: T.v34.electric, ...fleetN(D('fleet-electric-registered-2024', 'electric2024')), tone: 'clean' as const },
  { id: 'two-stroke-remaining' as FactId, label: T.v34.twoStroke, prefix: T.v34.about, ...(en ? { value: nf(D('two-stroke-remaining', 'y2024'), 0), unit: T.v34.orFewer } : { value: nf(D('two-stroke-remaining', 'y2024') / 1e4, 1), unit: T.v34.orFewer }), tone: 'exhaust' as const },
  { id: 'old-scooters-retired-2020-2023' as FactId, label: T.v34.retired, ...fleetN(D('old-scooters-retired-2020-2023', 'retired') * 1e6) },
];
const iarc = [
  { id: 'iarc-benzene-group1' as FactId, label: T.v28.benzene },
  { id: 'iarc-group1-three' as FactId, label: T.v28.butadiene, value: T.v28.group1 },
  { id: 'iarc-group1-three' as FactId, label: T.v28.formaldehyde, value: T.v28.group1 },
  { id: 'iarc-outdoor-air-pollution-group1' as FactId, label: T.v28.outdoor },
  { id: 'iarc-diesel-exhaust-group1' as FactId, label: T.v28.diesel },
  { id: 'iarc-gasoline-exhaust-2b' as FactId, label: T.v28.gasoline },
];
const strollerBand = { low: D('stroller-height-review', 'kenagy2016Low'), high: D('stroller-height-review', 'kenagy2016High') };
const studies = D('hei-sr23-trap-associations', 'studies');
const perHundred = seriesView('inspection-2025-per-100', locale, T);
const perHundredTotal = perHundred.s.datasets.reduce((a, d) => a + (d.points[0].y ?? 0), 0);

// ---- not used ---------------------------------------------------------------------------
const NU = T.notUsed.items;
const notUsedTokens = {
  outlier: `${Math.floor(Math.abs(D('iot-scramble-outlier-day', 'allDay')))}%`,
  typical: lf('iot-scramble-typical-range', locale).display,
  share: pct(D('tseng2019-never-smokers', 'neverSmokedShare')),
  // the target years are the registry's own keys (target2035, target2040)
  y1: 'target2035'.slice('target'.length),
  t1: pct(D('netzero-ev-sales-targets', 'target2035')),
  y2: 'target2040'.slice('target'.length),
  t2: pct(D('netzero-ev-sales-targets', 'target2040')),
};

// ---- studies read in full ---------------------------------------------------------------
const uses = sourceUses();
const fullRead = sourceIds.filter((id) => getSource(id).readLevel === 'full-text-page-checked');

// ---- method -----------------------------------------------------------------------------
const readCounts = readLevels.map((lvl) => ({ lvl, label: readerText(readLevelLabels[lvl][locale]), n: sourceIds.filter((id) => getSource(id).readLevel === lvl).length })).filter((r) => r.n > 0);

// ---- context outside the chain ----------------------------------------------------------
// the smell-chemicals facts have their own block (#smell-chemicals), not the context list
const smellIds = new Set<string>(Object.values(smellEvidenceGroups).flat());
const ctxAll = contextItems();
const ctx = { ...ctxAll, facts: ctxAll.facts.filter((f) => !smellIds.has(f.id)) };

const toc = [
  { href: '#chain', label: T.toc.chain },
  ...chainLinks.map((n) => ({ href: `#${chain.anchor(n)}`, label: `${fill(T.toc.linkN, { n })} · ${linkName(n)}` })),
  { href: '#smell-chemicals', label: T.toc.smell },
  { href: '#map', label: T.toc.map },
  { href: '#answers', label: T.toc.answers },
  { href: '#not-claimed', label: T.toc.notClaimed },
  { href: '#change-mind', label: T.toc.changeMind },
  { href: '#studies', label: T.toc.studies },
  { href: '#not-used', label: T.toc.notUsed },
  { href: '#method', label: T.toc.method },
];

// ---- each link's key number (shown before the fold) -------------------------------------
/** The one number each link leads with; link 3 leads with the site's estimate instead. */
const keyFact: Record<ChainLink, FactId | null> = {
  1: 'teds13-mc-co-share',
  2: 'marking-rules-turn-box',
  3: null,
  4: 'co-odourless',
  5: 'hei-sr23-trap-associations',
  6: 'commute-scooter-vs-subway-chuang2020',
  7: 'ev-share-2025',
};
/** How many items wait behind each link's fold: answers, table rows, more charts, pointers. */
const foldItems = (l: (typeof links)[number]) => l.answers.length + l.own.length + foldCount(l.n, l.others.length) + l.pointers.length;
---

<Base locale={locale} title={T.meta.title} description={T.meta.description} share="brief">
  <header class="ev-head" id="ev-top">
    <div class="container"><div class="ev-head__inner">
      <p class="eyebrow">{T.head.kicker}</p>
      <h1 class="display ev-title"><Phrased text={T.head.title} /></h1>
      <p class="lead">{T.head.lead}</p>
      <p class="ev-est"><a href={href('/estimate/', locale)}>{T.head.estimate}<Icon name="arrow-right" size="1.05em" /></a></p>
      <details class="ev-mini" data-ev-fold>
        <summary><span>{T.head.tocLabel}</span><Icon name="chevron-down" size="1.25rem" /></summary>
        <nav class="ev-toc" aria-label={T.head.tocLabel}>
          <ol>
            {toc.map((it) => <li><a href={it.href}>{it.label}</a></li>)}
          </ol>
        </nav>
      </details>
      <details class="ev-mini" data-ev-fold>
        <summary><span>{T.howTo.title}</span><Icon name="chevron-down" size="1.25rem" /></summary>
        <div class="ev-howto">
          <p>{T.howTo.body}</p>
          <ul class="ev-chips">
            {readerKinds.map((k) => <li><KindChip locale={locale} kind={k} /> <span>{readerKindLabels[k].meaning[locale]}</span></li>)}
          </ul>
        </div>
      </details>
    </div></div>
  </header>

  <!-- The seven links at a glance: one tap each (each link's sentence is at the top of its section) -->
  <Section id="chain" title={T.chain.title} lead={T.chain.lead} tone="sunken" width="wide" pad="tight">
    <ol class="ev-board">
      {board.map((b) => (
        <li class="ev-board__row">
          <a class="ev-board__link" href={`#${chain.anchor(b.n)}`}>
            <span class="ev-board__n" aria-hidden="true">{b.n}</span>
            <span class="ev-board__name"><span class="vh">{fill(T.toc.linkN, { n: b.n })}　</span>{b.name}</span>
            <span class="ev-board__chips">
              {b.chips.length ? b.chips.map((c) => <KindChip locale={locale} kind={c} size="sm" />) : <span class="ev-board__machine">{chain.noBadge[locale]}</span>}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </Section>

  {links.map((l, li) => {
    const kf = keyFact[l.n];
    const k = kf ? lf(kf, locale) : null;
    const b = board[l.n - 1];
    return (
    <section id={chain.anchor(l.n)} class:list={['ev-link', li % 2 === 1 && 'tone-sunken']} aria-labelledby={`${chain.anchor(l.n)}-title`} data-link={l.n}>
      <div class="container">
        <header class="ev-link__head">
          <p class="eyebrow">{fill(chain.linkOf[locale], { n: l.n, total: chain.links.length })} · {linkName(l.n)}</p>
          <h2 class="h1 ev-link__title" id={`${chain.anchor(l.n)}-title`}><Phrased text={l.title} /></h2>
          {/* link 2's one-line summary says what its headline and key number already say */}
          {l.n !== 2 && <p class="ev-link__claim">{b.text}</p>}
        </header>

        <div class="ev-link__grid">
          {kf && k ? (
            <div class="ev-key">
              <p class="ev-key__label">{T.key.labels[l.n - 1]}</p>
              <p class="ev-key__value"><Mixed text={k.display} locale={locale} /></p>
              <p class="ev-key__meta"><KindChip locale={locale} of={facts[kf]} /><span>{k.period}</span></p>
              <a class="ev-key__go" href={`#${kf}`}>{T.key.source}<span class="vh">{colon}{k.display}</span><Icon name="arrow-down" size="1.05em" /></a>
            </div>
          ) : (
            <div class="ev-key ev-key--est">
              <p class="ev-key__label">{T.key.labels[2]}</p>
              <p class="ev-l3__p">{T.link3.estLead}</p>
              <div class="ev-l3__row">
                <span class="ev-l3__label">{estimateText.addedByPack[locale]}</span>
                <EstimateValue locale={locale} slotId="co.dozen.add" />
              </div>
              <p class="ev-l3__p">{kSentences.K2[locale]}</p>
              <a class="ev-key__go" href={href('/estimate/', locale)}>{T.link3.estMore}<Icon name="arrow-right" size="1.05em" /></a>
            </div>
          )}

          <div class="ev-visuals ev-visuals--lead">
            {l.n === 1 && <SeriesFigure brief level={3} locale={locale} view={V('teds13-motorcycle-share')} title={T.v5.title} subtitle={T.v5.subtitle} caption={T.v5.caption} tone="exhaust" />}
            {l.n === 2 && <SeriesFigure brief level={3} locale={locale} view={V('wu2021-quiet-route')} title={T.v32.title} subtitle={T.v32.subtitle} caption={T.v32.caption} />}
            {l.n === 3 && <SeriesFigure brief level={3} locale={locale} view={V('taipei-traffic-vs-general-stations')} title={T.v9.title} subtitle={T.v9.subtitle} caption={T.v9.caption} />}
            {l.n === 4 && <SeriesFigure brief level={3} locale={locale} view={V('odour-thresholds')} />}
            {l.n === 5 && <SeriesFigure brief level={3} locale={locale} view={V('hei-sr23-outcomes')} />}
            {l.n === 6 && <SeriesFigure brief level={3} locale={locale} view={strollerView(locale, T, strollerBand)} title={T.v29.title} subtitle={T.v29.subtitle} caption={T.v29.caption} />}
            {l.n === 7 && <SeriesFigure brief level={3} locale={locale} view={V('ev-share-new-registrations')} title={T.v17.title} subtitle={T.v17.subtitle} caption={T.v17.caption} tone="clean" />}
          </div>
        </div>

        <details class="ev-more" data-section-fold data-ev-fold>
          <summary class="ev-more__sum">
            <span class="ev-more__text"><b>{T.more.open}</b><span>{fill(T.more.count, { count: foldItems(l) })}</span></span>
            <span class="ev-more__btn" aria-hidden="true"><Icon name="chevron-down" size="1.4rem" /></span>
          </summary>
          <div class="ev-more__body">
            <p class="ev-link__q"><b>{T.link.question}</b> {l.question}</p>

            {l.n === 3 && (
              <div class="ev-l3__mask">
                <h3 class="ev-sub ev-sub--first">{T.link3.masksTitle}</h3>
                <p class="ev-l3__p">{T.link3.masks}</p>
                <div><a class="ev-go" href={href('/questions/mask/', locale)}>{T.link3.masksLink}<Icon name="arrow-right" size="1.05em" /></a></div>
              </div>
            )}

            {l.n === 5 && (
              <div class="ev-l5">
                <Callout tone="note" label={T.link5.leadTitle}>
                  <p>{fill(T.link5.lead, { studies: nf(studies, 0) })}</p>
                  <p><b>{kSentences.K5[locale]}</b></p>
                </Callout>
                <Callout tone="exhaust" label={T.link5.rulerLabel}>
                  <p>{T.link5.ruler}</p>
                </Callout>
              </div>
            )}

            {l.answers.length > 0 && (
              <Fragment>
                <h3 class="ev-sub">{T.link.answers}</h3>
                <div class="ev-gaps">
                  {l.answers.map((a) => <AnswerCard locale={locale} id={a} level={4} k={['K5']} legacy />)}
                </div>
              </Fragment>
            )}

            <h3 class="ev-sub">{l.n === 5 ? T.link.table5 : T.link.table}</h3>
            <FactList locale={locale} ids={l.own} link={l.n} visible={3} />

            {foldCount(l.n, l.others.length) > 0 && (
              <details class="ev-fold" data-ev-fold>
                <summary><span>{fill(T.row.moreData, { n: l.n, count: foldCount(l.n, l.others.length) })}</span><Icon name="chevron-down" size="1.25rem" /></summary>
                <div class="ev-visuals ev-visuals--fold">
              {l.n === 1 && (
                <Fragment>
                  <figure class="ev-stats" aria-labelledby="v34-t">
                    <h4 class="ev-stats__title" id="v34-t">{T.v34.title}</h4>
                    <div class="ev-stats__grid">
                      {v34.map((s) => {
                        const f = lf(s.id, locale);
                        return (
                          <Stat locale={locale} label={s.label} value={s.value} unit={s.unit} prefix={'prefix' in s ? s.prefix : undefined} tone={'tone' in s ? s.tone : 'neutral'} size="md">
                            {f.statement}{cites(facts[s.id].sources).map((c) => <Cite locale={locale} id={c.id} n={c.n} />)} <a href={`#${s.id}`} class="ev-stat__row" aria-label={`${T.row.permalink}${colon}${s.label}`}>#</a>
                          </Stat>
                        );
                      })}
                    </div>
                    <p class="ev-stats__src"><EvidenceBadge locale={locale} kind="official-tw" /></p>
                  </figure>
                  <SeriesFigure locale={locale} view={V('tunnel-co-by-vehicle-class-ting2023')} title={T.v20.title} subtitle={T.v20.subtitle} caption={T.v20.caption} />
                  <div class="ev-pair">
                    <p class="ev-pair__title">{fill(T.v21.title, v21).replaceAll('|', '')}</p>
                    <p class="ev-pair__sub">{T.v21.subtitle}</p>
                    <div class="ev-pair__grid">
                      <SeriesFigure locale={locale} view={V('tsai2023-benzene-by-class')} caption={T.v21.caption} />
                      <SeriesFigure locale={locale} view={V('tsai2023-hc-by-class')} />
                    </div>
                  </div>
                  <div class="ev-pair">
                    <p class="ev-pair__title">{T.v22.title}</p>
                    <div class="ev-pair__grid">
                      <SeriesFigure locale={locale} view={V('tsai2018-older-phase-excess')} caption={T.v22.caption} />
                      <SeriesFigure locale={locale} view={V('tsai2018-by-mileage')} />
                    </div>
                  </div>
                  <aside class="ev-case" aria-labelledby="case-title">
                    <p class="ev-case__tab">{T.casePanel.label}</p>
                    <div class="ev-case__inner">
                      <h4 class="ev-case__title" id="case-title"><Phrased text={T.casePanel.title} /></h4>
                      <p>{T.casePanel.lead}</p>
