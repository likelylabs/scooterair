---
/**
 * /act/ — 我能做什麼 / What I can do (redesign brief 7.6, amendment 12.2).
 *
 * Five cards by who you are, each with ONE action on top (先做這一件) and a short list below:
 *   #walk · #parents · #ride · #community · #policy
 * then the measurement card (#measure → /estimate/#measure) and the letters (#letters:
 * #letter to a councillor, #committee note). The EV-share chart lives on the policy card.
 *
 * Copy: src/i18n/pages/act.ts. Every number is filled from the registry or src/data/estimate.ts.
 * Chips (KindChip) sit beside the number they qualify; actions without a number carry none.
 */
import Base from '@/layouts/Base.astro';
import Phrased from '@/components/ui/Phrased.astro';
import KindChip from '@/components/ui/KindChip.astro';
import Cite from '@/components/ui/Cite.astro';
import Icon from '@/components/ui/Icon.astro';
import Figure from '@/components/ui/Figure.astro';
import EvShareChart from '@/components/pages/action/EvShareChart.astro';
import Composer from '@/components/pages/action/Composer.astro';
import { datum, lf, num, requiredCaveats, sourcesOf } from '@/components/pages/action/ev';
import { href, localeFromParam, localeStaticPaths } from '@/i18n';
import { chipWhere, kSentences, readerDate, site } from '@/i18n/ui';
import { est, formatEstimate } from '@/data/estimate';
import { facts, localizeSeries, type FactId } from '@/data';
import { snapshot } from '@/lib/site-state.data';
import act from '@/i18n/pages/act';
import { fill, localize } from '@/i18n/pages/_copy';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const t = localize(act, locale);
const en = locale === 'en';
const nextYear = Number(snapshot.yearEnd.slice(0, 4)) + 1;
const yearOf = (id: FactId) => Number(/\d{4}/.exec(lf(id, 'en').period)![0]);
const abs = (v: number) => num(locale, Math.abs(v), 0);

// ---- numbers, all from the registry or the estimate
const tailpipeCm = num(locale, datum('iot-exhaust-height-assumption', 'exhaustHeight') * 100, 0);
const turnGapCm = num(locale, datum('marking-rules-turn-box', 'turnBoxGap') * 100, 0);
const quiet = { benzene: abs(datum('wu2021-quiet-route', 'benzene')), pm25: abs(datum('wu2021-quiet-route', 'pm25')) };
const child = formatEstimate('child.airPerKg', locale);
const top10 = formatEstimate('inspect.top10share', locale);
const twoStrokeN = datum('two-stroke-remaining', 'y2024');
const twoStroke = { year: 2024, count: fill(t.fmt.wan, { n: en ? num(locale, twoStrokeN, 0) : num(locale, twoStrokeN / 10000, 1) }) };
const per100 = { passed: datum('inspection-2025-per-100', 'passed'), failed: datum('inspection-2025-per-100', 'failed'), absent: datum('inspection-2025-per-100', 'absent') };
const per100Total = per100.passed + per100.failed + per100.absent;
const evYear = yearOf('ev-share-2025');
const evTargetKey = `target${evYear}`;
const evShare = { year: evYear, share: num(locale, datum('ev-share-2025', 'share'), 1), target: num(locale, datum('netzero-ev-sales-targets', evTargetKey), 0) };
const deadline = en ? readerDate(snapshot.yearEnd, locale).replace(/ \d{4}$/, '') : readerDate(snapshot.yearEnd, locale).replace(/^\d{4}\s*\S\s*/, '');
const askVars = { nextYear, deadline, total: per100Total, absent: per100.absent, ...evShare };
const askFacts: FactId[][] = [[], [], ['inspection-2025-per-100', 'two-stroke-remaining'], ['ev-share-2025', 'netzero-ev-sales-targets'], ['marking-rules-turn-box'], []];
const fact = (id: FactId) => facts[id];

// ---- the EV-share chart (moved here from the old home page, brief 5.4)
const series = localizeSeries('ev-share-new-registrations', locale);
const actual = series.datasets.find((d) => d.kind !== 'target')!;
const target = series.datasets.find((d) => d.kind === 'target')!;
const observed = actual.points.filter((p) => p.y !== null);
const first = observed[0];
const last = observed[observed.length - 1];
const allX = [...new Set([...actual.points, ...target.points].map((p) => Number(p.x)))].sort((a, b) => a - b);
const years: number[] = [];
for (let y = allX[0]; y <= allX[allX.length - 1]; y++) years.push(y);
const pct = (v: number) => num(locale, v, v % 1 ? 1 : 0);
// targets from the latest observed year on, so the 2025 target sits beside the 2025 figure
const targets = target.points.filter((p) => Number(p.x) >= Number(last.x)).map((p) => ({ x: Number(p.x), y: p.y! }));
const chartDesc = fill(t.policy.chart.desc, {
  y1: first.x,
  s1: pct(first.y!),
  y2: last.x,
  s2: pct(last.y!),
  targets: targets.map((p) => fill(t.fmt.target, { pct: pct(p.y), year: p.x })).join(t.fmt.listSep),
});
const chartCites = sourcesOf(['ev-share-2025', 'netzero-ev-sales-targets']);
const chartCaveats = requiredCaveats(['ev-share-2025', 'netzero-ev-sales-targets'], locale);

// ---- the forwarded message
const siteUrl = new URL(href('/', locale), Astro.site).href;
const lineText = fill(t.walk.line, { sentence: site.sentence[locale], url: siteUrl });
const composerLabels = { subject: t.composer.subject, copied: t.composer.copied, failed: t.composer.failed, mail: t.composer.mail, noStore: t.composer.noStore };

const cards = [
  { id: 'walk', jump: t.walk.jump },
  { id: 'parents', jump: t.parents.jump },
  { id: 'ride', jump: t.ride.jump },
  { id: 'community', jump: t.community.jump },
  { id: 'policy', jump: t.policy.jump },
  { id: 'measure', jump: t.measure.jump },
];
const quietRoute = lf('wu2021-quiet-route', locale);
const guo = lf('mj-cohort-mortality-guo2021', locale);
const idle = lf('idle-stop-mixed-evidence', locale);
---

<Base locale={locale} title={t.meta.title} description={t.meta.description} share="act" money>
  <div class="act">
    <header class="act-hero container container--wide">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 class="display act-hero__t"><Phrased text={t.hero.title} /></h1>
      <p class="act-hero__deck">{t.hero.deck}</p>
      <nav class="jump" aria-labelledby="jump-label">
        <p class="jump__label" id="jump-label">{t.hero.jump}</p>
        <ul>
          {cards.map((c) => (
            <li>
              <a href={`#${c.id}`}>
                <span>{c.jump}</span>
                <Icon name="arrow-down" size="1.1em" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <div class="cards container container--wide">
      <!-- ============================================================ WALK -->
      <section class="card" id="walk" aria-labelledby="walk-t">
        <h2 class="card__t" id="walk-t">{t.walk.title}</h2>
        <div class="first">
          <p class="first__kicker">{t.first}</p>
          <p class="first__do">{t.walk.top}</p>
          <div class="first__why has-chip"><p>{fill(t.walk.topWhy, { cm: tailpipeCm })}</p><KindChip locale={locale} of={fact('iot-exhaust-height-assumption')} size="sm" /></div>
          <div class="first__mask has-chip"><p><span>{t.walk.mask}</span></p><KindChip locale={locale} of={fact('mask-niosh-no-gas')} size="sm" /></div>
          <a class="card__link" href={href('/questions/mask/', locale)}>{t.walk.maskLink}<Icon name="arrow-right" size="1.05em" /></a>
        </div>
        <h3 class="more__t">{t.more}</h3>
        <ul class="more">
          <li>
            <p class="more__do">{t.walk.route}</p>
            <div class="more__why has-chip"><p>{fill(t.walk.routeWhy, quiet)}</p><KindChip locale={locale} of={fact('wu2021-quiet-route')} size="sm" /></div>
            {quietRoute.caveat && <details class="careful" data-sheet open data-shut-with-js><summary>{t.careful}</summary><p>{quietRoute.caveat}</p></details>}
          </li>
          <li>
            <p class="more__do">{t.walk.keepWalking}</p>
            <div class="more__why has-chip"><p>{t.walk.keepWalkingWhy}</p><KindChip locale={locale} kind="study" where={chipWhere.taiwan[locale]} size="sm" /></div>
            {guo.caveat && <details class="careful" data-sheet open data-shut-with-js><summary>{t.careful}</summary><p>{guo.caveat}</p></details>}
          </li>
          <li>
            <p class="more__do">{t.walk.smoky}</p>
          </li>
          <li>
            <p class="more__do">{t.walk.share}</p>
            <div class="msg" id="message">
              <h4 class="msg__t">{t.walk.lineTitle}</h4>
              <Composer
                locale={locale}
                id="line-message"
                title={t.walk.lineTitle}
                body={lineText}
                labels={{ copy: t.walk.copy, copied: t.composer.copied, failed: t.composer.failed }}
                share={{ href: `https://line.me/R/share?text=${encodeURIComponent(lineText)}`, label: t.walk.lineShare }}
              />
            </div>
          </li>
        </ul>
      </section>

      <!-- ============================================================ PARENTS -->
      <section class="card" id="parents" aria-labelledby="parents-t">
        <h2 class="card__t" id="parents-t">{t.parents.title}</h2>
        <div class="first">
          <p class="first__kicker">{t.first}</p>
          <p class="first__do">{t.parents.top}</p>
          <div class="first__why has-chip"><p>{fill(t.parents.topWhy, { lo: child.lo, hi: child.hi })}</p><KindChip locale={locale} of={fact('child-air-per-kg')} size="sm" /></div>
        </div>
        <h3 class="more__t">{t.more}</h3>
        <ul class="more">
          <li>
            <p class="more__do">{t.parents.poster}</p>
            <a class="card__link" href={href('/print/poster/', locale)}>{t.parents.posterLink}<Icon name="arrow-right" size="1.05em" /></a>
          </li>
          <li>
            <p class="more__do">{t.parents.film}</p>
            <a class="card__link" href={href('/90/', locale)}>{t.parents.filmLink}<Icon name="arrow-right" size="1.05em" /></a>
          </li>
          <li>
            <p class="more__do">{t.parents.child}</p>
            <a class="card__link" href={href('/questions/my-child/', locale)}>{t.parents.childLink}<Icon name="arrow-right" size="1.05em" /></a>
          </li>
        </ul>
      </section>

      <!-- ============================================================ RIDE -->
      <section class="card" id="ride" aria-labelledby="ride-t">
        <h2 class="card__t" id="ride-t">{t.ride.title}</h2>
        <div class="first">
          <p class="first__kicker">{t.first}</p>
          <p class="first__do">{t.ride.top}</p>
          <div class="first__why has-chip"><p>{fill(t.ride.topWhy, { share: top10.text })}</p><KindChip locale={locale} kind="derived" size="sm" /></div>
          <a class="card__link card__link--primary" href={href('/electric/', locale)}>{t.ride.calcLink}<Icon name="arrow-right" size="1.05em" /></a>
        </div>
        <h3 class="more__t">{t.more}</h3>
        <ul class="more">
          <li>
            <div class="more__do has-chip"><p>{fill(t.ride.twoStroke, twoStroke)}</p><KindChip locale={locale} of={fact('two-stroke-remaining')} size="sm" /></div>
          </li>
          <li>
            <div class="more__do has-chip"><p>{t.ride.idle}</p><KindChip locale={locale} of={fact('idle-stop-mixed-evidence')} size="sm" /></div>
            {idle.caveat && <details class="careful" data-sheet open data-shut-with-js><summary>{t.careful}</summary><p>{idle.caveat}</p></details>}
          </li>
          <li>
            <p class="more__do">{t.ride.rider}</p>
            <a class="card__link" href={href('/questions/rider/', locale)}>{t.ride.riderLink}<Icon name="arrow-right" size="1.05em" /></a>
          </li>
        </ul>
      </section>

      <!-- ============================================================ COMMUNITY -->
      <section class="card" id="community" aria-labelledby="community-t">
        <h2 class="card__t" id="community-t">{t.community.title}</h2>
        <div class="first">
          <p class="first__kicker">{t.first}</p>
          <p class="first__do">{t.community.top}</p>
          <a class="card__link card__link--primary" href={href('/print/poster/', locale)}>{t.community.topLink}<Icon name="arrow-right" size="1.05em" /></a>
        </div>
        <h3 class="more__t">{t.more}</h3>
        <ul class="more">
          <li>
            <p class="more__do">{t.community.charge}</p>
            <a class="card__link" href="#committee">{t.community.chargeLink}<Icon name="arrow-down" size="1.05em" /></a>
          </li>
          <li>
            <p class="more__do">{t.community.crossing}</p>
            <div class="more__why has-chip"><p>{fill(t.community.crossingWhy, { gap: turnGapCm })}</p><KindChip locale={locale} of={fact('marking-rules-turn-box')} size="sm" /></div>
          </li>
          <li>
            <p class="more__do">{t.community.notice}</p>
          </li>
        </ul>
      </section>

      <!-- ============================================================ POLICY -->
      <section class="card card--wide" id="policy" aria-labelledby="policy-t">
        <h2 class="card__t" id="policy-t">{t.policy.title}</h2>
        <div class="first">
          <p class="first__kicker">{t.first}</p>
          <p class="first__do">{fill(t.policy.top, { nextYear })}</p>
          <p class="first__why">
            {fill(t.policy.topWhy, { nextYear })}
          </p>
        </div>

        <h3 class="more__t" id="asks">{t.policy.asksTitle}</h3>
        <p class="asks__lead">{t.policy.asksLead}</p>
        <ol class="asks">
          {t.policy.asks.map((a, i) => (
            <li class="ask">
              <span class="ask__n" aria-hidden="true">{i + 1}</span>
              <div class="ask__body">
                <div class="ask__text has-chip">
                  <p>{fill(a.ask, askVars)}</p>
                  {askFacts[i].length > 0 && <KindChip locale={locale} of={fact(askFacts[i][0])} size="sm" />}
                </div>
                <p class="ask__label">
                  <span class="ask__label-l">{t.policy.to}</span>
                  {a.to}
                </p>
                {i === 5 && <p class="ask__label">{t.policy.position}</p>}
              </div>
            </li>
          ))}
        </ol>

        <Figure locale={locale} title={t.policy.chart.title} subtitle={t.policy.chart.subtitle} badge="official-tw" class="ev-fig">
          <EvShareChart
            locale={locale}
            title={t.policy.chart.chart}
            desc={chartDesc}
            years={years}
            actual={years.map((y) => actual.points.find((p) => Number(p.x) === y)?.y ?? null)}
            targets={targets}
            labels={{ first: { x: Number(first.x), y: first.y!, text: `${pct(first.y!)}%` }, last: { x: Number(last.x), y: last.y!, text: `${pct(last.y!)}%` } }}
            format={(v: number) => `${pct(v)}%`}
            names={{ actual: t.policy.chart.actual, target: t.policy.chart.target, year: t.policy.chart.year }}
          />
          <Fragment slot="caption">{chartCaveats.map((c, i) => <>{i > 0 && <br />}{c.text}</>)}</Fragment>
          <Fragment slot="source">{chartCites.map((c) => <Cite locale={locale} id={c.id} n={c.n} variant="chip" />)}</Fragment>
        </Figure>
        <a class="card__link" href="#letter">{t.letter.title}<Icon name="arrow-down" size="1.05em" /></a>
      </section>

      <!-- ============================================================ MEASURE -->
      <section class="card card--measure" id="measure" aria-labelledby="measure-t">
        <h2 class="card__t" id="measure-t">{t.measure.title}</h2>
        <p class="measure__k">{kSentences.K1[locale]}</p>
        <p class="measure__p">{t.measure.body}</p>
        <a class="card__link card__link--primary" href={href('/estimate/#measure', locale)}>{t.measure.link}<Icon name="arrow-right" size="1.05em" /></a>
      </section>
    </div>

    <!-- ============================================================ LETTERS -->
    <section class="letters container container--wide" id="letters" aria-labelledby="letters-t">
      <h2 class="letters__t" id="letters-t">{t.letters.title}</h2>
      <p class="letters__lead">{t.letters.lead}</p>

      <div class="letter" id="letter">
        <h3 class="letter__t">{t.letter.title}</h3>
        <p>{t.letter.lead}</p>
        <Composer
          locale={locale}
          id="councillor-letter"
          title={t.letter.title}
          fields={[
            { key: 'name', label: t.letter.name },
            { key: 'city', label: t.letter.city, hint: t.letter.cityHint, autocomplete: 'address-level1' },
            { key: 'sender', label: t.letter.sender, autocomplete: 'name' },
            { key: 'contact', label: t.letter.contact, autocomplete: 'email' },
          ]}
          subject={fill(t.letter.subject, { nextYear })}
          body={fill(t.letter.body, { nextYear, sites: est.meas.iot.sites.value })}
          labels={{ ...composerLabels, copy: t.letter.copy, fields: t.letter.fields }}
        />
      </div>

      <div class="letter" id="committee">
        <h3 class="letter__t">{t.note.title}</h3>
        <p class="letter__honest">{t.note.honest}</p>
        <Composer
          locale={locale}
          id="committee-note"
          title={t.note.title}
          fields={[
            { key: 'building', label: t.note.building },
            { key: 'name', label: t.note.name, autocomplete: 'name' },
          ]}
          subject={t.note.subject}
          body={t.note.body}
          labels={{ ...composerLabels, copy: t.note.copy, fields: t.note.fields }}
        />
      </div>
    </section>
  </div>
</Base>

<script>
  // "What to be careful about" is open without JavaScript (every sheet's content shows, brief
  // 9.3 check 15) and starts closed with it, like the HowSheet fallback.
  document.querySelectorAll<HTMLDetailsElement>('details[data-shut-with-js]').forEach((d) => (d.open = false));
</script>

<style>
  .act {
    padding-block-end: var(--sp-8);
  }
  .act-hero {
    padding-block: var(--sp-6) var(--sp-5);
  }
  .act-hero__t {
    margin-block: var(--sp-2) var(--sp-3);
  }
  .act-hero__deck {
    margin: 0;
    max-inline-size: 38rem;
    font-size: var(--fs-base);
    line-height: var(--lh-read, 1.6);
  }
  .jump {
    margin-block-start: var(--sp-5);
  }
  .jump__label {
    margin: 0 0 var(--sp-2);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .jump ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--tap-gap, 0.5rem);
  }
  .jump a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
    min-block-size: var(--tap, 3rem);
    padding: var(--sp-2) var(--sp-3);
    border: 2px solid var(--ink);
    border-radius: var(--radius-2);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--fs-btn, 1.0625rem);
    font-weight: var(--fw-bold);
    line-height: 1.3;
    text-decoration: none;
  }
  .jump a:hover {
    background: var(--bg-sunken);
  }
  .jump a :global(svg) {
    flex: none;
  }

  .cards {
    display: grid;
    gap: var(--sp-5);
  }
  @media (min-width: 56em) {
    .cards {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
    .card--wide,
    .card--measure {
      grid-column: 1 / -1;
    }
  }
  .card {
    scroll-margin-block-start: calc(var(--header-h, 48px) + var(--sp-3));
    display: grid;
    gap: var(--sp-3);
    align-content: start;
    min-inline-size: 0;
    padding: var(--sp-5) var(--sp-4);
    border: 2px solid var(--line-strong);
    border-radius: var(--radius-3, 12px);
    background: var(--surface);
  }
  @media (min-width: 40em) {
    .card {
      padding: var(--sp-5);
    }
  }
  .card p {
    margin: 0;
  }
  .card__t {
    margin: 0;
    font-size: var(--fs-headline, 1.6875rem);
    font-weight: var(--fw-black);
    line-height: var(--lh-headline, 1.28);
    text-wrap: balance;
  }
  .first {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-4);
    border-radius: var(--radius-2);
    background: var(--bg-sunken);
    border-inline-start: 6px solid var(--clean);
  }
  .first__kicker {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--ink);
  }
  .first__do {
    font-size: 1.3125rem;
    font-weight: var(--fw-black);
    line-height: 1.45;
  }
  .first__why,
  .first__mask,
  .more__why,
  .more__do {
    font-size: var(--fs-base);
    line-height: var(--lh-read, 1.6);
  }
  .first__mask {
    padding-block-start: var(--sp-3);
    border-block-start: 1px solid var(--line);
    font-weight: var(--fw-bold);
  }
  .has-chip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-3);
  }
  .has-chip > p {
    flex: 1 1 100%;
    margin: 0;
  }
  .card__link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-block-size: var(--tap, 3rem);
    padding: 0 var(--sp-3);
    border: 2px solid var(--ink);
    border-radius: var(--radius-2);
    color: var(--ink);
    background: var(--surface);
    font-size: var(--fs-btn, 1.0625rem);
    font-weight: var(--fw-bold);
    text-decoration: none;
  }
  .card__link:hover {
    background: var(--bg-sunken);
  }
  .card__link--primary {
    background: var(--go-ink-bg, var(--clean));
    border-color: var(--go-ink-bg, var(--clean));
    color: #fff;
  }
  .card__link--primary:hover {
    background: var(--go-ink-bg, var(--clean));
    filter: brightness(1.08);
  }
  .more__t {
    margin: var(--sp-2) 0 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .more {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .more > li {
    display: grid;
    gap: var(--sp-2);
    padding-block: var(--sp-3);
    border-block-start: 1px solid var(--line);
  }
  .more > li:first-child {
    border-block-start: 0;
    padding-block-start: 0;
  }
  .more__do {
    font-weight: var(--fw-bold);
  }
  .more__why {
    color: var(--ink);
  }
  .careful summary {
