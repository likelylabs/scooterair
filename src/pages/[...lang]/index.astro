---
/**
 * Home — placeholder shell.
 * The real long-form narrative is written by the home workstream (blueprint
 * Part 3); this file only proves the shell: Base, the rail slot, the prologue
 * from its copy module and the signature scene. Copy lives in
 * src/i18n/pages/home.ts, never inline here (see src/i18n/pages/_copy.ts).
 */
import Base from '@/layouts/Base.astro';
import Button from '@/components/ui/Button.astro';
import Phrased from '@/components/ui/Phrased.astro';
import PollutantKey from '@/components/art/PollutantKey.astro';
import Signal from '@/components/art/Signal.astro';
import StreetScene from '@/components/art/StreetScene.astro';
import { href, localeFromParam, localeStaticPaths } from '@/i18n';
import { nav, questions, site, ui } from '@/i18n/ui';
import home from '@/i18n/pages/home';
import { localize } from '@/i18n/pages/_copy';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const t = localize(home, locale).prologue;
---

<Base locale={locale} title={site.name[locale]} home>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__text">
      <p class="eyebrow hero__kicker">
        <Signal state="red" size="2rem" label={ui.phaseRed[locale]} />
        <span>{t.kicker}</span>
      </p>
      <h1 id="hero-title" class="display"><Phrased text={t.title} /></h1>
      <p class="lead">{t.deck}</p>
      <div class="cluster">
        <Button href={href(nav[0].path, locale)} size="lg" arrow>{questions.all[locale]}</Button>
        <Button href={href('/electric/', locale)} size="lg" variant="secondary">{questions.chips[5].label[locale]}</Button>
      </div>
    </div>
    <div class="hero__scene">
      <StreetScene locale={locale} />
    </div>
    <div class="container hero__key">
      <p class="meta">{t.disclosure}</p>
      <PollutantKey locale={locale} />
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: var(--sp-6);
    padding-block-start: clamp(2rem, 6vw, 4.5rem);
  }
  .hero__text {
    display: grid;
    gap: var(--sp-4);
    justify-items: start;
  }
  .hero__kicker::before {
    display: none;
  }
  .hero__kicker {
    color: var(--signal-red-ink);
  }
  .hero__scene {
    max-inline-size: 110rem;
    inline-size: 100%;
    margin-inline: auto;
    border-block-end: 1px solid var(--line);
  }
  .hero__key {
    display: grid;
    gap: var(--sp-4);
  }
</style>
