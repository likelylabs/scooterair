---
import Base from '@/layouts/Base.astro';
import StreetScene from '@/components/art/StreetScene.astro';
import { localeFromParam, localeStaticPaths } from '@/i18n';
import { site } from '@/i18n/ui';
export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
---

<Base locale={locale} title={site.name[locale]} home>
  <div class="container" style="padding-block: 3rem 1rem">
    <p class="eyebrow">{site.name[locale]}</p>
    <h1 class="display">{site.tagline[locale]}</h1>
    <p class="lead">{site.description[locale]}</p>
  </div>
  <StreetScene locale={locale} />
  <StreetScene locale={locale} state="clean" />
</Base>
