---
import { absUrl } from '../../lib/abs-url.ts';
/**
 * Home — one red light in fifteen screens (docs/redesign-brief.md section 3, with amendment
 * 12.2: the masks screen is the tenth; the rail is red to screen 12 and green from 13).
 *
 * Each screen is one <Screen> (lane B): one picture, one headline, at most two sentences, an
 * optional quiet line, the sheet behind 怎麼知道的？ and a next button whose words are the
 * question the next screen answers. Scrolling is ordinary scrolling; from 900 px a screen is a
 * two-column row. Pictures are lane C's scenes and lane D's charts.
 *
 * Where things come from
 *   words     src/i18n/pages/home.ts (never inline here); the estimate's own sentences from
 *             src/data/estimate.ts; the K sentences and chip names from src/i18n/ui.ts; the
 *             money headlines and rule-chosen money sentences from src/i18n/pages/electric.ts
 *   numbers   the estimate slots (EstimateValue, formatEstimate), the registry
 *             (./home-figures.ts) and the calculator's tables (./money-view.ts). None is typed
 *   rules     screen 4's second sentence: kerbSentence(); screen 5's headline: checkHeadline()
 *             (farBelowWho()), its first body line: checkSentence() (checkRule()); screens 13 and 14: lane I's buyHeadline / monthHeadline /
 *             monthLine; the pins of screen 6 and the quiet line of screen 2 ship only while
 *             their registry facts are verified
 *
 * Without JavaScript every screen shows its picture, its words and its sheet (an open block
 * under it); the money screens show the default case (新北市, a scooter to scrap, 300 km).
 */
import '@/styles/charts.css';
import '@/components/pages/home/home.css';
import Base from '@/layouts/Base.astro';
import EstimateValue from '@/components/ui/EstimateValue.astro';
import HowSheet from '@/components/ui/HowSheet.astro';
import IllustrationTag from '@/components/ui/IllustrationTag.astro';
import KindChip from '@/components/ui/KindChip.astro';
import NextButton from '@/components/ui/NextButton.astro';
import ScenarioSwitch from '@/components/ui/ScenarioSwitch.astro';
import Screen from '@/components/ui/Screen.astro';
import ScreenRail from '@/components/ui/ScreenRail.astro';
import Segmented from '@/components/ui/Segmented.astro';
import AirKey from '@/components/art/AirKey.astro';
import AirRange from '@/components/art/AirRange.astro';
import ApproachPlan from '@/components/art/ApproachPlan.astro';
import BodyFigure from '@/components/art/BodyFigure.astro';
import BodyPins from '@/components/art/BodyPins.astro';
import FixButton from '@/components/art/FixButton.astro';
import HeightsScene from '@/components/art/HeightsScene.astro';
import HeroStreet from '@/components/art/HeroStreet.astro';
import KerbScene from '@/components/art/KerbScene.astro';
import MaskScene from '@/components/art/MaskScene.astro';
import RiderScene from '@/components/art/RiderScene.astro';
import RoadOfTime from '@/components/art/RoadOfTime.astro';
import SwapControl from '@/components/art/SwapControl.astro';
import SwapScene from '@/components/art/SwapScene.astro';
import TailpipeMarks from '@/components/art/TailpipeMarks.astro';
import TenScooters from '@/components/art/TenScooters.astro';
import ChartTable from '@/components/charts/ChartTable.astro';
import MeasuredVsEstimate from '@/components/charts/MeasuredVsEstimate.astro';
import PriceBars from '@/components/charts/PriceBars.astro';
import WorkingSum from '@/components/charts/WorkingSum.astro';
import { mveModel } from '@/components/charts/core/estimateCharts';
import { monthlyBarsTitle, renderMonthlyBars } from '@/components/charts/core/monthlyBars';
import { workingHoursPerYear, workingKerbFlow, workingPerRed, workingPerRedCan } from '@/components/charts/core/workingSum';
import { openingData } from '@/components/pages/electric/opening-data';
import { tableOn, type OpenText } from '@/components/pages/electric/opening-view';
import { filmLength, homeFigures, verified } from '@/components/pages/home/home-figures';
import * as V from '@/components/pages/home/money-view';
import { checkHeadlinePhrased, checkSentence, defaultRedsPerDay, est, waitPerRed_s, estimateText, farBelowWho, formatEstimate, formatReference, kerbSentence, redsPerDayOptions, scenarioKeys } from '@/data/estimate';
import { fact } from '@/data/facts';
import { href, localeFromParam, localeStaticPaths } from '@/i18n';
import { homeMoney } from '@/lib/home-money';
import { formatDate } from '@/lib/site-state';
import electric from '@/i18n/pages/electric';
import home from '@/i18n/pages/home';
import { fill, localize } from '@/i18n/pages/_copy';
import { chipWhere, how, kSentences, num, redHoursSentence, site, ui } from '@/i18n/ui';

export const getStaticPaths = localeStaticPaths;
const locale = localeFromParam(Astro.params.lang);
const t = localize(home, locale);
const zh = locale === 'zh-TW';
const sp = zh ? '' : ' '; // between two sentences: nothing in Chinese, a space in English
/** Headlines: '|' marks phrases for Chinese, which has no spaces. English breaks between words by
 *  itself, and a long English phrase kept whole would take a line of its own, so the marks go. */
const hl = (s: string) => V.headlineMarks(s, locale);
/** The chips beside 怎麼知道的？: English chip words are longer, so they are set at the 14 px step */
const chipSize = zh ? 'md' : 'sm';
const TOTAL = 15;
const F = homeFigures(locale);
const evidence = (n: number) => href(`/evidence/#link-${n}`, locale);

// ---- screen 1 --------------------------------------------------------------------------------
const filmHref = href('/90/', locale);
const filmLabel = fill(t.common.film, { length: filmLength(t.common) });

// ---- screen 5: the headline is chosen by the written rule; mark where its line may break ------
const s5Headline = checkHeadlinePhrased(locale);
const mve = mveModel(locale);
// the cross-check paragraph: its first sentence is the measured rise, the rest is our working
const crossCheck = estimateText.crossCheck[locale];
// (the sentences up to and including the measured rise, the one that names ppm)
const crossCut = crossCheck.indexOf(zh ? '。' : '. ', crossCheck.indexOf('ppm')) + 1;
const crossMeasured = crossCheck.slice(0, crossCut).trim();
const crossOurs = crossCheck.slice(crossCut).trim();

// ---- screen 7: the assumption behind the yearly hours, the same sentence the film's transcript prints
const s7Assume = redHoursSentence(locale, waitPerRed_s.lo, waitPerRed_s.hi);

// ---- screen 6: a pin ships only with its verified fact ----------------------------------------
const pinFacts = { nose: 'route-irritant-vapour', lungs: 'route-particles-deep-lung', blood: 'route-co-blood' } as const;
const pins = (['nose', 'lungs', 'blood'] as const).filter((p) => verified(pinFacts[p]));

// ---- screen 7 --------------------------------------------------------------------------------
const posts: [any, any, any] = [
  { when: fill(t.s7.posts.minutes.when, { min: F.peakMinutes }), text: fill(t.s7.posts.minutes.text, { people: F.peakPeople }), kind: 'study', where: chipWhere.taiwan[locale] },
  { when: fill(t.s7.posts.hours.when, { h: F.walkHours }), text: t.s7.posts.hours.text, kind: 'study', where: chipWhere.abroad[locale] },
  { when: t.s7.posts.years.when, text: fill(t.s7.posts.years.text, { n: F.studies }), kind: 'study', where: chipWhere.international[locale] },
];

// ---- screen 10: the four masks, in the order of research/masks/VERIFIED.json → tableRows -------
const maskOrder = ['cloth', 'surgical', 'carbon', 'n95'] as const;

// ---- screens 13 and 14: the calculator's own tables (lane I) ---------------------------------
const D = openingData(locale);
// the day the prices were checked: without the year while it is this year's
const checkedOn = homeMoney(D.built).checkedOn;
const checkedDate = formatDate(checkedOn, locale, checkedOn.slice(0, 4) !== D.built.slice(0, 4));
const T = localize(electric, locale).open as unknown as OpenText;
const H: V.HomeMoneyText = {
  bodyClass: t.s13.bodyClass,
  swapOnly: t.s13.swapOnly,
  bodyKm: t.s14.bodyKm,
  swapDearer: t.s14.swapDearer,
  swapCheaper: t.s14.swapCheaper,
  sheetElectric: t.s13.sheet.electric,
  sheetPetrol: t.s13.sheet.petrol,
  sheetList: t.s13.sheet.list,
  sheetPaid: t.s13.sheet.paid,
  sheetNone: t.s13.sheet.none,
  sheetUpTo: t.s13.sheet.upTo,
  figWho: t.s13.figWho,
  checked: fill(t.common.checked, { date: checkedDate }),
  monthHead: t.s14.headline,
};
const P: V.HomeMoneyPayload = { D, T, H, calc: href('/electric/', locale) };
const table = tableOn(D, D.built);
const choice: V.HomeChoice = { county: D.defaults.county, scrap: D.defaults.scrap, km: D.defaults.km };
const calc = V.calcHref(P.calc, choice);
const countyName = D.counties.find((c) => c.id === choice.county)!.name;
const price = V.priceBarsProps(P, table, choice);

// ---- screen 15 -------------------------------------------------------------------------------
const pageUrl = absUrl(href('/', locale), Astro.site);
const lineHref = `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(pageUrl)}`;
---

<Base locale={locale} title={t.meta.title} description={t.meta.description} home share="home">
  <ScreenRail slot="rail" locale={locale} total={TOTAL} chapter={t.s1.chapter} />

  <div class="h-home">
    <h1 class="vh">{site.name[locale]}{zh ? '：' : ': '}{site.tagline[locale]}</h1>

    <!-- 1 · 紅燈亮了 ====================================================================== -->
    <Screen locale={locale} n={1} total={TOTAL} chapter={t.s1.chapter} headline={hl(t.s1.headline)} body={fill(t.s1.body, { s: F.red })} illustration next={{ label: t.s1.next }}>
      <HeroStreet slot="picture" locale={locale} />
      <Fragment slot="chips">
        <KindChip size={chipSize} locale={locale} of={fact('iot-pedestrian-wait')} where="" />
        <KindChip size={chipSize} locale={locale} kind="estimate" />
      </Fragment>
      <a slot="actions" class="h-act h-act--film" href={filmHref}>
        <svg class="h-act__play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4.5v15l12.5-7.5z" fill="currentColor"></path></svg>
        <span>{filmLabel}</span>
      </a>
      <HowSheet slot="sheet" id="how-1" locale={locale} kind="official" title={fill(t.s1.sheet.title, { s: F.red, n: F.drawn })} facts="iot-pedestrian-wait" primary={{ href: evidence(2) }} secondary={{ href: href('/estimate/#count', locale), label: t.s1.sheet.count }}>
        <p slot="block1">{t.s1.sheet.who}</p>
        <p slot="block2">{fill(t.s1.sheet.what, { s: F.red, lo: F.wait.lo, hi: F.wait.hi })}</p>
        <p slot="block3">{fill(t.s1.sheet.care, { n: F.drawn, name: F.dozen.name[locale], clo: F.dozen.count.lo, chi: F.dozen.count.hi })}</p>
      </HowSheet>
    </Screen>

    <!-- 2 · 排出什麼 ====================================================================== -->
    <Screen locale={locale} n={2} total={TOTAL} chapter={t.s2.chapter} headline={hl(t.s2.headline)} body={t.s2.body} quiet={verified('who-benzene-no-safe-level') ? t.s2.quiet : undefined} next={{ label: t.s2.next }}>
      <div slot="picture" class="h-pic">
        <div class="h-crop" style="--crop:8">
          <TailpipeMarks locale={locale}>
            <EstimateValue slot="chip" locale={locale} slotId="emit.co.perRed_can" label={t.s2.canLabel} sheet="how-2" />
          </TailpipeMarks>
        </div>
        <IllustrationTag locale={locale} />
        <div class="h-pic__ctl"><AirKey locale={locale} tap layout="row" class="h-key" /></div>
      </div>
      <HowSheet slot="sheet" id="how-2" locale={locale} kind="estimate" anchor="recipe" title={t.s2.sheet.title} facts={['iarc-benzene-group1', 'who-benzene-no-safe-level', 'co-odourless']}>
        <p slot="block1">{fill(t.s2.sheet.measured, { readings: F.readings })}</p>
        <Fragment slot="block2">
          <WorkingSum locale={locale} {...workingPerRed(locale)} />
          <WorkingSum locale={locale} {...workingPerRedCan(locale)} />
          <p>{fill(t.s2.sheet.can, { litres: formatEstimate('emit.co.perRed_L', locale).text, ml: F.canMl, cans: est.emit.co.canWords[locale] })}</p>
        </Fragment>
        <Fragment slot="block3">
          <p>{t.s2.sheet.care}</p>
          <p><a href={evidence(1)}>{how.fullEvidence[locale]}</a></p>
        </Fragment>
      </HowSheet>
    </Screen>

    <!-- 3 · 排在哪裡 ====================================================================== -->
    <Screen locale={locale} n={3} total={TOTAL} chapter={t.s3.chapter} headline={hl(t.s3.headline)} body={fill(t.s3.body, { h: F.tailpipeCm, gap: F.gapCm })} illustration next={{ label: t.s3.next }}>
      <ApproachPlan slot="picture" locale={locale} />
      <Fragment slot="chips">
        <KindChip size={chipSize} locale={locale} of={fact('marking-rules-turn-box')} where="" />
        <KindChip size={chipSize} locale={locale} of={fact('iot-exhaust-height-assumption')} where="" />
      </Fragment>
      <HowSheet slot="sheet" id="how-3" locale={locale} kind="official" title={fill(t.s3.sheet.title, { gap: F.gapCm })} facts={['marking-rules-turn-box', 'iot-exhaust-height-assumption', 'idling-regulation']} primary={{ href: evidence(2) }}>
        <p slot="block1">{t.s3.sheet.who}</p>
        <p slot="block2">{fill(t.s3.sheet.what, { h: F.tailpipeCm, gap: F.gapCm })}</p>
        <p slot="block3">{fill(t.s3.sheet.care, { gap: F.gapCm, min: F.idleMinutes })}</p>
      </HowSheet>
    </Screen>

    <!-- 4 · 吸進多少 ====================================================================== -->
    <Screen locale={locale} n={4} total={TOTAL} chapter={t.s4.chapter} headline={hl(t.s4.headline)} quiet={t.s4.quiet} next={{ label: t.s4.next }} class="h-s4">
      <div slot="picture" class="h-pic">
        <div class="h-box">
          <div class="h-box__row">
            <span class="h-box__what">{estimateText.alreadyThere[locale]}</span>
            <span class="h-box__val"><b>{formatReference(est.bg.co.traffic.shown, 'ppm', locale)}</b> <KindChip locale={locale} of={fact('moenv-co-stations-2025')} where="" size="sm" /></span>
          </div>
          <div class="h-box__row h-box__row--est">
            {scenarioKeys.map((s) => <EstimateValue locale={locale} slotId={`co.${s}.add`} label={estimateText.addedByPack[locale]} sheet="how-4" class="est--ring" data-when-scenario={s} data-say />)}
          </div>
          <p class="h-box__gloss"><b>{t.s4.box}</b><span aria-hidden="true">｜</span>{estimateText.ppmGloss[locale]}</p>
        </div>
        <KerbScene locale={locale} />
        <IllustrationTag locale={locale} />
        <div class="h-pic__ctl"><ScenarioSwitch locale={locale} /></div>
      </div>
      <p slot="body">{est.meta.gloss[locale]}{sp}{scenarioKeys.map((s) => <span data-when-scenario={s}>{kerbSentence(s, locale)}</span>)}</p>
      <HowSheet slot="sheet" id="how-4" locale={locale} kind="estimate" pollutant="co" anchor="recipe" title={t.s4.sheet.title} facts={['iot-waiting-area-co-2024', 'moenv-co-stations-2025']}>
        <p slot="block1">{fill(t.s4.sheet.measured, { sites: F.sites, n: F.peakSites, lo: F.peakLo, hi: F.peakHi })}</p>
        <Fragment slot="block2">{scenarioKeys.map((s) => <div data-when-scenario={s}><WorkingSum {...workingKerbFlow(locale, s)} /></div>)}</Fragment>
        <Fragment slot="block3">
          <p>{est.meta.appliesTo[locale]}{sp}{t.s4.sheet.care}</p>
          {scenarioKeys.map((s) => <div data-when-scenario={s}><AirRange locale={locale} scenario={s} /></div>)}
        </Fragment>
      </HowSheet>
    </Screen>

    <!-- 5 · 量到的，和算的 ================================================================= -->
    <Screen locale={locale} n={5} total={TOTAL} chapter={t.s5.chapter} headline={hl(s5Headline)} quiet={verified('who-benzene-no-safe-level') ? estimateText.benzeneWho[locale] : undefined} next={{ label: t.s5.next }}>
      <div slot="picture" class="h-pic h-pic--chart h-pic--mve"><MeasuredVsEstimate locale={locale} sheet="how-5" table={false} compact /></div>
      <div slot="body" class="h-lines">
        <p>{checkSentence(locale)}</p>
        {farBelowWho() && <p>{estimateText.belowIsNotSafe[locale]}</p>}
        <p>{estimateText.coMarksBenzene[locale]}</p>
      </div>
      <HowSheet slot="sheet" id="how-5" locale={locale} kind="measured" where={chipWhere.taiwan[locale]} facts={['iot-waiting-area-co-2024', 'moenv-co-stations-2025']} primary={{ href: evidence(3) }} secondary={{ href: href('/estimate/#check', locale), label: how.fullMethod[locale] }}>
        <p slot="block1">{t.s5.sheet.who}</p>
        <Fragment slot="block2">
          <p>{crossMeasured}</p>
          <p>{crossOurs}</p>
        </Fragment>
        <p slot="block3">{estimateText.whoAveraging[locale]}</p>
        <ChartTable table={mve.table} caption={t.s5.sheet.table} />
      </HowSheet>
    </Screen>

    <!-- 6 · 吸進去以後 ==================================================================== -->
    <Screen locale={locale} n={6} total={TOTAL} chapter={t.s6.chapter} headline={hl(t.s6.headline)} body={fill(t.s6.body, { n: F.studies })} quiet={kSentences.K5[locale]} next={{ label: t.s6.next }} class="h-s6">
      <div slot="picture" class="h-pic">
        <BodyFigure locale={locale} pins={[...pins]} />
        <IllustrationTag locale={locale} kind="body" />
        <div class="h-pic__ctl h-pins" aria-live="polite">
          {pins.length > 0 && <p class="h-pins__hint" data-js-only>{t.s6.hint}</p>}
          <BodyPins locale={locale} items={pins.map((pin) => ({ pin, text: t.s6.pins[pin] }))} />
        </div>
      </div>
      <KindChip size={chipSize} slot="chips" locale={locale} kind="study" where={chipWhere.longTermAllTraffic[locale]} fact="hei-sr23-trap-associations" />
      <HowSheet slot="sheet" id="how-6" locale={locale} kind="study" where={chipWhere.international[locale]} facts={['hei-sr23-trap-associations', ...pins.map((p) => pinFacts[p])]} primary={{ href: evidence(5) }}>
        <p slot="block1">{fill(t.s6.sheet.who, { n: F.studies })}</p>
        <p slot="block2">{t.s6.sheet.what}</p>
        <Fragment slot="block3">
          <p>{t.s6.sheet.care}</p>
          {pins.length > 0 && <p>{t.s6.sheet.routes}</p>}
        </Fragment>
      </HowSheet>
    </Screen>

    <!-- 7 · 天天等 ======================================================================== -->
    <Screen locale={locale} n={7} total={TOTAL} chapter={t.s7.chapter} headline={hl(t.s7.headline)} quiet={t.s7.quiet} next={{ label: t.s7.next }}>
      <div slot="picture" class="h-pic">
        <RoadOfTime locale={locale} posts={posts} />
        <div class="h-pic__ctl"><Segmented name="reds" legend={t.s7.stepper} hideLegend value={String(defaultRedsPerDay)} options={redsPerDayOptions.map((n) => ({ value: String(n), label: fill(t.s7.stepperOption, { n }) }))} /></div>
      </div>
      <p slot="body">{redsPerDayOptions.map((n) => <span data-when-reds={String(n)} data-say>{t.s7.body[n]}</span>)}{sp}<span>{s7Assume}</span></p>
      <KindChip size={chipSize} slot="chips" locale={locale} kind="derived" />
      <HowSheet slot="sheet" id="how-7" locale={locale} kind="study" heads={t.s7.sheet.heads as [string, string, string]} facts={['lung2025-peaks-hrv', 'mccreanor2007-london-walk', 'hei-sr23-trap-associations']} primary={{ href: evidence(5) }}>
        <ul slot="block1">
          <li>{fill(t.s7.sheet.minutes, { min: F.peakMinutes, people: F.peakPeople })}</li>
          <li>{fill(t.s7.sheet.hours, { h: F.walkHours, people: F.walkPeople })}</li>
          <li>{fill(t.s7.sheet.years, { n: F.studies })}</li>
        </ul>
        <Fragment slot="block2">
          <WorkingSum locale={locale} {...workingHoursPerYear(defaultRedsPerDay, locale)} />
          <p>{fill(t.s7.sheet.dose, { pct: F.dosePct })}</p>
        </Fragment>
        <p slot="block3">{t.s7.sheet.workers}</p>
      </HowSheet>
    </Screen>

    <!-- 8 · 誰最近 ======================================================================== -->
    <Screen locale={locale} n={8} total={TOTAL} chapter={t.s8.chapter} headline={hl(t.s8.headline)} body={fill(t.s8.body, { lo: F.child.lo, hi: F.child.hi })} quiet={kSentences.K4[locale]} illustration next={{ label: t.s8.next }}>
      <HeightsScene slot="picture" locale={locale} />
      <KindChip size={chipSize} slot="chips" locale={locale} of={fact('child-air-per-kg')} />
      <HowSheet slot="sheet" id="how-8" locale={locale} kind="study" where={chipWhere.international[locale]} facts="child-air-per-kg" primary={{ href: evidence(6) }}>
        <p slot="block1">{t.s8.sheet.who}</p>
        <p slot="block2">{fill(t.s8.sheet.what, { lo: F.child.lo, hi: F.child.hi })}</p>
        <p slot="block3">{t.s8.sheet.care}</p>
      </HowSheet>
    </Screen>

    <!-- 9 · 騎士也在裡面 ================================================================== -->
    <Screen locale={locale} n={9} total={TOTAL} chapter={t.s9.chapter} headline={hl(t.s9.headline)} body={t.s9.body} quiet={t.s9.quiet} illustration next={{ label: t.s9.next }}>
      <RiderScene slot="picture" locale={locale} />
      <KindChip size={chipSize} slot="chips" locale={locale} of={fact('commute-scooter-vs-subway-chuang2020')} />
      <HowSheet slot="sheet" id="how-9" locale={locale} kind="measured" where={chipWhere.taiwan[locale]} facts="commute-scooter-vs-subway-chuang2020" primary={{ href: evidence(6) }}>
        <p slot="block1">{t.s9.sheet.who}</p>
        <Fragment slot="block2">
          <p>{t.s9.sheet.what}</p>
          <ul class="h-modes">
            {(['scooter', 'walking', 'bus', 'car', 'metro'] as const).map((m) => <li><span>{t.s9.sheet.modes[m]}</span><span class="h-modes__n">{F.commute[m]} {t.common.ugm3}</span></li>)}
          </ul>
        </Fragment>
        <p slot="block3">{t.s9.sheet.care}</p>
      </HowSheet>
    </Screen>

    <!-- 10 · 口罩擋得住嗎 ================================================================= -->
    <Screen locale={locale} n={10} total={TOTAL} chapter={t.s10.chapter} headline={hl(t.s10.headline)} body={t.s10.body} quiet={t.s10.quiet} next={{ label: t.s10.next }}>
      <div slot="picture" class="h-pic">
        <MaskScene locale={locale} />
        <IllustrationTag locale={locale} />
        <div class="h-pic__ctl"><Segmented name="mask" legend={t.s10.switch} value="surgical" columns={zh ? 4 : 2} options={maskOrder.map((m) => (zh ? { value: m, label: t.s10.masks[m].label, sub: t.s10.masks[m].sub } : { value: m, label: `${t.s10.masks[m].label} ${t.s10.masks[m].sub}` }))} class="h-masks" /></div>
      </div>
      <Fragment slot="chips">
        <KindChip size={chipSize} locale={locale} of={fact('mask-niosh-no-gas')} where="" />
        <KindChip size={chipSize} locale={locale} of={fact('mask-asworn-vandersande')} where="" />
      </Fragment>
      <HowSheet slot="sheet" id="how-10" locale={locale} kind="official" where={chipWhere.abroad[locale]} heads={t.s10.sheet.heads as [string, string, string]} facts={['mask-niosh-no-gas', 'mask-asworn-vandersande', 'mask-ultrafine-su', 'mask-cloth-rengasamy', 'mask-fit-cherrie', 'mask-carbon-breakthrough', 'mask-carbon-mol-2005', 'mask-ilosh-taiwan', 'mask-respirator-benefit-langrish']} primary={{ href: href('/questions/mask/', locale), label: t.s10.sheet.more }}>
        <p slot="block1">{t.s10.sheet.who}</p>
        <Fragment slot="block2">
          <table class="h-masktable">
            <thead>
              <tr><th scope="col">{t.s10.sheet.cols.mask}</th><th scope="col">{t.s10.sheet.cols.gases}</th><th scope="col">{t.s10.sheet.cols.ultrafine}</th><th scope="col">{t.s10.sheet.cols.pm25}</th></tr>
            </thead>
            <tbody>
              {maskOrder.map((m) => (
                <tr>
                  <th scope="row">{t.s10.sheet.rows[m].mask}</th>
                  <td data-col={t.s10.sheet.cols.gases}>{t.s10.sheet.rows[m].gases}</td>
                  <td data-col={t.s10.sheet.cols.ultrafine}>{t.s10.sheet.rows[m].ultrafine}</td>
                  <td data-col={t.s10.sheet.cols.pm25}>{t.s10.sheet.rows[m].pm25}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="h-sub">{t.s10.sheet.taiwan}</p>
          <ul>
            <li>{fill(t.s10.sheet.mol, { tested: F.mask.tested, min: F.mask.minutes, result: F.mask.passed === 0 ? t.s10.sheet.molNone : fill(t.s10.sheet.molSome, { passed: F.mask.passed }) })}</li>
            <li>{fill(t.s10.sheet.ilosh, { people: F.mask.people, n95: F.mask.n95, medical: F.mask.medical })}</li>
          </ul>
        </Fragment>
        <p slot="block3">{t.s10.sheet.care}</p>
      </HowSheet>
    </Screen>

    <!-- 11 · 換掉 ========================================================================= -->
    <Screen locale={locale} n={11} total={TOTAL} chapter={t.s11.chapter} headline={hl(t.s11.headline)} body={t.s11.body} next={{ label: t.s11.next }}>
      <div slot="picture" class="h-pic">
        <SwapScene locale={locale} />
        <IllustrationTag locale={locale} />
        <div class="h-pic__ctl">
          <SwapControl locale={locale} />
          <div class="h-swapnote">
            <span class="h-swapnote__n" data-swap-all><span data-swap-when="part" hidden>{t.s11.chipBefore}<b data-swap-out="pct">100</b>{t.s11.chipAfter}</span><span data-swap-when="all" set:html={V.phrasedHtml(t.s11.chipAll)} /></span>
            <KindChip locale={locale} kind="derived" size="sm" />
            <span class="h-swapnote__if">{t.s11.assume}</span>
          </div>
        </div>
      </div>
      <HowSheet slot="sheet" id="how-11" locale={locale} kind="derived" facts={verified('liou-wu-2021-electric-scooter-benefit') ? 'liou-wu-2021-electric-scooter-benefit' : undefined} primary={{ href: evidence(7) }} secondary={{ href: calc, label: how.myTerms[locale] }}>
        <p slot="block1">{fill(t.s11.sheet.used, { total: 10 })}</p>
        <p slot="block2">{t.s11.sheet.how}</p>
        <Fragment slot="block3">
          <p>{t.s11.sheet.care}</p>
          {verified('liou-wu-2021-electric-scooter-benefit') && <p>{fill(t.s11.sheet.national, F.national)} <KindChip locale={locale} of={fact('liou-wu-2021-electric-scooter-benefit')} size="sm" /></p>}
        </Fragment>
      </HowSheet>
    </Screen>

    <!-- 12 · 還沒要換車 =================================================================== -->
    <Screen locale={locale} n={12} total={TOTAL} chapter={t.s12.chapter} headline={hl(t.s12.headline)} body={t.s12.body} next={{ label: t.s12.next }}>
      <div slot="picture" class="h-pic">
        <TenScooters locale={locale} />
        <IllustrationTag locale={locale} />
        <div class="h-pic__ctl"><FixButton locale={locale} /></div>
      </div>
      <Fragment slot="chips">
        <KindChip size={chipSize} locale={locale} of={fact('inspection-top-tenth-co-share')} />
        <span class="h-chipnote h-chipnote--one">{fill(t.s12.shareLabel, { share: formatEstimate('inspect.top10share', locale).text.replace(/ (?=\d|%)/g, '\u00a0') })}</span>
      </Fragment>
      <HowSheet slot="sheet" id="how-12" locale={locale} kind="derived" facts="inspection-top-tenth-co-share" primary={{ href: evidence(1) }} secondary={{ href: href('/act/#ride', locale), label: t.s12.sheet.ride }}>
        <p slot="block1">{fill(t.s12.sheet.used, { readings: F.readings })}</p>
        <p slot="block2">{fill(t.s12.sheet.how, { share: formatEstimate('inspect.top10share', locale).text })}</p>
        <p slot="block3">{t.s12.sheet.care}</p>
      </HowSheet>
    </Screen>

    <!-- 13 · 買的那天 ===================================================================== -->
    <Screen locale={locale} n={13} total={TOTAL} phase="green" chapter={t.s13.chapter} headline={hl(V.buyHead(P, table, choice))} next={{ label: t.s13.next }}>
      <div slot="above" class="h-pick">
        <div class="h-pick__county" data-js-only>
          <label class="h-pick__label" for="hm-county">{t.s13.county}</label>
          <select id="hm-county" class="h-select" data-hm-county autocomplete="off">
            {D.counties.map((c) => <option value={c.id} selected={c.id === choice.county}>{c.name}</option>)}
          </select>
        </div>
        <div data-js-only>
          <Segmented name="scrap" legend={t.s13.scrap} hideLegend value={choice.scrap} options={[{ value: 'yes', label: t.s13.scrapYes, sub: t.s13.scrapYesSub }, { value: 'no', label: t.s13.scrapNo, sub: t.s13.scrapNoSub }]} />
        </div>
        <p class="h-pick__fixed">{fill(t.s13.fixed, { county: countyName, scrap: choice.scrap === 'yes' ? T.caseScrapYes : T.caseScrapNo })}</p>
      </div>
      <div slot="picture" class="h-pic h-pic--chart">
        <div class="h-fig" data-hm-fig aria-live="polite" set:html={V.figureHtml(P, table, choice)} />
        <PriceBars locale={locale} id="hm-price" petrol={price.petrol} electric={price.electric} plate={price.plate} table={false} />
        <div class="h-scrapwrap" data-hm-scrap aria-live="polite" set:html={V.scrapHtml(P, table, choice)} />
      </div>
      <p slot="body" data-hm-body13>{V.buyBody(P, table, choice)}</p>
      <p class="h-deadline-note"><span data-hm-strip>{V.stripOf(P, table, choice)}</span>{sp}<span class="h-deadline-note__checked">{H.checked}</span></p>
      <div class="h-worstwrap" data-hm-worst set:html={V.worstFold(P, table)} />
      <KindChip size={chipSize} slot="chips" locale={locale} kind="derived" />
      <HowSheet slot="sheet" id="how-13" locale={locale} kind="derived" title={t.s13.sheet.title} primary={{ href: calc, label: how.myTerms[locale] }} secondary={{ href: href('/electric/#examples', locale), label: T.examplesLink }}>
        <p slot="block1">{t.s13.sheet.used}</p>
        <div slot="block2" class="h-work" data-hm-lines set:html={V.buyLinesHtml(P, table, choice)} />
        <Fragment slot="block3">
          <p>{t.s13.sheet.care}</p>
          <p data-hm-change hidden={!V.scrapChange(P, table, choice)}>{V.scrapChange(P, table, choice)}</p>
          <p data-hm-stripfold hidden={!V.stripFold(P, table, choice)}>{V.stripFold(P, table, choice)}</p>
          <p class="h-chipnote">{H.checked}</p>
        </Fragment>
      </HowSheet>
    </Screen>

    <!-- 14 · 每個月 ======================================================================= -->
    <Screen locale={locale} n={14} total={TOTAL} phase="green" chapter={t.s14.chapter} headline={hl(V.monthHead(P, table, choice.km))}>
      <div slot="picture" class="h-pic h-pic--chart">
        <div class="h-pic__ctl" data-js-only>
          <Segmented name="km" legend={t.s14.km} hideLegend value={String(choice.km)} columns={4} options={D.km.map((k) => ({ value: String(k), label: num(k, locale), sub: t.s14.kmUnit }))} />
        </div>
        <div id="hm-month" class="chart hc hc-monthlybars" data-chart="monthly-bars" data-grow="" role="group" aria-label={monthlyBarsTitle(locale, choice.km)} set:html={renderMonthlyBars(V.monthlyBarsProps(P, table, choice.km))} />
        <p class="h-under-note" data-hm-under aria-live="polite">{V.monthUnder(P, table, choice)}</p>
      </div>
      <p slot="body" data-hm-body14>{V.monthBody(P, table, choice.km)}</p>
      <KindChip size={chipSize} slot="chips" locale={locale} kind="derived" />
      <div slot="actions" class="h-two">
        <NextButton href="#s-15">{t.s14.next}</NextButton>
        <NextButton href={calc} variant="primary">{t.s14.mine}</NextButton>
      </div>
      <HowSheet slot="sheet" id="how-14" locale={locale} kind="derived" title={t.s14.sheet.title} primary={{ href: calc, label: how.myTerms[locale] }}>
        <p slot="block1">{t.s14.sheet.used}</p>
        <p slot="block2">{t.s14.sheet.how}</p>
        <Fragment slot="block3">
          <p>{fill(T.monthNote, { km: num(choice.km, locale) })}</p>
          <p>{T.beNote}</p>
        </Fragment>
      </HowSheet>
    </Screen>

    <!-- 15 · 下一個紅燈 =================================================================== -->
    <Screen locale={locale} n={15} total={TOTAL} phase="green" chapter={t.s15.chapter} headline={hl(t.s15.headline)} body={t.s15.body}>
      <div slot="picture" class="h-pic">
        <div class="h-crop" style="--crop:11"><HeroStreet locale={locale} phase="green" /></div>
        <IllustrationTag locale={locale} />
      </div>
      <div slot="actions" class="h-end">
        <NextButton href={calc} variant="primary">{t.s15.start}</NextButton>
        <ul class="h-end__grid" aria-label={t.s15.more}>
          <li>
            <a class="h-act" href={filmHref}>
              <svg class="h-act__play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4.5v15l12.5-7.5z" fill="currentColor"></path></svg>
              <span>{t.common.filmShort}</span>
            </a>
          </li>
          <li><a class="h-act" href={lineHref} target="_blank" rel="noopener noreferrer"><span set:html={V.phrasedHtml(t.s15.line)} /><span class="vh">{ui.externalLink[locale]}</span></a></li>
          <li><a class="h-act" href={href('/act/', locale)}><span set:html={V.phrasedHtml(t.s15.act)} /></a></li>
          <li><a class="h-act" href={href('/estimate/#measure', locale)}><span set:html={V.phrasedHtml(how.toMeasure[locale])} /></a></li>
        </ul>
      </div>
      <HowSheet slot="sheet" id="how-15" locale={locale} kind="derived" title={t.s15.sheet.title} primary={{ href: href('/estimate/#drawing', locale), label: how.fullMethod[locale] }}>
        <p slot="block1">{fill(t.s15.sheet.used, { n: F.drawn })}</p>
        <p slot="block2">{t.s15.sheet.how}</p>
        <p slot="block3">{t.s15.sheet.care}</p>
      </HowSheet>
    </Screen>
  </div>

  <script type="application/json" id="hm-data" set:html={JSON.stringify(P)} />
</Base>

