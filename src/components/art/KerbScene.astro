---
/**
 * KerbScene — G4, the page's central picture: the kerb, close (brief 3.2
 * screen 4, 5.1, 5.2).
 *
 * A parent with a pushchair and a schoolchild stand at the left; the tail of
 * the nearest scooter is a step or two to their right, its rider in view, with
 * rows of the pack behind. The plume of air.ts runs from the tailpipe to the
 * people, low, and a soft dark puff sits behind every tailpipe. Fume only, no
 * symbols (air.ts): how thick the plume is where the people stand
 * carries the estimate, in proportion to the carbon monoxide the pack adds
 * (AIR.fumeTint × AIR_EXTRA), and the number box above the picture gives the
 * figure. One label on the picture, with a thin line into the plume. Nothing is drawn on the wall: the
 * street's own air is left to the number box above the picture.
 *
 * The scenario switch changes layer B, the rows behind and nothing else. It
 * needs no script: drawn with scenario="all" the picture follows the
 * data-pick-scenario that lane B's ScenarioSwitch sets on the Screen (and the
 * checked radio when scripting is off). Fade 0.6 s.
 *
 * Props
 *   locale    Locale
 *   scenario  'all' (default: switchable) | 'few' | 'dozen' | 'full' (fixed: poster, share card, brief)
 *   initial   the scenario a switchable picture shows first (default 'dozen')
 *   tag       false (default; <Screen illustration> prints it) | 'street'
 *   id, class
 *
 *   <KerbScene slot="picture" locale={locale} />
 *   <KerbScene locale={locale} scenario="dozen" tag="street" />
 */
import '@/styles/art.css';
import type { Locale } from '@/i18n';
import { art } from '@/i18n/art';
import { est } from '@/data/estimate';
import SceneFrame from './SceneFrame.astro';
import SceneLabel from './SceneLabel.astro';
import { air, unitsPerPx, type AirScenario, type Box } from './air';
import { AIR_EXTRA } from './air-slots';
import { TAILPIPE, artId, person } from './parts';
import { placed, put, shopfronts, stepSources, tailOf, type Placed } from './kit';
import { leader, sceneAlt } from './scene';

interface Props {
  locale: Locale;
  scenario?: AirScenario | 'all';
  initial?: AirScenario;
  tag?: false | 'street';
  id?: string;
  class?: string;
  /** the label on the picture (default true; false for a thumbnail or a share card) */
  legend?: boolean;
}
const { locale, legend = true, scenario = 'all', initial = 'dozen', tag = false, id, class: cls } = Astro.props;
const shown: AirScenario = scenario === 'all' ? initial : scenario;

const VB: Box = { x: 0, y: -340, w: 450, h: 425 };
const parent = 26;
const child = 178;
const front: Placed = { x: 274, lift: 0, s: 1, row: 1 };
// rows behind, back row first; `step` is the scenario from which a row shows (2 = the dozen, 3 = a full box)
const behind: (Placed & { step: 2 | 3 })[] = [
  { x: 250, lift: 70, s: 0.8, row: 3, step: 3 },
  { x: 372, lift: 70, s: 0.8, row: 3, step: 3 },
  { x: 318, lift: 36, s: 0.9, row: 2, step: 2 },
];
const visible = (step: 2 | 3) => scenario === 'all' || (scenario === 'dozen' && step === 2) || scenario === 'full';
const rows = behind.filter((r) => visible(r.step));

const a = air({
  frame: VB,
  seed: 4,
  id: artId('air'),
  scenario,
  extra: AIR_EXTRA,
  kerb: { x0: 6, x1: front.x - 8, sourceX: front.x + TAILPIPE.x },
  tailpipes: [...rows.map(tailOf), tailOf(front)],
});
const steps = Object.fromEntries(rows.map((r, i) => [i, r.step])) as Record<number, 2 | 3>;
const stepped = (html: string) => (scenario === 'all' ? stepSources(html, steps) : html);

const street = [
  shopfronts({ x0: -10, x1: 460, base: 0, top: -340, bay: 196, shift: 96 }),
  // the road and the kerb the people stand on
  '<rect class="a-road" x="-10" y="0" width="470" height="90"/>',
  `<path class="a-kerb" d="M-10,-1H${front.x - 14}V13H-10Z"/>`,
  // a lane line on the road, clear of the corner where the tag sits
  `<path class="a-paint" opacity="0.8" d="M${front.x + 10},44H460V54H${front.x + 10}Z"/>`,
].join('');
const far =
  `<g class="${scenario === 'all' ? 'air-steps' : ''}">` +
  rows.map((r) => placed(r, 'gas', { cls: scenario === 'all' ? `air-b air-b${r.step}` : undefined })).join('') +
  '</g>';
const fg = [
  put(parent, 0, person('stroller'), { cls: 'a-figure' }),
  put(child, 0, person('schoolchild-cover'), { cls: 'a-figure' }),
  placed(front, 'gas', { face: true, cls: 'a-figure' }),
].join('');
// the one label: on the road between the child and the scooter, a short line up into the fume there
// it stands on the bottom edge and grows upward with 字大; its line starts under its plate
const LBL = { x: 196, y: VB.y + VB.h - 4 };
const lead = leader(LBL.x + 44, 50, 248, -58, unitsPerPx(VB.w));
const alt = sceneAlt(locale, art.kerb.alt[locale], { scenario: shown, count: est.scn[shown].count });
---

<SceneFrame locale={locale} box={VB} alt={alt} tag={tag} scenario={shown} drift id={id} class={['scene--kerb', cls].filter(Boolean).join(' ')}>
  <Fragment set:html={a.defs + street + a.wash + far + stepped(a.cores) + stepped(a.marks) + fg + (legend ? lead : '')} />
  {legend && <SceneLabel slot="labels" box={VB} x={LBL.x} y={LBL.y} anchor="start bottom" max={52} plate class="fume-label">{art.fume.label[locale]}</SceneLabel>}
</SceneFrame>
