---
/**
 * ScrambleCrossing — a pedestrian-scramble junction (行人專用時相) from above.
 * Every approach is held at red; people cross in all directions, including
 * diagonally, through the middle of the junction. Scooter packs wait behind
 * the four stop lines; a gasoline scooter carries one exhaust-coloured mark at
 * its tail. Nothing in the drawing shows an amount.
 *
 * Props
 *   kind      'gas' | 'electric': colours the packs and decides whether tail marks are drawn
 *   label     accessible description (required: this drawing carries meaning)
 *   animated  no longer used (the drawing is static)
 *   class     extra class
 */
import '@/styles/art.css';

interface Props {
  kind?: 'gas' | 'electric';
  label: string;
  animated?: boolean;
  class?: string;
}
const { kind = 'gas', label, animated = true, class: cls } = Astro.props;
const gas = kind === 'gas';
const S = 600; // viewBox size
const R0 = 210; // road edges
const R1 = 390;
const o: string[] = [];

// corner blocks: sidewalk + arcade tiles
[
  [0, 0],
  [R1, 0],
  [0, R1],
  [R1, R1],
].forEach(([x, y]) => {
  o.push(`<rect class="a-plane" x="${x}" y="${y}" width="${R0}" height="${R0}"/>`);
  let d = '';
  for (let k = 30; k < R0; k += 30) d += `M${x + k},${y} v${R0} M${x},${y + k} h${R0} `;
  o.push(`<path class="a-line" stroke-width="1" d="${d}"/>`);
});
// roads
o.push(`<rect class="a-road" x="${R0}" y="0" width="${R1 - R0}" height="${S}"/><rect class="a-road" x="0" y="${R0}" width="${S}" height="${R1 - R0}"/>`);

// zebra bars on the four sides
const bars = (horizontal: boolean, at: number) => {
  let s = '';
  for (let k = R0 + 10; k < R1 - 8; k += 22) s += horizontal ? `<rect class="a-paint" x="${k}" y="${at}" width="12" height="34"/>` : `<rect class="a-paint" x="${at}" y="${k}" width="34" height="12"/>`;
  return s;
};
o.push(bars(true, R0 - 40), bars(true, R1 + 6), bars(false, R0 - 40), bars(false, R1 + 6));
// diagonal crossings
const diag = (flip: boolean) => {
  let s = `<g transform="translate(300 300) rotate(${flip ? -45 : 45})">`;
  for (let k = -104; k <= 104; k += 22) s += `<rect class="a-paint" x="${k - 6}" y="-17" width="12" height="34"/>`;
  return s + '</g>';
};
o.push(diag(false), diag(true));

// stop lines, then scooter packs behind them (top-down capsules with a helmet)
const pack = (rot: number) => {
  let s = `<g transform="rotate(${rot} 300 300)">`;
  s += `<rect class="a-paint" x="304" y="${R1 + 52}" width="${(R1 - R0) / 2 - 10}" height="6"/>`;
  for (let row = 0; row < 3; row++)
    for (let col = 0; col < 4; col++) {
      if (row === 2 && col === 3) continue;
      const x = 316 + col * 19 + (row % 2) * 5;
      const y = R1 + 70 + row * 44;
      // one exhaust-coloured mark at each tail, and nowhere else
      s += `<rect class="a-ink" x="${x - 5}" y="${y}" width="10" height="34" rx="5"/><circle class="${gas ? 'a-deep' : 'a-clean'}" cx="${x}" cy="${y + 15}" r="5.5"/>${gas ? `<circle class="a-exh" cx="${x + 3}" cy="${y + 36}" r="3.2"/>` : ''}`;
    }
  return s + '</g>';
};
o.push(pack(0), pack(90), pack(180), pack(270));

// pedestrians: head-and-shoulders from above
const ped = (x: number, y: number, rot: number, small = false) => {
  const k = small ? 0.7 : 1;
  return `<g transform="translate(${x} ${y}) rotate(${rot})"><ellipse class="a-ink" rx="${9 * k}" ry="${5 * k}"/><circle class="${small ? 'a-yellow' : 'a-deep'}" r="${4.4 * k}"/></g>`;
};
const people: [number, number, number, boolean?][] = [
  [262, 268, 45], [280, 286, 45, true], [330, 322, 45], [352, 348, 45],
  [344, 258, -45], [318, 284, -45], [270, 334, -45], [252, 350, -45, true],
  [232, 190, 0], [262, 186, 0, true], [300, 192, 0], [352, 188, 0],
  [246, 412, 0], [322, 410, 0], [364, 414, 0],
  [190, 240, 90], [186, 300, 90], [192, 356, 90, true],
  [410, 250, 90], [414, 318, 90], [408, 368, 90],
  [300, 300, 20],
];
people.forEach(([x, y, rot, small]) => o.push(ped(x, y, rot, small)));
---

<svg class:list={['scramble', animated && 'a-animated', cls]} viewBox={`0 0 ${S} ${S}`} role="img" aria-label={label} focusable="false" set:html={o.join('')} />

<style>
  .scramble {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
</style>
