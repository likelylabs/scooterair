---
/**
 * TailpipeMarks — G2: one scooter, one fume, and what is in it (brief 3.2 screen 2, 5.2).
 *
 * One petrol scooter from the side, engine running. Its exhaust is drawn the one way every
 * picture draws it: a soft fume that leaves the tailpipe and drifts back along the ground, with a
 * few wavy wisps rising to the nose of a small head in profile (the one who smells it). Nothing in
 * the picture is a symbol that needs a key. What the fume holds is said in words ON the picture,
 * three labels with thin leader lines pointing into the same fume:
 *
 *   刺鼻的氣體：聞得到  at the wisps that reach the nose (top left, above the head)
 *   苯：聞不出來        into the thinner fume near the head (the air that is breathed)
 *   微粒：小到看不到    into the fume low behind the pipe (no darker patch: a reader must not
 *                       see a visible smudge beside the words "too small to see")
 *
 * The labels stand clear of both faces and grow into the picture with 字大: the top one from the
 * top edge down, the two on the road from the bottom edge up.
 *
 * The three are never ranked; they are placed by where the eye finds the fume, not by harm.
 *
 * Props
 *   locale  Locale
 *   tag     false (default; <Screen illustration> prints it) | 'street'
 *   id, class
 *
 *   <TailpipeMarks slot="picture" locale={locale} />
 */
import '@/styles/art.css';
import type { Locale } from '@/i18n';
import { art } from '@/i18n/art';
import SceneFrame from './SceneFrame.astro';
import SceneLabel from './SceneLabel.astro';
import { air, airRibbon, airWisp, unitsPerPx, type Box } from './air';
import { MASK_FACE, TAILPIPE, artId, maskHead, scooter } from './parts';
import { put } from './kit';
import { leader, sceneAlt } from './scene';

interface Props {
  locale: Locale;
  tag?: false | 'street';
  id?: string;
  class?: string;
}
const { locale, tag = false, id, class: cls } = Astro.props;

// a band of road under the scooter holds two of the three labels
const VB: Box = { x: -200, y: -266, w: 390, h: 380 };
const upp = unitsPerPx(VB.w);
const at = { x: 4, y: 0 };
const M = { x: at.x + TAILPIPE.x, y: TAILPIPE.y }; // the tailpipe mouth
const HEAD = { x: -112, y: -118, s: 0.46 }; // a small head in profile, looking back at the scooter: the one who smells it
const NOSE = { x: HEAD.x - MASK_FACE.nose.x * HEAD.s + 3, y: HEAD.y + MASK_FACE.nose.y * HEAD.s };

// the fume: one tailpipe's soft puff, a little larger than in a street (it is the subject here),
// with its own wisps along the ground
const a = air({ frame: VB, id: artId('air'), tailpipes: [{ ...M, boost: 1.4, ribbons: 2 }] });

// wisps: up and back to the nose (what you can smell)
const ribbons = [-7, 0, 7]
  .map((dy, i) => airRibbon(airWisp(M.x - 4, M.y - 3 - i * 1.5, NOSE.x + 2 + (i % 2) * 4, NOSE.y + dy, upp), upp, { weight: i === 1 ? 1.15 : 0.95, cls: 'sa-draw', attrs: ` pathLength="1" style="--i:${i * 2}"` }))
  .join('');

// the three labels and where their leader lines end. Each line starts under its label's plate (so
// at every text size it comes straight out of the words) and ends on the thing it names:
//   vapour  the wisps just in front of the nose
//   benzene the fume in front of the face, below the wisps (the air that is breathed)
//   pm      the fume right behind the tailpipe
const BOTTOM = VB.y + VB.h - 6;
const L = {
  vapour: { x: -192, y: VB.y + 6, to: { x: NOSE.x + 16, y: NOSE.y - 3 }, from: { x: NOSE.x + 14, y: VB.y + 16 } },
  benzene: { x: -192, y: BOTTOM, to: { x: HEAD.x + 12, y: HEAD.y + 8 }, from: { x: -150, y: BOTTOM - 10 } },
  pm: { x: 184, y: BOTTOM, to: { x: M.x - 20, y: M.y + 22 }, from: { x: 100, y: BOTTOM - 10 } },
};
const leaders = Object.values(L).map((l) => leader(l.from.x, l.from.y, l.to.x, l.to.y, upp)).join('');

const scene = [
  `<rect class="a-plane" x="${VB.x}" y="${VB.y}" width="${VB.w}" height="${-VB.y}"/>`,
  `<rect class="a-road" x="${VB.x}" y="0" width="${VB.w}" height="${VB.y + VB.h}"/>`,
  `<path class="a-line" d="M${VB.x},0H${VB.x + VB.w}"/>`,
  a.defs + a.cores + a.marks,
  put(HEAD.x, HEAD.y, maskHead(), { s: HEAD.s, flip: true, cls: 'a-figure' }) + ribbons,
  put(at.x, at.y, scooter({ kind: 'gas', rider: true }), { cls: 'a-figure' }),
  leaders,
].join('');
const alt = sceneAlt(locale, art.tailpipe.alt[locale], { kind: 'plain' });
---

<SceneFrame locale={locale} box={VB} alt={alt} tag={tag} arrive id={id} class={['scene--tailpipe', cls].filter(Boolean).join(' ')}>
  <Fragment set:html={scene} />
  <Fragment slot="labels">
    <SceneLabel box={VB} x={L.vapour.x} y={L.vapour.y} anchor="start top" max={52} plate class="fume-label">{art.fume.inSmell[locale]}</SceneLabel>
    <SceneLabel box={VB} x={L.benzene.x} y={L.benzene.y} anchor="start bottom" max={47} plate class="fume-label">{art.fume.inBenzene[locale]}</SceneLabel>
    <SceneLabel box={VB} x={L.pm.x} y={L.pm.y} anchor="end bottom" max={47} plate class="fume-label">{art.fume.inPm[locale]}</SceneLabel>
  </Fragment>
</SceneFrame>
