---
/**
 * SceneLabel — a word placed at a point of a drawing, as HTML over the SVG.
 * It keeps its own size (15 px, never under 14 px) however small the drawing
 * gets, which SVG <text> cannot do. Use it in SceneFrame's `labels` slot.
 *
 * Props
 *   box     the scene's viewBox { x, y, w, h }: the same object SceneFrame got
 *   x, y    where the label goes, in the drawing's own units
 *   anchor  which point of the label sits at (x, y):
 *           'start' | 'center' | 'end', optionally with 'top' | 'middle' | 'bottom'
 *           ('center bottom' puts the label centred above the point). Default 'start top'.
 *   plate   a see-through plate behind the words (for a busy background)
 *   quiet   lighter weight, secondary ink
 *   max     maximum width, in % of the picture (default 60)
 *   as      'p' (default) | 'span' | 'div'
 *
 *   <SceneLabel slot="labels" box={VB} x={296} y={-120} anchor="center bottom" plate>排氣管</SceneLabel>
 *
 * Chinese words in a label never break inside a phrase: at 320 px 特大 「聞不到」 must not
 * become 「聞 / 不到」. A plain-text label is cut at its punctuation (「刺鼻的氣體：」「聞得到」);
 * each short piece (up to five characters) is held on one line, a longer piece is glued word by
 * word (src/lib/glue.mjs). Labels with markup inside are left as they are.
 */
import '@/styles/art.css';
import type { Box } from './air';
import { labelStyle } from './scene';
import { glueZh } from '@/lib/glue.mjs';

interface Props {
  box: Box;
  x: number;
  y: number;
  anchor?: string;
  plate?: boolean;
  quiet?: boolean;
  max?: number;
  as?: 'p' | 'span' | 'div';
  class?: string;
  'aria-hidden'?: 'true' | 'false';
  [key: `data-${string}`]: string | number | boolean | undefined;
}
const { box, x, y, anchor = 'start top', plate = false, quiet = false, max, as: Tag = 'p', class: cls, ...rest } = Astro.props;
const raw = Astro.slots.has('default') ? await Astro.slots.render('default') : '';
const HAN = /[\u3400-\u9fff]/;
// a piece is the text between spaces, cut after each closing mark; spaces stay breakable
const piece = (p: string) => (!HAN.test(p) ? p : [...p].length <= 5 ? `<span class="nobr">${p}</span>` : glueZh(p));
const glued =
  HAN.test(raw) && !/[<>]/.test(raw)
    ? raw
        .split(/(\s+)/)
        .map((w) => (/^\s*$/.test(w) ? w : w.split(/(?<=[：，、。？！])/).map(piece).join('')))
        .join('')
    : null;
---

<Tag class:list={['scene__label', plate && 'scene__label--plate', quiet && 'scene__label--quiet', cls]} data-anchor={anchor} style={labelStyle(box, x, y, max)} {...rest}>{glued !== null ? <Fragment set:html={glued} /> : <Fragment set:html={raw} />}</Tag>
