---
/**
 * TenScooters — G11: ten scooters, one to fix (brief 3.2 screen 12, 5.2).
 *
 * Ten small scooters in two rows of five. Nine leave a small puff of fume. One, with no
 * rider on it (nobody is blamed), leaves a big cloud, drawn darker than the small puffs, and is
 * named in words right above it (該修的那一輛), so the cloud is not read as its neighbour's. The cloud is drawn so its area is the
 * share of all the fume in the picture that the highest tenth of inspection readings hold of
 * all the carbon monoxide: est.inspect.top10share (middle of the range), about a third. The
 * size is worked out here, never typed. This picture leaves the street's own air out, so that
 * "about a third of all the fume" is literally what is drawn.
 * The button is <FixButton> (the Screen's `controls` slot). Pressed, the
 * cloud shrinks to a wisp like the others, once, in 0.8 s. It is a checkbox
 * underneath: it works with the keyboard and without scripting.
 *
 * Props
 *   locale  Locale
 *   fixed   draw it already repaired (default false)
 *   tag     false (default; <Screen illustration> prints it) | 'street'
 *   id, class
 *
 *   <TenScooters slot="picture" locale={locale} />
 *   <FixButton slot="controls" locale={locale} />
 */
import '@/styles/art.css';
import type { Locale } from '@/i18n';
import { art, fill } from '@/i18n/art';
import { est } from '@/data/estimate';
import SceneFrame from './SceneFrame.astro';
import SceneLabel from './SceneLabel.astro';
import { air, type Box } from './air';
import { artId, scooter } from './parts';
import { pickSources, put, tailOf, type Placed } from './kit';

interface Props {
  locale: Locale;
  fixed?: boolean;
  tag?: false | 'street';
  id?: string;
  class?: string;
}
const { locale, fixed = false, tag = false, id, class: cls } = Astro.props;

const TOTAL = 10;
const VB: Box = { x: 0, y: -700, w: 1310, h: 870 };
const rows = [-400, 0]; // ground line of the back and the front row
const pack: Placed[] = rows.flatMap((ground) => Array.from({ length: 5 }, (_, i) => ({ x: 118 + i * 243, lift: -ground, s: 1, row: 1 as const })));
const BIG = 8; // the one that needs repair: front row, fourth along, so its cloud lies over the row

// How big the cloud is: the nine small puffs are each drawn at scale SMALL. The one's cloud is the
// same puff scaled up by `boost`, so its area is boost² times one small puff. It holds the share of
// all the fume that the highest tenth of readings hold (the middle of the published range):
//   boost² ÷ (9 + boost²) = share   →   boost = √(9 × share ÷ (1 − share))
const SMALL = 0.8;
const share = (est.inspect.top10share.lo + est.inspect.top10share.hi) / 2 / 100;
const boost = Math.sqrt(((TOTAL - 1) * share) / (1 - share));
const sharePct = Math.round(share * 100);

const small = { ribbons: 1, scale: SMALL };
const tail = (q: Placed) => tailOf(q);
const big = tail(pack[BIG]);
const a = air({
  frame: VB,
  id: artId('air'),
  seed: 23,
  tailpipes: [
    ...pack.map((q, i) => ({ ...tail(q), ...small, ...(i === BIG ? { ribbons: 0, scale: 0.001 } : {}) })),
    // the same tailpipe again: as it is (one big cloud), and repaired
    { ...big, ...small, boost, ribbons: 3 },
    { ...big, ...small },
  ],
});
const mouth = tail(pack[BIG]);
const isBig = (k: number) => k === TOTAL;
const one = (i: number) => pickSources(a.cores, (k) => k === i) + pickSources(a.marks, (k) => k === i);
const ground = rows.map((y) => `<path class="a-line" stroke-width="3" d="M40,${y}H${VB.w - 40}"/>`).join('');
const scene = [
  `<rect class="a-plane" x="0" y="${VB.y}" width="${VB.w}" height="${VB.h}"/>`,
  a.defs + ground,
  // drawn three times over, so the one cloud is clearly darker as well as bigger than the small puffs
  `<g class="ten-big" style="transform-origin:${mouth.x}px ${mouth.y + 20}px">${pickSources(a.cores, isBig).repeat(3)}</g>`,
  pack.map((_, i) => (i === BIG ? '' : one(i))).join(''),
  `<g class="ten-fixed">${one(TOTAL + 1)}</g>`,
  pack.map((q, i) => put(q.x, -q.lift, scooter({ kind: 'gas', rider: i !== BIG }), { cls: 'a-figure' })).join(''),
  // the big cloud's wisps lie over the scooters it reaches
  `<g class="ten-big ten-big--marks" style="transform-origin:${mouth.x}px ${mouth.y + 20}px">${pickSources(a.marks, isBig)}</g>`,
].join('');
const alt =
  fill(art.ten.alt, locale, { total: TOTAL, rest: TOTAL - 1, share: sharePct, fix: art.ten.fix[locale] }) + (locale === 'en' ? ' ' : '') + art.alt2.plain[locale];
---

<SceneFrame locale={locale} box={VB} alt={alt} tag={tag} id={id} class={['scene--ten', cls].filter(Boolean).join(' ')} data-fixed={fixed ? '' : undefined} data-share={sharePct}>
  <Fragment set:html={scene} />
  {/* the one to fix is named in words right above it, so its cloud is not taken for its neighbour's; gone once fixed */}
  <SceneLabel slot="labels" box={VB} x={pack[BIG].x + 92} y={-176} anchor="center bottom" max={46} plate class="ten-label">{art.ten.label[locale]}</SceneLabel>
</SceneFrame>
