---
/**
 * AirRange — the two small patches that let a reader SEE a range.
 *
 * The estimate sheet's third block and /estimate/#drawing show them side by
 * side: 範圍低的一頭 and 範圍高的一頭, each one reference patch drawn with the
 * same rule as every scene, from the low and the high end of the scenario's
 * carbon monoxide range (for the dozen today: 7 rings and 17 rings). The ring
 * counts printed under the patches are counted from what was drawn.
 *
 * Props
 *   locale    Locale
 *   scenario  'few' | 'dozen' | 'full' (default 'dozen')
 *   size      width of one patch in CSS px (default 120: one reference patch at true size)
 *   class
 *
 *   <AirRange locale={locale} scenario="dozen" />
 */
import '@/styles/art.css';
import type { Locale } from '@/i18n';
import { art, fill } from '@/i18n/art';
import { AIR, airPatch, type AirScenario } from './air';
import { AIR_RANGE } from './air-slots';
import { artId } from './parts';

interface Props {
  locale: Locale;
  scenario?: AirScenario;
  size?: number;
  class?: string;
}
const { locale, scenario = 'dozen', size = AIR.patch, class: cls } = Astro.props;
const ends = (['lo', 'hi'] as const).map((end) => {
  const want = AIR_RANGE[scenario][end];
  const p = airPatch({ extra: want.extra, id: artId('airp'), seed: end === 'lo' ? 5 : 6, wash: AIR.washOpacity[scenario] });
  if (p.rings !== want.rings) throw new Error(`AirRange: drew ${p.rings} rings for the ${end} end of "${scenario}" but the rule says ${want.rings}`);
  const name = art.range[end][locale];
  return { end, name, svg: p.svg, count: fill(art.range.rings, locale, { n: p.rings }), alt: fill(art.range.alt, locale, { which: name, n: p.rings }) };
});
---

<div class:list={['air-range', cls]} style={`--air-range-size:${size / 16}rem`}>
  {
    ends.map((e) => (
      <figure class="air-range__cell">
        <svg class="air-range__patch" viewBox={`0 0 ${AIR.patch} ${AIR.patch}`} role="img" aria-label={e.alt} focusable="false">
          <rect class="a-plane" width={AIR.patch} height={AIR.patch} />
          <Fragment set:html={e.svg} />
        </svg>
        <figcaption class="air-range__cap">
          <b>{e.name}</b>
          <span>{e.count}</span>
        </figcaption>
      </figure>
    ))
  }
</div>

<style>
  .air-range {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin: 0;
  }
  .air-range__cell {
    flex: 0 1 var(--air-range-size, 7.5rem);
    min-inline-size: 6.5rem;
    margin: 0;
  }
  .air-range__patch {
    display: block;
    inline-size: 100%;
    block-size: auto;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-2, 4px);
    /* the marks' halo is the colour of what is behind them: here, the patch itself */
    --here: var(--art-fill);
  }
  .air-range__cap {
    display: grid;
    gap: 0.0625rem;
    margin-block-start: 0.375rem;
    font-size: var(--fs-xs, 0.875rem);
    line-height: 1.35;
    color: var(--ink-2);
  }
  .air-range__cap b {
    font-weight: 700;
    color: var(--ink);
  }
</style>
