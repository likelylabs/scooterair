---
/**
 * AirLegend — the small key of a picture: what the soft cloud and each mark mean, with the same
 * drawings as the scene.
 *
 *   ☁ 機車排的氣　〰 油氣　○ 一氧化碳　∙ 微粒                 (plain)
 *   ☁ 機車排的氣　〰 聞得到：油氣 / ○ 聞不到：一氧化碳　∙ 看不到：微粒   (sense)
 *
 * A scene passes only the entries it draws (a green street: car exhaust and tyre dust; the
 * heights and rider pictures add the red ring at the nose), so a key never names a mark the
 * picture does not have. Four entries sit on one row when they fit; when they do not (a phone
 * in English, 大 / 特大 text) they fall into two even columns, never three and one. The `sense`
 * key names the marks by the sense that finds them, and is always two even columns.
 *
 * That the street's own air is not drawn is said in the tag under every street picture
 * (ui illustration.tag); `note` repeats it here where there is no tag (the film).
 *
 * Plain text: no buttons, nothing to tap, the same with or without scripting. Words 15 px (the
 * note 14 px).
 *
 * Props
 *   locale  Locale
 *   items   which entries, in order (default: plume, ribbon, ring, dot)
 *   sense   name the marks by sense (聞得到 / 聞不到 / 看不到): the first picture, the kerb, the film
 *   note    print the line about the street's own air (only where no tag says it)
 *   class
 */
import '@/styles/art.css';
import type { Locale } from '@/i18n';
import { art } from '@/i18n/art';
import { airGlyph, type AirKeyItem } from './air';

interface Props {
  locale: Locale;
  items?: readonly AirKeyItem[];
  sense?: boolean;
  note?: boolean;
  class?: string;
}
const { locale, items = ['plume', 'ribbon', 'ring', 'dot'], sense = false, note = false, class: cls } = Astro.props;
const word = (m: AirKeyItem): string => (sense && (m === 'ribbon' || m === 'ring' || m === 'dot') ? art.key.sense[m][locale] : art.key[m][locale]);
---

<div class:list={['air-legend', sense && 'air-legend--sense', `air-legend--n${items.length}`, cls]} role="group" aria-label={art.key.title[locale]}>
  <ul class="air-legend__list">
    {
      items.map((m) => (
        <li class="air-legend__item">
          <svg class="air-glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={airGlyph(m)} />
          <span>{word(m)}</span>
        </li>
      ))
    }
  </ul>
  {note && <p class="air-legend__note">{art.key.note[locale]}</p>}
</div>
