---
/**
 * RoadOfTime — G7: the road of time and the year strip (brief 3.2 screen 7,
 * 5.2). Replaces ui/TimeLadder.astro.
 *
 * A road with three signposts, nearest first: minutes, hours, many years.
 * Each signpost is a small drawing (a heartbeat trace with one shallow dip; a
 * pair of lungs; a calendar), a few words and a label chip. The words and the
 * chips are the host's (they carry study facts); the drawings are fixed.
 *
 * Under the road, the year strip: one small dot for every day of the year,
 * flowing into a bar measured in hours. It is drawn for 2, 4 and 6 red lights
 * a day from time.hoursPerYear (src/data/estimate.ts), never typed, and is
 * never empty. Which one shows follows lane B's <Segmented name="reds"> in the
 * same Screen (values "2", "4", "6"); with no switch it shows `reds`.
 *
 * Props
 *   locale  Locale
 *   posts   three signposts, nearest first:
 *           { when: string; text: string; kind: ChipKind | evidence id; where?: string }
 *   reds    red lights a day shown first: 2 | 4 | 6 (default: defaultRedsPerDay)
 *   id, class
 *
 *   <RoadOfTime slot="picture" locale={locale} posts={t.s7.posts} />
 *   <Segmented slot="controls" name="reds" legend={t.s7.stepper} value="4" options={[2, 4, 6].map((n) => ({ value: String(n), label: String(n) }))} />
 */
import '@/styles/art.css';
import type { Locale } from '@/i18n';
import { art, fill } from '@/i18n/art';
import { defaultRedsPerDay, hoursPerYear, redsPerDayOptions, time } from '@/data/estimate';
import KindChip from '@/components/ui/KindChip.astro';
import { rng } from './parts';

interface Post {
  when: string;
  text: string;
  kind: string;
  where?: string;
}
interface Props {
  locale: Locale;
  posts: [Post, Post, Post];
  reds?: 2 | 4 | 6;
  id?: string;
  class?: string;
}
const { locale, posts, reds = defaultRedsPerDay as 2 | 4 | 6, id, class: cls } = Astro.props;
if (posts.length !== 3) throw new Error('RoadOfTime: exactly three signposts (minutes, hours, years)');

/* ---- the three small drawings, each on a 72 × 60 signboard --------------------- */
const board = (inner: string) => `<path class="road-post" d="M36,58V78"/><rect class="road-board" x="2" y="2" width="68" height="56" rx="8"/>${inner}`;
const icons = [
  // a heartbeat trace: even beats, and one shallow dip in the rhythm
  board('<path class="road-trace" d="M8,32H17l3,-13l4,22l3,-9H33c2,0 3,3 5,3s3,-3 5,-3H47l3,-13l4,22l3,-9H64"/>'),
  // a pair of lungs
  board('<path class="road-ink" d="M33,12h6v14c7,0 14,6 17,15c2,6 1,11 -3,11c-6,0 -12,-4 -14,-9V30h-6v13c-2,5 -8,9 -14,9c-4,0 -5,-5 -3,-11c3,-9 10,-15 17,-15Z"/><path class="road-cut" d="M36,12V30"/>'),
  // a calendar
  board('<rect class="road-ink" x="14" y="14" width="44" height="38" rx="5"/><rect class="road-paper" x="18" y="24" width="36" height="24" rx="2"/><path class="road-ink-s" d="M24,10v8M48,10v8"/>' + [0, 1, 2].map((r) => [0, 1, 2, 3].map((c) => `<circle class="road-ink" cx="${23 + c * 8.7}" cy="${30 + r * 6.5}" r="1.9"/>`).join('')).join('')),
];

/* ---- the year strip: 365 dots, then a bar in hours ------------------------------ */
const DAYS = 365;
const W = 360;
const COLS = 61;
const PITCH = 5.6;
const AXIS = Math.ceil(time.span.hi / 12) * 12; // the bar's scale: whole half-days, enough for the longest case
const bar = { x: 12, y: 56, w: W - 24, h: 18 };
const xOf = (h: number) => bar.x + (h / AXIS) * bar.w;
const r = rng(7);
let dots = '';
for (let d = 0; d < DAYS; d++) dots += `<circle cx="${(12 + (d % COLS) * PITCH + 1.6).toFixed(1)}" cy="${(8 + Math.floor(d / COLS) * PITCH).toFixed(1)}" r="1.7"/>`;
// a few dots on their way down into the bar
let falling = '';
for (let k = 0; k < 9; k++) falling += `<circle cx="${(40 + r() * 280).toFixed(1)}" cy="${(40 + r() * 11).toFixed(1)}" r="1.7" opacity="${(0.9 - k * 0.06).toFixed(2)}"/>`;
const strips = redsPerDayOptions.map((n) => {
  const h = hoursPerYear(n);
  const ticks = Array.from({ length: AXIS / 12 + 1 }, (_, i) => i * 12);
  const svg =
    `<g class="road-days">${dots}${falling}</g>` +
    `<rect class="road-bar-track" x="${bar.x}" y="${bar.y}" width="${bar.w}" height="${bar.h}" rx="4"/>` +
    // solid to the low end, lighter on to the high end: the answer is a range
    `<rect class="road-bar" x="${bar.x}" y="${bar.y}" width="${(xOf(h.lo) - bar.x).toFixed(1)}" height="${bar.h}" rx="4"/>` +
    `<rect class="road-bar road-bar--range" x="${xOf(h.lo).toFixed(1)}" y="${bar.y}" width="${(xOf(h.hi) - xOf(h.lo)).toFixed(1)}" height="${bar.h}"/>` +
    `<path class="road-tick" d="${ticks.map((t) => `M${xOf(t).toFixed(1)},${bar.y + bar.h}v6`).join('')}"/>`;
  return { n, h, svg, ticks, alt: fill(art.road.stripAlt, locale, { n, lo: h.lo, hi: h.hi }) };
});
const alt = fill(art.road.alt, locale, { a: posts[0].when, b: posts[1].when, c: posts[2].when }) + (locale === 'en' ? ' ' : '') + art.alt2.plain[locale];
const pct = (x: number) => `${((x / W) * 100).toFixed(2)}%`;
---

<figure class:list={['road', cls]} id={id} role="group" aria-label={alt}>
  <ol class="road__posts">
    {
      posts.map((p, i) => (
        <li class="road__post" style={`--i:${i}`}>
          <svg class="road__sign" viewBox="0 0 72 80" aria-hidden="true" focusable="false" set:html={icons[i]} />
          <div class="road__words">
            <b class="road__when">{p.when}</b>
            <span class="road__text">{p.text}</span>
            <KindChip locale={locale} kind={p.kind as never} where={p.where} size="sm" />
          </div>
        </li>
      ))
    }
  </ol>
  <div class="road__year">
    {
      strips.map((s) => (
        <div class:list={['road-v', s.n === reds && 'is-first']} data-when-reds={s.n}>
          <p class="road__sum">
            <span>{fill(art.road.days, locale, { days: DAYS })}</span>
            <b>{fill(art.road.hours, locale, { lo: s.h.lo, hi: s.h.hi })}</b>
          </p>
          <div class="road__strip">
            <svg viewBox={`0 0 ${W} 82`} role="img" aria-label={s.alt} focusable="false" set:html={s.svg} />
            <div class="road__ticks" aria-hidden="true">
              {s.ticks.filter((t) => t % 24 === 0).map((t) => <span style={`left:${pct(xOf(t))}`}>{t === 0 ? '0' : `${t} ${art.road.hourUnit[locale]}`}</span>)}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</figure>
