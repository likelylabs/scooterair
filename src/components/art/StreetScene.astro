---
/**
 * StreetScene — the red light, one static keyframe at a time (blueprint V1).
 *
 * One crossing, drawn side-on along street B while B's signal is red:
 *   stop box (B's pack, tailpipes pointing back at the queue)
 *   → stop line → crosswalk (people cross here during B's red)
 *   → 50 cm or more → two-stage turn box (riders from the cross street, tails
 *     toward the crosswalk) → the corner, where a schoolchild in a yellow cap
 *     waits to cross the other street on the pack's green.
 *
 * NOTHING IN THIS SCENE DEPICTS AN AMOUNT. The low layer is one hatched band,
 * identical in every red frame and labelled in the frame; ribbons sit only at
 * tailpipe mouths at one length; rings have one count; stipple has one
 * density and is street-wide. No frame animates and none differs from another
 * in how much air pollution it shows — only in what is present.
 *
 * Props
 *   locale    Locale
 *   frame     'empty'  K0  red, boxes empty, child and older woman on the corner, stroller approaching
 *             'pack'   K1  the pack has arrived; hatched band, ribbons at tailpipes, rings   (default)
 *             'kerb'   K2  kerb-level close-up with the 0–180 cm ruler, first metre, stroller band
 *             'paused' K3  K1 dimmed and greyed, chip "countdown paused" — sits behind data
 *             'green'  K4  signal green, front scooters past the crosswalk, child stepping off; band unchanged
 *             'clean'  K5  K1 with electric scooters: no ribbons, rings or band; stipple and a far car remain
 *   count     the LED number (0–99). Defaults: 90 for empty/pack/clean, 38 for paused, none for green/kerb.
 *   emphasis  'fumes' | 'co' | 'ufp' | 'heights' — which layer is at full contrast (the rest recede).
 *             Default: 'heights' in the kerb frame, none elsewhere.
 *   variant   'auto' (default: a compact composition below 44rem of container width, a wide one above)
 *             | 'wide' | 'compact'
 *   labels    in-frame labels (default true). The "illustration" tag is always printed.
 *   state     DEPRECATED: 'red' → frame="pack", 'clean' → frame="clean".
 *   class     extra class on the wrapper
 *
 * The scene is static: there is no animation to disable.
 * Strings come from src/i18n/art.ts.
 */
import '@/styles/art.css';
import type { Locale } from '@/i18n';
import { art, fill } from '@/i18n/art';
import {
  CAR_TAILPIPE, LED_FIGURES, MOUTH, SCOOTER_LENGTH, STROLLER_BAND, TAILPIPE,
  artId, car, em, esc, hatchBand, ledDigit, ledPath, person, ribbon, ringsInBand, scooter, stipple,
} from './parts';

type Frame = 'empty' | 'pack' | 'kerb' | 'paused' | 'green' | 'clean';
type Emphasis = 'fumes' | 'co' | 'ufp' | 'heights';
interface Props {
  locale: Locale;
  frame?: Frame;
  count?: number;
  emphasis?: Emphasis;
  variant?: 'auto' | 'wide' | 'compact';
  labels?: boolean;
  state?: 'red' | 'clean';
  animated?: boolean;
  class?: string;
}
const { locale, state, variant = 'auto', labels = true, class: cls } = Astro.props;
const frame: Frame = Astro.props.frame ?? (state === 'clean' ? 'clean' : 'pack');
const emphasis: Emphasis | undefined = Astro.props.emphasis ?? (frame === 'kerb' ? 'heights' : undefined);
const defaultCount: Record<Frame, number | undefined> = { empty: 90, pack: 90, kerb: undefined, paused: 38, green: undefined, clean: 90 };
const count = Astro.props.count ?? defaultCount[frame];
const countText = count === undefined ? '' : String(Math.max(0, Math.min(99, Math.round(count)))).padStart(2, '0');
const alt = fill(art.alt[frame], locale, { count: countText });
const zh = locale === 'zh-TW';

const BAND = 100; // top of the hatched band, cm
const g = (x: number, s: string, flip = false) => `<g transform="translate(${x} 0)${flip ? ' scale(-1 1)' : ''}">${s}</g>`;
/** In-frame text. `dy` is in em so the stack follows the CSS font size. */
const label = (x: number, y: number, lines: string | string[], o: { anchor?: 'start' | 'end' | 'middle'; cls?: string } = {}) => {
  const arr = Array.isArray(lines) ? lines : [lines];
  return `<text class="a-text scene-t ${o.cls ?? ''}" x="${x}" y="${y}" text-anchor="${o.anchor ?? 'start'}">${arr
    .map((l, i) => `<tspan x="${x}"${i ? ' dy="1.28em"' : ''}>${esc(l)}</tspan>`)
    .join('')}</text>`;
};
/** Break a caption into lines no wider than maxEm. */
const wrap = (text: string, maxEm: number): string[] => {
  if (em(text) <= maxEm) return [text];
  const parts = zh ? text.split(/(?<=[，：；])/) : text.split(/(?<=,)\s|\s(?=not\b|for\b|at\b)/);
  const out: string[] = [];
  let cur = '';
  for (const p of parts) {
    const next = cur ? (zh ? cur + p : `${cur} ${p}`) : p;
    if (cur && em(next) > maxEm) {
      out.push(cur);
      cur = p;
    } else cur = next;
  }
  if (cur) out.push(cur);
  return out;
};
const emCaption = emphasis === 'fumes' ? art.scene.emFumes[locale] : emphasis === 'co' ? art.scene.emCo[locale] : emphasis === 'ufp' ? art.scene.emUfp[locale] : '';

/** A scooter with its rider, placed by the x of its front wheel's leading edge. */
function placed(front: number, scale: number, lift: number, kind: 'gas' | 'electric', o: { face?: boolean; ribbon?: boolean } = {}) {
  const rear = front - SCOOTER_LENGTH * scale;
  let s = `<g transform="translate(${rear.toFixed(1)} ${-lift}) scale(${scale})">`;
  if (o.ribbon) s += `<g class="L-fumes" transform="translate(${TAILPIPE.x} ${TAILPIPE.y})">${ribbon()}</g>`;
  return s + scooter({ kind, rider: true, face: o.face }) + '</g>';
}

/* ====================================================================== */
/* Street frames: K0, K1, K3, K4, K5                                       */
/* ====================================================================== */
function street(v: 'wide' | 'compact') {
  const wide = v === 'wide';
  const W = wide ? 1400 : 800;
  const TOP = wide ? -380 : -336;
  const NEAR = wide ? 58 : 50;
  const FAR = -30;
  const S = wide ? 25 : 28; // largest label size in this composition (drawing units)
  // the geometry of the approach, left to right (cm)
  const stop = wide ? 470 : 198; // stop line
  const cw0 = wide ? 590 : 262; // crosswalk
  const cw1 = wide ? 890 : 452;
  const tb0 = cw1 + 50; // turn box rear edge: 50 cm beyond the crosswalk
  const tb1 = tb0 + (wide ? 250 : 190);
  const slab0 = tb1 + 6; // the corner
  const slab1 = W - (wide ? 48 : 28);
  const pole = slab0 + (wide ? 26 : 12);
  const kind = frame === 'clean' ? 'electric' : 'gas';
  const hasPack = frame !== 'empty';
  const exhaust = hasPack && frame !== 'clean';
  const moved = frame === 'green';
  const o: string[] = [];

  // ---- background: an arcade shop-house row, kept faint
  const bay = wide ? 232 : 214;
  const signs = ['早餐', '機車行', '藥局', '五金', '麵店', '眼鏡', '文具'];
  o.push('<g class="scene-arch">');
  o.push(`<rect class="a-plane" x="-10" y="${FAR - 330}" width="${W + 20}" height="30"/><path class="a-line" d="M-10,${FAR - 330} H${W + 10} M-10,${FAR - 300} H${W + 10}"/>`);
  for (let x = 26, i = 0; x < W; x += bay, i++) {
    if (i % 2 === 0) {
      let d = '';
      for (let y = FAR - 250; y < FAR; y += 22) d += `M${x + 44},${y} H${x + bay - 28} `;
      o.push(`<path class="a-line" stroke-width="1" d="${d}"/><rect class="a-line" x="${x + 44}" y="${FAR - 262}" width="${bay - 72}" height="262"/>`);
    } else {
      o.push(`<rect class="a-line" x="${x + 48}" y="${FAR - 200}" width="62" height="200"/><rect class="a-line" x="${x + 126}" y="${FAR - 200}" width="${bay - 158}" height="120"/>`);
    }
    o.push(`<rect class="a-plane" x="${x}" y="${FAR - 300}" width="28" height="300"/><path class="a-line" d="M${x},${FAR - 300} V${FAR} M${x + 28},${FAR - 300} V${FAR}"/>`);
    const chars = [...signs[i % signs.length]];
    const sh = chars.length * 34 + 16;
    o.push(`<rect class="a-plane" x="${x - 8}" y="${FAR - 290}" width="44" height="${sh}"/><rect class="a-line" x="${x - 8}" y="${FAR - 290}" width="44" height="${sh}"/>`);
    chars.forEach((c, k) => o.push(`<text class="scene-sign" x="${x + 14}" y="${FAR - 290 + 38 + k * 34}" text-anchor="middle">${c}</text>`));
  }
  o.push('</g>');

  // ---- road: a shallow stage. The ground line for every wheel and foot is y = 0.
  o.push(`<rect class="a-road" x="-10" y="${FAR}" width="${W + 20}" height="${NEAR - FAR + 4}"/>`);
  // stop box outline, stop line, zebra bars, turn box outline (all paint)
  const box = (x0: number, x1: number) =>
    `<path class="a-paint" d="M${x0},${FAR + 5} H${x1} v${NEAR - FAR - 9} H${x0} Z M${x0 + 6},${FAR + 9} v${NEAR - FAR - 17} H${x1 - 6} v${-(NEAR - FAR - 17)} Z" fill-rule="evenodd"/>`;
  o.push(box(Math.max(-20, stop - (wide ? 420 : 400)), stop - 6));
  o.push(`<rect class="a-paint" x="${stop}" y="${FAR}" width="14" height="${NEAR - FAR + 4}"/>`);
  [
    [FAR + 5, 5],
    [FAR + 17, 7],
    [7, 9],
    [25, 12],
    [NEAR - 12, 16],
  ].forEach(([y, h]) => o.push(`<rect class="a-paint" x="${cw0}" y="${y}" width="${cw1 - cw0}" height="${h}"/>`));
  o.push(box(tb0, tb1));
  // the corner: pavement, kerb, and the first bars of the other street's crosswalk beyond it
  o.push(`<rect class="a-kerb" x="${slab0}" y="${FAR}" width="${slab1 - slab0}" height="${NEAR - FAR + 6}"/>`);
  let joints = '';
  for (let x = slab0 + 34; x < slab1; x += 34) joints += `M${x},${FAR} V${NEAR + 4} `;
  o.push(`<path class="a-line" stroke-width="1" d="${joints}M${slab0},8 H${slab1}"/>`);
  for (let x = slab1 + 8; x < W; x += 22) o.push(`<rect class="a-paint" x="${x}" y="${FAR + 6}" width="12" height="${NEAR - FAR - 8}"/>`);

  const world: string[] = []; // everything that K3 dims

  // ---- other traffic: one car in the far lane, heading away (not in the empty frame)
  if (hasPack) {
    const cs = wide ? 0.58 : 0.5;
    const cx = wide ? 505 : 240;
    const lift = wide ? 52 : 46;
    world.push(
      `<g class="a-row-3 scene-car" transform="translate(${cx} ${-lift}) scale(${cs})">${car()}<g class="L-fumes" transform="translate(${CAR_TAILPIPE.x} ${CAR_TAILPIPE.y}) scale(-1 1)">${ribbon()}</g></g>`,
    );
  }

  // ---- the pack in the stop box (three rows deep), and the riders in the turn box
  if (hasPack) {
    // At green the stop-box ranks have rolled forward: the front one is past the crosswalk, and
    // the turn-box riders have already left the frame. Nothing else about the picture changes.
    const r3 = moved ? [cw1 + 60, cw0 + 30, stop - 70] : wide ? [440, 250, 60] : [172, 66, -40];
    const r2 = moved ? [cw1 + 124, stop + 14] : wide ? [392, 190, -14] : [124, -62];
    const r1 = moved ? [cw1 + SCOOTER_LENGTH + 22, cw0 + 96, wide ? 250 : -30] : wide ? [462, 258, 54] : [190, -14];
    world.push(`<g class="a-row-3">${r3.map((x) => placed(x, 0.84, 25, kind, { ribbon: exhaust })).join('')}</g>`);
    world.push(`<g class="a-row-2">${r2.map((x) => placed(x, 0.92, 12, kind, { ribbon: exhaust })).join('')}</g>`);
    // turn box: riders who came from the cross street, tails toward the crosswalk
    const near = tb0 + 8 + SCOOTER_LENGTH;
    if (!moved) {
      world.push(`<g class="a-row-3">${[near - 16, near + (wide ? 34 : 8)].map((x) => placed(x, 0.84, 25, kind, { ribbon: exhaust })).join('')}</g>`);
      world.push(`<g class="a-row-2">${placed(near + 14, 0.92, 12, kind, { ribbon: exhaust })}</g>`);
    }
    world.push(`<g>${r1.map((x, i) => placed(x, 1, 0, kind, { ribbon: exhaust, face: i === 0 })).join('')}${moved ? '' : placed(near, 1, 0, kind, { ribbon: exhaust })}</g>`);
  }

  // ---- the signal: a pole on the corner, vehicle head with the LED count, pedestrian head for the child's crossing
  const hx = pole - (wide ? 196 : 190);
  const sy = TOP + 16;
  const bx = hx - 58;
  const green = frame === 'green';
  const sig: string[] = [];
  sig.push(`<path class="a-ink-s" stroke-width="8" d="M${pole},0 V${sy + 26} H${hx + 130}"/>`);
  if (!green) sig.push(`<circle cx="${hx + 26}" cy="${sy + 26}" r="${wide ? 120 : 100}" fill="url(#GLOW)"/>`);
  sig.push(`<rect class="a-housing" x="${hx}" y="${sy}" width="136" height="52" rx="6"/>`);
  sig.push(
    `<circle class="${green ? 'a-lamp-off' : 'a-led-red'}" cx="${hx + 26}" cy="${sy + 26}" r="17"/><circle class="a-lamp-off" cx="${hx + 68}" cy="${sy + 26}" r="17"/><circle class="${green ? 'a-led-green' : 'a-lamp-off'}" cx="${hx + 110}" cy="${sy + 26}" r="17"/>`,
  );
  sig.push(`<rect class="a-housing" x="${bx}" y="${sy}" width="52" height="52" rx="6"/>`);
  if (countText) sig.push(`<path class="${green ? 'a-led-green' : 'a-led-red'}" d="${ledDigit(countText[0], 4.2, 1.65, bx + 3.2, sy + 11.3)}${ledDigit(countText[1], 4.2, 1.65, bx + 3.2 + 25.2, sy + 11.3)}"/>`);
  // pedestrian head (for crossing the other street): red with the pack's red, green with its green
  sig.push(
    `<g transform="translate(${pole + 8} -262) scale(1.45)"><rect class="a-housing" width="30" height="36" rx="2.5"/><path class="${green ? 'a-led-green' : 'a-led-red'}" d="${ledPath(green ? LED_FIGURES.walk : LED_FIGURES.stand, 2, 0.8, 3, 2)}"/></g>`,
  );

  // ---- people
  const ppl: string[] = [];
  const womanX = slab0 + (wide ? 62 : 20);
  const childX = moved ? slab1 - 6 : slab0 + (wide ? 118 : 58);
  ppl.push(g(womanX, person('elder-woman')));
  ppl.push(`<g class="a-halo-g">${g(childX, person(moved ? 'schoolchild-step' : 'schoolchild'))}</g>`);
  if (frame === 'empty') ppl.push(g(wide ? 296 : 56, person('stroller'))); // approaching the crosswalk
  else if (!moved) {
    ppl.push(g(cw0 + (wide ? 108 : 66), person('stroller-front')));
    ppl.push(g(cw0 + (wide ? 214 : 146), person('adult-front')));
  }
  world.push(sig.join(''), ppl.join(''));

  // ---- air. One vocabulary, no amounts (see parts.ts).
  const air: string[] = [];
  if (exhaust) {
    air.push(`<g class="L-hatch"><rect class="a-band-fill" x="-10" y="${-BAND}" width="${W + 20}" height="${BAND}"/>${hatchBand({ x0: -10, width: W + 20, top: BAND })}</g>`);
    air.push(`<g class="a-co L-co">${ringsInBand({ width: W, count: wide ? 16 : 9, top: BAND })}</g>`);
  }
  air.push(`<g class="a-ufp L-ufp">${stipple({ width: W, top: TOP, bottom: 0, seed: wide ? 33 : 34 })}</g>`);
  world.push(air.join(''));

  o.push(`<g class="scene-world">${world.join('')}</g>`);

  // ---- in-frame labels
  const L: string[] = [];
  if (labels) {
    if (exhaust && frame !== 'paused') {
      // the band's own label, tied to the band by a bracket. It stands in the gap behind the
      // stop line; at green that gap belongs to the pull-away tag, so it moves over the crosswalk.
      const lx = green ? (wide ? (cw0 + cw1) / 2 : cw1 - 8) : stop + (cw0 - stop) / 2 + 8;
      const tx = wide || green ? lx - 16 : 16;
      const both = `${art.band.present[locale]}｜${art.band.unknown[locale]}`;
      // one line where it fits before the signal pole, otherwise the two halves stack
      const use = tx + em(both) * S > (green ? pole - 24 : W - 24) ? [art.band.present[locale], art.band.unknown[locale]] : [both];
      const ty = -BAND - 92 - (use.length - 1) * S * 1.28;
      L.push(`<path class="a-leader" d="M${lx - 9},-2 h-7 V${-BAND} h7 M${lx - 16},${-BAND} V${-BAND - 84}"/>`);
      L.push(label(tx, ty, use, { cls: 'a-text--exhaust' }));
    }
    if (frame === 'paused') L.push(label(bx + 26, sy + 52 + S * 1.15, art.scene.paused[locale], { anchor: 'middle' }));
    if (green) {
      const ty = TOP + S + 12;
      L.push(`<path class="a-leader" d="M${stop + 7},${FAR - 4} V${ty + 2 * S * 1.28 + 12}"/>`, label(wide ? stop - 14 : 16, ty, art.scene.pullAway[locale]));
    }
    if (frame === 'clean') {
      L.push(label(wide ? 250 : 16, -BAND - 96, art.scene.noTailpipes[locale], { cls: 'a-text--clean' }));
      const cs = wide ? 0.58 : 0.5;
      const lx = wide ? 640 : 370;
      const top = -(wide ? 52 : 46) - 146 * cs;
      L.push(`<path class="a-leader" d="M${lx},${top - 6} V${-BAND - 124}"/>`, label(lx - 36, -BAND - 132, art.scene.otherTraffic[locale], { cls: 'a-text--quiet' }));
    }
    if (emCaption) L.push(label(16, TOP + S + 10, wrap(emCaption, (bx - 40) / S), { cls: 'a-text--quiet' }));
  }
  L.push(label(10, NEAR - 9, art.illustration[locale], { cls: 'a-text--quiet scene-t--tag' }));
  o.push(L.join(''));

  const sizes = wide ? [25, 25, 18.5, 14.5] : [28, 21, 21, 21];
  return { v, viewBox: `0 ${TOP} ${W} ${NEAR - TOP}`, body: o.join(''), sizes };
}

/* ====================================================================== */
/* Kerb frame: K2                                                          */
/* ====================================================================== */
function kerb(v: 'wide' | 'compact') {
  const wide = v === 'wide';
  const W = wide ? 1000 : 660;
  const TOP = -238;
  const NEAR = 36;
  const FAR = -24;
  const S = wide ? 18 : 23;
  const RX = wide ? 96 : 64; // the ruler
  const womanX = wide ? 440 : 330;
  const childX = womanX + (wide ? 62 : 50);
  const parentX = childX + (wide ? 62 : 48);
  const cwEnd = parentX + 104; // edge of the crosswalk
  const tb0 = cwEnd + 50; // turn box rear edge, 50 cm on
  const o: string[] = [];

  // road, with the crosswalk's last bars and the turn box's rear line
  o.push(`<rect class="a-road" x="-10" y="${FAR}" width="${W + 20}" height="${NEAR - FAR + 4}"/>`);
  [
    [FAR + 5, 5],
    [4, 8],
    [NEAR - 12, 12],
  ].forEach(([y, h]) => o.push(`<rect class="a-paint" x="${RX + 30}" y="${y}" width="${cwEnd - RX - 30}" height="${h}"/>`));
  o.push(`<path class="a-paint" d="M${tb0},${FAR + 4} H${W + 10} v6 H${tb0 + 6} V${NEAR - 4} H${W + 10} v6 H${tb0} Z"/>`);

  // the first metre: the same hatched band as every red frame
  o.push(`<g class="L-hatch"><rect class="a-band-fill" x="-10" y="${-BAND}" width="${W + 20}" height="${BAND}"/>${hatchBand({ x0: -10, width: W + 20, top: BAND })}</g>`);
  // the stroller band, 55–85 cm, as a flat strip (no gradient)
  o.push(`<rect class="scene-stroller-band L-heights" x="${RX}" y="${-STROLLER_BAND.high}" width="${W + 10 - RX}" height="${STROLLER_BAND.high - STROLLER_BAND.low}"/>`);

  // scooters in the turn box, tails toward the crosswalk
  o.push(`<g class="a-row-2">${placed(tb0 + 34 + SCOOTER_LENGTH * 0.92, 0.92, 10, 'gas', { ribbon: true })}</g>`);
  o.push(placed(tb0 + 8 + SCOOTER_LENGTH, 1, 0, 'gas', { ribbon: true }));

  // people on the corner and at the crosswalk's edge
  o.push(g(womanX, person('elder-woman')), g(childX, person('schoolchild')), g(parentX, person('stroller')));

  // air
  o.push(`<g class="a-co L-co">${ringsInBand({ x0: RX + 20, width: W - RX - 20, count: wide ? 11 : 7, top: BAND })}</g>`);
  o.push(`<g class="a-ufp L-ufp">${stipple({ width: W, top: TOP, bottom: 0, seed: 35 })}</g>`);

  // the ruler, 0–180 cm
  const H: string[] = [];
  let ticks = `M${RX},0 V-180`;
  for (let h = 0; h <= 180; h += 10) ticks += ` M${RX},${-h} h${h % 50 === 0 ? -12 : -6}`;
  H.push(`<path class="a-rule scene-ruler" d="${ticks}"/>`);
  [0, 50, 100, 150].forEach((h) => H.push(`<text class="a-text a-text--quiet scene-t scene-t--num" x="${RX - 16}" y="${-h + S * 0.3}" text-anchor="end">${h}</text>`));
  H.push(`<text class="a-text a-text--quiet scene-t scene-t--num" x="${RX - 16}" y="${-180 - S * 0.3}" text-anchor="end">${esc(art.unitCm[locale])}</text>`);
  // the height labels belong to the 'heights' reading; under another emphasis only the ruler stays
  if (labels && emphasis === 'heights') {
    // mouths are TICKS (rings mean carbon monoxide): one on the ruler, one beside each face
    const mouths: [number, number, string][] = [
      [parentX + MOUTH.parent.x + 12, -MOUTH.parent.y, art.scene.adultMouth[locale]],
      [childX + MOUTH.schoolchild.x + 12, -MOUTH.schoolchild.y, art.scene.childMouth[locale]],
    ];
    mouths.forEach(([x, h, text]) => {
      H.push(`<path class="a-dim" d="M${RX},${-h} h16 M${x},${-h} h14"/>`);
      H.push(`<text class="a-text scene-t" x="${RX + 22}" y="${-h + S * 0.34}">${esc(text)}<tspan class="a-text--quiet" dx="0.3em">${esc(zh ? `（${art.scene.illustrative[locale]}）` : `(${art.scene.illustrative[locale]})`)}</tspan></text>`);
    });
    H.push(`<path class="a-dim" d="M${womanX + MOUTH['elder-woman'].x + 12},${MOUTH['elder-woman'].y} h14"/>`);
    // stroller band bracket + label + where the figure comes from
    H.push(`<path class="a-dim" d="M${RX + 16},${-STROLLER_BAND.low} h-8 V${-STROLLER_BAND.high} h8"/>`);
    H.push(label(RX + 22, -STROLLER_BAND.high + S * 0.95, [...art.scene.strollerBand[locale], zh ? `（${art.scene.strollerSource[locale]}）` : `(${art.scene.strollerSource[locale]})`]));
    // the first metre, named from above with a leader to the band's dashed edge
    const fx = cwEnd + 26;
    H.push(`<path class="a-leader" d="M${fx},${-BAND - 2} V${-BAND - 76} M${fx - 5},${-BAND - 9} l5,7 l5,-7"/>`);
    H.push(label(W - 12, -BAND - 84 - S * 1.28, art.scene.firstMetre[locale], { anchor: 'end', cls: 'a-text--exhaust' }));
    // the 50 cm between the crosswalk and the turn box
    H.push(`<path class="a-dim" d="M${cwEnd},${NEAR - 14} H${tb0} M${cwEnd},${NEAR - 20} v12 M${tb0},${NEAR - 20} v12"/>`);
    H.push(label(cwEnd - 10, NEAR - 8, art.scene.gap50[locale], { anchor: 'end' }));
  }
  o.push(`<g class="L-heights">${H.join('')}</g>`);
  if (labels && emCaption) o.push(label(RX + 22, TOP + S + 8, wrap(emCaption, (cwEnd - RX - 10) / S), { cls: 'a-text--quiet' }));
  o.push(label(RX + 36, NEAR - 8, art.illustration[locale], { cls: 'a-text--quiet scene-t--tag' }));

  const sizes = wide ? [18, 18, 13.5, 11.5] : [23, 17.5, 17.5, 17.5];
  return { v, viewBox: `0 ${TOP} ${W} ${NEAR - TOP}`, body: o.join(''), sizes };
}

const build = frame === 'kerb' ? kerb : street;
const show = variant === 'auto' ? (['compact', 'wide'] as const) : ([variant] as const);
const scenes = show.map((v) => ({ ...build(v), id: artId('glow') }));
---

<div class:list={['scene', `scene--${variant}`, `scene--${frame}`, frame === 'clean' ? 'is-clean' : 'is-red', emphasis && `em-${emphasis}`, cls]}>
  {scenes.map((sc) => {
    const defs = `<defs><radialGradient id="${sc.id}"><stop class="a-glow-stop" offset="0" stop-opacity="0.42"/><stop class="a-glow-stop" offset="0.35" stop-opacity="0.13"/><stop class="a-glow-stop" offset="1" stop-opacity="0"/></radialGradient></defs>`;
    return (
      <svg
        class={`scene__svg scene__svg--${sc.v}`}
        viewBox={sc.viewBox}
        style={`--l0:${sc.sizes[0]}px;--l1:${sc.sizes[1]}px;--l2:${sc.sizes[2]}px;--l3:${sc.sizes[3]}px`}
        role="img"
        aria-label={alt}
        focusable="false"
        set:html={defs + sc.body.replaceAll('url(#GLOW)', `url(#${sc.id})`)}
      />
    );
  })}
</div>

<style>
  .scene {
    container-type: inline-size;
    inline-size: 100%;
    overflow: hidden;
  }
  .scene__svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
    --l: var(--l0);
  }
  .scene--auto .scene__svg--wide {
    display: none;
  }
  @container (min-width: 30rem) {
    .scene__svg {
      --l: var(--l1);
    }
  }
  @container (min-width: 44rem) {
    .scene--auto .scene__svg--compact {
      display: none;
    }
    .scene--auto .scene__svg--wide {
      display: block;
    }
  }
  @container (min-width: 60rem) {
    .scene__svg {
      --l: var(--l2);
    }
  }
  @container (min-width: 76rem) {
    .scene__svg {
      --l: var(--l3);
    }
  }
  /* In-frame text is sized in drawing units (cm) so that it lands near 12–13px
     at every container width; the steps come from --l0…--l3 on each svg. */
  .scene :global(.scene-t) {
    font-size: var(--l);
  }
  .scene :global(.scene-t--num) {
    font-size: calc(var(--l) * 0.84);
    font-variant-numeric: tabular-nums;
  }
  .scene :global(.scene-t--tag) {
    font-size: calc(var(--l) * 0.82);
  }
  .scene :global(.scene-sign) {
    font-family: var(--font-cjk);
    font-size: 26px;
    font-weight: 600;
    fill: var(--art-line);
    opacity: 0.75;
  }
  .scene :global(.scene-arch) {
    opacity: 0.8;
  }
  .scene :global(.scene-stroller-band) {
    fill: var(--ink);
    opacity: 0.09;
  }
  .scene :global(.scene-ruler) {
    stroke: var(--ink);
    stroke-width: 2;
  }
  /* the far car is small and pale; its one ribbon keeps the exhaust colour */
  .scene :global(.scene-car .a-ribbon path) {
    stroke-width: 6;
  }
  /* the schoolchild stands in front of whatever is behind */
  .scene :global(.a-halo-g .a-ink),
  .scene :global(.a-halo-g .a-far) {
    stroke: var(--here);
    stroke-width: 2;
    paint-order: stroke;
  }

  /* K3: the same frame, greyed and dimmed, to sit behind data */
  .scene--paused :global(.scene-world),
  .scene--paused :global(.scene-arch) {
    filter: grayscale(1);
    opacity: 0.42;
  }

  /* emphasis: one layer at full contrast, the rest recede */
  .em-fumes :global(:is(.L-co, .L-ufp, .L-heights)),
  .em-co :global(:is(.L-fumes, .L-ufp, .L-heights)),
  .em-ufp :global(:is(.L-fumes, .L-co, .L-heights)),
  .em-heights :global(:is(.L-fumes, .L-co, .L-ufp)) {
    opacity: 0.28;
  }
  .em-fumes :global(.L-fumes .a-ribbon path) {
    stroke-width: 5.5;
  }
  .em-co :global(.a-co circle) {
    stroke-width: 2.6;
  }
  .em-ufp :global(.a-ufp path) {
    opacity: 1;
    stroke: var(--art-ufp);
    stroke-width: 1.6;
  }
</style>
