---
/**
 * MaskScene — G17: what a mask stops and what it does not (brief 12.2).
 *
 * A face in profile, in the signal-figure style, wearing a mask. A cloud of fume
 * arrives from the tailpipe of a scooter at the left (its tail, rear wheel and muffler show;
 * a bare pipe alone read as a cigarette), drawn as fume only (no symbols):
 *   the gases     the soft fume goes on through the mask, whichever mask: a fainter
 *                 haze of it is drawn inside the airway (no everyday mask stops the
 *                 gases in exhaust)
 *   wisps         the sharp-smelling gases you notice: they pass through to the nose; an
 *                 activated-carbon mask holds a couple at the mask
 *   soot          particles: a sooty patch builds up on the front of the mask (more
 *                 on a mask that stops more); on a loose mask the fume curls in at the
 *                 gaps beside the nose and at the cheek (two small arrows). Cloth lets
 *                 most through (a darker haze inside). A fitted N95 holds most and has
 *                 no gap.
 * What each mask does is said in words in the line above the drawing (`says`).
 * Every state is drawn from research/masks/VERIFIED.json → tableRows; nothing
 * here is a percentage.
 *
 * The switch is lane B's <Segmented name="mask"> in the same Screen, with the
 * values cloth · surgical · carbon · n95. The picture follows data-pick-mask
 * (and, without scripting, the checked radio) through CSS alone.
 *
 * Props
 *   locale  Locale
 *   mask    the mask shown first: 'cloth' | 'surgical' (default) | 'carbon' | 'n95'
 *   says    print one line above the drawing about the chosen mask (default true)
 *   tag     false (default; <Screen illustration> prints it) | 'street'
 *   id, class
 *
 *   <MaskScene slot="picture" locale={locale} />
 *   <Segmented slot="controls" name="mask" legend={…} value="surgical" options={MASK_CHOICES.map((m) => ({ value: m, label: art.mask.names[m][locale] }))} />
 */
import '@/styles/art.css';
import type { Locale } from '@/i18n';
import { art } from '@/i18n/art';
import SceneFrame from './SceneFrame.astro';
import { air, airPuff, airPuffDefs, airRibbon, airWisp, unitsPerPx, type Box } from './air';
import { MASK_CHOICES as MASKS, MASK_FACE, TAILPIPE, artId, maskHead, maskOn, scooter, type MaskChoice } from './parts';
import { put } from './kit';

interface Props {
  locale: Locale;
  mask?: MaskChoice;
  says?: boolean;
  tag?: false | 'street';
  id?: string;
  class?: string;
}
const { locale, mask = 'surgical', says = true, tag = false, id, class: cls } = Astro.props;

const VB: Box = { x: -64, y: -240, w: 334, h: 240 };
const upp = unitsPerPx(VB.w);
const K = 1.38;
const TX = 94;
/** A point of maskFace(), in this picture. */
const F = (p: { x: number; y: number }) => ({ x: TX + p.x * K, y: p.y * K });
const noseIn = F(MASK_FACE.inside);
const front = TX + MASK_FACE.front.x * K - 3;
const gapNose = F(MASK_FACE.gaps.nose);
const gapCheek = F(MASK_FACE.gaps.cheek);
// the scooter faces left, its tail toward the face, standing on the bottom edge; PIPE is its tailpipe mouth
const SC = { x: 30, s: 1 };
const PIPE = { x: SC.x - (TAILPIPE.x + 2) * SC.s, y: (TAILPIPE.y - 2) * SC.s };

const on = (...kinds: MaskChoice[]) => 'mk-v ' + kinds.map((k) => `mk-on-${k}`).join(' ');
const pid = artId('mk');

// a small puff of fume at the pipe: where it all comes from
const a = air({ frame: VB, id: artId('air'), tailpipes: [{ ...PIPE, dir: 1, scale: 0.42, ribbons: 0 }] });

// the cloud on its way to the face, in front of the mask: one connected soft cloud
const cloud = airPuff(pid, [
  { cx: 46, cy: -70, rx: 34, ry: 26 },
  { cx: 74, cy: -86, rx: 34, ry: 32 },
  { cx: front - 14, cy: -96, rx: 24, ry: 36 },
], { strength: 0.62, cls: 'sa-fade', attrs: ' style="--i:1"' });

// wisps: what you can smell, to the nose, through the mask
const ribTo = (y: number, i: number, cls = '', short = false) =>
  airRibbon(airWisp(PIPE.x + 4, PIPE.y - 4 - i, short ? front - 2 : noseIn.x - 3, y, upp), upp, { weight: 1, cls: `sa-draw ${cls}`.trim(), attrs: ` pathLength="1" style="--i:${i * 2}"` });
const ribbons =
  [-121, -113].map((y, i) => ribTo(y, i)).join('') +
  // two more: an activated-carbon layer holds these at the mask; every other mask lets them through
  [-129, -137].map((y, i) => ribTo(y + (i ? 8 : 2), i + 2, on('cloth', 'surgical', 'n95')) + ribTo(y, i + 2, on('carbon'), true)).join('');

// soot on the front of the mask: the particles it stops. A mask that stops more gets a darker patch.
const sootAt = [F({ x: 14, y: -86 }), F({ x: 18, y: -66 })];
// (the mask's own switch is on a wrapper: CSS opacity on the same element would override the puff's strength)
const soot = (k: number, kinds: MaskChoice[]) =>
  `<g class="${on(...kinds)}">${airPuff(pid, sootAt.map((p) => ({ cx: p.x - 2, cy: p.y, rx: 15, ry: 24 })), { strength: k, tone: 'soot', cls: 'mk-soot sa-fade', attrs: ' style="--i:6"' })}</g>`;
const soots = soot(0.32, ['cloth']) + soot(0.55, ['surgical', 'carbon']) + soot(0.85, ['n95']);

// fume curling in at the gaps beside the nose and at the cheek, with a small arrow each (loose masks)
const arrow = (d: string, head: string, cls = '') => `<path class="mk-leak ${cls}" d="${d}"/><path class="mk-leak mk-leak--head ${cls}" d="${head}"/>`;
const leakNose =
  airPuff(pid, [{ cx: gapNose.x - 20, cy: gapNose.y - 20, rx: 16, ry: 11 }], { strength: 0.6 }) +
  arrow(`M${gapNose.x - 30},${gapNose.y - 16} C${gapNose.x - 16},${gapNose.y - 24} ${gapNose.x - 3},${gapNose.y - 18} ${gapNose.x + 1},${gapNose.y + 1}`, `M${gapNose.x - 6},${gapNose.y - 5} L${gapNose.x + 1.5},${gapNose.y + 3} L${gapNose.x + 6},${gapNose.y - 7}`);
// (the cheek's arrow starts on the head, so it carries no puff: a patch of fume there would read as a mark on the skin)
const leakCheek =
  arrow(`M${gapCheek.x + 26},${gapCheek.y + 40} C${gapCheek.x + 28},${gapCheek.y + 22} ${gapCheek.x + 18},${gapCheek.y + 8} ${gapCheek.x + 3},${gapCheek.y + 4}`, `M${gapCheek.x + 10},${gapCheek.y - 2} L${gapCheek.x + 2},${gapCheek.y + 4} L${gapCheek.x + 8},${gapCheek.y + 12}`, 'mk-leak--on-head');

// Past the mask: the airway, cut out of the head as on the body figure. What got through is drawn
// inside it, on its way down the throat: always a faint haze (the gases), darker with a cloth mask
const AIRWAY = 'M24,-86 C40,-91 58,-85 62,-66 C64,-52 66,-38 67,-5';
const L = (x: number, y: number) => F({ x, y });
const inside = (k: number) =>
  airPuff(pid, [L(38, -89), L(54, -84), L(62, -66), L(65, -44), L(66, -22)].map((p, i) => ({ cx: p.x, cy: p.y, rx: 12, ry: i === 1 ? 10 : 16 })), { strength: k, cls: 'sa-fade', attrs: ` style="--i:8" mask="url(#${pid}-aw)"` });
// the haze stays inside the airway: a mask the shape of the cut-out
const airwayMask = `<mask id="${pid}-aw" maskUnits="userSpaceOnUse" x="${VB.x}" y="${VB.y}" width="${VB.w}" height="${VB.h}"><path transform="translate(${TX} 0) scale(${K})" d="${AIRWAY}" fill="none" stroke="#fff" stroke-width="7" stroke-linecap="round"/></mask>`;
const c = [L(24, -86), L(40, -91), L(56, -86), L(61, -70)];
const inRibbon = airRibbon(`M${c[0].x},${c[0].y} C${c[1].x},${c[1].y} ${c[2].x},${c[2].y} ${c[3].x},${c[3].y}`, upp, { weight: 1.1, cls: 'sa-draw', attrs: ' pathLength="1" style="--i:9"' });

const head = `<g transform="translate(${TX} 0) scale(${K})">`;
const scene = [
  `<rect class="a-plane" x="${VB.x}" y="${VB.y}" width="${VB.w}" height="${VB.h}"/>`,
  airPuffDefs(pid) + `<defs>${airwayMask}</defs>` + a.defs + a.cores,
  // the back of the scooter, cropped by the edge of the picture: tail, rear wheel, muffler and tailpipe
  put(SC.x, 0, scooter({ kind: 'gas' }), { s: SC.s, flip: true, cls: 'a-figure' }),
  cloud,
  `<g class="a-figure">${head}${maskHead()}<path class="a-bg-s" stroke-width="7" d="${AIRWAY}"/></g>${MASKS.map((m) => `<g class="${on(m)}">${head}${maskOn(m)}</g></g>`).join('')}</g>`,
  inside(0.5) + `<g class="${on('cloth')}">${inside(0.4)}</g>`,
  soots,
  `<g class="${on('cloth', 'surgical', 'carbon')}">${leakNose}${leakCheek}</g>`,
  ribbons + inRibbon,
].join('');
const alt = [art.mask.alt[locale], art.alt2.plain[locale]].join(locale === 'en' ? ' ' : '');
---

<SceneFrame locale={locale} box={VB} alt={alt} tag={tag} arrive id={id} class={['scene--mask', cls].filter(Boolean).join(' ')} data-mask={mask}>
  {says && (
    <div slot="before" class="mk-says" aria-live="polite">
      {MASKS.map((m) => (
        <p class:list={['mk-t', `mk-on-${m}`]} data-mask-says={m}><b>{art.mask.names[m][locale]}</b>{art.mask.says[m][locale]}</p>
      ))}
    </div>
  )}
  <Fragment set:html={scene} />
</SceneFrame>
