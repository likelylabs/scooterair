---
/**
 * AirKey — the three marks, named: the key under screen 2's picture and any
 * legend elsewhere. Glyphs are drawn with the same classes as the scenes.
 *
 *   〰 聞得到：油氣（沒燒完的汽油）　○ 聞不到：一氧化碳　∙ 看不到：微粒
 *
 * With `tap` each item is a 48 px button. Pressing one sets
 * data-pick-mark="ribbon|ring|dot" on the nearest [data-pick-scope] (every
 * <Screen> is one) and dispatches `sa:pick` ({ name: 'mark', value }), and a
 * picture in that scope lights that kind of mark (TailpipeMarks, BodyFigure,
 * MaskScene). Pressing it again shows all three. Without scripting it is a
 * plain list.
 *
 * Props
 *   locale  Locale
 *   marks   which marks, in order (default all three)
 *   layout  'list' (default: one per line) | 'row' (wraps; for a legend)
 *   tap     items are buttons that light their marks (default false)
 *   plume   first, a plain line naming the soft cloud the marks sit in
 *           (機車排的氣): never a button (default false)
 *   class
 *
 *   <AirKey slot="controls" locale={locale} tap />
 */
import '@/styles/art.css';
import type { Locale } from '@/i18n';
import { art } from '@/i18n/art';
import { airGlyph, type AirMark } from './air';

interface Props {
  locale: Locale;
  marks?: AirMark[];
  layout?: 'list' | 'row';
  tap?: boolean;
  plume?: boolean;
  class?: string;
}
const { locale, marks = ['ribbon', 'ring', 'dot'], layout = 'list', tap = false, plume = false, class: cls } = Astro.props;
---

<ul class:list={['air-key', `air-key--${layout}`, tap && 'air-key--tap', cls]} data-air-key={tap ? '' : undefined} aria-label={tap ? art.tailpipe.keyLegend[locale] : undefined}>
  {plume && (
    <li class="air-key__plume">
      <span class="air-key__item">
        <svg class="air-glyph" viewBox="0 0 24 24" aria-hidden="true" set:html={airGlyph('plume')} />
        <span>{art.key.plume[locale]}</span>
      </span>
    </li>
  )}
  {
    marks.map((m) => (
      <li>
        {tap ? (
          <Fragment>
            <button type="button" class="air-key__item" data-mark={m} aria-pressed="false" data-js-only>
              <svg class="air-glyph" viewBox="0 0 24 24" aria-hidden="true" set:html={airGlyph(m)} />
              <span>{art.marks[m][locale]}</span>
            </button>
            <span class="air-key__item" data-nojs-legend>
              <svg class="air-glyph" viewBox="0 0 24 24" aria-hidden="true" set:html={airGlyph(m)} />
              <span>{art.marks[m][locale]}</span>
            </span>
          </Fragment>
        ) : (
          <span class="air-key__item">
            <svg class="air-glyph" viewBox="0 0 24 24" aria-hidden="true" set:html={airGlyph(m)} />
            <span>{art.marks[m][locale]}</span>
          </span>
        )}
      </li>
    ))
  }
</ul>

<style is:global>
  /* the static legend is for readers without scripting; with it, the buttons above take its place */
  html.js .air-key__item[data-nojs-legend] {
    display: none;
  }
  /* the plume's line takes a row of its own above the buttons */
  .air-key__plume {
    flex: 1 0 100%;
  }
  /* it names the cloud; it is not a button, so it does not look like one */
  .air-key--tap .air-key__plume .air-key__item {
    min-block-size: 0;
    padding: 0.25rem 0;
    border-color: transparent;
    background: none;
    cursor: default;
  }
</style>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('[data-air-key] button[data-mark]');
    if (!btn) return;
    const key = btn.closest('[data-air-key]')!;
    const scope = btn.closest<HTMLElement>('[data-pick-scope]') ?? (key.parentElement as HTMLElement);
    const on = btn.getAttribute('aria-pressed') !== 'true';
    key.querySelectorAll('button[data-mark]').forEach((b) => b.setAttribute('aria-pressed', String(on && b === btn)));
    if (on) scope.setAttribute('data-pick-mark', btn.dataset.mark!);
    else scope.removeAttribute('data-pick-mark');
    btn.dispatchEvent(new CustomEvent('sa:pick', { bubbles: true, detail: { name: 'mark', value: on ? btn.dataset.mark : '' } }));
  });
</script>
