---
/**
 * /questions/app/ — 空氣品質 App 為什麼看不出來？ (brief 7.5)
 *   1  The station picture: an inlet 2.5 to 3.5 m up beside a kerb scene. The answer is about
 *      where and how long a station measures; nothing here says the app is wrong.
 *   2  What a station reports is what the street already holds; the layer beside the scooters is
 *      worked out separately: home screen 4's box (benzene when the exhaust is just noticeable),
 *      picture, quiet line and sheet.
 */
import type { Locale } from '@/i18n';
import { href } from '@/i18n';
import Screen from '@/components/ui/Screen.astro';
import HowSheet from '@/components/ui/HowSheet.astro';
import KindChip from '@/components/ui/KindChip.astro';
import StationScene from '@/components/art/StationScene.astro';
import KerbScene from '@/components/art/KerbScene.astro';
import SmellBenzeneBox from '@/components/pages/home/SmellBenzeneBox.astro';
import SmellSheet from '@/components/pages/home/SmellSheet.astro';
import { simChipWhere } from '@/data/simulation';
import home from '@/i18n/pages/home';
import { fact } from '@/data/facts';
import questions from '@/i18n/pages/questions';
import { filler, questionNumbers } from './q';

interface Props {
  locale: Locale;
  next: { label: string; href: string; primary?: boolean };
}
const { locale, next } = Astro.props;
const f = filler(locale);
const nums = questionNumbers(locale);
const inlet = { lo: nums.inletLo, hi: nums.inletHi };
const s1 = questions.app.s1;
const s2 = questions.app.s2;
---

<Screen locale={locale} n={1} total={1} id="answer" how="how-1" chapter={s1.chapter[locale]} headline={f(s1.headline[locale])} body={f(s1.body[locale], inlet)} quiet={f(s1.quiet[locale])} illustration>
  <StationScene slot="picture" locale={locale} />
  <KindChip slot="chips" locale={locale} of={fact('taipei-roadside-co-2024')} />
  <HowSheet slot="sheet" id="how-1" locale={locale} kind="measured" facts={['taipei-roadside-co-2024', 'iot-waiting-area-pm25-2024', 'moenv-co-stations-2025']} primary={{ href: href('/evidence/#link-3', locale) }}>
    <p slot="block1">{f(s1.sheet.b1[locale])}</p>
    <p slot="block2">{f(s1.sheet.b2[locale], inlet)}</p>
    <p slot="block3">{f(s1.sheet.b3[locale])}</p>
  </HowSheet>
</Screen>

<Screen locale={locale} n={2} total={1} id="more" how="how-2" chapter={s2.chapter[locale]} headline={s2.headline[locale]} body={f(s2.body[locale])} quiet={home.s4.quiet[locale]} illustration next={next} class="q-smellbox">
  <SmellBenzeneBox slot="box" locale={locale} sheet="how-2" />
  <KerbScene slot="picture" locale={locale} scenario="dozen" />
  <KindChip slot="chips" locale={locale} kind="estimate" where={simChipWhere[locale]} fact="smell-benzene-just-smellable" />
  <SmellSheet slot="sheet" locale={locale} id="how-2" />
</Screen>
