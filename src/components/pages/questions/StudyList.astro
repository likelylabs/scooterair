---
/**
 * StudyList — 「這個研究怎麼做的」: one accordion per study (registry fact). Each opens to what
 * was found and on whom, where, when, the kind of evidence, and what it does not say (the
 * registry caveat), with its citation chips. Native <details>: no JavaScript needed.
 *
 * Props
 *   locale  Locale
 *   facts   registry fact ids, in the order to show them
 *   name    group name so only one opens at a time (optional)
 *   titles  plain titles by fact id where the registry display is not self-explanatory
 */
import type { Locale } from '@/i18n';
import type { FactId } from '@/data';
import Details from '@/components/ui/Details.astro';
import Cite from '@/components/ui/Cite.astro';
import EvidenceBadge from '@/components/ui/EvidenceBadge.astro';
import questions from '@/i18n/pages/questions';
import { factBadge, lf, sourceLabel, sourcesOf } from './q';

interface Props {
  locale: Locale;
  facts: readonly FactId[];
  name?: string;
  /** optional plain titles by fact id, where the registry's short display is not self-explanatory */
  titles?: Record<string, string>;
}
const { locale, facts, name, titles = {} } = Astro.props;
const P = questions.page;
const items = facts.map((id) => {
  const f = lf(id, locale);
  const cites = sourcesOf([id]);
  return { id, f, cites, badge: factBadge(id), label: cites.map((c) => sourceLabel(c.id, locale)).join(locale === 'en' ? '; ' : '；'), title: titles[id] ?? f.display };
});
---

<div class="studies">
  {items.map((s) => (
    <Details summary={`${s.title} · ${s.label}`} name={name} id={`study-${s.id}`}>
      <dl class="studies__dl">
        <div><dt>{P.studyWhat[locale]}</dt><dd>{s.f.statement}</dd></div>
        <div><dt>{P.studyWhere[locale]}</dt><dd>{s.f.place}</dd></div>
        <div><dt>{P.studyWhen[locale]}</dt><dd>{s.f.period}</dd></div>
        <div><dt>{P.studyKind[locale]}</dt><dd><EvidenceBadge locale={locale} kind={s.badge.kind} secondary={s.badge.secondary} /></dd></div>
        {s.f.caveat && <div><dt>{P.studyNot[locale]}</dt><dd>{s.f.caveat}</dd></div>}
      </dl>
      <p class="cluster studies__cites">{s.cites.map((c) => <Cite locale={locale} id={c.id} n={c.n} variant="chip" />)}</p>
    </Details>
  ))}
</div>

<style>
  .studies__dl {
    display: grid;
    gap: var(--sp-3);
    margin: 0;
  }
  .studies__dl dt {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .studies__dl dd {
    margin: 0.15em 0 0;
    line-height: var(--lh-snug);
  }
  .studies__cites {
    margin-block-start: var(--sp-3);
  }
</style>
