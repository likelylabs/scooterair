---
/**
 * ShareBlock — the share block that ends a question page (brief 7.5): the card the link will
 * carry, a LINE button, and (with JavaScript) a button that copies the page's link. The card
 * images are lane J's (public/share/<zh|en>/<id>.png, rendered by scripts/build-share-cards.mjs);
 * this block shows a card only when it exists and was rendered in the redesign's template, so a
 * page never shows a broken picture, or an old card that contradicts the page, while the new
 * cards are waiting to be rendered. Until then the block is the two buttons alone.
 *
 * Props
 *   locale  Locale
 *   id      share-card id ('smell', 'my-child', … 'mask')
 */
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import type { Locale } from '@/i18n';
import { asset, htmlLang } from '@/i18n';
import { shareCard, type ShareCardId } from '@/lib/share-cards';
import Icon from '@/components/ui/Icon.astro';
import { ui } from '@/i18n/ui';
import questions from '@/i18n/pages/questions';

interface Props {
  locale: Locale;
  id: ShareCardId;
}
const { locale, id } = Astro.props;
const S = questions.page.share;
const card = shareCard(id, locale);
// A card is shown only once it has been rendered in the redesign's template (6 or later, written
// to the manifest by scripts/build-share-cards.mjs): the older cards carry the old pages' claims.
const REDESIGN_TEMPLATE = 6;
const manifestPath = join(process.cwd(), 'public', 'share', 'manifest.json');
const manifest: { template?: number; cards?: Record<string, string> } = existsSync(manifestPath) ? JSON.parse(readFileSync(manifestPath, 'utf8')) : {};
const key = `${locale === 'en' ? 'en' : 'zh'}/${id}`;
const rendered = (manifest.template ?? 0) >= REDESIGN_TEMPLATE && !!manifest.cards?.[key] && existsSync(join(process.cwd(), 'public', card.square));
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const line = `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(pageUrl)}`;
---

<section class:list={['share', !rendered && 'share--plain']} aria-labelledby="share-h">
  {rendered && <a class="share__card" href={asset(card.wide)} aria-label={S.picture[locale]}><img src={asset(card.square)} width="1080" height="1080" alt={card.alt} loading="lazy" decoding="async" lang={htmlLang[locale]} /></a>}
  <div class="share__side">
    <h2 class="share__title" id="share-h">{S.title[locale]}</h2>
    <p class="share__lead">{S.lead[locale]}</p>
    <div class="share__actions">
      <a class="share__btn share__btn--line" href={line} target="_blank" rel="noopener noreferrer">{S.line[locale]}<Icon name="arrow-up-right" size="1.05em" /><span class="vh">{ui.externalLink[locale]}</span></a>
      <button class="share__btn" type="button" data-copy={pageUrl} data-done={S.copied[locale]} hidden>{S.copy[locale]}</button>
    </div>
    <p class="share__status" role="status"></p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.share__btn[data-copy]').forEach((btn) => {
    if (!navigator.clipboard) return;
    btn.hidden = false;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? location.href);
        const s = btn.closest('.share')?.querySelector('.share__status');
        if (s) s.textContent = btn.dataset.done ?? '';
      } catch {
        /* clipboard refused: the LINE button still works */
      }
    });
  });
</script>

<style>
  .share {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--sp-4);
    align-items: start;
    inline-size: min(100% - 2 * var(--gutter), var(--screen-max));
    margin: var(--sp-6) auto 0;
    padding: var(--sp-4);
    border: 2px solid var(--ink);
    border-radius: var(--radius-2);
    background: var(--surface);
  }
  .share--plain {
    grid-template-columns: minmax(0, 1fr);
  }
  .share__card {
    display: block;
    border-radius: var(--radius-1);
    overflow: hidden;
    border: 1px solid var(--line-strong);
  }
  .share__card img {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  .share__side {
    display: grid;
    gap: var(--sp-2);
    min-inline-size: 0;
  }
  .share__title {
    margin: 0;
    font-size: var(--fs-md);
    font-weight: var(--fw-black);
    line-height: 1.3;
  }
  .share__lead {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-read);
    color: var(--ink-2);
  }
  .share__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tap-gap);
    margin-block-start: var(--sp-1);
  }
  .share__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35em;
    min-block-size: var(--tap);
    padding: 0.4rem 1.1rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-pill, 999px);
    background: var(--bg);
    color: var(--ink);
    font: inherit;
    font-size: var(--fs-btn);
    font-weight: var(--fw-bold);
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
  }
  .share__btn--line {
    background: var(--ink);
    color: var(--bg);
  }
  .share__btn[hidden] {
    display: none;
  }
  .share__status {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--ink-2);
    min-block-size: 0;
  }
  .share__status:empty {
    display: none;
  }
  @media (min-width: 40em) {
    .share {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: var(--sp-5);
      padding: var(--sp-5);
    }
    .share--plain {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media print {
    .share {
      display: none;
    }
  }
</style>
