---
/**
 * Act — one action on /act/: one sentence, labelled by how well supported it is, so that
 * "stand further back" (our inference) never looks as solid as "scrap the two-stroke"
 * (official data), and a plain request never looks like a measured effect.
 *
 *   label 'evidence'   the badges of the registry facts behind it (measured, official, …)
 *   label 'inference'  我們的推論 / Our inference
 *   label 'request'    請求 / A request: something we ask for, with no measured effect claimed
 *   label 'arithmetic' 本站計算 / Our arithmetic (the calculator)
 *
 * Props
 *   locale   Locale
 *   n        the action's number in its list
 *   text     the action, one sentence
 *   label    see above
 *   facts    registry facts behind it (badges for 'evidence'; sources for every label)
 *   why      optional supporting sentence, shown under a closed "why" toggle with its facts,
 *            citations and required caveats
 *   whyFacts facts the `why` sentence rests on (default: `facts`)
 *   link     optional { href, label } after the sentence
 */
import type { Locale } from '@/i18n';
import type { FactId } from '@/data';
import EvidenceBadge from '@/components/ui/EvidenceBadge.astro';
import Icon from '@/components/ui/Icon.astro';
import Tag from '@/components/ui/Tag.astro';
import Cite from '@/components/ui/Cite.astro';
import Claim from './Claim.astro';
import { badgesFor, sourcesOf } from './ev';
import act from '@/i18n/pages/act';

interface Props {
  locale: Locale;
  n: number;
  text: string;
  label: 'evidence' | 'inference' | 'request' | 'arithmetic';
  facts?: readonly FactId[];
  why?: string;
  whyFacts?: readonly FactId[];
  link?: { href: string; label: string };
}
const { locale, n, text, label, facts = [], why, link } = Astro.props;
const whyFacts = Astro.props.whyFacts ?? facts;
const L = act.labels;
const badges = label === 'evidence' ? badgesFor(facts) : [];
// citations on the action itself only when no `why` carries them
const cites = why || Astro.slots.has('why') ? [] : sourcesOf(facts);
---

<li class="act">
  <span class="act__n" aria-hidden="true">{n}</span>
  <div class="act__body">
    <p class="act__text">
      {text}{cites.map((c) => <Cite locale={locale} id={c.id} n={c.n} />)}
      {link && (
        <>
          {' '}
          <a href={link.href} class="act__link">{link.label}<Icon name="arrow-right" size="1.05em" /></a>
        </>
      )}
    </p>
    <p class="act__label">
      <span class="vh">{L.supportedBy[locale]}</span>
      {badges.map((b) => <EvidenceBadge locale={locale} kind={b.kind} secondary={b.secondary} />)}
      {label === 'inference' && <EvidenceBadge locale={locale} kind="inference" />}
      {label === 'arithmetic' && <EvidenceBadge locale={locale} kind="derived" />}
      {label === 'request' && <Tag>{L.request[locale]}</Tag>}
    </p>
    {(why || Astro.slots.has('why')) && (
      <details class="act__why">
        <summary><span>{L.why[locale]}</span><Icon name="chevron-down" size="1.1em" class="act__chev" /></summary>
        {why && <Claim locale={locale} text={why} facts={whyFacts} size="sm" badge={label === 'inference' ? 'inference' : label === 'request' ? [] : undefined} />}
        <slot name="why" />
      </details>
    )}
  </div>
</li>

<style>
  .act {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: var(--sp-3);
    padding-block: var(--sp-4);
    border-block-start: 1px solid var(--line);
  }
  .act:first-child {
    border-block-start: 0;
  }
  .act__n {
    font-family: var(--font-en-display, var(--font-heading));
    font-weight: var(--fw-black);
    font-size: var(--fs-xl);
    line-height: 1;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .act__body {
    display: grid;
    gap: var(--sp-2);
    min-inline-size: 0;
  }
  .act__text {
    margin: 0;
    font-size: var(--fs-md);
    line-height: var(--lh-snug);
  }
  .act__link {
    font-weight: var(--fw-bold);
    overflow-wrap: anywhere;
  }
  .act__label {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-2);
  }
  .act__why summary {
    cursor: pointer;
    font-size: var(--fs-sm);
    color: var(--ink-2);
    min-block-size: 44px;
    display: flex;
    align-items: center;
    inline-size: fit-content;
  }
  .act__why summary {
    gap: var(--sp-1);
    list-style: none;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .act__why summary::-webkit-details-marker {
    display: none;
  }
  .act__why :global(.act__chev) {
    transition: transform var(--dur-1, 0.15s);
  }
  .act__why[open] :global(.act__chev) {
    transform: rotate(180deg);
  }
  .act__why[open] summary {
    margin-block-end: var(--sp-2);
  }
  .act__why > :global(* + *) {
    margin-block-start: var(--sp-3);
  }
  @media (prefers-reduced-motion: reduce) {
    .act__why :global(.act__chev) {
      transition: none;
    }
  }
</style>
