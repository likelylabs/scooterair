---
/**
 * CheckChart — "measured beside estimated" (G5) for the one-page brief, drawn by the rules of
 * brief 4.4: one linear axis in ppm (0 to 2), three rows named for where and when they apply,
 * measured rows above (solid dots), the estimate below (a hatched band with a dashed edge, never
 * a dot or a line), the two-item legend, and the zoom-out strip with the WHO 15-minute value.
 * Every value comes from src/data/estimate.ts. Lane D's MeasuredVsEstimate is the site's own
 * version; this one is sized for paper and has no interaction.
 *
 * Props
 *   locale  Locale
 */
import type { Locale } from '@/i18n';
import KindChip from '@/components/ui/KindChip.astro';
import EstimateValue from '@/components/ui/EstimateValue.astro';
import { est, estimateText, formatEstNumber } from '@/data/estimate';
import act from '@/i18n/pages/act';
import { fill, localize } from '@/i18n/pages/_copy';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const b = localize(act, locale).brief;
const MAX = 2;
const x = (v: number) => `${((v / MAX) * 100).toFixed(2)}%`;
const peaks = est.meas.iot.co.peaks;
const total = est.co.dozen.total;
const n1 = (v: number) => formatEstNumber(v, 'dp1', locale);
const ticks = [0, 0.5, 1, 1.5, 2];
const who = est.who.co15min_ppm.value;
// the zoom-out strip: the whole chart (0–MAX) as a share of the WHO value
const stripShare = `${((MAX / who) * 100).toFixed(2)}%`;
---

<figure class="cc">
  <div class="cc__plot" role="group" aria-label={`${b.rowStreet}: ${n1(est.bg.co.traffic.shown)} ppm. ${b.rowIot}: ${peaks.map(n1).join(', ')} ppm. ${b.rowEst}: ${total.lo}–${total.hi} ppm.`}>
    <div class="cc__row">
      <p class="cc__label"><b>{b.rowStreet}</b><span>{b.rowStreetSub}</span></p>
      <div class="cc__track"><span class="cc__dot" style={`left:${x(est.bg.co.traffic.shown)}`}></span></div>
      <p class="cc__val">{n1(est.bg.co.traffic.shown)} ppm <KindChip locale={locale} kind="measured" size="sm" /></p>
    </div>
    <div class="cc__row">
      <p class="cc__label"><b>{b.rowIot}</b><span>{fill(b.rowIotSub, { n: est.meas.iot.co.peakSites })}</span></p>
      <div class="cc__track">{peaks.map((v) => <span class="cc__dot" style={`left:${x(v)}`}></span>)}</div>
      <p class="cc__val">{peaks.map(n1).join(' · ')} ppm <KindChip locale={locale} kind="measured" size="sm" /></p>
    </div>
    <div class="cc__row cc__row--est">
      <p class="cc__label"><b>{b.rowEst}</b><span>{b.rowEstSub}</span></p>
      <div class="cc__track"><span class="cc__band" style={`left:${x(total.lo)};width:calc(${x(total.hi)} - ${x(total.lo)})`}></span></div>
      <div class="cc__val"><EstimateValue locale={locale} slotId="co.dozen.total" anchor="check" /></div>
    </div>
    <div class="cc__axis" aria-hidden="true">
      {ticks.map((v) => <span style={`left:${x(v)}`}>{v}</span>)}
    </div>
    <p class="cc__unit">{b.axis}</p>
  </div>
  <p class="cc__legend"><span class="cc__k cc__k--m"></span>{estimateText.legendMeasured[locale]}<span class="cc__k cc__k--e"></span>{estimateText.legendEstimated[locale]}</p>
  <div class="cc__strip" aria-hidden="true">
    <span class="cc__strip-bar"><span class="cc__strip-in" style={`width:max(4px, ${stripShare})`}></span></span>
  </div>
  <p class="cc__who">{fill(b.who, { ppm: who })} <KindChip locale={locale} kind="official" size="sm" /></p>
</figure>

<style>
  .cc {
    margin: 0;
    display: grid;
    gap: 6px;
  }
  .cc p {
    margin: 0;
  }
  .cc__plot {
    display: grid;
    gap: 8px;
  }
  .cc__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
  }
  .cc__label {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.6em;
    font-size: var(--fs-sm);
    line-height: 1.35;
  }
  .cc__label span {
    color: var(--ink-2);
  }
  .cc__track {
    position: relative;
    block-size: 18px;
    background: linear-gradient(to right, var(--line) 0 0) left center / 100% 1px no-repeat;
  }
  .cc__dot {
    position: absolute;
    top: 50%;
    inline-size: 12px;
    block-size: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: var(--ink);
  }
  .cc__band {
    position: absolute;
    top: 1px;
    bottom: 1px;
    border: 2px dashed var(--estimate-ink, #8a5a00);
    background: repeating-linear-gradient(-45deg, var(--estimate-wash, #f6e3c2) 0 3px, var(--estimate, #c98a1e) 3px 5px);
  }
  .cc__val {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
  }
  .cc__axis {
    position: relative;
    block-size: 18px;
    border-block-start: 1.5px solid var(--ink-2);
    font-size: var(--fs-xs);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .cc__axis span {
    position: absolute;
    top: 1px;
    transform: translateX(-50%);
  }
  .cc__axis span:first-child {
    transform: none;
  }
  .cc__axis span:last-child {
    transform: translateX(-100%);
  }
  .cc__unit,
  .cc__legend,
  .cc__who {
    font-size: var(--fs-xs);
    color: var(--ink-2);
  }
  .cc__legend {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .cc__k {
    display: inline-block;
    inline-size: 12px;
    block-size: 12px;
  }
  .cc__k--m {
    border-radius: 50%;
    background: var(--ink);
  }
  .cc__k--e {
    margin-inline-start: 10px;
    border: 1.5px dashed var(--estimate-ink, #8a5a00);
    background: repeating-linear-gradient(-45deg, var(--estimate-wash, #f6e3c2) 0 2px, var(--estimate, #c98a1e) 2px 4px);
  }
  .cc__strip-bar {
    display: block;
    block-size: 10px;
    border: 1.5px solid var(--ink-2);
    position: relative;
  }
  .cc__strip-in {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    background: var(--ink);
  }
  .cc__who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
  }
</style>
