---
/**
 * EvShareChart — V17, 往回走的那條線: the electric share of newly registered scooters by year
 * (a solid line that breaks where a year is not verified), and the government's targets drawn
 * as hollow points joined by a dashed line, so a target never reads as a forecast.
 *
 * Built on the shared line renderer (charts/core/line.ts) and ChartShell; the line chart
 * component has no dashed or hollow-marker series, so the targets are added here.
 *
 * Props
 *   locale   Locale
 *   title    accessible name
 *   desc     the takeaway in a sentence
 *   years    every year on the axis, evenly spaced
 *   actual   one value per year (null = no verified figure: the line breaks)
 *   targets  { x: year, y: percent }[]
 *   labels   { first, last }: the two actual points to label directly
 *   names    { actual, target, year } legend and table words
 */
import type { Locale } from '@/i18n';
import ChartShell from '@/components/charts/ChartShell.astro';
import { renderLine } from '@/components/charts/core/line';
import { esc } from '@/components/charts/core/shared';

interface Point {
  x: number;
  y: number;
  text: string;
}
interface Props {
  locale: Locale;
  title: string;
  desc?: string;
  years: number[];
  actual: (number | null)[];
  targets: { x: number; y: number }[];
  labels: { first: Point; last: Point };
  format: (v: number) => string;
  names: { actual: string; target: string; year: string };
}
const { locale, title, desc, years, actual, targets, labels, format, names } = Astro.props;

const H = 200;
const TOP = 24;
const yMax = Math.max(100, ...targets.map((p) => p.y));
const n = years.length;
const shown = new Set([labels.first.x, labels.last.x, years[n - 1]]);
const render = renderLine({ locale, x: years.map((y) => (shown.has(y) ? String(y) : '')), series: [{ label: names.actual, tone: 'clean', values: actual }], unit: '%', yMax, height: H, area: false, xLabel: names.year });

const xp = (year: number) => ((years.indexOf(year) / (n - 1)) * 100).toFixed(2);
const yp = (v: number) => (TOP + H - (v / yMax) * H).toFixed(1);
const extra: string[] = [];
// target years as their own ticks (the last year is already labelled)
for (const p of targets) if (!shown.has(p.x)) extra.push(`<text class="c-tick" x="${xp(p.x)}%" y="${TOP + H + 18}" text-anchor="middle">${p.x}</text>`);
// dashed join between targets, in a stretched inner svg like the renderer's own lines
const d = targets.map((p, i) => `${i ? 'L' : 'M'}${(Number(xp(p.x)) * 10).toFixed(1)},${yp(p.y)}`).join('');
extra.push(`<svg class="c-stretch" x="0" y="0" width="100%" height="${TOP + H}" viewBox="0 0 1000 ${TOP + H}" preserveAspectRatio="none"><path class="c-line c-stroke-ink" d="${d}" stroke-dasharray="7 6" vector-effect="non-scaling-stroke"/></svg>`);
targets.forEach((p, i) => {
  const last = i === targets.length - 1;
  extra.push(`<circle cx="${xp(p.x)}%" cy="${yp(p.y)}" r="5.5" class="c-stroke-ink" fill="var(--here)" stroke-width="2.5"/>`);
  extra.push(`<text class="c-value c-value--sm" x="${xp(p.x)}%" y="${Number(yp(p.y)) - 11}" text-anchor="${last ? 'end' : 'middle'}" ${last ? 'dx="6"' : ''}>${esc(format(p.y))}</text>`);
});
// a dot on every verified year, so a year standing alone between gaps is still drawn
actual.forEach((v, i) => v !== null && extra.push(`<circle class="c-dot c-fill-clean" cx="${xp(years[i])}%" cy="${yp(v)}" r="4"/>`));
// direct labels on the first and last verified years
extra.push(`<text class="c-value c-value--sm" x="${xp(labels.first.x)}%" y="${Number(yp(labels.first.y)) - 12}" text-anchor="start">${esc(labels.first.text)}</text>`);
extra.push(`<text class="c-value c-value--sm" x="${xp(labels.last.x)}%" y="${Number(yp(labels.last.y)) - 12}" text-anchor="middle">${esc(labels.last.text)}</text>`);

const targetAt = (y: number) => targets.find((p) => p.x === y)?.y ?? null;
render.body += extra.join('');
render.legend = [
  { label: names.actual, tone: 'clean', shape: 'line' },
  { label: names.target, tone: 'ink', shape: 'dot' },
];
render.hover = {
  xs: years.map((_, i) => +((i / (n - 1)) * 100).toFixed(2)),
  rows: years.map((y, i) => [String(y), actual[i] !== null ? `${names.actual}: ${format(actual[i] as number)}` : '', targetAt(y) !== null ? `${names.target}: ${format(targetAt(y) as number)}` : ''].filter(Boolean).join('\n')),
};
render.table = {
  head: [names.year, locale === 'en' ? `${names.actual} (%)` : `${names.actual}（%）`, locale === 'en' ? `${names.target} (%)` : `${names.target}（%）`],
  rows: years
    .map((y, i) => [String(y), actual[i] !== null ? format(actual[i] as number) : '', targetAt(y) !== null ? format(targetAt(y) as number) : ''])
    // a year with neither a verified figure nor a target is left out, except a gap between the
    // first and last verified years: that row stays and says the figure could not be verified
    .filter((r) => {
      const y = Number(r[0]);
      const inside = y > labels.first.x && y < labels.last.x;
      return inside || ((r[1] !== '' || r[2] !== '') && (y <= labels.last.x || r[2] !== ''));
    })
    // an empty cell says why in words, never a lone dash
    .map((r) => [r[0], r[1] || (Number(r[0]) > labels.last.x ? (locale === 'en' ? 'year not reached yet' : '還沒到這一年') : locale === 'en' ? 'figure not verified' : '這年的數字沒查證到'), r[2] || (locale === 'en' ? 'no target for this year' : '這年沒有目標')]),
};
render.padRight = Math.max(render.padRight ?? 0, 18);
---

<ChartShell render={render} title={title} desc={desc} locale={locale} />
