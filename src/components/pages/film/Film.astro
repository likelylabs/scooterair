---
import { absUrl } from '../../../lib/abs-url.ts';
/**
 * Film — /90/ (redesign brief, section 8 and amendment 12.2): one red light as an animation.
 *
 * It is a page, not a video file: one continuous scene (./scene.ts) driven by one clock
 * (./timeline.ts), drawn with the site's own drawing kit and its one rule for air
 * (src/components/art/parts.ts, air.ts), so the film and the home page share one picture
 * grammar. Its words are src/i18n/pages/film.ts; its numbers are the estimate slots and the
 * money module, joined in ./film-data.ts. A stand-in digit cannot ship: a missing slot, a
 * caption that outgrows its time on screen, a pack that is not scn.dozen.drawn scooters, or a
 * NaN in a still, stops the build here.
 *
 * ONE DOCUMENT, TWO PRESENTATIONS
 *   With JavaScript off, with reduced motion, or in print, the reader sees the film laid out
 *   as stills with their captions, then the transcript. Otherwise <html> gets .film-live before
 *   first paint (the inline script in 90.astro) and the stage takes their place: a poster with a
 *   Play button, captions, a scrubber. Nothing plays until the reader asks.
 *
 * The same page is what scripts/film-export.mjs photographs, frame by frame, for the MP4.
 *
 * Props
 *   locale  Locale
 */
import '@/styles/art.css';
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { asset, href, type Locale } from '@/i18n';
import { localize, fill } from '@/i18n/pages/_copy';
import filmCopy from '@/i18n/pages/film';
import { chipWhere, illustration, kSentences, redHoursSentence, site } from '@/i18n/ui';
import { est, estimateText, waitPerRed_s } from '@/data/estimate';
import { fact, type FactId } from '@/data';
import { AIR_EXTRA } from '@/components/art/air-slots';
import EstimateValue from '@/components/ui/EstimateValue.astro';
import HowButton from '@/components/ui/HowButton.astro';
import HowSheet from '@/components/ui/HowSheet.astro';
import IllustrationTag from '@/components/ui/IllustrationTag.astro';
import KindChip from '@/components/ui/KindChip.astro';
import { createFilm, SVG_LAYERS } from './scene';
import { hudHTML } from './hud';
import { glueZh } from '@/lib/glue.mjs';
import { signGlyphs } from './glyphs';
import { BEATS, DURATION, DURATION_MINUTES, beatAt, clock, cueAt, type CueId } from './timeline';
import { filmData, filmLengthLabel, filmPeriods } from './film-data';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = localize(filmCopy, locale);
const en = locale === 'en';
const d = filmData(locale);
// a caption line keeps its words whole (src/lib/glue.mjs), as the playing caption does
const glueLine = (x: string) => glueZh(x.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'));
const asChecked = filmData(locale, { asChecked: true });
const periods = filmPeriods(locale);
const text = { ...d.text, panel: { ...d.text.panel, howHref: href(d.text.panel.howHref, locale) } };
const glyphs = await signGlyphs();
const drawn = est.scn.dozen.drawn;
const make = (id: string, withGlyphs = false) => createFilm({ locale, aspect: 4 / 3, px: 360, id, text, extra: AIR_EXTRA, drawn, glyphs: withGlyphs ? glyphs : undefined });
const shared = make('s', true);
const captionOf = (id: CueId) => d.captions.find((c) => c.id === id)!;

// ---- stills: the film laid out frame by frame --------------------------------------------
const stillTimes = BEATS.flatMap((b) => b.stills.map((time) => ({ time, beat: b })));
const stills = stillTimes.map(({ time, beat }, i) => {
  const f = make(`s${i}`);
  const r = f.renderStatic(time);
  const hud = f.hud(time);
  const all = Object.values(r).join('');
  if (/NaN|undefined/.test(all)) throw new Error(`film: the still at ${time} s has a broken value (${all.match(/.{40}(?:NaN|undefined).{20}/)?.[0]})`);
  const cue = captionOf(cueAt(time).id);
  const line = cue.main + (cue.note ? (en ? ' ' : '') + (en ? `(${cue.note})` : `（${cue.note}）`) : '');
  const scene = hud.tag !== 'none';
  return {
    n: i + 1,
    time,
    // the time printed with a still is the start of its caption, as in the transcript below
    cueStart: cueAt(time).t,
    beat,
    r,
    hud: hudHTML(text, hud, { link: false }),
    tag: hud.tag,
    cue,
    scene,
    // the panel is in the picture: its estimate, pressable, goes in the caption (the picture holds nothing to press)
    panel: hud.panel > 0.5 && !hud.zero,
    alt: fill(t.still.alt, { n: i + 1, line }) + (scene ? (en ? ' ' : '') + (hud.tag === 'body' ? illustration.body[locale] : illustration.altNote[locale]) : ''),
  };
});

// ---- the MP4, when it has been exported (scripts/film-export.mjs writes the manifest) ------
type Manifest = { files?: Record<string, { file: string; bytes: number }> };
const manifestPath = join(process.cwd(), 'public/film/manifest.json');
const manifest: Manifest = existsSync(manifestPath) ? JSON.parse(readFileSync(manifestPath, 'utf8')) : {};
const mp4 = manifest.files?.[locale];
const mp4Href = mp4 && existsSync(join(process.cwd(), 'public/film', mp4.file)) ? asset(`/film/${mp4.file}`) : null;
const mp4Size = mp4 ? (mp4.bytes / 1e6).toFixed(1) : '';

const pageUrl = absUrl(href('/90/', locale), Astro.site);
const lineHref = `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(fill(t.player.lineText, { min: DURATION_MINUTES }))}`;

// ---- transcript: every cue, what the picture adds to it, and what it rests on --------------
type Ref = { chip?: { fact?: FactId; kind?: string; where?: string }; href?: string; sheet?: string; estimate?: boolean };
const dr = t.transcript.drawn;
const m = d.money.money;
const tagLine = (g: (typeof m.tags)[number]) => fill(dr.tag, { where: g.where, plate: g.plate, sum: [g.before, g.amount, g.after].filter(Boolean).join(' ') });
const extra: Partial<Record<CueId, string[]>> = {
  arrive: [fill(dr.pack, { scenario: d.slots.scenario, n: d.slots.drawn })],
  howMuch: [fill(dr.street, { label: text.panel.street, value: text.panel.streetValue })],
  under: [fill(dr.ruler, { lo: d.slots.band.lo, hi: d.slots.band.hi })],
  // the assumption behind the yearly hours, in the same words as home screen 7
  daily: [redHoursSentence(locale, waitPerRed_s.lo, waitPerRed_s.hi)],
  thins: [dr.burst, kSentences.K6[locale]],
  electric: [fill(dr.zero, { label: text.panel.addedElectric, value: text.panel.zero })],
  tags: [...m.tags.map(tagLine), m.chip],
  monthly: [m.perMonth, ...m.bars.map((b) => fill(dr.bar, { label: b.label, value: b.value }))],
};
const refs: Partial<Record<CueId, Ref>> = {
  smell: { chip: { fact: 'iot-pedestrian-wait' }, href: '/estimate/#count' },
  arrive: { chip: { kind: 'estimate' }, href: '/estimate/#count' },
  knee: { chip: { fact: 'iot-exhaust-height-assumption' }, href: '/evidence/#link-2' },
  howMuch: { estimate: true, chip: { fact: 'moenv-co-stations-2025' }, sheet: 'how-film-estimate' },
  co: { chip: { fact: 'co-odourless' }, href: '/evidence/#link-4' },
  fuel: { chip: { fact: 'iarc-benzene-group1' }, href: '/evidence/#link-4' },
  specks: { chip: { fact: 'route-particles-deep-lung' }, href: '/evidence/#link-4' },
  mask: { chip: { fact: 'mask-niosh-no-gas' }, href: '/questions/mask/' },
  under: { chip: { fact: 'iot-exhaust-height-assumption' }, sheet: 'how-film-heights' },
  child: { chip: { fact: 'child-air-per-kg' }, sheet: 'how-film-heights' },
  rider: { chip: { fact: 'commute-scooter-vs-subway-chuang2020' }, href: '/questions/rider/' },
  daily: { chip: { kind: 'derived' }, href: '/questions/one-red-light/' },
  years: { chip: { kind: 'study', where: chipWhere.longTermAllTraffic[locale] }, sheet: 'how-film-health' },
  linked: { chip: { kind: 'study', where: chipWhere.longTermAllTraffic[locale] }, sheet: 'how-film-health' },
  thins: { href: '/estimate/#answers' },
  noLayer: { href: '/evidence/#link-7' },
  tags: { chip: { kind: 'derived' }, href: '/electric/' },
  monthly: { chip: { kind: 'derived' }, href: '/electric/' },
};
const rows = d.captions.map((c, i) => ({ ...c, beat: beatAt(c.t), head: i === 0 || beatAt(c.t) !== beatAt(d.captions[i - 1].t), extra: extra[c.id] ?? [], ref: refs[c.id] }));

// ---- sheets --------------------------------------------------------------------------------
const hei = fact('hei-sr23-trap-associations');
const heightFact = fact('iot-exhaust-height-assumption');
const datum = (f: { data?: Record<string, { value: number } | number> }, key: string): number => {
  const v = f.data?.[key];
  const n = typeof v === 'number' ? v : v?.value;
  if (typeof n !== 'number' || !Number.isFinite(n)) throw new Error(`film: the registry fact has no data "${key}"`);
  return n;
};
const sheet = {
  estimate: {
    title: fill(t.sheets.estimate.title, { range: d.slots.coAdded }),
    measured: fill(t.sheets.estimate.measured, { street: d.slots.coStreet, peaks: est.meas.iot.co.peaks.join(en ? ', ' : '、') }),
  },
  heights: fill(t.sheets.heights.what, { pipe: Math.round(datum(heightFact, 'exhaustHeight') * 100), lo: d.slots.band.lo, hi: d.slots.band.hi, airLo: est.child.airPerKg.lo, airHi: est.child.airPerKg.hi }),
  health: {
    who: fill(t.sheets.health.who, { n: datum(hei, 'studies') }),
    care: fill(t.sheets.health.care, { k5: kSentences.K5[locale] }),
  },
};

const pageData = {
  text,
  captions: d.captions,
  periods: periods.map((p) => ({ from: p.from, money: p.part.money, cues: p.part.cues })),
  asChecked: { money: asChecked.money.money, cues: asChecked.money.cues },
  extra: AIR_EXTRA,
  drawn,
  ui: { play: t.player.play, pause: t.player.pause, position: t.player.position },
};
const label = `${t.player.kicker}${en ? ': ' : '：'}${t.player.title}`;
const VB = `0 0 ${shared.VW} ${shared.VH}`;
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs set:html={shared.defs()} /></svg>

<section class="film" data-film data-locale={locale} aria-label={label}>
  <header class="film__head">
    <p class="film__kicker">{t.player.kicker}</p>
    <h1 class="film__h1">{t.player.title}</h1>
    <p class="film__deck">{filmLengthLabel(locale)}</p>
  </header>

  <div class="film__stage" data-stage role="group" aria-label={label}>
    <div class="film__pic" data-pic data-tag="street">
      {SVG_LAYERS.map((k) => <svg class="film__layer" data-layer={k} aria-hidden="true" focusable="false"></svg>)}
      <div class="film__over" data-over aria-hidden="true"></div>
      <div class="hud" data-hud></div>
      <IllustrationTag locale={locale} overlay class="film__tag film__tag--street" />
      <IllustrationTag locale={locale} kind="body" overlay class="film__tag film__tag--body" />
      <div class="film__poster" data-poster>
        <p class="film__kicker">{t.player.kicker}</p>
        <p class="film__title" aria-hidden="true">{t.player.title}</p>
        <button type="button" class="film__big" data-film-big aria-label={`${t.player.play}${locale === 'en' ? ': ' : '：'}${t.player.title}`}><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4.5v15l12.5-7.5z"></path></svg>{t.player.play}</button>
        <p class="film__len">{filmLengthLabel(locale)}</p>
      </div>
      <div class="film__end" data-end>
        <p class="film__end-title">{t.end.title}</p>
        <a class="film__cta film__cta--primary" href={href('/electric/', locale)}>{t.end.calc} →</a>
        <div class="film__end-grid">
          <button type="button" class="film__cta" data-film-again>{t.end.again}</button>
          <a class="film__cta" href={lineHref} target="_blank" rel="noopener">{t.player.line}</a>
          <a class="film__cta" href={href('/evidence/', locale)}>{t.end.evidence}</a>
          {mp4Href && <a class="film__cta" href={mp4Href} download>{t.player.download}</a>}
        </div>
        <a class="film__cta film__cta--quiet" href={href('/estimate/#measure', locale)}>{t.end.measure}</a>
      </div>
    </div>
    <div class="film__caption" aria-hidden="true"><div data-capbox><p class="cap__main" data-cap data-headline-dynamic></p><p class="cap__note" data-note></p></div><p class="film__mark"><b>{site.name[locale]}</b><span>{label}</span></p></div>
    <div class="film__controls">
      <button type="button" class="film__btn" data-film-toggle aria-label={t.player.play}><svg class="ico--play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4.5v15l12.5-7.5z"></path></svg><svg class="ico--pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.5 5h4v14h-4zM13.5 5h4v14h-4z"></path></svg></button>
      <button type="button" class="film__btn" data-film-restart aria-label={t.player.restart}><svg class="ico--line" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12a7 7 0 1 0 2.2-5.1M4.5 4.5v4h4"></path></svg></button>
      <input class="film__seek" type="range" min="0" max={DURATION} step="0.1" value="0" aria-label={t.player.seek} data-film-seek />
      <span class="film__time"><span data-film-time>0:00</span><span class="film__total"> / {clock(DURATION)}</span></span>
      <button type="button" class="film__speed" data-film-speed aria-pressed="false" aria-label={`${t.player.speed.label}${en ? ': ' : '：'}${t.player.speed.slow}`}>{t.player.speed.slow}</button>
    </div>
    <p class="vh" aria-live="polite" data-film-say></p>
  </div>

  <div class="film__under">
    <p class="film__notes">{fill(t.player.notes, { red: d.slots.red })} <a class="film__inline" href={text.panel.howHref}>{t.player.how} →</a></p>
    <p class="film__notes film__keys">{t.player.keys}</p>
    <div class="film__share">
      <a class="film__cta" href={lineHref} target="_blank" rel="noopener">{t.player.line}</a>
      {mp4Href && <a class="film__cta" href={mp4Href} download>{t.player.download}</a>}
      {mp4Href && <span class="film__share-note">{fill(t.player.downloadNote, { size: mp4Size })}</span>}
    </div>
    <p class="film__stills-note">{t.still.note} <button type="button" class="film__optin" data-film-optin hidden>{t.still.optIn}</button></p>
    <ol class="film__stills">
      {stills.map((s) => (
        <li data-still-t={s.time} tabindex="-1">
          <figure class="still">
            <div class="still__pic" data-tag={s.tag} role="img" aria-label={s.alt} data-scene={s.scene ? '' : undefined}>
              {SVG_LAYERS.map((k) => s.r[k] && <svg class="film__layer" viewBox={VB} aria-hidden="true" focusable="false" set:html={s.r[k]} />)}
              <div class="film__over" aria-hidden="true" set:html={s.r.over} />
              <div class="hud" aria-hidden="true" set:html={s.hud} />
              {s.tag === 'street' && <IllustrationTag locale={locale} overlay class="film__tag" />}
              {s.tag === 'body' && <IllustrationTag locale={locale} kind="body" overlay class="film__tag" />}
            </div>
            <figcaption>
              <p class="still__when">{fill(t.still.frameN, { n: s.n })} · {clock(s.cueStart)} · {t.beats[s.beat.id]}</p>
              <p class="still__line" set:html={glueLine(s.cue.main)} />
              {s.cue.note && <p class="still__note">{s.cue.note}{s.cue.chip && <Fragment> <KindChip locale={locale} kind={s.cue.chip.kind} size="sm" /></Fragment>}</p>}
              {s.panel && <p class="still__est"><EstimateValue locale={locale} slotId="co.dozen.add" label={text.panel.added} sheet="how-film-estimate" /></p>}
            </figcaption>
          </figure>
        </li>
      ))}
    </ol>

    <section class="film__transcript" aria-labelledby="film-transcript" data-transcript id="transcript">
      <h2 id="film-transcript">{t.transcript.title}</h2>
      <p class="film__notes">{t.transcript.intro}</p>
      <ol class="film__lines">
        {rows.map((c) => (
          <Fragment>
            {c.head && <li class="film__lines-head"><h3>{t.beats[c.beat.id]}</h3></li>}
            <li data-line={c.id}>
              <button type="button" class="film__jump" data-film-jump={c.t} data-js-only aria-label={fill(t.transcript.jump, { time: clock(c.t) })}>{clock(c.t)}</button>
              <div class="film__line">
                <p class="film__line-text" set:html={glueLine(c.main)} />
                {c.note && <p class="film__line-note">{c.note}</p>}
                {c.extra.map((x) => <p class="film__line-note">{x}</p>)}
                {c.ref && (
                  <p class="film__line-source">
                    {c.ref.estimate && <EstimateValue locale={locale} slotId="co.dozen.add" label={text.panel.added} sheet={c.ref.sheet} />}
                    {c.ref.chip && (c.ref.chip.fact ? <KindChip locale={locale} of={fact(c.ref.chip.fact)} /> : <KindChip locale={locale} kind={c.ref.chip.kind} where={c.ref.chip.where} />)}
                    {c.ref.sheet && !c.ref.estimate && <HowButton locale={locale} sheet={c.ref.sheet} />}
                    {c.ref.href && <a class="film__source" href={href(c.ref.href, locale)}>{t.transcript.source} →</a>}
                  </p>
                )}
              </div>
            </li>
          </Fragment>
        ))}
      </ol>
    </section>

    <HowSheet id="how-film-estimate" locale={locale} kind="estimate" title={sheet.estimate.title} pollutant="co" anchor="numbers" facts={['moenv-co-stations-2025']}>
      <p slot="block1">{sheet.estimate.measured}</p>
      <ol slot="block2" class="film__flow">{estimateText.flow.map((s) => <li>{s[locale]}</li>)}</ol>
      <p slot="block3">{t.sheets.estimate.care} {est.meta.gloss[locale]}</p>
    </HowSheet>
    <HowSheet id="how-film-heights" locale={locale} kind="study" title={t.sheets.heights.title} facts={['iot-exhaust-height-assumption', 'child-air-per-kg']} primary={{ href: href('/evidence/#link-6', locale) }}>
      <p slot="block1">{t.sheets.heights.who}</p>
      <p slot="block2">{sheet.heights}</p>
      <p slot="block3">{t.sheets.heights.care}</p>
    </HowSheet>
    <HowSheet id="how-film-health" locale={locale} kind="study" where={chipWhere.longTermAllTraffic[locale]} title={t.sheets.health.title} facts={['hei-sr23-trap-associations']} primary={{ href: href('/evidence/#link-5', locale) }}>
      <p slot="block1">{sheet.health.who}</p>
      <p slot="block2">{t.sheets.health.what}</p>
      <p slot="block3">{sheet.health.care}</p>
    </HowSheet>
  </div>

  <script type="application/json" data-film-data set:html={JSON.stringify(pageData).replace(/</g, '\\u003c')} />
</section>

<script>
  import './film.client.ts';
</script>

<style is:global>
  /*
   * The stage, the HUD, the captions, the controls, the stills, the transcript, and the film's
   * own drawing classes (.f-* in the SVG, .fo-* in the HTML over it). Colours are the site's
   * tokens and the .a-* / .air-* classes of art.css.
   *
   * RULE FOR .f-* AND .fo-* CLASSES: never set `opacity`, `transform` or `display` on an
   * element the timeline drives. The timeline writes those (as SVG attributes, or as inline
   * styles on the HTML layer), and a declaration here would fight it. Use fill-opacity and
   * stroke-opacity when a class needs to be pale.
   */
  .film {
    --cap-h: 6.25rem;
    /* two rows of controls on a phone: the scrubber, then the buttons (48 + 8 + 48 + padding) */
    --ctl-h: 7rem;
    /* room for the picture: the viewport less the site header, the caption band and the controls */
    /* (the header's own height plus its 1 px bottom rule) */
    --avail: calc(100svh - var(--header-h) - 1px - var(--cap-h) - var(--ctl-h));
    --pic-h: clamp(10rem, var(--avail), 40rem);
    --film-ink: #f3f5f3;
    --film-quiet: #c3cbcb;
    --film-line: #2a3237;
  }
  @media (min-width: 40em) {
    .film {
      --cap-h: 6rem;
      --ctl-h: 3.5rem;
    }
  }
  /* 大 and 特大 (brief 6.4): the words over the picture grow with the text, so the picture keeps a
     floor height and the stage may run taller than the screen; nothing in it is cut */
  :root:is([data-text='lg'], [data-text='xl']) .film {
    --pic-h: clamp(17rem, var(--avail), 40rem);
  }
  /* a narrow stage (a small phone, or large text): the clock shows the position only, so the speed button fits */
  @container (max-width: 22rem) {
    .film__total {
      display: none;
    }
    .film__controls .film__speed {
      padding-inline: 0.6rem;
    }
  }
  .film .vh {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* the page's heading: on the poster when the film can play, above the stills when it cannot */
  .film__head {
    inline-size: min(100%, 44rem);
    margin-inline: auto;
    padding: var(--sp-5) var(--gutter) var(--sp-2);
  }
  .film-live .film__head {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .film__h1 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--fs-headline);
    font-weight: 900;
    line-height: var(--lh-headline);
  }
  .film__deck {
    margin: 0.25rem 0 0;
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .film__stage {
    display: none;
    container-type: inline-size;
    /* never wider than about twice its picture's height: on a laptop a wide film frame, on a phone a square */
    inline-size: min(100%, calc(var(--pic-h) * 1.9));
    margin-inline: auto;
    background: var(--asphalt-900);
  }
  .film-live .film__stage {
    display: block;
  }
  .film-live .film__stills,
  .film-live .film__stills-note {
    display: none;
  }
  /* words inside the picture are bounded by the picture, like words in a drawing: they keep their
     standard size when the reader picks 大 or 特大 (the captions and the transcript grow instead) */
  .film__pic,
  .still__pic {
    --pr: min(1rem, 16px);
    /* the site's tokens, at their standard sizes, for everything drawn over the picture (the tag, the cards, the buttons) */
    --fs-xs: calc(0.875 * var(--pr));
    --fs-sm: calc(0.9375 * var(--pr));
    --fs-btn: calc(1.0625 * var(--pr));
    --fs-md: calc(1.25 * var(--pr));
    --tap: calc(3 * var(--pr));
  }
  .film__pic {
    --here: var(--bg);
    position: relative;
    overflow: hidden;
    block-size: min(var(--pic-h), 100cqi);
    background: var(--bg);
    cursor: pointer;
    /* the picture is its own world for layout and paint: nothing in it can reflow the page */
    contain: strict;
    container-type: size;
  }
  .film__layer {
    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    overflow: hidden;
    pointer-events: none;
    /* each layer is its own compositor layer: when only the air moves, the street is not repainted */
    will-change: transform;
  }
  /* the scenario steps of art.css fade with a CSS transition; in the film the timeline alone decides */
  .film :is(.air-b, .air-wash) {
    transition: none;
  }

  /* ---- words over the picture (HTML, never SVG text) ------------------------------------- */
  .film__over {
    position: absolute;
    inset: 0;
    pointer-events: none;
    color: var(--ink);
    font-weight: 700;
    line-height: 1.3;
  }
  .film__over > *,
  .fo-box > * {
    position: absolute;
    margin: 0;
  }
  .film__over p {
    margin: 0;
  }
  .fo-ruler {
    translate: -100% -50%;
    font-family: var(--font-latin), sans-serif;
    font-size: clamp(calc(0.875 * var(--pr, 1rem)), 4cqw, calc(1.375 * var(--pr, 1rem)));
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    /* a paper edge keeps the figures readable over the pavement */
    text-shadow: 0 0 2px var(--here), 0 0 2px var(--here), 0 0 3px var(--here);
  }
  .fo-ruler--unit {
    font-family: inherit;
    font-size: clamp(calc(0.875 * var(--pr, 1rem)), 3.6cqw, calc(1.125 * var(--pr, 1rem)));
    color: var(--ink-2);
  }
  .fo-side {
    inset-block-end: 14%;
    padding: 0.2em 0.6em;
    font-size: clamp(calc(0.875 * var(--pr, 1rem)), 4.2cqw, calc(1.375 * var(--pr, 1rem)));
    font-weight: 800;
    white-space: nowrap;
    color: #fff;
    border-radius: var(--radius-1);
  }
  .fo-side--petrol {
    background: var(--exhaust-600);
  }
  .fo-side--electric {
    background: var(--clean-600);
  }
  /* the 4:3 box every card is drawn in (scene.ts fit(400, 300, 0.98)) */
  .fo-box {
    inset-inline-start: 50%;
    inset-block-start: 50%;
    inline-size: calc(min(100cqw, 100cqh * 4 / 3) * 0.98);
    aspect-ratio: 4 / 3;
    translate: -50% -50%;
    container-type: size;
  }
  .fo-pin {
    translate: -50% -50%;
  }
  .fo-pin b {
    display: grid;
    place-items: center;
    inline-size: clamp(calc(1.75 * var(--pr, 1rem)), 9cqw, calc(3.25 * var(--pr, 1rem)));
    aspect-ratio: 1;
    font-family: var(--font-latin), sans-serif;
    font-size: clamp(calc(0.9375 * var(--pr, 1rem)), 5cqw, calc(1.75 * var(--pr, 1rem)));
    font-weight: 800;
    color: var(--bg);
    background: var(--ink);
    border: 2px solid var(--bg);
    border-radius: 50%;
  }
  .fo-name {
    translate: -50% 0;
    font-size: clamp(calc(0.9375 * var(--pr, 1rem)), 5cqw, calc(1.75 * var(--pr, 1rem)));
    font-weight: 800;
    white-space: nowrap;
  }
  .fo-name--e {
    color: var(--clean-ink);
  }
  /* the two price tags and their chip: one column, so a longer English line makes a taller tag, never an overlap */
  /* the two tags and their chip, centred on the card (the paper is theirs alone while they are up) */
  .fo-stack {
    inset: 50% 5% auto;
    translate: 0 -50%;
    display: grid;
    gap: calc(0.45 * var(--pr, 1rem));
    justify-items: center;
  }
  .fo-tag {
    position: relative;
    display: grid;
    gap: 0.1em;
    inline-size: 100%;
    padding: 0.4em 0.7em 0.45em 1.9em;
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: 0.5em;
    font-size: clamp(calc(0.875 * var(--pr, 1rem)), 4.3cqw, calc(1.5 * var(--pr, 1rem)));
    transform-origin: 1em 50%;
    box-shadow: 0 2px 0 color-mix(in srgb, var(--ink) 25%, transparent);
  }
  /* the hole a price tag hangs by */
  .fo-tag::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.6em;
    inset-block-start: 50%;
    inline-size: 0.7em;
    aspect-ratio: 1;
    translate: 0 -50%;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--bg);
  }
  .fo-tag__where {
    font-weight: 700;
    color: var(--ink-2);
  }
  .fo-tag__sum {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.35em;
    font-weight: 800;
    line-height: 1.15;
  }
  .fo-tag__sum b {
    font-family: var(--font-latin), var(--font-body);
    font-size: 1.7em;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .fo-tag--less .fo-tag__sum {
    color: var(--clean-ink);
  }
  .fo-tag--more .fo-tag__sum {
    color: var(--exhaust-ink);
  }
  /* 綠牌 / 白牌, drawn like the plate itself */
  .fo-plate {
    margin-inline-start: auto;
    padding: 0.05em 0.5em;
    font-size: calc(0.875 * var(--pr, 1rem));
    font-style: normal;
    font-weight: 700;
    white-space: nowrap;
    border: 1.5px solid var(--ink);
    border-radius: 0.25em;
  }
  .fo-plate--light {
    color: #fff;
    background: var(--clean-600);
    border-color: var(--clean-600);
  }
  .fo-plate--heavy {
    color: #101416;
    background: #fff;
  }
  .fo-chip {
    position: static;
    display: flex;
    align-items: center;
    gap: 0.35em;
    max-inline-size: 100%;
    padding: 0.15em 0.7em;
    font-size: clamp(calc(0.875 * var(--pr, 1rem)), 3.7cqw, calc(1.125 * var(--pr, 1rem)));
    font-weight: 500;
    line-height: 1.3;
    color: var(--ink-2);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 1em;
  }
  .fo-chip__g {
    flex: none;
    inline-size: 1em;
    block-size: 1em;
  }
  .fo-permonth {
    translate: -50% 0;
    font-size: clamp(calc(0.9375 * var(--pr, 1rem)), 4.6cqw, calc(1.5 * var(--pr, 1rem)));
    font-weight: 800;
    white-space: nowrap;
  }
  /* the two bars, pushed in slowly during their hold: the same point as scene.ts PUSH (220/400, 204/300) */
  .fo-bars {
    inset: 0;
    transform-origin: 55% 68%;
  }
  .fo-bars > * {
    position: absolute;
    margin: 0;
  }
  .fo-bar {
    display: grid;
    gap: 0.2em;
    inline-size: 74%;
    font-size: clamp(calc(0.9375 * var(--pr, 1rem)), 4.6cqw, calc(1.5 * var(--pr, 1rem)));
    line-height: 1.2;
  }
  .fo-bar__label {
    font-weight: 700;
  }
  .fo-bar__value {
    font-family: var(--font-latin), var(--font-body);
    font-size: 1.2em;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .fo-bar__track {
    display: block;
    block-size: clamp(calc(1 * var(--pr, 1rem)), 7.6cqw, calc(2.5 * var(--pr, 1rem)));
  }
  .fo-bar__track i {
    display: block;
    block-size: 100%;
    min-inline-size: 4px;
    transform-origin: 0 50%;
    border-radius: 0 0.25em 0.25em 0;
    background: var(--chart-exhaust);
  }
  .fo-bar--e .fo-bar__track i {
    background: var(--chart-clean);
  }
  .fo-bar--e .fo-bar__value {
    color: var(--clean-ink);
  }
  .fo-bar--p .fo-bar__value {
    color: var(--exhaust-ink);
  }

  /* ---- the illustration tag: on in every street shot; the body card has its own; none on money */
  .film__pic .film__tag,
  .still__pic .film__tag {
    z-index: 1;
  }
  .film__pic[data-tag='street'] .film__tag--body,
  .film__pic[data-tag='body'] .film__tag--street,
  .film__pic[data-tag='none'] .film__tag,
  .film:not([data-begun]) .film__pic .film__tag {
    display: none;
  }

  /* ---- HUD -------------------------------------------------------------------------------- */
  .hud {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: calc(0.5 * var(--pr, 1rem));
    padding: calc(0.5 * var(--pr, 1rem));
    pointer-events: none;
    font-size: clamp(calc(0.875 * var(--pr, 1rem)), 1.75cqw, calc(1.125 * var(--pr, 1rem)));
    line-height: 1.3;
    color: var(--ink);
  }
  .hud__left {
    position: relative;
    min-inline-size: 0;
  }
  .hud__count {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    display: flex;
    align-items: center;
    gap: 0.35em;
    margin: 0;
    padding: 0.25em 0.7em 0.25em 0.5em;
    white-space: nowrap;
    font-size: 1.07em;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    background: var(--surface);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-pill);
  }
  .hud__sc {
    inline-size: 1.9em;
    block-size: 1.2em;
  }
  .hud__panel {
    display: grid;
    inline-size: max-content;
    max-inline-size: calc(100cqw - calc(1 * var(--pr, 1rem)));
    background: var(--surface);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-2);
    overflow: hidden;
  }
  .hud__row {
    display: grid;
    gap: 0.05em;
    margin: 0;
    padding: 0.35em 0.65em 0.4em;
    color: inherit;
    text-decoration: none;
  }
  .hud__row[hidden] {
    display: none;
  }
  .hud__row--est {
    pointer-events: auto;
    min-block-size: var(--tap);
    align-content: center;
    background: var(--estimate-wash);
  }
  .hud__row--street {
    grid-template-columns: auto auto;
    justify-content: space-between;
    align-items: baseline;
    column-gap: 0.8em;
    border-block-start: 1px solid var(--line-strong);
  }
  .hud__name {
    font-weight: 700;
    color: var(--ink-2);
  }
  .hud__val {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    white-space: nowrap;
  }
  .hud__val b {
    font-family: var(--font-latin), var(--font-body);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  /* brief 8.2, change 2: the one number, 20 px or more */
  .hud__row--est .hud__val b,
  .hud__row--zero .hud__val b {
    font-size: max(calc(1.25 * var(--pr, 1rem)), 1.45em);
    line-height: 1.2;
  }
  .hud__kind {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    font-weight: 700;
    color: var(--ink-2);
  }
  .hud__kind .chip-glyph {
    inline-size: 1em;
    block-size: 1em;
  }
  .hud__kind--est {
    padding: 0 0.5em;
    color: var(--estimate-ink);
    border: 1.5px dashed var(--estimate);
    border-radius: var(--radius-pill);
    background: var(--surface);
  }
  .hud__clock {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.25em 0.45em;
    background: #0d1113;
    border: 1px solid #3d474d;
    border-radius: var(--radius-2);
  }
  .hud__clock svg {
    display: block;
    inline-size: 3em;
    block-size: 2.08em;
  }
  .hud__led {
    fill: none;
    stroke: var(--signal-red-led);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 0.01 1.99;
  }
  .hud__clock[data-lamp='green'] .hud__led {
    stroke: var(--signal-green-led);
  }
  .hud__ff {
    display: none;
    align-items: center;
    gap: 0.3em;
    color: #f2c230;
    font-weight: 700;
  }
  .hud__ff i {
    font-style: normal;
  }
  .hud__ff-a {
    font-family: var(--font-latin), sans-serif;
    letter-spacing: -0.12em;
  }
  .hud__ff[data-on^='ff'],
  .hud__ff[data-on='hold'] {
    display: flex;
  }
  .hud__ff:not([data-on='hold']) .hud__ff-b,
  .hud__ff[data-on='hold'] :is(.hud__ff-a, .hud__ff-w),
  .hud__ff:not([data-on='ff word']) .hud__ff-w {
    display: none;
  }

  /* nothing sits over the poster but its own title and button */
  .film:not([data-begun]) .film__pic .hud {
    display: none;
  }

  /* ---- poster and end card ------------------------------------------------------------------ */
  .film__poster,
  .film__end {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-content: center;
    justify-items: center;
    padding: calc(0.75 * var(--pr, 1rem));
    text-align: center;
    color: var(--ink);
  }
  .film__poster {
    gap: calc(0.35 * var(--pr, 1rem));
    /* the ruler shot shows through, paler where the words are */
    background: radial-gradient(ellipse 62% 48% at 50% 50%, color-mix(in srgb, var(--bg) 92%, transparent), color-mix(in srgb, var(--bg) 62%, transparent));
  }
  .film__poster[hidden] {
    display: none;
  }
  .film__kicker {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: var(--ls-caps);
    color: var(--exhaust-ink);
  }
  .film__title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(calc(1.75 * var(--pr, 1rem)), 8cqw, calc(3 * var(--pr, 1rem)));
    font-weight: 900;
    font-stretch: var(--display-stretch);
    line-height: var(--lh-heading);
  }
  .film__big {
    display: inline-flex;
    align-items: center;
    gap: calc(0.6 * var(--pr, 1rem));
    min-block-size: calc(3.5 * var(--pr, 1rem));
    margin-block-start: calc(0.5 * var(--pr, 1rem));
    padding: calc(0.6 * var(--pr, 1rem)) calc(1.5 * var(--pr, 1rem)) calc(0.6 * var(--pr, 1rem)) calc(1.1 * var(--pr, 1rem));
    font: inherit;
    font-size: var(--fs-md);
    font-weight: 800;
    color: var(--on-accent);
    background: var(--accent);
    border: 0;
    border-radius: var(--radius-pill);
    cursor: pointer;
  }
  .film__big svg {
    inline-size: calc(1.6 * var(--pr, 1rem));
    block-size: calc(1.6 * var(--pr, 1rem));
    fill: currentColor;
  }
  .film__big:hover {
    background: var(--accent-hover);
  }
  .film__len {
    margin: calc(0.2 * var(--pr, 1rem)) 0 0;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink);
  }
  .film__end {
    gap: calc(0.5 * var(--pr, 1rem));
    align-content: center;
    justify-items: stretch;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    opacity: 0;
    visibility: hidden;
    cursor: default;
    overflow-y: auto;
  }
  .film__end > * {
    inline-size: min(100%, calc(26 * var(--pr, 1rem)));
    margin-inline: auto;
  }
  .film__end[data-on] {
    visibility: visible;
  }
  .film__end > .film__end-title {
    inline-size: min(100%, calc(44 * var(--pr, 1rem)));
  }
  .film__end-title {
    margin: 0 0 calc(0.2 * var(--pr, 1rem));
    font-family: var(--font-heading);
    font-size: clamp(calc(1.125 * var(--pr, 1rem)), 5.4cqw, calc(1.875 * var(--pr, 1rem)));
    font-weight: 900;
    line-height: var(--lh-heading);
    text-wrap: balance;
  }
  .film__end-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: calc(0.5 * var(--pr, 1rem));
  }
  .film__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-block-size: var(--tap);
    padding: calc(0.35 * var(--pr, 1rem)) calc(0.9 * var(--pr, 1rem));
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    color: var(--ink);
    background: var(--surface);
    border: 1.5px solid var(--ink);
    border-radius: var(--radius-pill);
    cursor: pointer;
  }
  .film__cta--primary {
    font-size: var(--fs-btn);
    font-weight: 800;
    color: var(--on-accent);
    background: var(--accent);
    border-color: var(--accent);
  }
  .film__cta--quiet {
    color: var(--accent);
    background: none;
    border-color: transparent;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  /* a short picture (a small phone, or 特大 text): the end card keeps its buttons and drops its sentence */
  @container (max-height: 21rem) {
    .film__end-title {
      display: none;
    }
  }

  /* ---- captions ----------------------------------------------------------------------------- */
  .film__caption {
    display: grid;
    align-content: center;
    block-size: var(--cap-h);
    padding: 0.3rem 0.75rem;
    overflow: hidden;
    text-align: center;
    color: var(--film-ink);
  }
  .cap__main {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 6.1cqw, 2.125rem);
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: var(--ls-heading);
    text-wrap: balance;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  :lang(en) .cap__main {
    font-size: clamp(1.1875rem, 5.4cqw, 2rem);
    font-stretch: 88%;
    line-height: 1.15;
  }
  /* brief 8.2, change 15: quiet lines at 15 px or more */
  .cap__note {
    margin: 0.2rem 0 0;
    font-size: clamp(0.9375rem, 2.6cqw, 1.25rem);
    line-height: 1.3;
    color: var(--film-quiet);
    text-wrap: balance;
  }
  .cap__note:empty {
    display: none;
  }
  .cap__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    padding: 0 0.5em;
    font-weight: 700;
    white-space: nowrap;
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    vertical-align: 0.05em;
  }
  .cap__chip .chip-glyph {
    inline-size: 0.9em;
    block-size: 0.9em;
  }

  /* ---- controls: every one a 48 px target, 8 px apart ------------------------------------------ */
  .film__controls {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    grid-template-areas: 'seek seek seek seek' 'play again time speed';
    align-items: center;
    /* 8 px between the scrubber and the buttons under it */
    gap: 0.5rem;
    block-size: var(--ctl-h);
    padding: 0.25rem 0.5rem;
    color: var(--film-ink);
    border-block-start: 1px solid var(--film-line);
  }
  @media (min-width: 40em) {
    .film__controls {
      grid-template-columns: auto auto 1fr auto auto;
      grid-template-areas: 'play again seek time speed';
    }
  }
  .film__btn,
  .film__speed {
    display: grid;
    place-items: center;
    min-inline-size: var(--tap);
    block-size: var(--tap);
    padding: 0 0.6rem;
    /* 「慢一點」 on one line, never 「慢 / 一點」 against the edge */
    white-space: nowrap;
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    border-radius: var(--radius-2);
    cursor: pointer;
  }
  .film__btn[data-film-toggle] {
    grid-area: play;
  }
  .film__btn[data-film-restart] {
    grid-area: again;
  }
  .film__btn:hover,
  .film__speed:hover {
    background: var(--film-line);
  }
  .film__btn svg {
    inline-size: 1.6rem;
    block-size: 1.6rem;
    fill: currentColor;
  }
  .film__btn .ico--line {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .film .ico--pause,
  .film[data-playing] .ico--play {
    display: none;
  }
  .film[data-playing] .ico--pause {
    display: block;
  }
  .film__speed {
    grid-area: speed;
    padding-inline: 0.9rem;
    font-size: var(--fs-sm);
    font-weight: 700;
    border: 1.5px solid #66737a;
    border-radius: var(--radius-pill);
  }
  .film__speed[aria-pressed='true'] {
    color: #101416;
    background: #4fd1ba;
    border-color: #4fd1ba;
  }
  .film__seek {
    --pct: 0%;
    grid-area: seek;
    min-inline-size: 0;
    inline-size: 100%;
    block-size: var(--tap);
    margin: 0;
    appearance: none;
    -webkit-appearance: none;
    background: none;
    cursor: pointer;
  }
  .film__seek::-webkit-slider-runnable-track {
    block-size: 8px;
    border-radius: 4px;
    background: linear-gradient(90deg, #4fd1ba var(--pct), #47525a var(--pct));
  }
  .film__seek::-moz-range-track {
    block-size: 8px;
    border-radius: 4px;
    background: linear-gradient(90deg, #4fd1ba var(--pct), #47525a var(--pct));
  }
  .film__seek::-webkit-slider-thumb {
    -webkit-appearance: none;
