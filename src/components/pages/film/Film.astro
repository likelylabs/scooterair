---
/**
 * Film — /90/ (blueprint 4.7, V45). One red light, played against a real countdown.
 *
 * It is a page, not a video file: the six scene frames the home page uses (<StreetScene> with
 * `frame` and `count`), the empty chart, a card for the pause and an end card, sequenced by
 * ./timeline.ts and driven by ./film.client.ts.
 *
 * ONE DOCUMENT, TWO PRESENTATIONS
 *   The markup is an ordered list of beats: each one a frame (drawn once, where it first
 *   appears) and its caption. With JavaScript off, or with reduced motion on, that list is what
 *   the reader sees: the frames in order with their captions. Otherwise <html> gets
 *   .film-live before first paint (the inline script in 90.astro) and the same list is stacked into a
 *   stage with a clock, a play button and a scrubber. Nothing plays until the reader asks.
 *
 * RULES KEPT HERE
 *   - The label 示意圖｜多濃沒人量過 is inside every frame (a strip under the picture, with a
 *     swatch of the hatching as its key: it is a legend, never a band of its own).
 *   - Frames cut; nothing cross-fades, so the hatched band is never drawn at a second density.
 *   - The long-term health line sits on a card with no scene in it.
 *   - The captions are chain.summary; no line of the chain is retyped here.
 *
 * Props
 *   locale  Locale
 */
import type { Locale } from '@/i18n';
import { href } from '@/i18n';
import { chain, emptyData, rail, site, t as fill, type EvidenceKind } from '@/i18n/ui';
import { localize } from '@/i18n/pages/_copy';
import filmCopy from '@/i18n/pages/film';
import homeCopy from '@/i18n/pages/home';
import StreetScene from '@/components/art/StreetScene.astro';
import EmptyChart from '@/components/charts/EmptyChart.astro';
import Button from '@/components/ui/Button.astro';
import EvidenceBadge from '@/components/ui/EvidenceBadge.astro';
import Phrased from '@/components/ui/Phrased.astro';
import { ledDigit } from '@/components/art/parts';
import LedTable from './LedTable.astro';
import { BEATS, DURATION, FRAME_ORDER, STARTS, checkTimeline, clockTime, type Beat, type FrameId } from './timeline';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = localize(filmCopy, locale);
const home = localize(homeCopy, locale);
checkTimeline(chain.countdown);

const plain = (s: string) => s.replaceAll('|', '');
const line = (n: number) => chain.summary[n - 1];
const linkName = (n: number) => (n === chain.links.length ? chain.breakable[locale] : chain.links[n - 1][locale]);
const clockLabel = (b: Beat, count: number) =>
  b.phase === 'paused' ? chain.kickerPaused[locale] : b.phase === 'green' ? chain.kickerGreen[locale] : fill(b.id === 'l7' && count === b.count[0] ? chain.kickerReset : chain.kickerRed, locale, { n: count });

/** What each beat says. The seven lines come from chain.summary; the rest from home.ts and ui.ts. */
const say: Record<string, { kicker: string; line: string; then?: string; badges?: EvidenceKind[] }> = {
  title: { kicker: home.prologue.kicker, line: plain(home.prologue.title) },
  ask: { kicker: t.beats.ask, line: t.beats.askLine },
  open: { kicker: t.beats.open, line: home.connect.question, badges: ['gap'] },
  five: { kicker: t.beats.five, line: home.link6.handoff },
  green: { kicker: rail.green[locale], line: t.beats.green },
};
const beats = BEATS.map((b, i) => {
  const s = b.link
    ? { kicker: `${fill(chain.linkN, locale, { n: b.link })} · ${b.link === 7 ? t.beats.replay : linkName(b.link)}`, line: line(b.link).text[locale], then: b.cue ? emptyData.caption[locale] : undefined, badges: line(b.link).badges }
    : say[b.id];
  const frameN = FRAME_ORDER.indexOf(b.frame) + 1;
  return {
    ...b,
    ...s,
    badges: s.badges ?? [],
    start: STARTS[i],
    time: clockTime(STARTS[i]),
    clock: clockLabel(b, b.count[0]),
    frameN,
    /** true where this beat is the first to use its frame: the frame is drawn here. */
    draws: BEATS.findIndex((x) => x.frame === b.frame) === i,
  };
});

const min = Math.floor(DURATION / 60);
const sec = DURATION % 60;
const length = fill(filmCopy.player.length, locale, { min, sec });
const lengthNote = fill(filmCopy.notes.length, locale, { min, sec });
const total = clockTime(DURATION);

/** Strings and templates the player needs at run time. */
const text = {
  play: t.player.play,
  pause: t.player.pause,
  restart: t.player.restart,
  ended: t.player.ended,
  position: t.player.position,
  red: chain.kickerRed[locale],
  reset: chain.kickerReset[locale],
  paused: chain.kickerPaused[locale],
  green: chain.kickerGreen[locale],
  total,
};

const digits = '0123456789'.split('');
type SceneProps = { frame: 'empty' | 'pack' | 'kerb' | 'paused' | 'green' | 'clean'; count?: number; emphasis?: 'heights' | 'fumes'; labels?: boolean };
/** The StreetScene behind each frame id. `count` is the count at which the frame first appears. */
const scene = (f: FrameId, count: number): SceneProps | undefined =>
  f === 'empty' || f === 'pack' || f === 'clean'
    ? { frame: f, count }
    : f === 'heights' || f === 'fumes'
      ? { frame: 'kerb', emphasis: f }
      : f === 'paused'
        ? { frame: 'paused', count, labels: false } // K3 without its "countdown paused" chip: here the clock is still running
        : f === 'green'
          ? { frame: 'green' }
          : undefined;
---

<section class="film" data-film data-text={JSON.stringify(text)} aria-labelledby="film-title">
  <header class="container film__head">
    <p class="eyebrow">{t.head.kicker}</p>
    <h1 id="film-title" class="film__title">{t.head.title}</h1>
    <p class="film__deck">{t.head.deck}</p>
  </header>

  <div class="film__wrap">
    <p class="film__still-note">
      <span>{t.still.note}</span>
      <button type="button" class="film__optin" data-film-optin hidden>{t.still.optIn}</button>
    </p>

    {/* Read before the picture; shown under the stage while it is a player. */}
    <aside class="film__notes" aria-labelledby="film-notes">
      <p id="film-notes" class="film__notes-label">{t.notes.title}</p>
      <p>{home.prologue.disclosure}</p>
      <p>{lengthNote}</p>
      <p>{t.notes.cuts}</p>
      <p class="film__keys">{t.player.keys}</p>
    </aside>

    <div class="film__stage" role="group" aria-label={t.player.label} data-film-stage>
      <div class="film__inner">
        <!-- the clock: the signal's own countdown, large. Not a live region. -->
        <div class="film__bar">
          <span class="film__led" data-film-led data-phase="red" aria-hidden="true">
            <svg viewBox="0 0 26 18" focusable="false">
              {[0, 1].map((pos) => (
                <g data-led={pos}>
                  <path class="film__dash" d={`M${3 + pos * 12},9h6`} />
                  {digits.map((d) => <path class="film__digit" d={ledDigit(d, 2, 0.8, 2 + pos * 12, 3)} data-d={d} data-on={'90'[pos] === d ? '' : undefined} />)}
                </g>
              ))}
            </svg>
          </span>
          <span class="film__clock" data-film-clock>{beats[0].clock}</span>
          <span class="film__time"><span data-film-time>0:00</span><span class="film__total">{` / ${total}`}</span></span>
        </div>

        <ol class="film__beats">
          {beats.map((b, i) => (
            <li class="beat" data-beat={b.id} data-i={i}>
              {b.draws && (
                <div class:list={['beat__frame', `beat__frame--${b.frame}`]} data-frame-el={b.frame} data-count={scene(b.frame, b.count[0])?.count} data-on={i === 0 ? '' : undefined}>
                  <div class="frame__pic">
                    {scene(b.frame, b.count[0]) && <StreetScene locale={locale} {...scene(b.frame, b.count[0])!} />}
                    {b.frame === 'chart' && (
                      <Fragment>
                        <EmptyChart locale={locale} title={home.link3.figure.chart} desc={home.link3.figure.desc} panelHeight={18} seriesLabel="" class="film-chart film-chart--s" />
                        <EmptyChart locale={locale} title={home.link3.figure.chart} desc={home.link3.figure.desc} panelHeight={44} class="film-chart film-chart--l" />
                      </Fragment>
                    )}
                    {b.frame === 'card' && (
                      <div class="film-card">
                        <svg class="film-card__pause" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><rect x="3" y="2.5" width="3.6" height="11" /><rect x="9.4" y="2.5" width="3.6" height="11" /></svg>
                        <p class="film-card__title"><Phrased text={t.card.title} /></p>
                        <p class="film-card__body">{t.card.body}</p>
                      </div>
                    )}
                  </div>
                  <p class="frame__slate"><span class="frame__swatch" aria-hidden="true"></span><span>{t.slate}</span></p>
                </div>
              )}
              <div class:list={['beat__cap', b.frame === 'chart' && 'beat__cap--chart']} data-cap data-on={i === 0 ? '' : undefined}>
                <p class="beat__when">
                  <span class="beat__n">{fill(filmCopy.still.frameN, locale, { n: i + 1 })}</span>
                  <span>{b.time}</span>
                  <span>{b.clock}</span>
                  {!b.draws && <span class="beat__same">{fill(filmCopy.still.sameFrame, locale, { n: beats.findIndex((x) => x.frame === b.frame) + 1 })}</span>}
                </p>
                <p class="beat__kicker">{b.kicker}</p>
                <p class="beat__line">{b.line}</p>
                {b.then && <p class="beat__line beat__line--then" data-cue={b.cue}>{b.then}</p>}
                {b.badges.length > 0 && <p class="beat__badges">{b.badges.map((k) => <EvidenceBadge locale={locale} kind={k} />)}</p>}
                {b.link === 7 && <p class="beat__nobadge">{chain.noBadge[locale]}</p>}
              </div>
            </li>
          ))}
          <li class="beat beat--end" data-beat="end">
            <div class="beat__end" data-end>
              <p class="eyebrow">{t.end.kicker}</p>
              <p class="beat__sentence">{t.end.sentence}</p>
              <p class="beat__site">{site.name[locale]}</p>
              <p class="beat__choose">{t.end.choose}</p>
              <div class="beat__choices">
                <Button href={href('/', locale)} variant="secondary" size="lg" arrow>{t.end.evidence}</Button>
                <Button href={href('/electric/#calc', locale)} variant="secondary" size="lg" arrow>{t.end.money}</Button>
              </div>
            </div>
          </li>
        </ol>

        <button type="button" class="film__big" data-film-big>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4.5v15l12.5-7.5z" /></svg>
          <span class="film__big-label">{t.player.play}</span>
          <span class="film__big-len">{length}</span>
        </button>

        <div class="film__controls">
          <button type="button" class="film__btn" data-film-toggle aria-label={t.player.play}>
            <svg class="film__ico film__ico--play" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 4.5v15l12.5-7.5z" /></svg>
            <svg class="film__ico film__ico--pause" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.5 5h4v14h-4zM13.5 5h4v14h-4z" /></svg>
          </button>
          <button type="button" class="film__btn" data-film-restart aria-label={t.player.restart}>
            <svg class="film__ico film__ico--line" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12a7 7 0 1 0 2.2-5.1M4.5 4.5v4h4" /></svg>
          </button>
          <input class="film__seek" type="range" min="0" max={DURATION} step="1" value="0" aria-label={t.player.seek} data-film-seek />
        </div>
        <p class="vh" aria-live="polite" data-film-say></p>
        <LedTable counts={beats.filter((b) => b.draws && scene(b.frame, b.count[0])?.count !== undefined).map((b) => b.count[0])}>
          {(n: number) => <StreetScene locale={locale} frame="empty" count={n} labels={false} />}
        </LedTable>
      </div>
    </div>

    <div class="film__after">
      <section class="film__transcript" aria-labelledby="film-transcript">
        <h2 id="film-transcript" class="film__h2">{t.transcript.title}</h2>
        <p class="film__transcript-intro">{t.transcript.intro}</p>
        <ol class="film__lines">
          {beats.map((b) => (
            <li>
              <button type="button" class="film__jump" data-film-jump={b.start} aria-label={fill(filmCopy.transcript.jump, locale, { time: b.time })}>{b.time}</button>
              <div>
                <p class="film__line-meta">{b.clock} · {b.kicker}</p>
                {b.frame === 'card' && <p class="film__line-card">{plain(t.card.title)}{locale === 'en' ? ' ' : ''}{t.card.body}</p>}
                <p class="film__line-text">{b.line}</p>
                {b.then && <p class="film__line-text">{b.then}</p>}
              </div>
            </li>
          ))}
          <li>
            <button type="button" class="film__jump" data-film-jump={DURATION} aria-label={fill(filmCopy.transcript.jump, locale, { time: total })}>{total}</button>
            <div>
              <p class="film__line-meta">{t.player.ended}</p>
              <p class="film__line-text">{t.end.sentence}</p>
            </div>
          </li>
        </ol>
      </section>
    </div>
  </div>
</section>

<style>
  .film {
    padding-block: clamp(1rem, 3vw, 2.5rem) var(--section-y);
  }
  .film__head {
    display: grid;
    gap: var(--sp-1);
    margin-block-end: var(--sp-4);
  }
  .film__title {
    font-size: var(--fs-2xl);
    font-weight: var(--fw-black);
    font-stretch: var(--display-stretch);
    line-height: var(--lh-heading);
  }
  .film__deck {
    color: var(--ink-2);
    max-inline-size: var(--measure);
  }
  .film__wrap {
    display: flex;
    flex-direction: column;
    inline-size: min(100%, 68rem);
    margin-inline: auto;
  }
  .film__stage {
    container: film / inline-size;
  }
  .film__inner {
    position: relative;
    /* On a phone the scenes are short and the empty chart is tall. The picture row is sized for
       the scenes; the chart runs past it into the caption row, and its own (short) caption
       starts lower by the difference. One stage height either way, so nothing shifts. */
    --pic-h: 15rem;
    --chart-h: 18rem;
    --slate-h: 1.625rem;
    --bar-h: 2.75rem;
  }
  @container film (min-width: 30rem) {
    .film__inner {
      --pic-h: 22rem;
      --chart-h: 22rem;
    }
  }
  @container film (min-width: 44rem) {
    .film__inner {
      --pic-h: 25rem;
      --chart-h: 25rem;
      --bar-h: 3.25rem;
      --big-at: 0.45;
    }
  }

  /* ---- shared pieces: the frame, its label, the caption ---- */
  .film__beats {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .frame__pic :global(.film-chart) {
    inline-size: 100%;
    margin-inline: auto;
    padding-inline: var(--sp-4);
  }
  .frame__pic :global(.film-chart--l),
  .frame__pic :global(.chart__data) {
    display: none;
  }
  @container film (min-width: 44rem) {
    .frame__pic :global(.film-chart--s) {
      display: none;
    }
    .frame__pic :global(.film-chart--l) {
      display: block;
    }
  }
  .frame__slate {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    box-sizing: border-box;
    min-block-size: var(--slate-h);
    padding: 0 var(--sp-4);
    white-space: nowrap;
    overflow: hidden;
    border-block: 1px solid var(--line-strong);
    background: var(--bg-sunken);
    color: var(--exhaust-ink);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.04em;
    line-height: 1.3;
  }
  .frame__swatch {
    flex: none;
    inline-size: 1.75rem;
    block-size: 0.8rem;
    border: 1px solid var(--art-haze);
    background: repeating-linear-gradient(-55deg, var(--art-haze) 0 1.5px, transparent 1.5px 5px);
  }
  .film-card {
    display: grid;
    gap: var(--sp-3);
    justify-items: start;
    align-content: center;
    block-size: 100%;
    padding: var(--sp-5) var(--sp-4);
    background: var(--bg-sunken);
  }
  .film-card__pause {
    inline-size: 2.5rem;
    block-size: 2.5rem;
    fill: var(--ink-2);
  }
  .film-card__title {
    font-size: var(--fs-xl);
    font-weight: var(--fw-black);
    line-height: var(--lh-heading);
  }
  .film-card__body {
    max-inline-size: var(--measure);
    color: var(--ink-2);
  }
  .beat__cap {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: var(--sp-2) var(--sp-4) var(--sp-3);
  }
  .beat__when {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--sp-3);
    color: var(--ink-3);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
  }
  .beat__n {
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .beat__kicker {
    color: var(--ink-2);
    line-height: 1.35;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: 0.04em;
  }
  .beat__line {
    max-inline-size: 40em;
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    line-height: var(--lh-snug);
    text-wrap: pretty;
  }
  .beat__line--then {
    color: var(--exhaust-ink);
    font-size: var(--fs-sm);
  }
  /* English runs longer: on a phone it steps down a size so the controls stay on screen */
  .beat__line:lang(en) {
    font-size: var(--fs-sm);
  }
  @container film (min-width: 30rem) {
    .beat__line,
    .beat__line:lang(en) {
      font-size: var(--fs-md);
    }
    .beat__line--then,
    .beat__line--then:lang(en) {
      font-size: var(--fs-base);
    }
    .beat__cap {
      gap: var(--sp-2);
      padding-block: var(--sp-3) var(--sp-4);
    }
    :global(html.film-live) .beat__cap--chart {
      padding-block-start: var(--sp-3);
    }
  }
  .beat__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-2);
  }
  .beat__nobadge {
    color: var(--ink-3);
    font-size: var(--fs-xs);
  }
  .beat__end {
    display: grid;
    gap: var(--sp-3);
    align-content: center;
    justify-items: start;
    padding: var(--sp-5) var(--sp-4);
    background: var(--bg);
  }
  .beat__sentence {
    max-inline-size: 22em;
    font-size: var(--fs-xl);
    font-weight: var(--fw-black);
    line-height: var(--lh-heading);
    text-wrap: balance;
  }
  .beat__site {
    color: var(--ink-2);
    font-weight: var(--fw-bold);
    letter-spacing: 0.04em;
  }
  .beat__choose {
    margin-block-start: var(--sp-3);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
  }
  /* two choices of equal weight: the same button, the same width */
  .beat__choices {
    display: grid;
    gap: var(--sp-3);
    inline-size: 100%;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    grid-auto-rows: 1fr;
    max-inline-size: 48rem;
  }
  .beat__choices :global(.btn) {
    inline-size: 100%;
  }

  /* ---- the still presentation (default): the frames in order with their captions ---- */
  .film__bar,
  .film__big,
  .film__controls,
  .film__transcript,
  .film__keys {
    display: none;
  }
  .film__still-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-4);
    margin: 0 var(--gutter) var(--sp-5);
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  .film__optin {
    min-block-size: var(--tap);
    padding: 0.4em 1em;
    border: 2px solid var(--ink);
    border-radius: var(--radius-2);
    background: none;
    color: var(--ink);
    font: inherit;
    font-weight: var(--fw-bold);
    cursor: pointer;
  }
  .film__optin[hidden] {
    display: none;
  }
  .beat {
    border-block-start: var(--rule-paint) solid var(--ink);
    margin-block-end: var(--sp-6);
  }
  .beat__frame {
    border-block-end: 1px solid var(--line);
  }
  .film__after {
    margin: var(--sp-7) var(--gutter) 0;
  }
  .film__notes {
    display: grid;
    gap: var(--sp-2);
    max-inline-size: 46rem;
    margin: 0 var(--gutter) var(--sp-6);
    padding: var(--sp-3) var(--sp-4);
    border-inline-start: var(--rule-paint) solid var(--ink);
    background: var(--bg-sunken);
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
  }
  .film__notes-label {
    font-weight: var(--fw-bold);
  }

  /* ---- the playing presentation: the same list, stacked into a stage ---- */
  @media screen {
    :global(html.film-live) .film__still-note,
    :global(html.film-live) .beat__when {
      display: none;
    }
    :global(html.film-live) .film__stage {
      order: 1;
      border-block: var(--rule-paint) solid var(--ink);
      background: var(--bg);
    }
    :global(html.film-live) .film__notes {
      order: 2;
      margin-block: var(--sp-6) 0;
    }
    :global(html.film-live) .film__after {
      order: 3;
    }
    :global(html.film-live) .film__bar {
      display: flex;
      align-items: center;
      gap: var(--sp-3);
      block-size: var(--bar-h);
      padding-inline: var(--sp-4);
      border-block-end: 1px solid var(--line);
    }
    :global(html.film-live) .film__beats {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: calc(var(--pic-h) + var(--slate-h)) auto;
    }
    :global(html.film-live) .beat {
      display: contents;
    }
    :global(html.film-live) .beat__frame {
      grid-area: 1 / 1;
      align-self: start;
      border: 0;
      visibility: hidden;
      cursor: pointer;
    }
    :global(html.film-live) .frame__slate {
      block-size: var(--slate-h);
    }
    :global(html.film-live) .frame__pic {
      display: grid;
      align-content: end;
