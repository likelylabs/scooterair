---
/**
 * LedTable — how the signal's countdown is drawn inside a <StreetScene>, for every count the
 * film shows, as data for the player (film.client.ts). Build time only; prints one JSON island.
 *
 * WHY: the scene frames are static and take one `count`. The film's clock runs, and the LED in
 * the picture has to run with it. Rather than re-implement how the art draws its digits (which
 * belongs to the art workstream and may change), this component asks the art itself: it renders
 * the lightest street frame once per digit, reads back whatever `d` attributes change with the
 * count, and stores them per digit and per composition (compact, wide). The player finds the
 * same path in each frame by its content and swaps it.
 *
 * If the art stops drawing a count as "tens digit, then ones digit" in one path, the per-digit
 * table cannot be built; the component then stores every count whole. If it cannot find the
 * count at all, it stores nothing and the player hides the LED in the picture rather than let it
 * disagree with the clock.
 *
 * Usage (the slot is a function of the count):
 *   <LedTable counts={[86, 67, 38]}>{(n: number) => <StreetScene locale={locale} frame="empty" count={n} labels={false} />}</LedTable>
 *
 * Props
 *   counts  the counts the static frames are built with; the table is checked against them
 *   max     highest count the film shows (default 90)
 */
interface Props {
  counts: number[];
  max?: number;
}
const { counts, max = 90 } = Astro.props;

type Variant = 'compact' | 'wide';
const two = (n: number) => String(n).padStart(2, '0');
const cache = new Map<number, Record<Variant, string[]>>();
/** Every `d` attribute of each composition, in document order, for one count. */
async function paths(n: number): Promise<Record<Variant, string[]>> {
  if (cache.has(n)) return cache.get(n)!;
  const html: string = await Astro.slots.render('default', [n]);
  const out = { compact: [] as string[], wide: [] as string[] };
  for (const m of html.matchAll(/<svg[^>]*class="[^"]*scene__svg--(compact|wide)[^"]*"[\s\S]*?<\/svg>/g)) {
    out[m[1] as Variant] = Array.from(m[0].matchAll(/\sd="([^"]*)"/g), (x) => x[1]);
  }
  cache.set(n, out);
  return out;
}

type Table = { t: string[]; o: string[] } | { all: Record<string, string> };
async function build(v: Variant): Promise<Table | null> {
  const a = (await paths(0))[v];
  const b = (await paths(11))[v];
  if (!a.length || a.length !== b.length) return null;
  const changed = a.map((d, i) => (d === b[i] ? -1 : i)).filter((i) => i >= 0);
  if (changed.length !== 1) return null; // the count is not one path: the picture's LED is hidden
  const at = changed[0];
  const s = async (n: number) => (await paths(n))[v][at];
  const whole = async (): Promise<Table> => {
    const all: Record<string, string> = {};
    for (let n = 0; n <= max; n++) all[two(n)] = await s(n);
    return { all };
  };
  // "ab" = tens(a) + ones(b)? Find where tens(0) ends: the longest start that "00" shares with
  // every "0b", cut back to the start of a subpath.
  const s00 = await s(0);
  let cut = s00.length;
  for (let d = 1; d <= 9; d++) {
    const x = await s(d);
    let k = 0;
    while (k < cut && k < x.length && x[k] === s00[k]) k++;
    cut = k;
  }
  cut = s00.lastIndexOf('M', cut);
  if (cut <= 0) return whole();
  const t0 = s00.slice(0, cut);
  const o0 = s00.slice(cut);
  const t: string[] = [];
  const o: string[] = [];
  for (let d = 0; d <= 9; d++) {
    const ones = await s(d);
    const tens = await s(d * 10);
    if (!ones.startsWith(t0) || !tens.endsWith(o0)) return whole();
    o.push(ones.slice(cut));
    t.push(tens.slice(0, tens.length - o0.length));
  }
  for (const n of [...counts, 11, max]) {
    const text = two(n);
    if (t[Number(text[0])] + o[Number(text[1])] !== (await s(n))) return whole();
  }
  return { t, o };
}
const table = { compact: await build('compact'), wide: await build('wide') };
if (!table.compact || !table.wide) console.warn('[film] the countdown inside the scene could not be read back from StreetScene; the player will hide it and show the count on its own bar only.');
---

<script type="application/json" data-film-led-table set:html={JSON.stringify(table)} />
