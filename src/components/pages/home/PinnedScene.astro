---
/**
 * PinnedScene — the desktop layout of the home page (blueprint 3.0, wave 2): at 960px and wider
 * the page reads in two columns, the scene pinned in the left one and cross-fading between the
 * frames the chapters assign, the text in the right one.
 *
 * It is an enhancement layered on the page as built. Put it in Base's `head` slot:
 *
 *   <Base …><PinnedScene slot="head" /> …
 *
 * and mark the page with two classes (nothing else about the markup changes):
 *
 *   .pin-run    a stretch of the page that has a scene beside it: the hero, or a <div> around
 *               consecutive chapters that each have a frame. Chapters with no frame (the brief,
 *               link 5, the join, the money) stay outside every run and keep their full width:
 *               the scene is never beside them. Link 5 is why this matters: no health figure
 *               shares a frame with the scene.
 *   .pin-frame  the box that holds a chapter's frame (and, for link 4 and link 7, its key or
 *               its switch and ledger). In a run it becomes the pinned pane.
 *
 * HOW IT WORKS
 *   - A three-line script in <head> adds .pin to <html> before first paint; every rule below
 *     hangs off that class and off the width, so with JavaScript off, or under 960px, the page
 *     is exactly the single-column page.
 *   - Each .pin-frame is position: fixed in the same rectangle (the left column, under the
 *     rail). A run clips what is fixed inside it (clip-path), so a pane is visible only while
 *     its run is on screen: the next full-width chapter wipes it away instead of sliding under
 *     it. Nothing in the flow is moved or measured, so there is no layout shift.
 *   - Inside a run with several frames, the script marks the frame of the chapter under the
 *     reading line (the same line the countdown rail uses) and the others fade out beneath it.
 *     The incoming pane fades in over the outgoing one, which stays opaque until it is covered:
 *     the page behind never shows through.
 *   - Reduced motion: the frames swap without a fade.
 *
 * Coupling to shared components, by class name only: Chapter's `.chapter__inner`,
 * `.chapter__art--top` and `.chapter__asides`; StreetScene's `.scene`.
 */
---

<script is:inline>
  // Pinned scene (home page, 960px and wider). Runs before first paint.
  (function () {
    var d = document.documentElement;
    try {
      if (!window.matchMedia || !window.CSS || !CSS.supports('clip-path', 'inset(0)') || !CSS.supports('width', 'min(1px, 2px)')) return;
      d.classList.add('pin');
      var wide = matchMedia('(min-width: 960px)');
      var setup = function () {
        var runs = [].slice
          .call(document.querySelectorAll('.pin-run'))
          .map(function (run) {
            var frames = [].slice.call(run.querySelectorAll('.pin-frame'));
            return {
              run: run,
              frames: frames,
              owners: frames.map(function (f) {
                return f.closest('.chapter') || run;
              }),
              on: -1,
            };
          })
          .filter(function (r) {
            return r.frames.length > 1;
          });
        if (!runs.length) return;
        var rail = document.querySelector('[data-rail]');
        var queued = false;
        var update = function () {
          queued = false;
          if (!wide.matches) return;
          // the reading line: the one the countdown rail uses, so the frame and the rail turn together
          var top = rail ? rail.getBoundingClientRect().bottom : 0;
          var line = top + (window.innerHeight - top) * 0.33;
          runs.forEach(function (r) {
            var cur = 0;
            for (var i = 0; i < r.owners.length; i++) if (r.owners[i].getBoundingClientRect().top <= line) cur = i;
            if (cur === r.on) return;
            r.on = cur;
            r.frames.forEach(function (f, i) {
              f.toggleAttribute('data-pin-on', i === cur);
            });
            r.run.setAttribute('data-pin-live', '');
          });
        };
        var queue = function () {
          if (queued) return;
          queued = true;
          requestAnimationFrame(update);
        };
        window.addEventListener('scroll', queue, { passive: true });
        window.addEventListener('resize', queue, { passive: true });
        if (wide.addEventListener) wide.addEventListener('change', queue);
        update();
      };
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setup);
      else setup();
    } catch (e) {
      d.classList.remove('pin');
    }
  })();
</script>

<style is:global>
  @media screen and (min-width: 960px) {
    html.pin {
      /* under the header, its hairline, and the rail */
      --pin-top: calc(var(--header-h) + var(--rail-h) + 1px);
      /* the text column: its right edge is the page container's right edge */
      --pin-text: clamp(26rem, 44vw, 38rem);
      --pin-gap: clamp(1.5rem, 3vw, 3rem);
      --pin-edge: calc((100% - min(100% - 2 * var(--gutter), var(--page-max))) / 2);
    }

    /* ---- the run: a window onto the pane ---- */
    html.pin .pin-run {
      clip-path: inset(0);
    }

    /* ---- the text column ---- */
    html.pin .pin-run > .chapter > .chapter__inner,
    html.pin .hero.pin-run > .container {
      inline-size: var(--pin-text);
      margin-inline: auto var(--pin-edge);
    }
    /* the frame's own slot leaves the flow with its frame */
    html.pin .pin-run > .chapter > .chapter__art--top {
      position: static;
      z-index: auto;
      margin: 0;
      border: 0;
    }
    /* the caveat and the action stack: two side by side do not fit this column */
    html.pin .pin-run .chapter__asides {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-5);
    }

    /* ---- the pane ---- */
    html.pin .pin-run .pin-frame {
      position: fixed;
      inset-block: var(--pin-top) 0;
      inset-inline-start: 0;
      z-index: 1;
      display: grid;
      /* one column, no wider than the scene's compact composition, no taller than the pane */
      grid-template-columns: min(100% - 3rem, 43.5rem, (100vh - var(--pin-top) - 3rem) * 2);
      justify-content: center;
      align-content: center;
      /* on a short window the tallest pane (link 7: switch, frame, ledger) scrolls from its top */
      align-content: safe center;
      inline-size: calc(100% - var(--pin-edge) - var(--pin-text) - var(--pin-gap));
      max-inline-size: none;
      margin: 0;
      padding-block: var(--sp-4);
      overflow: hidden auto;
      background: var(--here);
      border-inline-end: 1px solid var(--line);
      /* off: stay opaque until the incoming pane has covered this one, then go */
      opacity: 0;
      visibility: hidden;
      transition:
        opacity 0s 0.32s,
        visibility 0s 0.32s;
    }
    html.pin .pin-run .pin-frame > * {
      grid-column: 1;
      min-inline-size: 0;
    }
    html.pin .pin-run .pin-frame > .container {
      inline-size: 100%;
    }
    /* on: before the script has spoken, the first frame of each run */
    html.pin .pin-run .pin-frame[data-pin-on],
    html.pin .pin-run:not([data-pin-live]) > .pin-frame,
    html.pin .pin-run:not([data-pin-live]) > :first-child .pin-frame {
      z-index: 2;
      opacity: 1;
      visibility: visible;
      transition: opacity 0.32s var(--ease-out);
    }

    /* ---- the hero: the same two columns, the empty stop line in the pane ---- */
    html.pin .hero.pin-run {
      align-content: center;
      min-block-size: calc(100vh - var(--pin-top));
      min-block-size: calc(100svh - var(--pin-top));
    }
    html.pin .hero.pin-run .hero__title {
      font-size: min(var(--fs-4xl), var(--pin-text) / 6.6);
    }
  }
  @media screen and (min-width: 960px) and (prefers-reduced-motion: reduce) {
    html.pin .pin-run .pin-frame,
    html.pin .pin-run .pin-frame[data-pin-on] {
      transition: none;
    }
  }
</style>
