---
/**
 * RedLightYear — 「你的紅燈，一年加起來」 (blueprint V12). Two numbers the reader types, with
 * NO preset values; nothing is shown until both are entered. The output is time only (hours a
 * year), tagged as the reader's own numbers and our arithmetic, with the fixed line
 * 「這只是時間，不是劑量。」. It makes no health claim. Collapsed by default (native <details>).
 * Without JavaScript the reader gets the formula in words instead of a result.
 *
 * Props
 *   locale  Locale
 */
import type { Locale } from '@/i18n';
import home from '@/i18n/pages/home';
import { localize } from '@/i18n/pages/_copy';
import EvidenceBadge from '@/components/ui/EvidenceBadge.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = localize(home, locale).link5.tool;
---

<details class="rly" data-rly data-template={t.result} data-locale={locale === 'en' ? 'en-GB' : 'zh-TW'}>
  <summary class="rly__summary">{t.summary}</summary>
  <div class="rly__body">
    <p class="rly__intro">{t.intro}</p>
    <div class="rly__fields">
      <label class="rly__field">
        <span class="rly__label">{t.lights}</span>
        <span class="rly__input"><input type="number" inputmode="numeric" min="1" max="500" step="1" name="rly-lights" data-rly-lights autocomplete="off" /> <span>{t.lightsUnit}</span></span>
      </label>
      <label class="rly__field">
        <span class="rly__label">{t.seconds}</span>
        <span class="rly__input"><input type="number" inputmode="numeric" min="1" max="600" step="1" name="rly-seconds" data-rly-seconds autocomplete="off" /> <span>{t.secondsUnit}</span></span>
      </label>
    </div>
    <div class="rly__out" aria-live="polite">
      <p class="rly__pending" data-rly-pending hidden>{t.pending}</p>
      <p class="rly__result" data-rly-result hidden></p>
      <p class="rly__noscript" data-rly-noscript>{t.noscript}</p>
    </div>
    <p class="rly__tag"><EvidenceBadge locale={locale} kind="derived" label={t.tag} /></p>
    <p class="rly__fixed">{t.fixed}</p>
  </div>
</details>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-rly]').forEach((root) => {
    const lights = root.querySelector<HTMLInputElement>('[data-rly-lights]')!;
    const seconds = root.querySelector<HTMLInputElement>('[data-rly-seconds]')!;
    const pending = root.querySelector<HTMLElement>('[data-rly-pending]')!;
    const result = root.querySelector<HTMLElement>('[data-rly-result]')!;
    root.querySelector<HTMLElement>('[data-rly-noscript]')!.hidden = true;
    const nf = (d: number) => new Intl.NumberFormat(root.dataset.locale, { maximumFractionDigits: d });
    const update = () => {
      const a = Number(lights.value);
      const b = Number(seconds.value);
      const ok = lights.value !== '' && seconds.value !== '' && a > 0 && b > 0 && Number.isFinite(a) && Number.isFinite(b);
      pending.hidden = ok;
      result.hidden = !ok;
      if (ok) {
        const hours = (a * b * 365) / 3600;
        result.textContent = (root.dataset.template ?? '').replace('{h}', nf(hours < 10 ? 1 : 0).format(hours));
      }
    };
    lights.addEventListener('input', update);
    seconds.addEventListener('input', update);
    update();
  });
</script>

<style>
  .rly {
    border: 2px solid var(--ink);
    border-radius: var(--radius-1, 4px);
    background: var(--surface, transparent);
    max-inline-size: 40rem;
  }
  .rly__summary {
    list-style: none;
    justify-content: space-between;
    gap: var(--sp-3);
    cursor: pointer;
    padding: var(--sp-3) var(--sp-4);
    font-weight: var(--fw-bold);
    min-block-size: 44px;
    display: flex;
    align-items: center;
  }
  .rly__summary::-webkit-details-marker {
    display: none;
  }
  .rly__summary::after {
    content: '+';
    flex: none;
    font-size: 1.5em;
    line-height: 1;
    font-weight: var(--fw-bold);
  }
  .rly[open] .rly__summary::after {
    content: '−';
  }
  .rly__body {
    display: grid;
    gap: var(--sp-3);
    padding: 0 var(--sp-4) var(--sp-4);
  }
  .rly__intro,
  .rly__noscript,
  .rly__pending {
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .rly__fields {
    display: grid;
    gap: var(--sp-3);
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }
  .rly__field {
    display: grid;
    gap: var(--sp-1);
  }
  .rly__label {
    font-weight: var(--fw-medium);
  }
  .rly__input {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .rly__input input {
    inline-size: 7rem;
    min-block-size: 44px;
    padding: 0 var(--sp-2);
    border: 2px solid var(--line-strong);
    border-radius: var(--radius-1, 4px);
    background: var(--bg, transparent);
    color: var(--ink);
    font: inherit;
    font-variant-numeric: tabular-nums;
  }
  .rly__result {
    font-size: var(--fs-xl);
    font-weight: var(--fw-black);
    line-height: var(--lh-snug);
  }
  .rly__fixed {
    font-weight: var(--fw-bold);
  }
</style>
