---
/**
 * Notes — the registry caveats that must sit beside their numbers (facts and series with
 * `requiresCaveat`). Printed in small type right after the claim, never in a footnote.
 *
 * Props
 *   locale  Locale
 *   notes   string[] (from an Evidence, or several merged)
 *   label   override the label (default 出處附註 / Source notes)
 */
import type { Locale } from '@/i18n';
import home from '@/i18n/pages/home';

interface Props {
  locale: Locale;
  notes: string[];
  label?: string;
}
const { locale, notes } = Astro.props;
const list = [...new Set(notes)].filter(Boolean);
const label = Astro.props.label ?? home.meta.notes[locale];
---

{
  list.length > 0 && (
    <div class="notes">
      <p class="notes__label">{label}</p>
      {list.map((n) => <p class="notes__item">{n}</p>)}
    </div>
  )
}

<style>
  .notes {
    display: grid;
    gap: var(--sp-1);
    padding-inline-start: var(--sp-3);
    border-inline-start: 2px solid var(--line-strong);
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--ink-2);
    max-inline-size: var(--measure, 40rem);
  }
  .notes__label {
    font-weight: var(--fw-bold);
    color: var(--ink);
  }
</style>
