---
/**
 * Ev — the evidence tail of one claim on the home page: its badge(s), then its citation
 * markers. Takes an `Evidence` from home-data.ts (badges, cites and numbers already assigned
 * in page order). Renders nothing for null.
 *
 * Props
 *   locale  Locale
 *   ev      Evidence | null
 *   cites   false = badges only (when the markers are printed elsewhere)
 *   badges  false = citation markers only
 */
import type { Locale } from '@/i18n';
import Cite from '@/components/ui/Cite.astro';
import EvidenceBadge from '@/components/ui/EvidenceBadge.astro';
import type { Evidence } from './home-data';

interface Props {
  locale: Locale;
  ev: Evidence | null;
  cites?: boolean;
  badges?: boolean;
}
const { locale, ev, cites = true, badges = true } = Astro.props;
---

{
  ev && (ev.badges.length > 0 || ev.cites.length > 0) && (
    <span class="evtail">
      {cites && ev.cites.map((c) => <Cite locale={locale} id={c.id} n={c.n} />)}
      {badges && ev.badges.map((b) => <EvidenceBadge locale={locale} kind={b.kind} secondary={b.secondary} />)}
    </span>
  )
}

<style>
  .evtail {
    display: inline;
  }
  .evtail :global(.ev-wrap) {
    margin-inline-start: 0.45em;
  }
</style>
