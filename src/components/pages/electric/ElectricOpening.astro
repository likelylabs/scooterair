---
/**
 * ElectricOpening — the first screen of /electric/ (brief 7.7): a finished result before any
 * input. Three large questions (有沒有舊車可以報廢？ · 停車的地方能充電嗎？ · 一個月騎多遠？) beside the
 * county, then the three answers (買的那天差多少 · 每個月差多少 · 幾年打平): figure first, the price
 * bars, the working folded below. There is no empty state.
 *
 * The answers are the calculator's own: the same function (model.ts openAnswers) and the same
 * words (opening-view answersHtml) as the result further down, so the opening and the calculator
 * print the same figures for the same answers.
 *
 * Without JavaScript: the default county (新北市), every scrapping, charging and distance answer
 * printed as a variant the switches show (Segmented, :has()).
 * With JavaScript (./opening.client.ts): the variant true on the reader's day is drawn from the
 * page's table; another county is worked out by the calculator engine in the browser; and
 * ?county=&scrap=&km=(&charge=) from the home page set the answers and the line 「你在首頁選的：…」.
 * Each change is told to the detailed calculator below (event `el:open` on document).
 *
 * Props
 *   locale  Locale
 */
import type { Locale } from '@/i18n';
import Segmented from '@/components/ui/Segmented.astro';
import KindChip from '@/components/ui/KindChip.astro';
import electric from '@/i18n/pages/electric';
import { fill, localize } from '@/i18n/pages/_copy';
import { openingData } from './opening-data';
import { caseKey, openingAnswers } from './opening-answers';
import { answersHtml, ansScrapNotes, ansWho, caseText, escHtml, tableOn, worstFoldHtml, worstText, type OpenText, type Scrap, type Charge } from './opening-view';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const T = localize(electric, locale).open as unknown as OpenText;
const D = openingData(locale);
const A = openingAnswers(locale, D.built);
const t = tableOn(D, D.built);
const at = A.tables[A.periods[0].t];
const def = D.defaults;
const scraps: Scrap[] = ['yes', 'no'];
const charges: Charge[] = ['no', 'yes'];
const countyName = D.counties.find((c) => c.id === def.county)!.name;
const chosen = fill(T.chosenDefault, { case: caseText(D, T, def) });
const variant = (s: Scrap, km: number, c: Charge) => {
  const a = at[caseKey(s, km, c)];
  // what scrapping does: the same case with the other scrapping answer (the same function as the calculator)
  const notes = ansScrapNotes(D.locale, T, s, a, at[caseKey(s === 'yes' ? 'no' : 'yes', km, c)]);
  return `${answersHtml(D.locale, T, a, { level: 3, bars: true, working: true, notes })}<p class="op-body">${escHtml(ansWho(D.locale, T, a))}</p>${worstFoldHtml(worstText(D, T, t), T)}`;
};
// What the browser needs, and no more: the strip and the worst case per table, and the answers
// for the default county per period (every other figure comes from the engine when asked).
const S = {
  locale: D.locale,
  built: D.built,
  defaults: D.defaults,
  km: D.km,
  counties: D.counties,
  periods: D.periods,
  strips: D.tables.map((x) => Object.fromEntries(D.counties.map((c) => [c.id, { yes: D.words[x.buy[c.id].yes.strip], no: D.words[x.buy[c.id].no.strip] }]))),
  worst: D.tables.map((x) => worstText(D, T, x)),
  answers: A,
};
---

<div class="op" data-op data-pick-scope>
  <p class="op-chosen" data-op-chosen aria-live="polite">{chosen}</p>

  <div class="op-strip" data-op-strip>
    {scraps.map((s) => <p data-when-scrap={s}>{D.words[t.buy[def.county][s].strip]}</p>)}
  </div>

  <section class="op-card op-qs" aria-labelledby="op-qs-title">
    <h2 id="op-qs-title" class="op-card__title">{T.questionsTitle}</h2>
    <div class="op-county">
      <label class="op-label" for="op-county" data-js-only>{T.county}</label>
      <select id="op-county" class="op-select" data-op-county data-js-only>
        {D.counties.map((c) => <option value={c.id} selected={c.id === def.county}>{c.name}</option>)}
      </select>
      <p class="op-small op-nojs">{fill(T.countyStatic, { county: countyName })}</p>
    </div>
    <Segmented name="scrap" legend={T.scrapLegend} value={def.scrap} options={[{ value: 'yes', label: T.scrapYes }, { value: 'no', label: T.scrapNo }]} />
    <Segmented name="charge" legend={T.chargeLegend} value={def.charge} options={[{ value: 'no', label: T.chargeNo, sub: T.chargeNoSub }, { value: 'yes', label: T.chargeYes, sub: T.chargeYesSub }]} />
    <Segmented name="km" legend={T.kmLegend} value={String(def.km)} columns={4} options={D.km.map((k) => ({ value: String(k), label: String(k), sub: T.kmSub }))} />
  </section>

  <section class="op-card op-answer" aria-labelledby="op-ans-title" data-op-answer>
    <h2 id="op-ans-title" class="op-card__title">{T.answerTitle}</h2>
    {scraps.flatMap((s) =>
      D.km.flatMap((k) =>
        charges.map((c) => <div class="op-variant" data-when-scrap={s} data-when-km={String(k)} data-when-charge={c} data-op-case={caseKey(s, k, c)} set:html={variant(s, k, c)} />),
      ),
    )}
    <p class="op-chip"><KindChip locale={locale} kind="derived" /> <span>{fill(T.chipChecked, { date: t.checked })}</span></p>
  </section>

  <div class="op-actions">
    <a class="op-more" href="#calc" data-op-more>
      <span class="op-more__main">{T.more} <span aria-hidden="true">↓</span></span>
      <span class="op-more__sub">{T.moreSub}</span>
    </a>
    <div class="op-links">
      <a class="op-link" href="#examples">{T.examplesLink}</a>
      <a class="op-link" href="#not-yet">{T.notNowLink}</a>
    </div>
  </div>
</div>

<script type="application/json" id="op-data" set:html={JSON.stringify({ S, T })} />

<script>
  import './opening.client';
</script>

<style>
  .op {
    display: grid;
    gap: var(--sp-5);
    margin-block-start: var(--sp-4);
    max-inline-size: 46rem;
  }
  /* figures of another county, or of another day, while they are worked out again */
  .op :global([data-op-stale]),
  .op-answer[aria-busy='true'] .op-variant {
    opacity: 0.45;
  }
  .op-card :global(.ans-q) {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    border-inline-start: var(--rule-paint) solid var(--ink-3);
    padding-inline-start: var(--sp-3);
  }
  .op-card :global(.ans--go) {
    border-inline-start-color: var(--clean);
  }
  .op-card :global(.ans--dear) {
    border-inline-start-color: var(--exhaust);
  }
  .op-card :global(.ans) {
    gap: var(--sp-5);
  }
  .op-card :global(.op-scrap),
  :global(.op-scrap) {
    font-size: var(--fs-base);
    font-weight: var(--fw-regular, 400);
    line-height: var(--lh-read);
  }
  .op-card :global(.op-worst > summary) {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    list-style: none;
    min-block-size: var(--tap);
    font-weight: var(--fw-bold);
    font-size: var(--fs-base);
    cursor: pointer;
  }
  .op-card :global(.op-worst > summary::-webkit-details-marker) {
    display: none;
  }
  .op-card :global(.op-worst > summary)::before {
    content: '';
    flex: none;
    inline-size: 0.55em;
    block-size: 0.55em;
    border-inline-end: 2.5px solid currentColor;
    border-block-end: 2.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform var(--dur-1) var(--ease-out);
  }
  .op-card :global(.op-worst[open] > summary)::before {
    transform: rotate(45deg);
  }
  .op-card :global(.op-worst p) {
    font-size: var(--fs-base);
    line-height: var(--lh-read);
    padding-block-end: var(--sp-2);
  }
  .op-chosen {
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    line-height: var(--lh-read);
    max-inline-size: 46rem;
  }
  .op-strip p {
    display: block;
    padding: var(--sp-3) var(--sp-4);
    border-inline-start: var(--rule-paint) solid var(--exhaust);
    background: var(--exhaust-wash);
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    line-height: 1.5;
    max-inline-size: 46rem;
  }
  .op-county {
    display: grid;
    gap: var(--sp-2);
    max-inline-size: 24rem;
  }
  .op-label {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .op-select {
    min-block-size: var(--tap);
    padding: 0 var(--sp-3);
    border: 2px solid var(--ink);
    border-radius: var(--radius-2);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: var(--fs-btn);
    font-weight: var(--fw-bold);
  }
  .op-nojs {
    display: block;
  }
  :global(html.js) .op-nojs {
    display: none;
  }
  .op-grid {
    display: grid;
    gap: var(--sp-5);
    align-items: start;
  }
  @media (min-width: 56em) {
    .op-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .op-card {
    display: grid;
    gap: var(--sp-4);
    padding: var(--sp-5) var(--sp-4);
    border: 2px solid var(--ink);
    border-radius: var(--radius-3);
    background: var(--surface);
    min-inline-size: 0;
  }
  @media (min-width: 30em) {
    .op-card {
      padding: var(--sp-5);
    }
  }
  /* grid children may shrink below their longest word (the card never pushes the page sideways) */
  .op-card > :global(*),
  .op-variant > :global(*) {
    min-inline-size: 0;
  }
  .op-card__title {
    font-size: var(--fs-sm);
    font-weight: var(--fw-black);
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }
  .op-variant {
    display: grid;
    gap: var(--sp-4);
  }
  .op-card :global(.op-head) {
    font-size: var(--fs-headline);
    font-weight: var(--fw-black);
    line-height: var(--lh-headline, 1.28);
    text-wrap: balance;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  /* Chinese breaks only between the phrases marked '|' in the copy; English breaks at its spaces */
  .op-card :global(.op-head--phrased span) {
    display: inline-block;
    max-inline-size: 100%;
  }
  :global(html[lang='en']) .op-card :global(.op-head--phrased span) {
    display: inline;
  }
  :global(html[lang='en']) .op-card :global(.op-head) {
    word-break: normal;
    overflow-wrap: break-word;
  }
  .op-card :global(.op-fig) {
    display: grid;
    gap: var(--sp-1);
  }
  .op-card :global(.op-fig__who) {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .op-card :global(.op-fig__line) {
    font-size: var(--fs-base);
    font-weight: var(--fw-black);
    line-height: 1.1;
  }
  .op-card :global(.op-fig__n) {
    font-size: var(--fs-figure);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  .op-card :global(.op-fig--go .op-fig__line) {
    color: var(--clean-ink);
  }
  .op-card :global(.op-fig--dear .op-fig__line) {
    color: var(--exhaust-ink);
  }
  .op-card :global(.op-bars),
  .op-card :global(.op-mbars) {
    display: grid;
    gap: var(--sp-3);
  }
  .op-card :global(.op-bar),
  .op-card :global(.op-mbar) {
    display: grid;
    gap: var(--sp-1);
  }
  .op-card :global(.op-bar__label),
  .op-card :global(.op-mbar__label) {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .op-card :global(.op-bar__track),
  .op-card :global(.op-mbar__track) {
    display: flex;
    block-size: 1.75rem;
  }
  .op-card :global(.op-bar__fill),
  .op-card :global(.op-mbar__fill) {
    display: block;
    block-size: 100%;
    border-radius: var(--radius-1) 0 0 var(--radius-1);
    background: var(--ink);
    transform-origin: left center;
  }
  .op-card :global(.op-bar--petrol .op-bar__fill),
  .op-card :global(.op-mbar--petrol .op-mbar__fill) {
    background: var(--exhaust);
  }
  .op-card :global(.op-bar--ev .op-bar__fill),
  .op-card :global(.op-mbar--home .op-mbar__fill) {
    background: var(--clean);
  }
  .op-card :global(.op-bar__off) {
    display: block;
    block-size: 100%;
    border: 2px dashed var(--clean-ink);
    border-inline-start: 0;
    border-radius: 0 var(--radius-1) var(--radius-1) 0;
    background: repeating-linear-gradient(135deg, transparent 0 5px, var(--clean-wash) 5px 9px);
  }
  .op-card :global(.op-mbar__more) {
    display: block;
    block-size: 100%;
    background: repeating-linear-gradient(135deg, var(--clean) 0 3px, transparent 3px 6px);
    opacity: 0.6;
  }
  .op-card :global(.op-mbar--swap .op-mbar__track) {
    block-size: 0.875rem;
  }
  .op-card :global(.op-mbar--swap .op-mbar__fill) {
    background: var(--chart-swap);
    border-radius: var(--radius-1);
  }
  .op-card :global(.op-mbar__sub) {
    display: block;
    font-weight: var(--fw-regular, 400);
    color: var(--ink-2);
  }
  .op-card :global(.op-bar__value),
  .op-card :global(.op-mbar__value) {
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
    line-height: 1.45;
  }
  .op-card :global(.op-bar__value b),
  .op-card :global(.op-mbar__value b) {
    font-size: var(--fs-base);
    font-weight: var(--fw-black);
  }
  .op-card :global(.op-bar__value span) {
    color: var(--ink-2);
  }
  .op-card :global(.op-divider) {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-block-start: var(--sp-2);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .op-card :global(.op-divider)::after {
    content: '';
    flex: 1;
    border-block-start: 1px dashed var(--line-strong);
  }
  .op-card :global(.op-body),
  .op-line {
    font-size: var(--fs-base);
    line-height: var(--lh-read);
  }
  .op-line {
    font-weight: var(--fw-bold);
  }
  .op-lines {
    display: grid;
    gap: var(--sp-2);
  }
  .op-small,
  .op-card :global(.op-small) {
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .op-chip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .op-card :global(.op-work) {
    border-block-start: 1px solid var(--line);
  }
  .op-card :global(.op-work > summary) {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    list-style: none;
    min-block-size: var(--tap);
    font-weight: var(--fw-bold);
    font-size: var(--fs-btn);
    cursor: pointer;
  }
  .op-card :global(.op-work > summary::-webkit-details-marker) {
    display: none;
  }
  .op-card :global(.op-work > summary)::before {
    content: '';
    flex: none;
    inline-size: 0.55em;
    block-size: 0.55em;
    border-inline-end: 2.5px solid currentColor;
    border-block-end: 2.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform var(--dur-1) var(--ease-out);
  }
  .op-card :global(.op-work[open] > summary)::before {
    transform: rotate(45deg);
  }
  .op-card :global(.op-work__body) {
    display: grid;
    gap: var(--sp-4);
    padding-block: var(--sp-2) var(--sp-3);
  }
  .op-card :global(.op-work__title) {
    display: grid;
    font-weight: var(--fw-black);
  }
  .op-card :global(.op-work__title span) {
    font-weight: var(--fw-regular);
    font-size: var(--fs-sm);
    color: var(--ink-2);
  }
  .op-card :global(.op-work__lines) {
    list-style: none;
    padding: 0;
    margin: var(--sp-2) 0 0;
    display: grid;
  }
  .op-card :global(.op-work__lines li) {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-3);
    padding-block: var(--sp-2);
    border-block-end: 1px solid var(--line);
    font-size: var(--fs-sm);
    line-height: 1.45;
  }
  .op-card :global(.op-work__lines .op-work__paid) {
    font-weight: var(--fw-black);
    font-size: var(--fs-base);
    border-block-end: 0;
    border-block-start: 2px solid var(--ink);
  }
  .op-card :global(.op-amt) {
    flex: none;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .op-card :global(.op-upto) {
    color: var(--ink-2);
  }
  .op-actions {
    display: grid;
    gap: var(--sp-3);
    max-inline-size: 40rem;
  }
  .op-more {
    display: grid;
    gap: 0.15em;
    min-block-size: var(--tap);
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--radius-3);
    background: var(--go-ink-bg);
    color: #fff;
    text-decoration: none;
  }
  .op-more:hover {
    filter: brightness(1.1);
  }
  .op-more__main {
    font-size: var(--fs-btn);
    font-weight: var(--fw-black);
  }
  .op-more__sub {
    font-size: var(--fs-sm);
  }
  .op-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tap-gap) var(--sp-4);
  }
  .op-link {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
    font-weight: var(--fw-bold);
    color: var(--ink);
  }
  /* bars grow once when the opening first shows (brief 5.3); the resting state is the final state */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-motion='off'])) .op-card :global(.op-bar__fill),
    :global(html:not([data-motion='off'])) .op-card :global(.op-mbar__fill) {
      animation: op-grow 0.9s var(--ease-out) both;
    }
  }
  @keyframes op-grow {
    from {
      transform: scaleX(0);
    }
  }
</style>
