---
/**
 * Calculator — the /electric/ questions (#calc) and the live result (#result).
 *
 * The form needs JavaScript (the engine runs in the browser); without it the form is hidden
 * and a note points to the worked examples, each a complete result. The city comes from the
 * <select id="el-city" data-money-city> in #status, so the banner, the timeline and the
 * calculator always talk about the same place.
 *
 * The engine, the dataset and the renderer load as one chunk on first use (or when the
 * browser is idle); ./calc.client.ts does the wiring.
 *
 * Props
 *   locale  Locale
 *   cfg     JSON-serialisable settings from the page (citations, household questions per
 *           place, remote-district names, links, status words)
 */
import type { Locale } from '@/i18n';
import Select from '@/components/ui/Select.astro';
import RadioGroup from '@/components/ui/RadioGroup.astro';
import Range from '@/components/ui/Range.astro';
import Callout from '@/components/ui/Callout.astro';
import Icon from '@/components/ui/Icon.astro';
import electric from '@/i18n/pages/electric';
import { fill, localize } from '@/i18n/pages/_copy';
import { readerText } from '@/i18n/ui';
import { econData } from '@/data/econ';
import ElectricResult from './ElectricResult.astro';

interface Props {
  locale: Locale;
  cfg: Record<string, unknown>;
  today: string;
  /** the same places as the #status select (question 1 mirrors it) */
  cityOptions: { value: string; label: string }[];
  /** the worked result the calculator opens on (brief 7.7): the place, the distance, and the old scooter assumed when there is one to scrap */
  defaults: { county: string; km: number; scrap: { engine: 'four-stroke' | 'two-stroke'; builtOn: string } };
}
const { locale, cfg, today, cityOptions, defaults } = Astro.props;
const [defYear, defMonth] = defaults.scrap.builtOn.split('-');
const T = localize(electric, locale);
const C = T.calc;
const year = Number(today.slice(0, 4));
const years = Array.from({ length: 45 }, (_, i) => String(year - i));
const months = Array.from({ length: 12 }, (_, i) => ({ value: String(i + 1).padStart(2, '0'), label: locale === 'en' ? ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][i] : String(i + 1) }));
// the build month cannot be later than this month (the engine refuses a scooter built after today)
const thisMonth = today.slice(0, 7);
const kmMax = 3000;
const flagKeys = ['childUnder12', 'schoolChild', 'deliveryRider', 'indigenous', 'medicalWorker', 'neighbourhoodWatch', 'disasterAffected', 'remoteDistrict', 'previousLocalSubsidy', 'foreignNational'] as const;
const evOptions = [
  { value: '', label: C.advanced.evAuto },
  ...econData.evModels
    .filter((m) => m.calculator === true)
    .flatMap((m) =>
      m.plans
        .filter((p) => econData.plans.find((x) => x.id === p)?.calculator === true)
        .map((p) => ({ value: `${m.id}::${p}`, label: `${readerText(m.name[locale])} — ${readerText(econData.plans.find((x) => x.id === p)!.name[locale])}` })),
    ),
];
const gasOptions = [{ value: '', label: C.advanced.gasAuto }, ...econData.gasModels.filter((m) => m.calculator === true).map((m) => ({ value: m.id, label: `${readerText(m.brand[locale])} ${readerText(m.name[locale])}` }))];
---

<div class="el-calc" data-el-calc>
  <div class="el-calc__noscript" data-el-noscript>
    <Callout tone="note" label={T.result.title}>
      <p>{C.noscript}</p>
    </Callout>
  </div>

  <form class="el-form" data-js-only onsubmit="return false" aria-describedby="el-calc-lead" novalidate>
    <!-- Each question's visible number and wording is a picture of its control's own label
         (aria-hidden), so a screen reader hears the question once, from the control itself. -->
    <div class="el-q">
      <p class="el-q__n" aria-hidden="true"><span class="el-num">1</span>{C.q1}</p>
      <Select id="el-city-q" label={C.q1} options={cityOptions} value={defaults.county} hint={C.q1Hint} class="el-vh-label" data-el-cityq />
    </div>

    <div class="el-q">
      <p class="el-q__n" aria-hidden="true"><span class="el-num">2</span>{C.q2.legend}</p>
      <RadioGroup name="el-scrap" legend={C.q2.legend} hint={C.q2.hint} options={[{ value: 'no', label: C.q2.no }, { value: 'yes', label: C.q2.yes }]} value="yes" class="el-vh-legend" />
      <div class="el-sub" data-el-if="scrap">
        <div class="el-pair">
          <Select id="el-year" label={C.q2.year} options={years.map((y) => ({ value: y, label: y }))} value={defYear} />
          <Select id="el-month" label={C.q2.month} options={months} value={defMonth} data-el-thismonth={thisMonth} />
        </div>
        <p class="el-hint">{C.q2.builtHint}</p>
        <RadioGroup name="el-engine" legend={C.q2.engine} options={[{ value: 'four-stroke', label: C.q2.fourStroke }, { value: 'two-stroke', label: C.q2.twoStroke }]} value={defaults.scrap.engine} hint={C.q2.engineHint} />
      </div>
    </div>

    <fieldset class="el-q">
      <legend class="el-q__n"><span class="el-num" aria-hidden="true">3</span>{C.q3.legend}</legend>
      <p class="el-hint" data-el-hhint data-template={C.q3.hint}>{C.q3.hintNoCity}</p>
      <ul class="el-checks">
        {flagKeys.map((k) => (
          <li data-flag={k} hidden>
            <label class="el-check">
              <input type="checkbox" name={`el-${k}`} value="1" data-el-flag={k} />
              <span data-template={k === 'remoteDistrict' ? C.q3.flags[k] : undefined}>{k === 'remoteDistrict' ? '' : C.q3.flags[k]}</span>
            </label>
          </li>
        ))}
      </ul>
      <div data-flag="income" hidden>
        <RadioGroup name="el-income" legend={C.q3.income} options={[{ value: 'none', label: C.q3.incomeNone }, { value: 'middle-low', label: C.q3.incomeMiddle }, { value: 'low', label: C.q3.incomeLow }]} value="none" />
      </div>
      <div class="el-age" data-flag="age" hidden>
        <label for="el-age">{C.q3.age}</label>
        <p class="el-hint" id="el-age-hint" data-template={C.q3.ageHint}></p>
        <span class="el-age__row"><input id="el-age" name="el-age" type="number" inputmode="numeric" min="0" max="120" step="1" aria-describedby="el-age-hint" /> <span>{C.q3.ageUnit}</span></span>
      </div>
    </fieldset>

    <div class="el-q">
      <p class="el-q__n" aria-hidden="true"><span class="el-num">4</span>{C.q4.label}</p>
      <Range id="el-km" label={C.q4.label} min={50} max={kmMax} step={50} value={defaults.km} unit={C.q4.unit} hint={C.q4.hint} class="el-vh-label" />
      <p class="el-error" id="el-km-error" data-el-error="monthlyKm" data-error={C.q4.error} hidden></p>
      <p class="el-hint" id="el-km-over" data-el-over={kmMax} hidden>{fill(C.q4.overMax, { max: kmMax.toLocaleString(locale === 'en' ? 'en-GB' : 'zh-TW') })}</p>
      <p class="el-hint" id="el-km-under" data-el-under={50} hidden>{fill(C.q4.underMin, { min: 50 })}</p>
    </div>

    <div class="el-q">
      <p class="el-q__n" aria-hidden="true"><span class="el-num">5</span>{C.q5.legend}</p>
      <RadioGroup name="el-charge" legend={C.q5.legend} options={[{ value: 'no', label: C.q5.no }, { value: 'yes', label: C.q5.yes }]} value="no" hint={C.q5.noHint} class="el-vh-legend" />
      <p class="el-hint el-nosocket" data-el-if="nosocket">{C.q5.noSocket} <a href="#no-socket">{C.q5.noSocketLink}</a></p>
      <RadioGroup
        name="el-power"
        variant="stack"
        legend={C.q5.power}
        options={[
          { value: 'subscription', label: C.q5.sub, hint: C.q5.subHint },
          { value: 'payg', label: C.q5.payg, hint: C.q5.paygHint },
          { value: 'home', label: C.q5.home, hint: C.q5.homeHint },
        ]}
        value="subscription"
      />
      <RadioGroup
        name="el-plate"
        variant="stack"
        legend={C.q5.plate}
        options={[
          { value: 'heavy', label: C.q5.heavy, hint: C.q5.heavyHint },
          { value: 'any', label: C.q5.light, hint: C.q5.lightHint },
        ]}
        value="any"
      />
    </div>

    <details class="el-adv">
      <summary><span>{C.advanced.summary}</span><Icon name="chevron-down" size="1.25rem" class="el-adv__chev" /></summary>
      <div class="el-adv__body">
        <Select id="el-ev" label={C.advanced.ev} options={evOptions} value="" aria-describedby="el-ev-chosen" />
        <p class="el-hint el-chosen" id="el-ev-chosen" data-el-chosen="el-ev" data-template={C.advanced.chosen} aria-live="polite"></p>
        <Select id="el-gas" label={C.advanced.gas} options={gasOptions} value="" aria-describedby="el-gas-chosen" />
        <p class="el-hint el-chosen" id="el-gas-chosen" data-el-chosen="el-gas" data-template={C.advanced.chosen} aria-live="polite"></p>
        <p class="el-hint">{C.advanced.note}</p>
      </div>
    </details>
  </form>

  <!-- the answer so far, kept in view while the reader answers (updated by calc.client.ts) -->
  <div class="el-bar" data-el-bar data-js-only>
    <p class="el-bar__label">{C.bar.label}</p>
    <p class="el-bar__text" data-el-bar-text>{C.bar.empty}</p>
    <a class="el-bar__see" href="#result" data-el-bar-see hidden>{C.bar.see}</a>
  </div>
</div>

<section id="result" class="el-live" aria-labelledby="result-title" data-js-only>
  <h2 id="result-title" class="el-live__title">{T.result.title}</h2>
  <p class="el-live__placeholder" data-el-placeholder hidden>{T.result.placeholder}</p>
  <p class="el-live__status" data-el-status role="status" aria-live="polite" aria-atomic="true"></p>
  <ElectricResult id="el-live" locale={locale} hidden />
</section>

<script type="application/json" id="el-calc-data" set:html={JSON.stringify(cfg)} />

<script>
  import './calc.client';
</script>

<style>
  .el-calc__noscript {
    display: block;
  }
  :global(html.js) .el-calc__noscript {
    display: none;
  }
  .el-form {
    display: grid;
    gap: var(--sp-6);
  }
  .el-q {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-3);
    min-inline-size: 0;
  }
  .el-q__n {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-size: var(--fs-md);
    font-weight: var(--fw-black);
    line-height: var(--lh-heading);
    padding: 0;
    margin-block-end: var(--sp-2);
  }
  .el-num {
    flex: none;
    display: inline-grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border: var(--rule-paint) solid var(--ink);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-sm);
  }
  .el-hint {
    font-size: var(--fs-sm);
    color: var(--ink-2);
    line-height: var(--lh-snug);
    max-inline-size: var(--measure);
  }
  .el-q__city {
    font-weight: var(--fw-bold);
  }
  .el-q__city output:empty::before {
    content: '—';
  }
  .el-sub {
    display: grid;
    gap: var(--sp-3);
    padding-inline-start: var(--sp-4);
    border-inline-start: var(--rule-paint) solid var(--line);
  }
  .el-sub[hidden],
  [data-flag][hidden] {
    display: none;
  }
  /* year and month side by side; on a narrow phone with large text they stack, so the year
     is never cut to 「201」 */
  .el-pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
    gap: var(--sp-3);
  }
  .el-checks {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  /* The whole row is the target (at least 48 px, brief 6.3): the native box is kept for the
     keyboard and screen readers but drawn by the label, so a 22 px box is not the thing to hit. */
  .el-check {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    min-block-size: var(--tap);
    padding-inline-start: 2.6rem;
    cursor: pointer;
  }
  .el-check input {
    position: absolute;
    inset-inline-start: 0;
    inset-block: 0;
    inline-size: 2.6rem;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .el-check::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.35rem;
    inset-block-start: 50%;
    translate: 0 -50%;
    inline-size: 1.6rem;
    block-size: 1.6rem;
    border: 2px solid var(--ink);
    border-radius: 4px;
    background: var(--surface);
  }
  .el-check:has(input:checked)::before {
    background: var(--ink);
  }
  .el-check:has(input:checked)::after {
    content: '';
    position: absolute;
    inset-inline-start: 0.85rem;
    inset-block-start: 50%;
    inline-size: 0.5rem;
    block-size: 0.9rem;
    border: solid var(--bg);
    border-width: 0 3px 3px 0;
    translate: 0 -62%;
    rotate: 45deg;
  }
  .el-check:has(input:focus-visible)::before {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .el-age {
    display: grid;
    gap: var(--sp-1);
  }
  .el-age label {
    font-weight: var(--fw-bold);
  }
  .el-age__row {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .el-age input {
    inline-size: 6rem;
    min-block-size: var(--tap);
    padding: 0 var(--sp-3);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-1);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
  }
  /* a fold that looks like one: a full-width row with a rule and a chevron, like the other folds */
  .el-adv > summary {
    cursor: pointer;
    font-weight: var(--fw-bold);
    min-block-size: var(--tap);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    border-block: 1px solid var(--line);
    list-style: none;
  }
  .el-adv > summary::-webkit-details-marker {
    display: none;
  }
  .el-adv :global(.el-adv__chev) {
    flex: none;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .el-adv[open] :global(.el-adv__chev) {
    transform: rotate(180deg);
  }
  .el-adv__body {
    display: grid;
    gap: var(--sp-4);
    padding-block-start: var(--sp-3);
  }
  .el-adv__body :global(select) {
    max-inline-size: 100%;
  }
  .el-nosocket[hidden],
  .el-error[hidden],
  [data-el-over][hidden] {
    display: none;
  }
  .el-error {
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--signal-red-ink);
    border-inline-start: var(--rule-paint) solid var(--signal-red);
    padding-inline-start: var(--sp-3);
  }
  .el-form :global([aria-invalid='true']) {
    border-color: var(--signal-red) !important;
    outline: 2px solid var(--signal-red);
    outline-offset: 1px;
  }
  .el-chosen:empty {
    display: none;
  }
  /* the answer so far: a one-line bar that stays at the bottom of the screen while the questions
     are in view, so every change visibly does something */
  .el-bar {
    position: sticky;
    inset-block-end: 0;
    z-index: 5;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--sp-1) var(--sp-3);
    margin-block-start: var(--sp-6);
    margin-inline: calc(-1 * var(--sp-2));
    padding: var(--sp-3) var(--sp-4);
    background: var(--surface);
    border: var(--rule-paint) solid var(--ink);
    box-shadow: 0 -0.25rem 1rem rgb(0 0 0 / 0.12);
  }
  .el-bar__label {
    grid-column: 1 / -1;
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .el-bar__text {
    font-weight: var(--fw-black);
    line-height: var(--lh-snug);
    min-inline-size: 0;
  }
  .el-bar__see {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
    padding-inline: var(--sp-3);
    background: var(--ink);
    color: var(--surface);
    font-weight: var(--fw-bold);
    text-decoration: none;
    white-space: nowrap;
  }
  .el-bar__see[hidden] {
    display: none;
  }
  .el-bar[data-flash] {
    animation: el-flash 0.9s var(--ease-out);
  }
  @keyframes el-flash {
    from {
      background: var(--clean-wash, var(--exhaust-wash));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .el-bar[data-flash] {
      animation: none;
    }
  }
  /* on a narrow screen the bar stacks (label, answer, button at full width) and the button may
     wrap, so the answer never squeezes into a few letters a line */
  @media (max-width: 30em) {
    .el-bar {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--sp-2) var(--sp-3);
      gap: var(--sp-1);
    }
    .el-bar__see {
      justify-content: center;
      white-space: normal;
      text-align: center;
    }
  }
  /* with large text a fixed bar would cover the questions: it stays in the flow instead */
  :global(html[data-text='lg']) .el-bar,
  :global(html[data-text='xl']) .el-bar {
    position: static;
  }
  /* focused fields and anchors land above the bar, not under it */
  :global(html:has(.el-bar)) {
    scroll-padding-block-end: 8rem;
  }
  /* on a phone the on-screen keyboard takes the bottom of the screen: step aside while typing */
  @media (max-width: 40em) {
    .el-calc:has(input[type='number']:focus) .el-bar {
      position: static;
    }
  }
  :global(.el-vh-legend legend),
  :global(.el-vh-label > label),
  :global(.el-vh-label label:first-child) {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .el-live {
    display: grid;
    gap: var(--sp-4);
    scroll-margin-block-start: calc(var(--header-h, 3.5rem) + var(--sp-4));
  }
  .el-live__title {
    font-size: var(--fs-xl);
    font-weight: var(--fw-black);
  }
  .el-live__placeholder {
    padding: var(--sp-5);
    border: 1px dashed var(--line-strong);
    color: var(--ink-2);
  }
  .el-live__placeholder[hidden] {
    display: none;
  }
  .el-live__status {
    font-size: var(--fs-sm);
    color: var(--ink-2);
    min-block-size: 1.2em;
  }
  .el-live[aria-busy='true'] :global(.el-result) {
    opacity: 0.55;
  }
  @media (prefers-reduced-motion: no-preference) {
    .el-live :global(.el-result) {
      transition: opacity var(--dur-2) var(--ease-out);
    }
  }
</style>
