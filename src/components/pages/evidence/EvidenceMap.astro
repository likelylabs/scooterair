---
/**
 * EvidenceMap — V30. Rows: the seven links. Columns: the kinds of evidence, then 推估 (brief 7.3:
 * the old 沒人量過 column is gone). Each cell lists the sources that link uses for that kind, as
 * numbered chips that go to the source's entry on /sources/; an empty cell stays empty. The 推估
 * cell lists this site's own estimates for that link (the kerbside estimate on link 3, and every
 * answer carrying the 推估 chip), each a link to its working on /estimate/. Link 3 is whole: its
 * 推估 cell is drawn with a dashed outline beside the solid measured cell.
 *
 * A real <table> on wide screens; below 60em each row becomes a block, with the column name
 * printed beside each cell. Explicit roles keep the table semantics when the display changes.
 *
 * Props
 *   locale  Locale
 */
import type { Locale } from '@/i18n';
import { href } from '@/i18n';
import { chain, evidence } from '@/i18n/ui';
import { answersForLink, chainLinks, factsForLink, localizeAnswer, seriesForLink, type Evidence, type SourceId } from '@/data';
import EvidenceBadge from '@/components/ui/EvidenceBadge.astro';
import KindChip from '@/components/ui/KindChip.astro';
import evidenceCopy from '@/i18n/pages/evidence';
import { fill, localize } from '@/i18n/pages/_copy';
import { citeN, kindOf, seriesSources, sourceShort } from './ev';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const T = localize(evidenceCopy, locale);
const M = T.map;
const cols: Evidence[] = ['measured-tw', 'official-tw', 'modelled-tw', 'international', 'derived', 'market-tw'];
const rows = chainLinks.map((n) => {
  const fs = factsForLink(n, { primaryOnly: true });
  const ss = seriesForLink(n, { primaryOnly: true });
  const cells = cols.map((e) => {
    const ids = new Set<SourceId>();
    fs.filter((f) => f.evidence === e).forEach((f) => f.sources.forEach((s) => ids.add(s)));
    ss.filter((s) => s.evidence === e).forEach((s) => seriesSources(s.id).forEach((x) => ids.add(x)));
    return [...ids].sort((a, b) => citeN(a) - citeN(b));
  });
  // link 7 is named as its eyebrow names it everywhere on the page
  // this site's own estimates for the link: the kerbside estimate (link 3) and every answer with the 推估 chip
  const ests = answersForLink(n)
    .filter((a) => a.chips.some((c) => c.kind === 'estimate'))
    .map((a) => {
      const l = localizeAnswer(a, locale);
      return { href: a.anchor ? href(`/estimate/#${a.anchor}`, locale) : `#${a.id}`, label: l.question };
    });
  if (n === 3) ests.unshift({ href: href('/estimate/', locale), label: M.estimateKerb });
  return { n, name: n === chain.links.length ? chain.breakable[locale] : chain.links[n - 1][locale], cells, ests };
});
const usedCols = cols.filter((_, i) => rows.some((r) => r.cells[i].length > 0));
const colIdx = usedCols.map((c) => cols.indexOf(c));
---

<div class:list={['emap', locale === 'en' && 'emap--late']}>
  <table class="emap__table" role="table" aria-describedby="emap-caption">
    <thead role="rowgroup">
      <tr role="row">
        <th scope="col" role="columnheader">{M.linkColumn}</th>
        {usedCols.map((c) => <th scope="col" role="columnheader"><EvidenceBadge locale={locale} kind={kindOf(c)} /></th>)}
        <th scope="col" role="columnheader"><KindChip locale={locale} kind="estimate" size="sm" /></th>
      </tr>
    </thead>
    <tbody role="rowgroup">
      {rows.map((r) => (
        <tr role="row">
          <th scope="row" role="rowheader" class="emap__link">
            <a href={`#${chain.anchor(r.n)}`}>
              <span class="emap__n">{fill(T.toc.linkN, { n: r.n })}</span>
              <span class="emap__name">{r.name}</span>
            </a>
          </th>
          {colIdx.map((ci) => (
            <td role="cell" class:list={['emap__cell', r.cells[ci].length === 0 && 'emap__cell--empty']}>
              <span class="emap__label" aria-hidden="true">{evidence.kinds[kindOf(cols[ci])].label[locale]}</span>
              {r.cells[ci].length === 0 ? (
                <span class="emap__none"><span class="vh">{M.none}</span></span>
              ) : (
                <span class="emap__chips">
                  {r.cells[ci].map((id) => (
                    <a class="emap__chip" href={href(`/sources/#${id}`, locale)} title={sourceShort(id, locale)}>
                      <span aria-hidden="true">{citeN(id)}</span>
                      <span class="vh">{sourceShort(id, locale)}</span>
                    </a>
                  ))}
                </span>
              )}
            </td>
          ))}
          <td role="cell" class:list={['emap__cell', 'emap__gapcell', r.n === 3 && 'emap__gapcell--central', r.ests.length === 0 && 'emap__cell--empty']}>
            <span class="emap__label" aria-hidden="true">{M.estimateColumn}</span>
            {r.ests.length === 0 ? (
              <span class="emap__none"><span class="vh">{M.none}</span></span>
            ) : (
              <ul class="emap__gaps">
                {r.ests.map((g) => <li><a href={g.href}>{g.label}</a></li>)}
              </ul>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <p class="emap__caption" id="emap-caption">{M.caption}</p>
</div>

<style>
  .emap {
    /* last resort only: the fixed layout below keeps the table inside its box at every width */
    max-inline-size: 100%;
    overflow-x: auto;
  }
  .emap__table {
    inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }
  /* column headers are badges: they wrap inside their column instead of widening the table */
  .emap__table thead :global(.ev) {
    white-space: normal;
    max-inline-size: 100%;
  }
  .emap__table th,
  .emap__table td {
    text-align: start;
    vertical-align: top;
  }
  .emap__link a {
    display: grid;
    gap: 2px;
    color: inherit;
    text-decoration: none;
  }
  .emap__n {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    color: var(--ink-2);
  }
  .emap__name {
    font-weight: var(--fw-bold);
    line-height: var(--lh-snug);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .emap__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .emap__chip {
    display: inline-grid;
    place-items: center;
    min-inline-size: 2rem;
    min-block-size: 1.75rem;
    padding: 0 0.35em;
    border-radius: var(--radius-1);
    background: var(--bg-sunken);
    color: var(--accent);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
  }
  .emap__chip:hover,
  .emap__chip:focus-visible {
    background: var(--accent);
    color: var(--on-accent);
  }
  .emap__gaps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-1);
    line-height: var(--lh-snug);
  }
  .emap__gaps a {
    color: var(--ink);
  }
  .emap__ped {
    display: block;
    font-weight: var(--fw-bold);
    margin-block-end: var(--sp-1);
  }
  .emap__gapcell--central {
    outline: 2px dashed var(--estimate);
    outline-offset: -4px;
  }
  .emap__caption {
    margin-block-start: var(--sp-3);
    font-size: var(--fs-xs);
    color: var(--ink-2);
    max-inline-size: 44rem;
  }

  /* phones and tablets: one block per link */
  @media (max-width: 59.99em) {
    .emap__table,
    .emap__table tbody,
    .emap__table tr,
    .emap__table th,
    .emap__table td {
      display: block;
    }
    .emap__table thead {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .emap__table tr {
      padding-block: var(--sp-3) var(--sp-4);
      border-block-start: 2px solid var(--ink);
    }
    .emap__link {
      margin-block-end: var(--sp-2);
    }
    .emap__cell {
      display: grid !important;
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: var(--sp-2);
      align-items: start;
      padding-block: var(--sp-2);
      border-block-start: 1px solid var(--line);
    }
    .emap__cell--empty {
      display: none !important;
    }
    .emap__label {
      font-size: var(--fs-xs);
      font-weight: var(--fw-bold);
      color: var(--ink-2);
      line-height: 1.75rem;
    }
    .emap__gapcell {
      grid-template-columns: 7.5rem minmax(0, 1fr);
    }
    .emap__gapcell .emap__ped,
    .emap__gapcell .emap__gaps {
      grid-column: 2;
    }
    .emap__gapcell--central {
      padding-inline: var(--sp-2);
    }
    /* phone tap targets: 44px chips, 8px apart */
    .emap__chips {
      gap: var(--sp-2);
    }
    .emap__chip {
      min-inline-size: var(--tap, 44px);
      min-block-size: var(--tap, 44px);
    }
    .emap__label {
      line-height: var(--tap, 44px);
    }
    .emap__link a,
    .emap__gaps a {
      display: inline-flex;
      align-items: center;
      min-block-size: var(--tap, 44px);
    }
    .emap__link a {
      display: grid;
      align-content: center;
    }
  }
  @media (min-width: 60em) {
    .emap__table {
      table-layout: fixed;
    }
    .emap__label {
      display: none;
    }
    .emap__table thead th {
      padding: var(--sp-2);
      border-block-end: 2px solid var(--ink);
      vertical-align: bottom;
    }
    .emap__table tbody th,
    .emap__table tbody td {
      padding: var(--sp-3) var(--sp-2);
      border-block-end: 1px solid var(--line);
    }
    /* fixed layout takes its widths from the header row: link names and the gap column get room, the rest share */
    .emap__table thead th:first-child {
      inline-size: 9.5rem;
    }
    .emap__table thead th:last-child {
      inline-size: 13rem;
    }
    .emap__table td {
      overflow-wrap: anywhere;
    }
    .emap__table thead th {
      hyphens: auto;
      overflow-wrap: break-word;
    }
  }
  /*
   * English column names are long ("International evidence", "Official Taiwan data"): the table
   * fits only from 80em. Between 60em and 80em the English map keeps the stacked layout.
   */
  @media (min-width: 60em) and (max-width: 79.99em) {
    .emap--late .emap__table,
    .emap--late .emap__table tbody,
    .emap--late .emap__table tr,
    .emap--late .emap__table th,
    .emap--late .emap__table td {
      display: block;
    }
    .emap--late .emap__table thead {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .emap--late .emap__table tr {
      padding-block: var(--sp-3) var(--sp-4);
      border-block-start: 2px solid var(--ink);
    }
    .emap--late .emap__table tbody th,
    .emap--late .emap__table tbody td {
      padding: 0;
      border-block-end: 0;
    }
    .emap--late .emap__link {
      margin-block-end: var(--sp-2);
    }
    .emap--late .emap__cell {
      display: grid !important;
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: var(--sp-2);
      align-items: start;
      padding-block: var(--sp-2);
      border-block-start: 1px solid var(--line);
    }
    .emap--late .emap__cell--empty {
      display: none !important;
    }
    .emap--late .emap__label {
      display: block;
      font-size: var(--fs-xs);
      font-weight: var(--fw-bold);
      color: var(--ink-2);
      line-height: 1.75rem;
    }
    .emap--late .emap__gapcell .emap__ped,
    .emap--late .emap__gapcell .emap__gaps {
      grid-column: 2;
    }
    .emap--late .emap__gapcell--central {
      padding-inline: var(--sp-2);
    }
  }
</style>
