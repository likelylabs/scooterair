---
/**
 * GapCard — one recorded gap (src/data/gaps.ts), stated in the same type size as a finding and
 * always followed by what would close it and who could measure it (blueprint Part 2, move 2).
 *
 * Props
 *   locale   Locale
 *   id       GapId
 *   full     true in #gaps: the anchor #<gap id>, why it matters, the closest evidence and
 *            the search date. false in a link section: a short card that links to the entry.
 *   level    heading level (default 3)
 */
import type { Locale } from '@/i18n';
import { href } from '@/i18n';
import type { GapId } from '@/data';
import EvidenceBadge from '@/components/ui/EvidenceBadge.astro';
import evidenceCopy from '@/i18n/pages/evidence';
import { fill, localize } from '@/i18n/pages/_copy';
import { dataAnchor, gapN, lf, lg, ls } from './ev';

interface Props {
  locale: Locale;
  id: GapId;
  full?: boolean;
  level?: 3 | 4;
}
const { locale, id, full = false, level = 3 } = Astro.props;
const T = localize(evidenceCopy, locale);
const G = T.gaps;
const g = lg(id, locale);
const n = gapN(id);
const H = `h${level}` as 'h3' | 'h4';
const closest = [
  ...g.closest.facts.map((f) => ({ href: `#${f}`, label: lf(f, locale).display })),
  ...g.closest.series.map((s) => ({ href: `#${dataAnchor(s)}`, label: ls(s, locale).title })),
];
---

<article class:list={['gap', full && 'gap--full']} id={full ? id : undefined} aria-labelledby={`${full ? '' : 'l-'}${id}-t`}>
  <p class="gap__meta">
    <span class="gap__n">{fill(G.gapN, { n })}</span>
    <EvidenceBadge locale={locale} kind="gap" />
  </p>
  <H class="gap__title" id={`${full ? '' : 'l-'}${id}-t`}>
    {full ? g.title : <a href={`#${id}`}>{g.title}</a>}
  </H>
  <p class="gap__statement">{g.statement}</p>
  {full && <p class="gap__line"><b>{G.why}</b>{g.whyItMatters}</p>}
  <p class="gap__line"><b>{G.close}</b>{g.wouldClose}</p>
  {g.whoCouldMeasure && <p class="gap__line"><b>{G.who}</b>{g.whoCouldMeasure}</p>}
  {full && closest.length > 0 && (
    <p class="gap__line gap__closest">
      <b>{G.closest}</b>
      {closest.map((c, i) => (
        <Fragment>{i > 0 && (locale === 'en' ? '; ' : '；')}<a href={c.href}>{c.label}</a></Fragment>
      ))}
    </p>
  )}
  {full && <p class="gap__date">{fill(G.searched, { date: g.searchedOn })}</p>}
  {full && <p class="gap__ask"><a href={href('/unmeasured/#ask', locale)}>{G.ask} →</a></p>}
</article>

<style>
  .gap {
    display: grid;
    gap: var(--sp-2);
    padding: var(--sp-4);
    border: 2px dashed var(--ink-3);
    border-radius: var(--radius-2);
    background: var(--bg);
    scroll-margin-block-start: calc(var(--header-h) + var(--rail-h) + var(--sp-4));
    min-inline-size: 0;
  }
  .gap:target {
    border-color: var(--accent);
    background: var(--mark-bg);
  }
  .gap__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
  }
  .gap__n {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    color: var(--ink-2);
  }
  .gap__title {
    font-size: var(--fs-md);
    line-height: var(--lh-snug);
  }
  .gap__title a {
    color: inherit;
  }
  .gap__statement {
    font-size: var(--fs-base);
    line-height: var(--lh-body);
  }
  .gap__line {
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--ink-2);
  }
  .gap__line b {
    color: var(--ink);
    margin-inline-end: 0.2em;
  }
  .gap__closest a {
    color: var(--accent);
  }
  .gap__date {
    font-size: var(--fs-xs);
    color: var(--ink-3);
  }
  .gap__ask a {
    font-weight: var(--fw-bold);
    color: var(--accent);
  }
</style>
