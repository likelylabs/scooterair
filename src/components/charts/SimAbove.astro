---
/**
 * SimAbove — chart (c) of the simulation: two small charts, each with its own unit and its own
 * line, stacked and never merged or ranked.
 *
 *   (c1) how much of the red you can smell it: share of the red's seconds above what most people
 *        can smell, by the 1967 and the 1970 study's level (0–100 %). No reference line: the bands
 *        speak for themselves (a "half the seconds" guide would read as a threshold no source sets)
 *   (c2) benzene for people who stay an hour with the wind from the scooters (ppb), against
 *        California's 1-hour reference (set from 6-hour data). One statistic: from the middle case
 *        to the high case (P50 with the wind held in 45 % of reds to P95 at 65 %), which is what
 *        statement 8's "1 to 4 times" rests on
 *
 * Rules it keeps: hatched bands with a dashed edge, no middle mark; no odour-unit number; no
 * carbon monoxide on either axis; no one-red benzene row; no cancer or risk word; no comparison
 * with carbon monoxide or particles. Data: src/data/simulation.ts (simAboveModel()).
 *
 * Props: locale, only? ('smell' | 'benzene': one of the two charts), id, class
 */
import '@/styles/charts.css';
import type { Locale } from '@/i18n';
import { uid as makeId } from '@/components/uid';
import { simAboveModel, type SimBandRow } from './core/simCharts';
import { chipHtml, guides, hatchDef, pc } from './core/html';
import { tableHtml } from './core/shared';
import { chartText } from './strings';

interface Props {
  locale: Locale;
  /** one chart only (home screen 5's sheet: 'benzene') */
  only?: 'smell' | 'benzene';
  id?: string;
  class?: string;
}
const { locale, only, id, class: cls } = Astro.props;
const m = simAboveModel(locale, only);
const u = makeId('sima');
const H = 26;
const panels = [
  { key: 'smell', ...m.smell, ref: undefined as undefined | { value: number; label: string }, unit: '%' },
  { key: 'benzene', ...m.benzene, unit: 'ppb' },
].filter((p) => !only || p.key === only);
const title = only === 'benzene' ? m.benzene.title : only === 'smell' ? m.smell.title : `${m.smell.title}${locale === 'en' ? '; ' : '；'}${m.benzene.title}`;
const xOf = (max: number) => (v: number) => (v / max) * 100;
---

<div id={id} class:list={['chart', 'hc', 'hc-above', 'hc--unit-end', cls]} data-chart="sim-above" data-grow="" role="group" aria-label={title}>
  <p class="vh" data-chart-summary>{panels.map((p) => p.summary).join(locale === 'en' ? ' ' : '')}</p>
  {
    panels.map((p) => {
      const x = xOf(p.axis.max);
      const tickXs = p.axis.ticks.map(x);
      return (
        <section class="hc-above__panel" data-panel={p.key}>
          <p class="hc-sim__label">{p.title}</p>
          <ol class="hc-rows" role="list">
            {(p.rows as SimBandRow[]).map((r, i) => (
              <li class="hc-row">
                <div class="hc-row__text">
                  <span class="hc-row__head">
                    <span class="hc-row__label">{r.label}</span>{' '}
                    <span class="hc-row__value hc-row__value--sm"><span class="hc-row__n">{r.value}</span></span>
                  </span>
                  <span class="hc-row__sub">
                    <span class="hc-row__tail"><Fragment set:html={chipHtml('estimate', locale)} /></span> <span>{r.sub}</span>
                  </span>
                </div>
                <svg class="hc-plot" width="100%" height={H} aria-hidden="true" focusable="false">
                  <Fragment set:html={hatchDef(`${u}-${p.key}-${i}`)} />
                  <rect class="hc-track" x="0" y={H / 2 - 9} width="100%" height="18" rx="2" />
                  <Fragment set:html={guides(tickXs, H)} />
                  <rect class="hc-band hc-g" data-mark="estimate" x={pc(x(r.lo))} y={H / 2 - 10} width={pc(Math.max(x(r.hi) - x(r.lo), 0.8))} height="20" rx="2" fill={`url(#${u}-${p.key}-${i})`} />
                  {p.ref && <line class="hc-who" data-mark="reference" x1={pc(x(p.ref.value))} x2={pc(x(p.ref.value))} y1="0" y2={H} />}
                </svg>
              </li>
            ))}
          </ol>
          <div class="hc-axis" data-chart-axis aria-hidden="true">
            {p.axis.ticks.map((t, i) => <span style={`inset-inline-start:${pc(tickXs[i])}`}>{t}</span>)}
            <b class="hc-axis__unit">{p.unit}</b>
          </div>
          <p class="hc-sim__axislabel" aria-hidden="true">{p.axis.label}</p>
          {p.ref && (
            <div class="hc-sim__who">
              <svg width="14" height="22" aria-hidden="true" focusable="false"><line class="hc-who" x1="7" x2="7" y1="1" y2="21" /></svg>
              <p class="hc-sim__wholabel"><span class="hc-sim__wholine">{p.ref.label}</span> <Fragment set:html={chipHtml('official', locale)} /></p>
            </div>
          )}
          <p class="hc-sim__caption">{p.key === 'benzene' ? `${p.summary}${locale === 'en' ? ' ' : ''}` : ''}{p.caption}</p>
        </section>
      );
    })
  }
  <Fragment set:html={tableHtml(m.table, { title, tableLabel: chartText.dataTable[locale] })} />
</div>

<script>
  import './core/grow';
</script>
