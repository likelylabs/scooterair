---
/**
 * MonthlyBars — G13 (docs/redesign-brief.md 3.2 screen 13): fuel and power each month.
 * Two thick filled bars, petrol against charging at home; then, under a divider that reads
 * 不能在家充電的話, two thin outlined bars for battery swapping. Every bar has its amount in 元
 * beside its name.
 *
 * Give it one month case, or several keyed by distance:
 *
 *   <MonthlyBars locale={locale} month={homeMoney().month[300]} />
 *   <MonthlyBars locale={locale} months={homeMoney().month} when="km" />
 *
 * With `months`, one chart per distance is printed, each wrapped in `data-when-<when>="<km>"`,
 * so a <Segmented name="km"> in the same [data-pick-scope] shows the chosen one (lane B's
 * contract), with or without JavaScript.
 *
 * Props
 *   locale      Locale
 *   month       a MonthCase from src/lib/home-money.ts
 *   months      Record<km, MonthCase>
 *   when        the Segmented's name (default 'km')
 *   sharedScale true draws every distance to one scale, so the bars grow as the distance does.
 *               Default false: each distance fills its own width
 *   table       false leaves out the "view data table" toggle. Default true
 *   id, class   on the single chart, or on the set's wrapper
 *
 * To redraw one in the browser: updateHtmlChart(el, renderMonthlyBars(monthlyBarsFromCase(monthCase(km), locale)))
 * from ./core/html and ./core/monthlyBars.
 */
import '@/styles/charts.css';
import type { Locale } from '@/i18n';
import { monthlyBarsFromCase, monthlyBarsMax, monthlyBarsTitle, renderMonthlyBars, type MonthCaseLike } from './core/monthlyBars';

interface Props {
  locale: Locale;
  month?: MonthCaseLike;
  months?: Record<string | number, MonthCaseLike>;
  when?: string;
  sharedScale?: boolean;
  table?: boolean;
  id?: string;
  class?: string;
}
const { locale, month, months, when = 'km', sharedScale = false, table, id, class: cls } = Astro.props;
if (!month && !months) throw new Error('MonthlyBars: pass `month` (a MonthCase from src/lib/home-money.ts) or `months`.');
const set = months ? Object.values(months).map((m) => monthlyBarsFromCase(m, locale, { table })) : [];
const max = sharedScale && set.length ? monthlyBarsMax(set) : undefined;
const single = month ? monthlyBarsFromCase(month, locale, { table }) : undefined;
const bad = [...set, ...(single ? [single] : [])].find((c) => [c.petrol, c.home, c.swapPlan, c.swapPayg].some((b) => !Number.isFinite(b.hi) || b.hi <= 0));
if (bad) throw new Error(`MonthlyBars: a figure is missing at ${bad.km} km. A chart is never drawn empty.`);
---

{
  single ? (
    <div id={id} class:list={['chart', 'hc', 'hc-monthlybars', cls]} data-chart="monthly-bars" data-grow="" role="group" aria-label={monthlyBarsTitle(locale, single.km)} set:html={renderMonthlyBars(single)} />
  ) : (
    <div id={id} class:list={['hc-monthly-set', cls]}>
      {set.map((c) => (
        <div {...{ [`data-when-${when}`]: String(c.km) }}>
          <div class="chart hc hc-monthlybars" data-chart="monthly-bars" data-km={c.km} data-grow="" role="group" aria-label={monthlyBarsTitle(locale, c.km)} set:html={renderMonthlyBars({ ...c, max })} />
        </div>
      ))}
    </div>
  )
}

<script>
  import './core/grow';
</script>
