---
/**
 * @deprecated RETIRED (docs/redesign-brief.md 5.4): the site draws no empty chart any more.
 * Use <MeasuredVsEstimate> (measured beside estimated) or <EstimateBands>. This file and
 * core/empty.ts stay only until every page has moved off them; they are deleted in phase 3
 * (acceptance check 8 fails while any `EmptyChart` remains in src/).
 *
 * EmptyChart — the empty chart (V8), formerly the site's signature graphic. A complete,
 * carefully drawn chart frame (stacked panels, axes, ticks, gridlines, the
 * red-then-green phase bar) with no marks at all, because nobody has measured
 * what it would show. It has to look deliberate, never broken: the frame is
 * as finished as any other chart, the y axes show only where zero would be
 * (no invented scale), and every panel says "no data" in words.
 *
 * Put it in <Figure empty …>, which swaps the source line for the 沒人量過
 * badge and adds the "who could measure it" line.
 *
 * Defaults draw blueprint V8 exactly: three panels (一氧化碳, 苯, 超細微粒),
 * the two unmeasured heights (stroller, adult), x from 90 to 0 seconds.
 *
 * Props (plus id, class)
 *   locale       Locale
 *   title        accessible name of the graphic (required)
 *   desc         what the chart would show, in a sentence; the component adds
 *                "this chart is empty on purpose…" for screen readers
 *   panels       { label: string; unit?: string }[]
 *   series       { label: string; icon?: 'stroller' | 'adult' }[] — what would be plotted
 *   seriesLabel  heading above the series key
 *   x            { from, to, step, label, phase?: { changeAt, first, second } }
 *   panelHeight  px (default 84)
 *
 * Screen readers get: the title, the description, and a data table whose every
 * cell reads 無資料 / no data.
 */
import type { Locale } from '@/i18n';
import { emptyData } from '@/i18n/ui';
import ChartShell from './ChartShell.astro';
import { renderEmpty, type EmptyChartProps } from './core/empty';

interface Props {
  locale: Locale;
  title: string;
  desc?: string;
  panels?: EmptyChartProps['panels'];
  series?: EmptyChartProps['series'];
  seriesLabel?: string;
  x?: EmptyChartProps['x'];
  panelHeight?: number;
  id?: string;
  class?: string;
}
const { locale, title, desc, panelHeight, id, class: cls } = Astro.props;
const en = locale === 'en';
const panels = Astro.props.panels ?? [
  { label: en ? 'Carbon monoxide' : '一氧化碳', unit: 'ppm' },
  { label: en ? 'Benzene' : '苯', unit: 'ppb' },
  { label: en ? 'Ultrafine particles' : '超細微粒', unit: en ? 'particles/cm³' : '個/cm³' },
];
const series = Astro.props.series ?? [
  { label: emptyData.stroller[locale], icon: 'stroller' as const },
  { label: emptyData.adult[locale], icon: 'adult' as const },
];
const x = Astro.props.x ?? { from: 90, to: -12, step: 15, label: emptyData.xLabel[locale], phase: { changeAt: 0, first: emptyData.red[locale], second: emptyData.green[locale] } };
const render = renderEmpty({
  locale,
  panels,
  series,
  seriesLabel: Astro.props.seriesLabel ?? (Astro.props.series ? undefined : emptyData.heights[locale]),
  x,
  noData: emptyData.panel[locale],
  seriesHeader: emptyData.tableHeight[locale],
  panelHeight,
});
---

<ChartShell render={render} title={title} desc={[desc, emptyData.sr[locale]].filter(Boolean).join(' ')} locale={locale} id={id} class={['chart--empty', cls].filter(Boolean).join(' ')} />
