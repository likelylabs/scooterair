---
/**
 * Header — wordmark, primary nav, language switch, theme toggle.
 *
 * Wide screens show the nav inline. Narrow screens get a <details> menu that
 * overlays the page (no layout shift, works without JavaScript); a small
 * script adds Escape / outside-click / link-click closing.
 *
 * Props
 *   locale  Locale
 */
import { href, htmlLang, switchLocalePath, type Locale } from '@/i18n';
import { nav, ui } from '@/i18n/ui';
import Icon from '@/components/ui/Icon.astro';
import Wordmark from './Wordmark.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const other: Locale = locale === 'en' ? 'zh-TW' : 'en';
const path = Astro.url.pathname;
const items = nav.map((item) => {
  const url = href(item.path, locale);
  return { url, label: item.label[locale], current: path === url || path.startsWith(url) };
});
---

<header class="site-header">
  <div class="container site-header__bar">
    <Wordmark locale={locale} />

    <nav class="site-nav" aria-label={ui.primaryNav[locale]}>
      <ul>
        {items.map((i) => (
          <li>
            <a href={i.url} aria-current={i.current ? 'page' : undefined}>{i.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__tools">
      <a class="lang-switch" data-lang-switch href={switchLocalePath(path, other)} lang={htmlLang[other]} hreflang={htmlLang[other]} title={ui.switchLanguageHint[locale]}>
        <span class="lang-switch__short" aria-hidden="true">{ui.switchLanguageShort[locale]}</span>
        <span class="lang-switch__long">{ui.switchLanguage[locale]}</span>
      </a>
      <ThemeToggle locale={locale} />
      <details class="menu" data-menu>
        <summary aria-label={ui.menu[locale]}>
          <span class="menu__open"><Icon name="menu" size="1.5rem" /></span>
          <span class="menu__close"><Icon name="close" size="1.5rem" /></span>
        </summary>
        <nav class="menu__panel" aria-label={ui.primaryNav[locale]}>
          <ul>
            <li><a href={href('/', locale)} aria-current={path === href('/', locale) ? 'page' : undefined}>{ui.home[locale]}</a></li>
            {items.map((i) => (
              <li>
                <a href={i.url} aria-current={i.current ? 'page' : undefined}>{i.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: var(--bg);
    border-block-end: 1px solid var(--line);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    block-size: var(--header-h);
  }
  .site-header__tools {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    margin-inline-start: auto;
  }

  /* Inline nav: wide screens only */
  .site-nav {
    display: none;
    margin-inline-start: auto;
  }
  .site-nav ul {
    display: flex;
    gap: clamp(0.25rem, 1.2vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    block-size: var(--header-h);
    padding-inline: 0.4rem;
    color: var(--ink-2);
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    text-decoration: none;
    white-space: nowrap;
    /* painted underline, like a lane edge */
    box-shadow: inset 0 0 0 transparent;
    transition: box-shadow var(--dur-1) var(--ease-out), color var(--dur-1) var(--ease-out);
  }
  .site-nav a:hover {
    color: var(--ink);
    box-shadow: inset 0 -3px 0 var(--line-strong);
  }
  .site-nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: var(--fw-bold);
    box-shadow: inset 0 -3px 0 var(--ink);
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: var(--tap);
    block-size: var(--tap);
    padding-inline: 0.5rem;
    border-radius: var(--radius-2);
    color: var(--ink);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    text-decoration: none;
    white-space: nowrap;
  }
  .lang-switch:hover {
    background: var(--bg-sunken);
    color: var(--ink);
  }
  /* Narrow: short visible label, full label for assistive tech */
  .lang-switch__long {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Overlay menu: narrow screens only */
  .menu {
    position: static;
  }
  .menu > summary {
    display: grid;
    place-items: center;
    inline-size: var(--tap);
    block-size: var(--tap);
    border-radius: var(--radius-2);
    list-style: none;
    cursor: pointer;
  }
  .menu > summary::-webkit-details-marker {
    display: none;
  }
  .menu > summary:hover {
    background: var(--bg-sunken);
  }
  .menu > summary span {
    grid-area: 1 / 1;
    display: grid;
  }
  .menu:not([open]) .menu__close,
  .menu[open] .menu__open {
    display: none;
  }
  .menu__panel {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    max-block-size: calc(100vh - var(--header-h));
    max-block-size: calc(100dvh - var(--header-h));
    overflow-y: auto;
    background: var(--bg);
    border-block-end: var(--rule-stop) solid var(--ink);
  }
  .menu__panel ul {
    margin: 0;
    padding: var(--sp-2) var(--gutter) var(--sp-5);
    list-style: none;
  }
  .menu__panel li + li {
    border-block-start: 1px solid var(--line);
  }
  .menu__panel a {
    display: flex;
    align-items: center;
    min-block-size: 3.25rem;
    color: var(--ink);
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    text-decoration: none;
  }
  .menu__panel a[aria-current='page']::before {
    content: '';
    inline-size: 0.75rem;
    block-size: 0.75rem;
    margin-inline-end: 0.75rem;
    background: var(--clean);
    border-radius: 50%;
  }

  @media (min-width: 62em) {
    .site-nav {
      display: block;
    }
    .menu {
      display: none;
    }
    .site-header__tools {
      margin-inline-start: var(--sp-2);
    }
    .lang-switch__short {
      display: none;
    }
    .lang-switch__long {
      position: static;
      inline-size: auto;
      block-size: auto;
      clip-path: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-menu]').forEach((menu) => {
    const summary = menu.querySelector('summary');
    const close = (focus = false) => {
      if (!menu.open) return;
      menu.open = false;
      if (focus) summary?.focus();
    };
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close(true);
    });
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node)) close();
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => close()));
    // the panel covers the page: close it when keyboard focus leaves it, so focus never lands on
    // a control hidden underneath (WCAG 2.4.11)
    menu.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !menu.contains(next)) close();
    });
    window.matchMedia('(min-width: 62em)').addEventListener('change', () => close());
  });

  // Language switches (header and footer) keep the reader's place: both languages use the same
  // anchors, so carry the current #fragment over to the other language's URL.
  const syncLangSwitch = () =>
    document.querySelectorAll<HTMLAnchorElement>('a[data-lang-switch]').forEach((a) => {
      const u = new URL(a.href, location.href);
      u.hash = location.hash;
      a.href = u.href;
    });
  syncLangSwitch();
  window.addEventListener('hashchange', syncLangSwitch);
  document.addEventListener('click', (e) => (e.target as Element | null)?.closest?.('a[data-lang-switch]') && syncLangSwitch(), true);
</script>
