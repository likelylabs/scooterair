---
/**
 * Header — 48 px: the wordmark (the home link), 字大, the language switch and the menu
 * (brief 3.1). From 62em the five menu items also sit inline.
 *
 * The menu is a <details> that overlays the page (no layout shift, works without JavaScript):
 * the five items of the main menu, then the reader's settings (text size, animation, dark
 * theme). A small script adds Escape / outside-click / link-click closing.
 *
 * The header is sized in px on purpose: 字大 and a large browser font scale the page, not its
 * four controls, so they always fit a 320 px screen. Every control is 48 × 48 px, 8 px apart.
 *
 * Props
 *   locale     Locale
 *   switchTo   optional href for the language button (a page with no twin at the same path,
 *              such as the 404 page, sends it to the other language's home page)
 */
import { href, htmlLang, switchLocalePath, type Locale } from '@/i18n';
import { nav, ui } from '@/i18n/ui';
import Icon from '@/components/ui/Icon.astro';
import Wordmark from './Wordmark.astro';
import TextSize from './TextSize.astro';
import Settings from './Settings.astro';

interface Props {
  locale: Locale;
  switchTo?: string;
}
const { locale, switchTo } = Astro.props;
const other: Locale = locale === 'en' ? 'zh-TW' : 'en';
const path = Astro.url.pathname;
const items = nav.map((item) => {
  const url = href(item.path, locale);
  return { url, label: item.label[locale], current: path === url || path.startsWith(url) };
});
---

<header class="site-header">
  <div class="container site-header__bar">
    <Wordmark locale={locale} />

    <nav class="site-nav" aria-label={ui.primaryNav[locale]}>
      <ul>
        {items.map((i) => (
          <li>
            <a href={i.url} aria-current={i.current ? 'page' : undefined}>{i.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__tools">
      <TextSize locale={locale} />
      <a class="tool lang-switch" data-lang-switch href={switchTo ?? switchLocalePath(path, other)} lang={htmlLang[other]} hreflang={htmlLang[other]} title={ui.switchLanguageHint[locale]}>
        <span class="lang-switch__short" aria-hidden="true">{ui.switchLanguageShort[locale]}</span>
        <span class="lang-switch__long">{ui.switchLanguage[locale]}</span>
      </a>
      <details class="menu" data-menu>
        <summary class="tool menu__btn">
          <span class="menu__icon menu__open"><Icon name="menu" size="24px" /></span>
          <span class="menu__icon menu__close"><Icon name="close" size="24px" /></span>
          <span class="menu__word">{ui.menu[locale]}</span>
        </summary>
        <div class="menu__panel">
          <nav class="menu__nav" aria-label={ui.primaryNav[locale]}>
            <ul>
              {items.map((i) => (
                <li>
                  <a href={i.url} aria-current={i.current ? 'page' : undefined}>{i.label}</a>
                </li>
              ))}
            </ul>
          </nav>
          <Settings locale={locale} />
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background: var(--bg);
    border-block-end: 1px solid var(--line);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    gap: 8px;
    block-size: var(--header-h);
  }
  /* px inside the header: see the note at the top of this file */
  .site-header :global(.wordmark) {
    min-block-size: 48px;
    gap: 8px;
  }
  .site-header :global(.mark) {
    inline-size: 24px;
    block-size: 24px;
  }
  .site-header :global(.wordmark__name) {
    font-size: 19px;
  }
  .site-header :global(.wordmark__name:lang(en)) {
    font-size: 21px;
  }
  .site-header :global(.wordmark__alt) {
    font-size: 14px;
    padding-inline-start: 8px;
  }
  .site-header__tools {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-inline-start: auto;
  }
  /* A header control is a 48 px square to the finger and a 38 px outlined button to the eye. */
  .site-header :global(.tool) {
    position: relative;
    font-size: 16px;
    line-height: 1;
  }
  .site-header :global(.tool)::before {
    content: '';
    position: absolute;
    inset: 5px 0;
    border: 1.5px solid var(--line-strong);
    border-radius: 6px;
    pointer-events: none;
  }
  .site-header :global(.tool:hover) {
    background: none;
  }
  .site-header :global(.tool:hover)::before {
    background: var(--bg-sunken);
    z-index: -1;
  }
  .site-header :global(.tool:focus-visible) {
    outline-offset: -3px;
  }

  /* Inline nav: wide screens only */
  .site-nav {
    display: none;
    margin-inline-start: auto;
  }
  .site-nav ul {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    block-size: var(--header-h);
    min-inline-size: 48px;
    justify-content: center;
    padding-inline: 8px;
    color: var(--ink);
    font-size: 16px;
    font-weight: var(--fw-medium);
    text-decoration: none;
    white-space: nowrap;
    /* painted underline, like a lane edge */
    box-shadow: inset 0 0 0 transparent;
    transition: box-shadow var(--dur-1) var(--ease-out);
  }
  .site-nav a:hover {
    color: var(--ink);
    box-shadow: inset 0 -3px 0 var(--line-strong);
  }
  .site-nav a[aria-current='page'] {
    font-weight: var(--fw-bold);
    box-shadow: inset 0 -3px 0 var(--ink);
  }

  .lang-switch {
    font-stretch: 90%;
  }
  /* Narrow: short visible label, full label for assistive tech */
  .lang-switch__long {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* The menu */
  .menu {
    position: static;
  }
  .menu__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    list-style: none;
  }
  .menu__btn::-webkit-details-marker {
    display: none;
  }
  .menu__icon {
    display: grid;
  }
  .menu:not([open]) .menu__close,
  .menu[open] .menu__open {
    display: none;
  }
  /* the word 選單 beside the icon wherever there is room for it; always there for a screen reader */
  .menu__word {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .menu__panel {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 100%;
    max-block-size: calc(100vh - var(--header-h));
    max-block-size: calc(100dvh - var(--header-h));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 var(--gutter) var(--sp-4);
    background: var(--bg);
    border-block-end: var(--rule-stop) solid var(--ink);
  }
  .menu__nav ul {
    margin: 0;
    padding: var(--sp-2) 0 0;
    list-style: none;
  }
  /* each link is a 48 px target; the 4 px above and below keep two links 8 px apart */
  .menu__nav li {
    padding-block: 4px;
    border-block-end: 1px solid var(--line);
  }
  .menu__nav a {
    display: flex;
    align-items: center;
    min-block-size: var(--tap);
    color: var(--ink);
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
    line-height: 1.3;
    text-decoration: none;
  }
  .menu__nav a[aria-current='page']::before {
    content: '';
    flex: none;
    inline-size: 0.75rem;
    block-size: 0.75rem;
    margin-inline-end: 0.75rem;
    background: var(--clean);
    border-radius: 50%;
  }

  @media (min-width: 25em) {
    .menu__btn {
      padding-inline: 10px 12px;
    }
    .menu__word {
      position: static;
      inline-size: auto;
      block-size: auto;
      clip-path: none;
      font-size: 16px;
    }
  }
  @media (min-width: 62em) {
    .site-header__bar {
      position: relative;
      gap: 16px;
    }
    .site-nav {
      display: block;
    }
    .site-header__tools {
      margin-inline-start: 0;
    }
    .lang-switch__short {
      display: none;
    }
    .lang-switch__long {
      position: static;
      inline-size: auto;
      block-size: auto;
      clip-path: none;
    }
    /* the five items are inline, so the menu holds the settings only */
    .menu__nav {
      display: none;
    }
    .menu__panel {
      inset-inline: auto 0;
      inline-size: 22rem;
      padding-block-start: var(--sp-2);
      border: 2px solid var(--ink);
      border-block-start: 0;
      border-radius: 0 0 var(--radius-3) var(--radius-3);
    }
    :global(html:not(.js)) .menu {
      display: none; /* nothing in it without scripting */
    }
  }
  @media (forced-colors: active) {
    .site-header :global(.tool) {
      border: 0;
    }
    .site-header :global(.tool)::before {
      border-color: ButtonText;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-menu]').forEach((menu) => {
    const summary = menu.querySelector('summary');
    const close = (focus = false) => {
      if (!menu.open) return;
      menu.open = false;
      if (focus) summary?.focus();
    };
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close(true);
    });
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node)) close();
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => close()));
    // the panel covers the page: close it when keyboard focus leaves it, so focus never lands on
    // a control hidden underneath (WCAG 2.4.11)
    menu.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (next && !menu.contains(next)) close();
    });
  });

  // Language switches (header and footer) keep the reader's place: both languages use the same
  // anchors, so carry the current #fragment over to the other language's URL.
  const syncLangSwitch = () =>
    document.querySelectorAll<HTMLAnchorElement>('a[data-lang-switch]').forEach((a) => {
      const u = new URL(a.href, location.href);
      u.hash = location.hash;
      a.href = u.href;
    });
  syncLangSwitch();
  window.addEventListener('hashchange', syncLangSwitch);
  document.addEventListener('click', (e) => (e.target as Element | null)?.closest?.('a[data-lang-switch]') && syncLangSwitch(), true);
</script>
