---
/**
 * Footer — zebra strip, wordmark + tagline, nav (the primary items plus the
 * footer-only ones: 資料來源, 關於, 修改紀錄), "about this data" line and a
 * credits slot.
 *
 * Props
 *   locale  Locale
 * Slots
 *   credits  optional credits / partner line (plain inline content)
 */
import { href, htmlLang, switchLocalePath, type Locale } from '@/i18n';
import { footerNav, nav, site, ui } from '@/i18n/ui';
import Wordmark from './Wordmark.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const other: Locale = locale === 'en' ? 'zh-TW' : 'en';
const hasCredits = Astro.slots.has('credits');
---

<footer class="site-footer">
  <div class="zebra" aria-hidden="true"></div>
  <div class="tone-inverse site-footer__body">
    <div class="container site-footer__grid">
      <div class="site-footer__brand">
        <Wordmark locale={locale} />
        <p class="site-footer__tagline">{site.tagline[locale]}</p>
      </div>

      <nav class="site-footer__nav" aria-label={ui.footerNav[locale]}>
        <ul>
          <li><a href={href('/', locale)}>{ui.home[locale]}</a></li>
          {[...nav, ...footerNav].map((item) => (
            <li><a href={href(item.path, locale)}>{item.label[locale]}</a></li>
          ))}
        </ul>
      </nav>

      <div class="site-footer__data">
        <h2 class="eyebrow">{ui.aboutDataTitle[locale]}</h2>
        <p>
          {ui.aboutData[locale]}{' '}
          <a href={href('/sources/', locale)}>{ui.sources[locale]}</a>
        </p>
        {hasCredits && (
          <p class="site-footer__credits">
            <span class="vh">{ui.credits[locale]}: </span>
            <slot name="credits" />
          </p>
        )}
      </div>
    </div>
    <div class="container site-footer__base">
      <a href={switchLocalePath(Astro.url.pathname, other)} lang={htmlLang[other]} hreflang={htmlLang[other]}>{ui.switchLanguage[locale]}</a>
      <a href="#top">{ui.backToTop[locale]}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--section-y);
  }
  .site-footer__body {
    padding-block: var(--sp-7) var(--sp-5);
  }
  .site-footer__grid {
    display: grid;
    gap: var(--sp-6);
  }
  .site-footer__tagline {
    margin-block-start: var(--sp-2);
    color: var(--ink-2);
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
  }
  .site-footer__nav ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--sp-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer__nav a {
    display: flex;
    align-items: center;
    min-block-size: var(--tap);
    color: var(--ink);
    font-weight: var(--fw-medium);
    text-decoration: none;
  }
  .site-footer__nav a:hover {
    text-decoration: underline;
  }
  .site-footer__data {
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--ink-2);
  }
  .site-footer__data p {
    margin-block-start: var(--sp-3);
    max-inline-size: 30em;
  }
  .site-footer__credits {
    color: var(--ink-3);
  }
  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-3) var(--sp-5);
    margin-block-start: var(--sp-7);
    padding-block-start: var(--sp-4);
    border-block-start: 1px solid var(--line);
    font-size: var(--fs-sm);
  }
  .site-footer__base a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap);
  }
  @media (min-width: 48em) {
    .site-footer__grid {
      grid-template-columns: 1.1fr 1fr 1.3fr;
      gap: var(--sp-7);
    }
  }
</style>
