---
/**
 * Settings — the reader's settings inside the menu: 文字大小 (標準 / 大 / 特大), 動畫 (開 / 關)
 * and 深色 (開 / 關). Placed by Header.astro; pages never place it.
 *
 * - Text size: three named buttons; the pressed one is the current size (brief 6.4).
 * - Animation: one switch stops the gentle, continuous motion and every arrival animation
 *   (brief 5.3). It starts off when the system asks for reduced motion.
 * - Each switch says its state in words (開 / 關) and by the knob's position, never by colour alone.
 *
 * Hidden without JavaScript (the page then follows the system's own settings).
 *
 * Props
 *   locale  Locale
 */
import type { Locale } from '@/i18n';
import { settings, t as fill } from '@/i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const sizes = ['md', 'lg', 'xl'] as const;
---

<section class="settings" data-js-only aria-label={settings.heading[locale]}>
  <div class="settings__row">
    <p class="settings__label" id="settings-text">{settings.textSize[locale]}</p>
    <div class="settings__sizes" role="group" aria-labelledby="settings-text">
      {sizes.map((s) => (
        <button type="button" class:list={['settings__size', `settings__size--${s}`]} data-text-set={s} aria-pressed={s === 'md' ? 'true' : 'false'} data-say={fill(settings.textSizeNow, locale, { size: settings.textSizes[s][locale] })}>
          {settings.textSizes[s][locale]}
        </button>
      ))}
    </div>
  </div>
  {([['motion', settings.motion[locale], 'true'], ['theme', settings.theme[locale], 'false']] as const).map(([key, label, first]) => (
    <button type="button" class="settings__switch" role="switch" aria-checked={first} {...{ [`data-${key}-toggle`]: '' }}>
      <span class="settings__label">{label}</span>
      <span class="settings__state" aria-hidden="true">
        <span class="settings__on">{settings.on[locale]}</span>
        <span class="settings__off">{settings.off[locale]}</span>
      </span>
      <span class="settings__track" aria-hidden="true"><span class="settings__knob"></span></span>
    </button>
  ))}
  <p class="vh" role="status" aria-live="polite" data-settings-status></p>
</section>

<style>
  .settings {
    display: grid;
    gap: var(--tap-gap);
    padding-block: var(--sp-3);
  }
  .settings__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-4);
  }
  .settings__label {
    margin: 0;
    font-size: var(--fs-btn);
    font-weight: var(--fw-bold);
    line-height: 1.3;
    color: var(--ink);
  }
  .settings__sizes {
    display: flex;
    gap: var(--tap-gap);
  }
  .settings__size {
    min-inline-size: var(--tap);
    min-block-size: var(--tap);
    padding: 0 0.7em;
    border: 2px solid var(--line-strong);
    border-radius: var(--radius-3);
    background: var(--surface);
    color: var(--ink);
    font-weight: var(--fw-bold);
    line-height: 1.2;
    cursor: pointer;
  }
  /* each button shows its own size, in px so the row never outgrows a narrow phone */
  .settings__size--md {
    font-size: 16px;
  }
  .settings__size--lg {
    font-size: 19px;
  }
  .settings__size--xl {
    font-size: 22px;
  }
  .settings__size[aria-pressed='true'] {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--bg);
  }
  .settings__switch {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    inline-size: 100%;
    min-block-size: var(--tap);
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    text-align: start;
    cursor: pointer;
  }
  .settings__state {
    margin-inline-start: auto;
    font-size: var(--fs-btn);
    font-weight: var(--fw-bold);
  }
  .settings__switch[aria-checked='true'] .settings__off,
  .settings__switch[aria-checked='false'] .settings__on {
    display: none;
  }
  .settings__track {
    flex: none;
    display: flex;
    align-items: center;
    inline-size: 3.25rem;
    block-size: 1.875rem;
    padding: 3px;
    border: 2px solid var(--ink);
    border-radius: var(--radius-pill);
    background: var(--surface);
  }
  .settings__knob {
    inline-size: 1.125rem;
    block-size: 1.125rem;
    border-radius: 50%;
    background: var(--ink);
    transition: transform var(--dur-1) var(--ease-out);
  }
  .settings__switch[aria-checked='true'] .settings__track {
    background: var(--ink);
  }
  .settings__switch[aria-checked='true'] .settings__knob {
    background: var(--bg);
    transform: translateX(1.375rem);
  }
  @media (forced-colors: active) {
    .settings__size[aria-pressed='true'],
    .settings__switch[aria-checked='true'] .settings__track {
      forced-color-adjust: none;
      background: Highlight;
      color: HighlightText;
      border-color: Highlight;
    }
    .settings__switch[aria-checked='true'] .settings__knob {
      forced-color-adjust: none;
      background: HighlightText;
    }
    .settings__knob {
      forced-color-adjust: none;
      background: ButtonText;
    }
  }
</style>

<script>
  import './settings.client';
</script>
