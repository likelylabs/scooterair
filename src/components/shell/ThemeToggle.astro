---
/**
 * ThemeToggle — a stand-alone light/dark icon button. The header no longer places it: the
 * theme switch lives in the menu with the other reader settings (Settings.astro). Kept for
 * pages that want the button on its own (the print sheets' screen view).
 * Hidden without JavaScript (the page then simply follows prefers-color-scheme). The choice is
 * stored in localStorage under `sa-theme` and applied before first paint by the inline script
 * in Base.astro, so there is no flash.
 *
 * Props
 *   locale  Locale
 */
import type { Locale } from '@/i18n';
import { ui } from '@/i18n/ui';
import Icon from '@/components/ui/Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

{/* A toggle button: its name says what it is ("深色模式" / "Dark theme") and aria-pressed says
    whether it is on, so a screen reader hears the current theme and the result of pressing it. */}
<button class="theme-toggle" type="button" data-theme-toggle data-js-only aria-label={ui.themeDarkToggle[locale]} aria-pressed="false" title={ui.themeToggle[locale]}>
  <span class="theme-toggle__sun"><Icon name="sun" size="1.25rem" /></span>
  <span class="theme-toggle__moon"><Icon name="moon" size="1.25rem" /></span>
</button>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    inline-size: var(--tap);
    block-size: var(--tap);
    padding: 0;
    border: 0;
    border-radius: var(--radius-2);
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: var(--bg-sunken);
  }
  .theme-toggle span {
    grid-area: 1 / 1;
    display: grid;
  }
  /* Show the icon of the theme you would switch TO. */
  .theme-toggle__sun {
    display: none !important;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle__sun {
      display: grid !important;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle__moon {
      display: none;
    }
  }
  :global(:root[data-theme='dark']) .theme-toggle__sun {
    display: grid !important;
  }
  :global(:root[data-theme='dark']) .theme-toggle__moon {
    display: none;
  }
</style>

<script>
  // all three reader settings share one script (it also keeps this button's aria-pressed right)
  import './settings.client';
</script>
