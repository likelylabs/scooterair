---
/**
 * Figure — the frame every chart, table and infographic sits in.
 * Order is fixed: number + title (says the finding, not the topic) →
 * subtitle (what is plotted, with units) → body → caption → source line.
 * There is no card: a painted rule on top, the page behind.
 *
 * Props
 *   locale    Locale
 *   title     the takeaway, as a sentence; '|' phrase marks allowed
 *   subtitle  what is measured and in what unit
 *   number    figure number shown before the title ("1" → "圖 1" / "Fig. 1")
 *   caption   how to read it / caveats (or use the `caption` slot)
 *   source    plain source text (or use the `source` slot for <Cite> chips)
 *   sample    true = demo numbers: tag in the head AND a line in the footer
 *   id        anchor id
 *   level     heading level for the title (default 3)
 *   frame     'rule' (default) | 'none' (for illustrations)
 *   tone      colour of the top rule: 'ink' | 'exhaust' | 'clean' | 'signal'
 *   badge     EvidenceKind (or several) shown at the start of the source line
 *   secondary true = the figure rests on a secondary-confidence fact: adds 次級來源
 *   empty     the empty-data state (V8): nobody has measured what this figure
 *             would show. The 沒人量過 badge stands where the source line goes,
 *             the caption defaults to "this is not a layout error…", and `who`
 *             says who could measure it. Put an <EmptyChart> in the body.
 *   who       (with `empty`) who could fill the gap, as text
 * Slots
 *   default  the chart / table / art
 *   caption  rich caption
 *   source   rich source line, e.g. <Cite variant="chip" … />
 *   who      (with `empty`) rich "who could measure it" line, e.g. with the ask link
 */
import type { Locale } from '@/i18n';
import { emptyData, ui, type EvidenceKind } from '@/i18n/ui';
import EvidenceBadge from './EvidenceBadge.astro';
import Phrased from './Phrased.astro';
import Tag from './Tag.astro';
import { uid as makeId } from '@/components/uid';

interface Props {
  locale: Locale;
  title: string;
  subtitle?: string;
  number?: string | number;
  caption?: string;
  source?: string;
  sample?: boolean;
  id?: string;
  level?: 2 | 3 | 4;
  frame?: 'rule' | 'none';
  tone?: 'ink' | 'exhaust' | 'clean' | 'signal';
  badge?: EvidenceKind | EvidenceKind[];
  secondary?: boolean;
  empty?: boolean;
  who?: string;
  class?: string;
}
const { locale, title, subtitle, number, source, sample = false, id, level = 3, frame = 'rule', tone = 'ink', badge, secondary = false, empty = false, who, class: cls } = Astro.props;
const caption = Astro.props.caption ?? (empty ? emptyData.caption[locale] : undefined);
const badges = badge ? (Array.isArray(badge) ? badge : [badge]) : [];
const hasWho = empty && (Boolean(who) || Astro.slots.has('who'));
const H = `h${level}` as 'h2' | 'h3' | 'h4';
const uid = id ?? makeId('fig');
const hasCaption = caption || Astro.slots.has('caption');
const hasSource = source || Astro.slots.has('source') || badges.length > 0;
---

<figure id={id} class:list={['fig', `fig--${frame}`, `fig--${tone}`, empty && 'fig--empty', cls]} aria-labelledby={`${uid}-t`}>
  <header class="fig__head">
    {(number !== undefined || sample) && (
      <p class="fig__meta">
        {number !== undefined && <span class="fig__num">{ui.figure[locale]} {number}</span>}
        {sample && <Tag tone="sample">{ui.sampleData[locale]}</Tag>}
      </p>
    )}
    <H id={`${uid}-t`} class="fig__title"><Phrased text={title} /></H>
    {subtitle && <p class="fig__sub">{subtitle}</p>}
  </header>
  <div class="fig__body"><slot /></div>
  {(hasCaption || hasSource || sample || empty) && (
    <figcaption class="fig__foot">
      {hasCaption && <p class="fig__caption"><slot name="caption">{caption}</slot></p>}
      {sample && <p class="fig__sample">{ui.sampleDataLong[locale]}</p>}
      {empty ? (
        <Fragment>
          <p class="fig__source fig__source--empty">
            <span class="fig__source-label">{ui.source[locale]}</span>
            <EvidenceBadge kind="gap" locale={locale} />
            <span>{emptyData.none[locale]}</span>
          </p>
          {hasWho && (
            <p class="fig__who">
              <span class="fig__source-label">{emptyData.who[locale]}</span>
              <span><slot name="who">{who}</slot></span>
            </p>
          )}
        </Fragment>
      ) : (
        hasSource && (
          <p class="fig__source">
            <span class="fig__source-label">{ui.source[locale]}</span>
            {badges.map((b, i) => <EvidenceBadge kind={b} locale={locale} secondary={secondary && i === badges.length - 1} />)}
            <slot name="source">{source}</slot>
          </p>
        )
      )}
    </figcaption>
  )}
</figure>

<style>
  .fig {
    --fig-rule: var(--ink);
    display: grid;
    gap: var(--sp-4);
    min-inline-size: 0;
  }
  .fig--exhaust {
    --fig-rule: var(--exhaust);
  }
  .fig--clean {
    --fig-rule: var(--clean);
  }
  .fig--signal {
    --fig-rule: var(--signal-red);
  }
  .fig--rule {
    padding-block-start: var(--sp-3);
    border-block-start: var(--rule-paint) solid var(--fig-rule);
  }
  .fig__head {
    display: grid;
    gap: var(--sp-1);
    max-inline-size: 40rem;
  }
  .fig__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    margin-block-end: var(--sp-1);
  }
  .fig__num {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .fig__num:lang(en) {
    text-transform: uppercase;
  }
  .fig__title {
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
    font-stretch: 100%;
    line-height: var(--lh-snug);
    letter-spacing: 0;
  }
  @media (min-width: 48em) {
    .fig__title {
      font-size: var(--fs-lg);
    }
  }
  .fig__sub {
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--ink-2);
  }
  .fig__body {
    min-inline-size: 0;
  }
  .fig__foot {
    display: grid;
    gap: var(--sp-2);
    padding-block-start: var(--sp-3);
    border-block-start: 1px solid var(--line);
    font-size: var(--fs-xs);
    line-height: var(--lh-snug);
    color: var(--ink-3);
  }
  .fig__caption {
    max-inline-size: 44rem;
    color: var(--ink-2);
  }
  .fig__sample {
    font-weight: var(--fw-bold);
    color: var(--ink);
  }
  .fig__source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1) var(--sp-2);
  }
  .fig__source-label {
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
  }
  .fig__source-label:lang(en) {
    text-transform: uppercase;
  }
  /* empty-data state: the footer is where the absence is stated, so it reads at full strength */
  .fig--empty .fig__caption {
    color: var(--ink);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
  }
  .fig__source--empty,
  .fig__who {
    color: var(--ink-2);
  }
  .fig__who {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-1) var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--ink);
  }
  .fig__who .fig__source-label {
    font-size: var(--fs-xs);
    color: var(--ink-2);
  }
</style>
