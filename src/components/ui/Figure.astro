---
/**
 * Figure — the frame every chart, table and infographic sits in.
 * Order is fixed: number + title (says the finding, not the topic) →
 * subtitle (what is plotted, with units) → body → caption → source line.
 * There is no card: a painted rule on top, the page behind.
 *
 * Props
 *   locale    Locale
 *   title     the takeaway, as a sentence; '|' phrase marks allowed
 *   subtitle  what is measured and in what unit
 *   number    figure number shown before the title ("1" → "圖 1" / "Fig. 1")
 *   caption   how to read it / caveats (or use the `caption` slot)
 *   source    plain source text (or use the `source` slot for <Cite> chips)
 *   sample    true = demo numbers: tag in the head AND a line in the footer
 *   id        anchor id
 *   level     heading level for the title (default 3)
 *   frame     'rule' (default) | 'none' (for illustrations)
 *   tone      colour of the top rule: 'ink' | 'exhaust' | 'clean' | 'signal'
 *   badge     EvidenceKind (or several) shown at the start of the source line
 *   secondary true = the figure rests on a secondary-confidence fact: adds the registry's
 *             secondary-confidence tag (evidence.secondary in ui.ts)
 *   empty, who   @deprecated and ignored. There is no empty-data state any more (brief 5.4):
 *             a figure always shows a value, and a pollutant with no publishable estimate
 *             gets a sentence, not an empty chart. The props are still accepted so pages that
 *             have not been rebuilt keep building; remove them from your page.
 * Slots
 *   default  the chart / table / art
 *   caption  rich caption
 *   source   rich source line, e.g. <Cite variant="chip" … />
 */
import type { Locale } from '@/i18n';
import { langHtml, typeset, ui, type EvidenceKind } from '@/i18n/ui';
import EvidenceBadge from './EvidenceBadge.astro';
import Phrased from './Phrased.astro';
import Tag from './Tag.astro';
import { uid as makeId } from '@/components/uid';

interface Props {
  locale: Locale;
  title: string;
  subtitle?: string;
  number?: string | number;
  caption?: string;
  source?: string;
  sample?: boolean;
  id?: string;
  level?: 2 | 3 | 4;
  frame?: 'rule' | 'none';
  tone?: 'ink' | 'exhaust' | 'clean' | 'signal';
  badge?: EvidenceKind | EvidenceKind[];
  secondary?: boolean;
  /** @deprecated ignored */
  empty?: boolean;
  /** @deprecated ignored */
  who?: string;
  class?: string;
}
const { locale, number, sample = false, id, level = 3, frame = 'rule', tone = 'ink', badge, secondary = false, class: cls } = Astro.props;
// plain-text props get the site's typography convention (Han–Latin spacing, ranges, minus: see ui.ts)
const ts = (s: string | undefined) => (s === undefined ? s : typeset(s, locale));
const title = ts(Astro.props.title) ?? '';
const subtitle = ts(Astro.props.subtitle);
const source = ts(Astro.props.source);
const caption = ts(Astro.props.caption);
const badges = badge ? (Array.isArray(badge) ? badge : [badge]) : [];
const H = `h${level}` as 'h2' | 'h3' | 'h4';
const uid = id ?? makeId('fig');
const hasCaption = caption || Astro.slots.has('caption');
const hasSource = source || Astro.slots.has('source') || badges.length > 0;
---

<figure id={id} class:list={['fig', `fig--${frame}`, `fig--${tone}`, cls]} aria-labelledby={`${uid}-t`}>
  <header class="fig__head">
    {(number !== undefined || sample) && (
      <p class="fig__meta">
        {number !== undefined && <span class="fig__num">{typeset(`${ui.figure[locale]} ${number}`, locale)}</span>}
        {sample && <Tag tone="sample">{ui.sampleData[locale]}</Tag>}
      </p>
    )}
    <H id={`${uid}-t`} class="fig__title"><Phrased text={title} locale={locale} /></H>
    {subtitle && <p class="fig__sub" set:html={langHtml(subtitle, locale)} />}
  </header>
  <div class="fig__body"><slot /></div>
  {(hasCaption || hasSource || sample) && (
    <figcaption class="fig__foot">
      {hasCaption && <p class="fig__caption"><slot name="caption">{caption && <Fragment set:html={langHtml(caption, locale)} />}</slot></p>}
      {sample && <p class="fig__sample">{ui.sampleDataLong[locale]}</p>}
      {hasSource && (
        <p class="fig__source">
          <span class="fig__source-label">{ui.source[locale]}</span>
          {badges.map((b, i) => <EvidenceBadge kind={b} locale={locale} secondary={secondary && i === badges.length - 1} />)}
          <slot name="source">{source && <Fragment set:html={langHtml(source, locale)} />}</slot>
        </p>
      )}
    </figcaption>
  )}
</figure>

<style>
  .fig {
    --fig-rule: var(--ink);
    display: grid;
    gap: var(--sp-4);
    min-inline-size: 0;
  }
  .fig--exhaust {
    --fig-rule: var(--exhaust);
  }
  .fig--clean {
    --fig-rule: var(--clean);
  }
  .fig--signal {
    --fig-rule: var(--signal-red);
  }
  .fig--rule {
    padding-block-start: var(--sp-3);
    border-block-start: var(--rule-paint) solid var(--fig-rule);
  }
  .fig__head {
    display: grid;
    gap: var(--sp-1);
    max-inline-size: 40rem;
  }
  .fig__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    margin-block-end: var(--sp-1);
  }
  .fig__num {
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .fig__num:lang(en) {
    text-transform: uppercase;
  }
  .fig__title {
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
    font-stretch: 100%;
    line-height: var(--lh-snug);
    letter-spacing: 0;
  }
  @media (min-width: 48em) {
    .fig__title {
      font-size: var(--fs-lg);
    }
  }
  .fig__sub {
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--ink-2);
  }
  .fig__body {
    min-inline-size: 0;
  }
  .fig__foot {
    display: grid;
    gap: var(--sp-2);
    padding-block-start: var(--sp-3);
    border-block-start: 1px solid var(--line);
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--ink-2);
  }
  .fig__caption {
    max-inline-size: 44rem;
    color: var(--ink-2);
  }
  .fig__sample {
    font-weight: var(--fw-bold);
    color: var(--ink);
  }
  .fig__source {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1) var(--sp-2);
  }
  .fig__source-label {
    font-weight: var(--fw-bold);
    letter-spacing: var(--ls-caps);
  }
  .fig__source-label:lang(en) {
    text-transform: uppercase;
  }
</style>
