---
/**
 * NotClaimedList — 「我們不會說的話」 (V33): statements the site will not make,
 * each struck through and followed by one line of why. Generate `items` from
 * the claims policy on /evidence/#not-claimed:
 *
 *   import { claimRuleList } from '@/data';
 *   const items = claimRuleList.filter((r) => r.kind === 'do-not-claim')
 *     .map((r) => ({ claim: r.rule[locale], why: r.why[locale], instead: r.instead?.[locale] }));
 *
 * The strike is drawn with <s>, and every item starts with a visually hidden
 * 「我們不會說：」, because most screen readers do not announce a strike-through.
 * The struck text keeps full contrast: it has to stay readable to be refused.
 *
 * Props
 *   locale   Locale
 *   items    { claim: string; why: string; instead?: string }[]
 *   label    accessible name of the list (default 「我們不會說的話」)
 *   insteadLabel  label before `instead` (default "我們說的是：" / "What we say instead: ")
 */
import type { Locale } from '@/i18n';
import { board } from '@/i18n/ui';

interface Props {
  locale: Locale;
  items: { claim: string; why: string; instead?: string }[];
  label?: string;
  insteadLabel?: string;
  class?: string;
}
const { locale, items, label = board.notClaimed[locale], class: cls } = Astro.props;
const insteadLabel = Astro.props.insteadLabel ?? (locale === 'en' ? 'What we say instead: ' : '我們說的是：');
---

<ul class:list={['ncl', cls]} aria-label={label}>
  {items.map((it) => (
    <li class="ncl__item">
      <p class="ncl__claim"><span class="vh">{board.notClaimedPrefix[locale]}</span><s>{it.claim}</s></p>
      <p class="ncl__why"><b>{board.why[locale]}</b>{it.why}</p>
      {it.instead && <p class="ncl__instead"><b>{insteadLabel}</b>{it.instead}</p>}
    </li>
  ))}
</ul>

<style>
  .ncl {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    max-inline-size: 44rem;
  }
  .ncl__item {
    display: grid;
    gap: var(--sp-1);
    padding-block: var(--sp-4);
    border-block-start: 1px solid var(--line-strong);
  }
  .ncl__item:last-child {
    border-block-end: 1px solid var(--line-strong);
  }
  .ncl__claim {
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
    line-height: var(--lh-snug);
  }
  .ncl__claim s {
    text-decoration-line: line-through;
    text-decoration-color: var(--signal-red);
    text-decoration-thickness: 0.14em;
  }
  .ncl__why,
  .ncl__instead {
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--ink-2);
  }
  .ncl__instead {
    color: var(--ink);
  }
  @media (forced-colors: active) {
    .ncl__claim s {
      text-decoration-color: CanvasText;
    }
  }
</style>
