---
/**
 * Section — the standard page block: vertical rhythm, a container, and an
 * optional head (eyebrow, title, lead).
 *
 * Props
 *   id       anchor id (also labels the section via its title)
 *   tone     'default' | 'sunken' | 'surface' | 'exhaust' | 'clean' | 'inverse'
 *   width    'page' (default, 76rem) | 'wide' (60rem) | 'prose' (one text column)
 *   eyebrow  short kicker above the title
 *   title    section title; may contain '|' phrase marks (see Phrased)
 *   lead     intro paragraph
 *   level    heading level, 2 (default) or 3
 *   pad      'normal' | 'tight' | 'none'
 *   rule     draw a stop-line rule across the top of the section
 *   fold     the title becomes the summary of a closed <details> holding the lead and the
 *            content: a long reference block a reader opens on purpose. A link to the
 *            section's id (or to anything inside it) opens it. The id then sits on an empty
 *            anchor inside the <details>, not on the <section>: a browser opens a closed
 *            <details> by itself only when the link's target is inside it, so this works
 *            without JavaScript too.
 * Slots
 *   default  the content
 *   head     replaces the generated head entirely
 */
import Phrased from './Phrased.astro';

interface Props {
  id?: string;
  tone?: 'default' | 'sunken' | 'surface' | 'exhaust' | 'clean' | 'inverse';
  width?: 'page' | 'wide' | 'prose';
  eyebrow?: string;
  title?: string;
  lead?: string;
  level?: 2 | 3;
  pad?: 'normal' | 'tight' | 'none';
  rule?: boolean;
  fold?: boolean;
  class?: string;
}
const { id, tone = 'default', width = 'page', eyebrow, title, lead, level = 2, pad = 'normal', rule = false, fold = false, class: cls } = Astro.props;
const H = `h${level}` as 'h2' | 'h3';
const titleId = id && title ? `${id}-title` : undefined;
const container = width === 'page' ? 'container' : `container container--${width}`;
const folded = fold && !!title;
---

<section id={folded ? undefined : id} class:list={['section', `section--pad-${pad}`, tone !== 'default' && `tone-${tone}`, cls]} aria-labelledby={titleId}>
  <div class={container}>
    {rule && <hr class="stopline section__rule" />}
    {fold && title ? (
      <details class="section__fold" data-section-fold>
        <summary class="section__sum">
          <H id={titleId} class="section__title"><Phrased text={title} /></H>
          <svg class="section__chev" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6" /></svg>
        </summary>
        {id && <div id={id} class="section__anchor" data-section-anchor></div>}
        {lead && <p class="lead">{lead}</p>}
        <slot />
      </details>
    ) : Astro.slots.has('head') ? (
      <slot name="head" />
    ) : (
      (eyebrow || title || lead) && (
        <header class="section__head">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {title && <H id={titleId} class="section__title"><Phrased text={title} /></H>}
          {lead && <p class="lead">{lead}</p>}
        </header>
      )
    )}
    {!(fold && title) && <slot />}
  </div>
</section>

<script>
  // A folded section opens when the address (or a link) points at it, at its own heading, or at
  // anything inside it. On a deep link the page above may still grow (the calculator renders its
  // result after load), so the target is kept in view until the reader scrolls or a few seconds pass.
  const openFor = (hash: string, settle = false) => {
    if (!hash || hash === '#') return;
    let el: Element | null = null;
    try {
      el = document.getElementById(decodeURIComponent(hash.slice(1)));
    } catch {
      return;
    }
    if (!el) return;
    const own = el.matches('section') ? el.querySelector<HTMLDetailsElement>(':scope > .container > details[data-section-fold], :scope details[data-section-fold]') : null;
    if (own) own.open = true;
    for (let d = el.closest('details[data-section-fold]'); d; d = d.parentElement?.closest('details[data-section-fold]') ?? null) (d as HTMLDetailsElement).open = true;
    const target = el;
    const go = () => target.scrollIntoView({ behavior: 'instant' as ScrollBehavior, block: 'start' });
    // a target outside any fold is left to the browser, except on arrival: the page above may
    // still grow, so it is kept in view the same way (/electric/#cities below the calculator)
    if (!own && !el.closest('details[data-section-fold]') && !settle) return;
    requestAnimationFrame(go);
    if (!settle) return;
    let stop = false;
    const quit = () => (stop = true);
    for (const ev of ['wheel', 'touchstart', 'keydown', 'mousedown']) addEventListener(ev, quit, { once: true, passive: true });
    const ro = new ResizeObserver(() => !stop && go());
    ro.observe(document.body);
    setTimeout(() => ro.disconnect(), 4000);
  };
  openFor(location.hash, true);
  addEventListener('hashchange', () => openFor(location.hash));
  // printing opens every fold: the shell does it for every page (Header.astro)
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.('a[href*="#"]') as HTMLAnchorElement | null;
    if (a && a.pathname === location.pathname && a.hash) openFor(a.hash);
  });
</script>

<style>
  .section--pad-normal {
    padding-block: var(--section-y);
  }
  .section--pad-tight {
    padding-block: calc(var(--section-y) / 2);
  }
  /* a folded section's anchor lands with the fold's title in view, below the site bar */
  .section__anchor {
    display: block;
    scroll-margin-block-start: calc(var(--header-h, 3.5rem) + 5.5rem);
  }
  .section__rule {
    margin-block-end: var(--sp-5);
  }
  .section__head {
    display: grid;
    gap: var(--sp-3);
    margin-block-end: var(--sp-6);
    max-inline-size: 46rem;
  }
  .section__head .lead {
    margin-block-start: var(--sp-1);
  }
  .section__fold > .section__sum {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3, 0.75rem);
    min-height: var(--tap, 3rem);
    cursor: pointer;
    list-style: none;
  }
  .section__fold > .section__sum::-webkit-details-marker {
    display: none;
  }
  .section__fold > .section__sum .section__title {
    margin: 0;
  }
  .section__chev {
    flex: none;
    transition: transform 0.2s;
  }
  .section__fold[open] .section__chev {
    transform: rotate(180deg);
  }
  .section__fold[open] > .section__sum {
    margin-block-end: var(--sp-4, 1rem);
  }
</style>
