---
/**
 * EvidenceChain — the whole argument at a glance: every link in order on one
 * vertical rail (it reads the same on a phone and on a desktop), each with
 * its evidence badge(s) and citations, drawn in the line style of its evidence.
 *
 * Two endings
 *   - the classic chain: the last link is "the link you can break", in green
 *     (pass seven `links`, or <ChainLink final> children);
 *   - the chain board (V15): pass `question` and the chain ends in an OPEN link —
 *     the rail breaks, the question wears 沒人量過 — followed by the `reveal`
 *     slot, a native <details> that is closed by default and wears 我們的推論,
 *     the weakest badge on the page. The reader meets the facts and the open
 *     question before any conclusion.
 *
 * Two ways to fill it:
 *  1. Data: pass `links` and the component renders the items.
 *  2. Composition: put <ChainLink> children in the default slot.
 *
 * Props
 *   locale    Locale
 *   label     accessible name for the list (default "證據鏈 / Evidence chain")
 *   current   highlight link n as "you are here"
 *   links     { title?: string; body?: string; strength?: EvidenceKind | EvidenceKind[];
 *               secondary?: boolean; line?: EvidenceLine; href?: string;
 *               cites?: { id: string; n: number | string }[] }[]
 *             title defaults to chain.links[i]
 *   question  the open final link, as text ("所以，這 90 秒裡，站在旁邊的人吸進了什麼？")
 *   collapseSources  put each link's citations behind 「看來源」 (the home board);
 *                    leave false on /evidence/, where everything is expanded
 *   revealLabel  the reveal's button text (default 「看我們怎麼接」)
 *   revealOpen   start the reveal open (/evidence/ only; the home page keeps it closed)
 * Slots
 *   default  <ChainLink> children (when `links` is not used)
 *   action   with `links` and no `question`: the call to action inside the final link
 *   reveal   the site's own inference. Start it with 「我們的推論：」
 *   boxes    always-open boxes beside the reveal: <StanceBox kind="not-saying"> and
 *            <StanceBox kind="change-mind">
 */
import type { Locale } from '@/i18n';
import { board, chain, type EvidenceLevel, type EvidenceLine } from '@/i18n/ui';
import ChainLink from './ChainLink.astro';
import Cite from './Cite.astro';
import EvidenceBadge from './EvidenceBadge.astro';
import Icon from './Icon.astro';

interface LinkData {
  title?: string;
  body?: string;
  strength?: EvidenceLevel | EvidenceLevel[];
  secondary?: boolean;
  line?: EvidenceLine;
  href?: string;
  cites?: { id: string; n: number | string }[];
}
interface Props {
  locale: Locale;
  label?: string;
  current?: number;
  links?: LinkData[];
  question?: string;
  collapseSources?: boolean;
  revealLabel?: string;
  revealOpen?: boolean;
  class?: string;
}
const { locale, label = chain.name[locale], current, links, question, collapseSources = false, revealLabel = board.reveal[locale], revealOpen = false, class: cls } = Astro.props;
const hasReveal = Astro.slots.has('reveal');
const hasBoxes = Astro.slots.has('boxes');
---

<div class:list={['chainboard', cls]}>
  <ol class="chain" aria-label={label}>
    {links
      ? links.map((l, i) => (
          <ChainLink locale={locale} n={i + 1} title={l.title} strength={l.strength} secondary={l.secondary} line={l.line} href={l.href} final={!question && i === links.length - 1} current={current === i + 1} collapseSources={collapseSources}>
            {l.body && <p>{l.body}</p>}
            {l.cites?.length ? (
              <Fragment slot="cites">
                {l.cites.map((c) => <Cite locale={locale} id={c.id} n={c.n} variant="chip" />)}
              </Fragment>
            ) : null}
            {!question && i === links.length - 1 && Astro.slots.has('action') ? <slot name="action" slot="action" /> : null}
          </ChainLink>
        ))
      : <slot />}
    {question && <ChainLink locale={locale} n={(links?.length ?? 0) + 1} title={question} open />}
  </ol>
  {(hasReveal || hasBoxes) && (
    <div class="chainboard__after">
      {hasReveal && (
        <details class="reveal" open={revealOpen}>
          <summary>
            <span class="reveal__btn">{revealLabel}<Icon name="chevron-down" size="1.2rem" /></span>
            <EvidenceBadge kind="inference" locale={locale} />
          </summary>
          <div class="reveal__body"><slot name="reveal" /></div>
        </details>
      )}
      {hasBoxes && <div class="chainboard__boxes"><slot name="boxes" /></div>}
    </div>
  )}
</div>

<style>
  .chainboard {
    display: grid;
    gap: var(--sp-6);
    min-inline-size: 0;
  }
  .chain {
    margin: 0;
    padding: 0;
    list-style: none;
    max-inline-size: 44rem;
  }
  .chainboard__after {
    display: grid;
    gap: var(--sp-6);
    align-items: start;
  }
  /* the reveal: closed by default, drawn in the dashed line of an inference */
  .reveal {
    max-inline-size: 44rem;
  }
  .reveal > summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-3);
    list-style: none;
    cursor: pointer;
  }
  .reveal > summary::-webkit-details-marker {
    display: none;
  }
  .reveal__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-block-size: 3.25rem;
    padding: 0 var(--sp-5);
    border: 2px solid var(--ink);
    border-radius: var(--radius-2);
    background: var(--surface);
    font-weight: var(--fw-bold);
  }
  .reveal > summary:hover .reveal__btn {
    background: var(--ink);
    color: var(--bg);
  }
  .reveal > summary:focus-visible {
    outline: none;
  }
  .reveal > summary:focus-visible .reveal__btn {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .reveal[open] .reveal__btn :global(svg) {
    transform: rotate(180deg);
  }
  .reveal__body {
    margin-block-start: var(--sp-4);
    padding: var(--sp-4);
    border: 3px dashed var(--ink);
    font-size: var(--fs-base);
    line-height: var(--lh-body);
  }
  .reveal__body > :global(* + *) {
    margin-block-start: 0.8em;
  }
  .chainboard__boxes {
    display: grid;
    gap: var(--sp-5);
    align-items: start;
  }
  @media (min-width: 56em) {
    .chainboard__boxes {
      grid-template-columns: repeat(2, minmax(0, var(--measure)));
      gap: var(--sp-6);
    }
  }
</style>
