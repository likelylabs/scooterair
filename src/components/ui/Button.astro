---
/**
 * Button — a button, or a link that looks like one when `href` is set.
 * The primary action is signal green: go.
 *
 * Props
 *   href      render an <a> (pass internal paths through href())
 *   variant   'primary' (green, one per view) | 'secondary' (outlined) | 'ghost' (text + arrow)
 *   size      'md' (default, 44px) | 'lg' (52px)
 *   arrow     trailing arrow (default: true for ghost, false otherwise)
 *   external  link leaves the site: adds rel, target and an "opens in new tab" hint
 *   locale    Locale (only needed with `external`)
 *   type      'button' | 'submit' (when rendering a <button>)
 * Any other attribute (id, disabled, data-*) is passed through.
 */
import type { Locale } from '@/i18n';
import { ui } from '@/i18n/ui';
import Icon from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  arrow?: boolean;
  external?: boolean;
  locale?: Locale;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'md', arrow = variant === 'ghost', external = false, locale = 'zh-TW', type = 'button', class: cls, ...rest } = Astro.props;
const classes = ['btn', `btn--${variant}`, `btn--${size}`, cls];
---

{href ? (
  <a class:list={classes} href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} {...rest}>
    <span><slot /></span>
    {external ? <Icon name="arrow-up-right" size="1.1em" /> : arrow && <Icon name="arrow-right" size="1.1em" />}
    {external && <span class="vh">{ui.externalLink[locale]}</span>}
  </a>
) : (
  <button class:list={classes} type={type} {...rest}>
    <span><slot /></span>
    {arrow && <Icon name="arrow-right" size="1.1em" />}
  </button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-block-size: var(--tap);
    padding: 0.5em 1.15em;
    border: 2px solid transparent;
    border-radius: var(--radius-2);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }
  .btn--lg {
    min-block-size: 3.25rem;
    padding-inline: 1.5em;
    font-size: var(--fs-base);
  }
  .btn--primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
  .btn--primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: var(--on-accent);
  }
  .btn--secondary {
    background: transparent;
    border-color: var(--ink);
    color: var(--ink);
  }
  .btn--secondary:hover {
    background: var(--ink);
    color: var(--bg);
  }
  .btn--ghost {
    padding-inline: 0;
    border-color: transparent;
    background: none;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.25em;
  }
  .btn--ghost:hover {
    color: var(--accent-hover);
    text-decoration-thickness: 0.16em;
  }
  .btn :global(.icon) {
    transition: transform var(--dur-2) var(--ease-out);
  }
  .btn:hover :global(.icon) {
    transform: translateX(0.2em);
  }
  .btn[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
