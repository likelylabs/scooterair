---
/**
 * Chapter — one beat of the red light: a full-bleed unit of the scroll
 * narrative, laid out to the blueprint's phone budget (3.0):
 *
 *   frame (art slot) → kicker with the count → chain marker → headline → deck
 *   → one lead visual → up to three short paragraphs → one caveat → one action
 *   → "all the evidence for this link" → one hand-off line.
 *
 * Nothing in a chapter is pinned. The countdown rail (<CountdownRail>, once per
 * page) reads each chapter's data-rail-* attributes and shows where the reader is.
 *
 * Props
 *   locale     Locale
 *   id         anchor id (required). Convention: 'top', 'brief', 'link-1' … 'link-7',
 *              'green', 'connect', 'money', 'next' (chain.anchors in ui.ts)
 *   title      headline; '|' phrase marks allowed
 *   kicker     the line above the headline. With `count` it should print the count
 *              ("紅燈 · 剩 64 秒") so it reads without JavaScript; when omitted on a
 *              counted chapter, that text is generated from the count
 *   lead       the deck: about 100 Chinese characters at most
 *   paragraphs body copy as strings (from your copy module): at most three, about
 *              100 characters each (four for link 7). Use the default slot instead
 *              when the body needs markup
 *   link       evidence-chain link 1–7: shows the "link n of 7" marker and sets the
 *              default count from chain.countdown
 *   chainHref  where the marker links to (the chain overview)
 *   phase      'red' | 'green' | 'paused' | 'none' — the signal beside the kicker.
 *              Default: 'red' for links 1–4, 6 and 7, 'paused' for link 5, else 'none'
 *   count      seconds on the countdown while this chapter scrolls past: a number
 *              (held) or [from, to]. Defaults: the link's allocation; [5, 0] for
 *              phase="green". Omit on chapters outside the red light (money, close)
 *   railLabel  name shown on the rail (default: the link's name; 接起來 / 算錢 / 綠燈亮的那一秒
 *              for those chapters; otherwise the title)
 *   haze       true = the hatched "present, amount not measured" band along the
 *              bottom, at the ONE fixed density. It never varies by chapter and never
 *              follows the countdown (blueprint R11). A number is accepted and treated
 *              as true/false. Blueprint: on for links 1–4, 6 and the green beat
 *   hazeKind   'unmeasured' (default) | 'all' | 'fumes' | 'co' | 'ufp'
 *   tone       'street' (page) | 'sunken' | 'night' (asphalt, both themes) | 'clear' (green wash) | 'exhaust'
 *   size       'tall' (default, about a screen) | 'auto' (a short beat)
 *   artPosition 'top' (default: the frame leads, as the blueprint asks) | 'bottom'
 *   caveat     「這一段沒有說的事」: one caveat, as text (or use the `caveat` slot)
 *   action     「你現在可以做的」: one action, as text (or use the `action` slot)
 *   actionBadge  EvidenceKind behind the action (e.g. 'inference' for "stand back")
 *   moreHref   target of 「看這一環的全部證據」 (href('/evidence/#link-3', locale))
 *   handoff    the last line, handing on to the next chapter
 *   budget     false silences the build-time budget warnings (the money chapter)
 * Slots
 *   art      the chapter's one static frame (<StreetScene frame="…" />), full-bleed
 *   visual   the one lead visual (a <Figure>), right after the deck
 *   default  body with markup; wrap running text in <div class="prose">
 *   caveat   rich caveat        action   rich action (links, a share button)
 */
import type { Locale } from '@/i18n';
import { chain, chapterText, rail, t, ui, type EvidenceKind } from '@/i18n/ui';
import Haze from '@/components/art/Haze.astro';
import Signal from '@/components/art/Signal.astro';
import Callout from './Callout.astro';
import ChainMarker from './ChainMarker.astro';
import EvidenceBadge from './EvidenceBadge.astro';
import Icon from './Icon.astro';
import Phrased from './Phrased.astro';

type HazeKind = 'unmeasured' | 'all' | 'fumes' | 'co' | 'ufp';
interface Props {
  locale: Locale;
  id: string;
  title: string;
  kicker?: string;
  lead?: string;
  paragraphs?: string[];
  link?: number;
  chainHref?: string;
  phase?: 'red' | 'green' | 'paused' | 'none';
  count?: number | [number, number];
  railLabel?: string;
  haze?: boolean | number;
  hazeKind?: HazeKind;
  tone?: 'street' | 'sunken' | 'night' | 'clear' | 'exhaust';
  size?: 'tall' | 'auto';
  artPosition?: 'top' | 'bottom';
  caveat?: string;
  action?: string;
  actionBadge?: EvidenceKind;
  moreHref?: string;
  handoff?: string;
  budget?: boolean;
  class?: string;
}
const { locale, id, title, lead, paragraphs = [], link, chainHref, railLabel, hazeKind = 'unmeasured', tone = 'street', size = 'tall', artPosition = 'top', caveat, action, actionBadge, moreHref, handoff, budget = true, class: cls } = Astro.props;

/** The one density the hatched band is ever drawn at (blueprint 3.0). */
const HAZE_DENSITY = 0.5;
const HAZE_HEIGHT = 200;
const hazeOn = Boolean(Astro.props.haze);

const phase = Astro.props.phase ?? (link ? (link === 5 ? 'paused' : 'red') : 'none');
const rawCount = Astro.props.count ?? (link ? chain.countdown.links[link - 1] : phase === 'green' ? chain.countdown.green : undefined);
const count: [number, number] | undefined = rawCount === undefined ? undefined : Array.isArray(rawCount) ? rawCount : [rawCount, rawCount];
const kicker =
  Astro.props.kicker ??
  (count && phase !== 'none'
    ? phase === 'paused'
      ? chain.kickerPaused[locale]
      : phase === 'green'
        ? chain.kickerGreen[locale]
        : link === 7
          ? t(chain.kickerReset, locale, { n: count[0] })
          : t(chain.kickerRed, locale, { n: count[0] })
    : undefined);
const toneClass = { street: '', sunken: 'tone-sunken', night: 'tone-inverse', clear: 'tone-clean', exhaust: 'tone-exhaust' }[tone];
const hasArt = Astro.slots.has('art');
const hasCaveat = Boolean(caveat) || Astro.slots.has('caveat');
const hasAction = Boolean(action) || Astro.slots.has('action');
const label = railLabel ?? (link ? '' : id === chain.anchors.connect ? rail.connect[locale] : id === chain.anchors.money ? rail.money[locale] : phase === 'green' ? rail.green[locale] : title.replaceAll('|', ''));

// Budget check (build time, warnings only): see blueprint 3.0.
if (budget) {
  const zh = locale === 'zh-TW';
  const len = (s: string) => (zh ? [...s].length : Math.round(s.length / 2.6));
  const warn = (msg: string) => console.warn(`[chapter budget] #${id} (${locale}): ${msg}`);
  if (lead && len(lead) > 135) warn(`deck is about ${len(lead)} characters; the budget is about 100.`);
  const max = link === 7 ? 4 : 3;
  if (paragraphs.length > max) warn(`${paragraphs.length} paragraphs; the budget is ${max}.`);
  paragraphs.forEach((p, i) => len(p) > 135 && warn(`paragraph ${i + 1} is about ${len(p)} characters; the budget is about 100.`));
}
---

<section
  id={id}
  class:list={['chapter', `chapter--${size}`, toneClass, hazeOn && 'chapter--haze', cls]}
  aria-labelledby={`${id}-title`}
  style={`--haze-room:${hazeOn ? Math.round(HAZE_HEIGHT * 0.6) : 0}px`}
  data-rail-chapter
  data-link={link}
  data-phase={phase === 'none' ? undefined : phase}
  data-count-from={count?.[0]}
  data-count-to={count?.[1]}
  data-rail-label={label || undefined}
>
  {hasArt && artPosition === 'top' && <div class="chapter__art chapter__art--top"><slot name="art" /></div>}
  <div class="container chapter__inner">
    <header class="chapter__head">
      {(kicker || phase !== 'none') && (
        <p class:list={['eyebrow chapter__kicker', `chapter__kicker--${phase}`]}>
          {(phase === 'red' || phase === 'green') && <Signal state={phase} size="1.9rem" label={phase === 'red' ? ui.phaseRed[locale] : ui.phaseGreen[locale]} />}
          {phase === 'paused' && (
            <svg class="chapter__pause" viewBox="0 0 16 16" width="1.5rem" height="1.5rem" role="img" aria-label={chapterText.paused[locale]}><rect x="3" y="2.5" width="3.6" height="11" /><rect x="9.4" y="2.5" width="3.6" height="11" /></svg>
          )}
          {kicker && <span>{kicker}</span>}
        </p>
      )}
      {link && <ChainMarker locale={locale} n={link} href={chainHref} />}
      <h2 id={`${id}-title`} class="chapter__title"><Phrased text={title} locale={locale} /></h2>
      {lead && <p class="lead">{lead}</p>}
    </header>
    {Astro.slots.has('visual') && <div class="chapter__visual"><slot name="visual" /></div>}
    {paragraphs.length > 0 && <div class="chapter__text prose">{paragraphs.map((p) => <p>{p}</p>)}</div>}
    {Astro.slots.has('default') && <div class="chapter__body"><slot /></div>}
    {(hasCaveat || hasAction) && (
      <div class="chapter__asides">
        {hasCaveat && (
          <Callout tone="exhaust" label={chapterText.caveat[locale]}>
            <slot name="caveat"><p>{caveat}</p></slot>
          </Callout>
        )}
        {hasAction && (
          <Callout tone="clean" label={chapterText.action[locale]}>
            <slot name="action"><p>{action}</p></slot>
            {actionBadge && <p><EvidenceBadge kind={actionBadge} locale={locale} /></p>}
          </Callout>
        )}
      </div>
    )}
    {moreHref && (
      <p class="chapter__more"><a href={moreHref}>{chapterText.more[locale]}<Icon name="arrow-right" size="1.1em" /></a></p>
    )}
    {handoff && (
      <p class="chapter__handoff"><Icon name="arrow-down" size="1.25em" /><span>{handoff}</span></p>
    )}
  </div>
  {hasArt && artPosition === 'bottom' && <div class="chapter__art chapter__art--bottom"><slot name="art" /></div>}
  {hazeOn && <Haze density={HAZE_DENSITY} kind={hazeKind} height={HAZE_HEIGHT} seed={id.length * 7 + 3} animated={false} />}
</section>

<style>
  .chapter {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-block: var(--section-y) calc(var(--section-y) + var(--haze-room));
    overflow: hidden;
    border-block-start: 1px solid var(--line);
  }
  .chapter--tall {
    min-block-size: min(92svh, 56rem);
  }
  .chapter__inner {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--sp-6);
    align-content: start;
    min-inline-size: 0;
  }
  .chapter__inner > * {
    min-inline-size: 0;
  }
  .chapter__head {
    display: grid;
    gap: var(--sp-3);
    max-inline-size: 48rem;
  }
  .chapter__kicker::before {
    display: none;
  }
  .chapter__kicker {
    font-variant-numeric: tabular-nums;
  }
  .chapter__kicker--red {
    color: var(--signal-red-ink);
  }
  .chapter__kicker--green {
    color: var(--clean-ink);
  }
  .chapter__pause {
    flex: none;
    fill: currentColor;
  }
  .chapter__title {
    font-size: var(--fs-3xl);
    font-stretch: var(--display-stretch);
    line-height: calc((var(--lh-heading) + var(--lh-display)) / 2);
  }
  .chapter__asides {
    display: grid;
    gap: var(--sp-5);
    align-items: start;
  }
  @media (min-width: 56em) {
    .chapter__asides {
      grid-template-columns: repeat(2, minmax(0, 31rem));
      gap: var(--sp-6);
    }
    .chapter__asides > :global(.callout) {
      max-inline-size: none;
    }
  }
  .chapter__more a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-block-size: var(--tap);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
  }
  .chapter__handoff {
    display: flex;
    align-items: flex-start;
    gap: 0.5em;
    max-inline-size: var(--measure);
    padding-block-start: var(--sp-4);
    border-block-start: var(--rule-paint) solid var(--ink);
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
    line-height: var(--lh-snug);
  }
  .chapter__handoff :global(svg) {
    flex: none;
    margin-block-start: 0.15em;
  }
  /* the frame: full-bleed, first thing in the chapter on every screen */
  .chapter__art {
    position: relative;
    z-index: 1;
  }
  .chapter__art--top {
    margin-block: calc(var(--section-y) * -1) var(--sp-6);
    border-block-end: 1px solid var(--line);
  }
  .chapter__art--bottom {
    margin-block-start: auto;
    padding-block-start: var(--sp-6);
    margin-block-end: calc((var(--section-y) + var(--haze-room)) * -1);
  }
</style>
