---
/**
 * @deprecated The question index is a grid of picture cards now (brief 5.4). Kept until nothing imports it;
 * delete in phase 3.
 *
 * QuestionChips — questions in the reader's own words (V4), drawn as
 * pedestrian push-buttons: a round "button" and a plate. Each is an ordinary
 * link; two columns at 360px.
 *
 * Props
 *   locale  Locale
 *   items   { label: string; href: string }[] — default: the six chips of the
 *           home page (questions.chips in ui.ts), in blueprint order
 *   all     show the text link to every question (default true)
 *   label   accessible name of the list
 * Slot
 *   after   one line under the chips (the 「請環保局來量我家路口 →」 action link)
 */
import { href, type Locale } from '@/i18n';
import { questions } from '@/i18n/ui';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  items?: { label: string; href: string }[];
  all?: boolean;
  label?: string;
  class?: string;
}
const { locale, all = true, label = questions.label[locale], class: cls } = Astro.props;
const items = Astro.props.items ?? questions.chips.map((c) => ({ label: c.label[locale], href: href(c.path, locale) }));
---

<nav class:list={['chips', cls]} aria-label={label}>
  <ul class="chips__list">
    {items.map((c) => (
      <li>
        <a class="chip" href={c.href}>
          <span class="chip__btn" aria-hidden="true"></span>
          <span class="chip__label">{c.label}</span>
        </a>
      </li>
    ))}
  </ul>
  {all && (
    <p class="chips__all"><a href={href(questions.allPath, locale)}>{questions.all[locale]}<Icon name="arrow-right" size="1.05em" /></a></p>
  )}
  {Astro.slots.has('after') && <p class="chips__after"><slot name="after" /></p>}
</nav>

<style>
  .chips {
    display: grid;
    gap: var(--sp-3);
    max-inline-size: 46rem;
  }
  .chips__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chips__list li {
    display: grid;
  }
  .chip {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--sp-2);
    min-block-size: 3.5rem;
    padding: var(--sp-2) var(--sp-3) var(--sp-2) var(--sp-2);
    border: 2px solid var(--ink);
    border-radius: var(--radius-2);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    line-height: 1.35;
    text-decoration: none;
  }
  /* the push-button: a steel ring around a signal-green cap */
  .chip__btn {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border: 3px solid var(--line-strong);
    border-radius: 50%;
    background: var(--clean);
    box-shadow: inset 0 0 0 2px var(--surface);
  }
  .chip:hover {
    background: var(--clean-wash);
    color: var(--ink);
  }
  .chip:hover .chip__btn,
  .chip:active .chip__btn {
    border-color: var(--ink);
    box-shadow: none;
  }
  .chips__all a,
  .chips__after :global(a) {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-block-size: var(--tap);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
  }
  .chips__all,
  .chips__after {
    margin: 0;
  }
  /* English words are long: below 344px a two-column chip is narrower than "themselves?",
     which then breaks mid-word or leaves the "?" alone on a line. One column there. */
  @media (max-width: 21.5em) {
    .chips__list:lang(en) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (min-width: 40em) {
    .chips__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .chip {
      font-size: var(--fs-base);
    }
  }
</style>
