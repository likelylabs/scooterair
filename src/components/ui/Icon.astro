---
/**
 * Icon — the site's small line-icon set. Hand-drawn on a 24px grid,
 * 1.75px round strokes, `currentColor`. Decorative by default (aria-hidden);
 * pass `label` to expose it as an image.
 *
 * Props
 *   name   'arrow-right' | 'arrow-up-right' | 'arrow-down' | 'sun' | 'moon' | 'menu'
 *          | 'close' | 'chevron-down' | 'info' | 'alert' | 'check' | 'minus' | 'plus' | 'table'
 *   size   CSS length, default '1.25em'
 *   label  accessible name (omit for decorative icons)
 */
export type IconName =
  | 'arrow-right' | 'arrow-up-right' | 'arrow-down' | 'sun' | 'moon' | 'menu' | 'close'
  | 'chevron-down' | 'info' | 'alert' | 'check' | 'minus' | 'plus' | 'table';

interface Props {
  name: IconName;
  size?: string;
  label?: string;
  class?: string;
}

const { name, size = '1.25em', label, class: cls } = Astro.props;

const paths: Record<IconName, string> = {
  'arrow-right': '<path d="M4 12h15M13 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8.5 7H17v8.5"/>',
  'arrow-down': '<path d="M12 4v15M6 13l6 6 6-6"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"/>',
  moon: '<path d="M20 14.2A8 8 0 0 1 9.8 4 8 8 0 1 0 20 14.2Z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/>',
  alert: '<path d="M12 3.5 21.5 20h-19L12 3.5Z"/><path d="M12 10v4.5M12 17v.5"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  minus: '<path d="M5 12h14"/>',
  plus: '<path d="M5 12h14M12 5v14"/>',
  table: '<rect x="3.5" y="5" width="17" height="14" rx="1"/><path d="M3.5 10h17M3.5 14.5h17M9.5 5v14"/>',
};
---

<svg
  class:list={['icon', cls]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={paths[name]}
/>

<style>
  .icon {
    flex: none;
    display: inline-block;
    vertical-align: -0.2em;
  }
</style>
