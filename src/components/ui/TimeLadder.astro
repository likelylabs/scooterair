---
/**
 * TimeLadder — "the ruler of time" (V11): a ladder of exposure durations, one
 * finding per stop. Every card is the same size whatever the study's sample,
 * and the first stop — the red light itself — is an empty dashed card, because
 * no study has looked at it. Horizontal on wide screens, stacked on phones.
 *
 * Props
 *   locale  Locale
 *   label   accessible name (default 「時間的尺 / The ruler of time」)
 *   stops   {
 *             time: string;            // "90 秒", "1 小時", "很多年"
 *             body?: string;           // one finding, with who was measured
 *             badge?: EvidenceKind | EvidenceKind[];
 *             secondary?: boolean;
 *             scope?: 'traffic' | 'all-sources' | string;  // 整體車流 / 所有來源的 PM2.5 (R2), or your own words
 *             empty?: boolean;         // no study: dashed card, gap badge, body defaults to 「沒有研究」
 *           }[]
 *
 * Health findings never share a frame with the scene: place this in a chapter
 * with no `art` slot and no haze (blueprint, Link 5).
 */
import type { Locale } from '@/i18n';
import { ladder, type EvidenceKind } from '@/i18n/ui';
import EvidenceBadge from './EvidenceBadge.astro';

interface Stop {
  time: string;
  body?: string;
  badge?: EvidenceKind | EvidenceKind[];
  secondary?: boolean;
  scope?: 'traffic' | 'all-sources' | (string & {});
  empty?: boolean;
}
interface Props {
  locale: Locale;
  label?: string;
  stops: Stop[];
  class?: string;
}
const { locale, label = ladder.label[locale], stops, class: cls } = Astro.props;
const scopeText = (s?: string) => (s === 'traffic' ? ladder.scopeTraffic[locale] : s === 'all-sources' ? ladder.scopeAllSources[locale] : s);
const badgesOf = (s: Stop): EvidenceKind[] => (s.badge ? (Array.isArray(s.badge) ? s.badge : [s.badge]) : s.empty ? ['gap'] : []);
---

<ol class:list={['ladder', cls]} aria-label={label} style={`--n:${stops.length}`}>
  {stops.map((s) => (
    <li class:list={['ladder__stop', s.empty && 'ladder__stop--empty']}>
      <p class="ladder__time">{s.time}</p>
      <div class="ladder__card">
        <p class="ladder__body">{s.body ?? (s.empty ? ladder.empty[locale] : '')}</p>
        {scopeText(s.scope) && <p class="ladder__scope">{scopeText(s.scope)}</p>}
        {badgesOf(s).length > 0 && (
          <p class="ladder__badges">{badgesOf(s).map((b, i, all) => <EvidenceBadge kind={b} locale={locale} secondary={s.secondary && i === all.length - 1} />)}</p>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .ladder {
    --tick: 0.875rem;
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* phone: a vertical ruler down the left edge */
  .ladder__stop {
    position: relative;
    display: grid;
    gap: var(--sp-2);
    padding: 0 0 var(--sp-5) calc(var(--tick) + var(--sp-4));
    border-inline-start: 3px solid var(--ink);
  }
  .ladder__stop:last-child {
    padding-block-end: 0;
  }
  .ladder__stop::before {
    content: '';
    position: absolute;
    inset-block-start: 0.65em;
    inset-inline-start: 0;
    inline-size: var(--tick);
    border-block-start: 3px solid var(--ink);
  }
  .ladder__time {
    font-size: var(--fs-xl);
    font-weight: 800;
    font-stretch: 72%;
    font-variant-numeric: lining-nums;
    line-height: 1.2;
  }
  .ladder__card {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    justify-items: start;
    padding: var(--sp-4);
    border: 2px solid var(--ink);
    background: var(--surface);
    --here: var(--surface);
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
  }
  .ladder__stop--empty .ladder__card {
    border-style: dashed;
    background: transparent;
    --here: inherit;
    min-block-size: 6.5rem;
  }
  .ladder__stop--empty .ladder__body {
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
  }
  .ladder__scope {
    padding-inline-start: 0.6em;
    border-inline-start: 3px solid var(--line-strong);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    color: var(--ink-2);
  }
  .ladder__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-2);
    margin-block-start: auto;
  }
  /* wide: a horizontal ruler along the top, cards of equal width and height */
  @media (min-width: 56em) {
    .ladder {
      grid-template-columns: repeat(var(--n), minmax(0, 1fr));
      column-gap: var(--sp-4);
    }
    .ladder__stop {
      grid-template-rows: auto 1fr;
      padding: var(--sp-4) 0 0;
      border-inline-start: 0;
      border-block-start: 3px solid var(--ink);
    }
    .ladder__stop::before {
      inset-block-start: 0;
      inline-size: 0;
      block-size: var(--tick);
      border-block-start: 0;
      border-inline-start: 3px solid var(--ink);
    }
    .ladder__stop + .ladder__stop::after {
      /* the rule is continuous across the gaps */
      content: '';
      position: absolute;
      inset-block-start: -3px;
      inset-inline-start: calc(var(--sp-4) * -1);
      inline-size: var(--sp-4);
      border-block-start: 3px solid var(--ink);
    }
    .ladder__time {
      padding-inline-start: var(--sp-3);
    }
  }
</style>
