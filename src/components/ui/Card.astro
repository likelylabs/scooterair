---
/**
 * Card — a self-contained teaser or summary. With `href` the whole card is one
 * link (the title is the link; an arrow shows it goes somewhere). The card is
 * never an <a> itself, so links inside it are valid: a <Cite> marker or a link
 * in the body or the footer is raised above the stretched title link and keeps
 * its own target.
 *
 * Props
 *   title    card heading
 *   href     makes the card a link (pass it through href() first)
 *   eyebrow  kicker above the title
 *   tone     'surface' (default) | 'sunken' | 'exhaust' | 'clean' | 'inverse'
 *   level    heading level (default 3)
 * Slots
 *   default  body text
 *   media    illustration above the text (bleeds to the card edge)
 *   footer   meta row under the body (tags, cite chips)
 */
import Icon from './Icon.astro';

interface Props {
  title: string;
  href?: string;
  eyebrow?: string;
  tone?: 'surface' | 'sunken' | 'exhaust' | 'clean' | 'inverse';
  level?: 2 | 3 | 4;
  class?: string;
}
const { title, href, eyebrow, tone = 'surface', level = 3, class: cls } = Astro.props;
const H = `h${level}` as 'h2' | 'h3' | 'h4';
---

<article class:list={['card', `tone-${tone}`, href && 'card--link', cls]}>
  {Astro.slots.has('media') && <div class="card__media"><slot name="media" /></div>}
  <div class="card__body">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <H class="card__title">
      {href ? (
        <a href={href}>
          {title}<Icon name="arrow-right" size="0.9em" class="card__arrow" />
        </a>
      ) : (
        title
      )}
    </H>
    {Astro.slots.has('default') && <div class="card__text stack"><slot /></div>}
    {Astro.slots.has('footer') && <div class="card__footer cluster"><slot name="footer" /></div>}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
    border: 1px solid var(--line);
    border-block-start: var(--rule-paint) solid var(--ink);
  }
  .card.tone-exhaust {
    border-block-start-color: var(--exhaust);
  }
  .card.tone-clean {
    border-block-start-color: var(--clean);
  }
  .card__media {
    overflow: hidden;
    border-block-end: 1px solid var(--line);
  }
  .card__body {
    display: grid;
    gap: var(--sp-2);
    align-content: start;
    flex: 1;
    padding: var(--sp-4);
  }
  .card__title {
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
    font-stretch: 100%;
    line-height: var(--lh-snug);
    letter-spacing: 0;
  }
  .card__title a {
    color: inherit;
    text-decoration: none;
  }
  /* stretch the title link over the whole card */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card__title :global(.card__arrow) {
    margin-inline-start: 0.35em;
    transition: transform var(--dur-2) var(--ease-out);
  }
  .card--link:hover {
    border-color: var(--ink);
  }
  .card--link:hover :global(.card__arrow) {
    transform: translateX(0.25em);
  }
  .card--link:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  .card__title a:focus-visible {
    outline: none;
  }
  .card__text {
    --stack: 0.6em;
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
    color: var(--ink-2);
  }
  /* links and citation markers in the body stay clickable above the stretched title link */
  .card--link .card__text :global(a),
  .card--link .card__text :global(.cite) {
    position: relative;
    z-index: 1;
  }
  .card__footer {
    --cluster: var(--sp-2);
    position: relative; /* keeps chips clickable above the stretched link */
    z-index: 1;
    margin-block-start: auto;
    padding-block-start: var(--sp-2);
  }
  @media (min-width: 48em) {
    .card__body {
      padding: var(--sp-5);
    }
  }
</style>
