---
/**
 * Tabs — progressively enhanced tabs. Children are <TabPanel>s.
 * Without JavaScript every panel is shown in order under its own heading.
 * With it, the headings become a tab list (arrow keys, Home/End).
 *
 * Props
 *   label  accessible name of the tab list
 * Slot
 *   default  <TabPanel> children
 *
 *   <Tabs label={t.tabsLabel}>
 *     <TabPanel id="taipei" label="台北市"> … </TabPanel>
 *     <TabPanel id="kaohsiung" label="高雄市"> … </TabPanel>
 *   </Tabs>
 */
interface Props {
  label: string;
  class?: string;
}
const { label, class: cls } = Astro.props;
---

<sa-tabs class:list={['tabs', cls]} data-label={label}>
  <slot />
</sa-tabs>

<style is:global>
  .tabs {
    display: block;
  }
  .tabs__list {
    display: flex;
    gap: var(--sp-1);
    margin-block-end: var(--sp-5);
    overflow-x: auto;
    border-block-end: 1px solid var(--line-strong);
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }
  /* more tabs off either edge (set by the script): fade that edge so the strip visibly continues */
  .tabs__list[data-more~='end'] {
    mask-image: linear-gradient(to left, transparent, #000 3rem);
  }
  .tabs__list[data-more~='start'] {
    mask-image: linear-gradient(to right, transparent, #000 3rem);
  }
  .tabs__list[data-more~='start'][data-more~='end'] {
    mask-image: linear-gradient(to right, transparent, #000 3rem calc(100% - 3rem), transparent);
  }
  .tabs__count {
    margin-block: calc(var(--sp-5) * -1 + var(--sp-1)) var(--sp-4);
    font-size: var(--fs-xs);
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .tabs__tab {
    flex: none;
    min-block-size: var(--tap);
    padding: 0 var(--sp-4);
    border: 0;
    border-block-end: var(--rule-paint) solid transparent;
    margin-block-end: -1px;
    background: none;
    color: var(--ink-2);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    cursor: pointer;
  }
  .tabs__tab:hover {
    color: var(--ink);
  }
  .tabs__tab[aria-selected='true'] {
    color: var(--ink);
    border-block-end-color: var(--ink);
  }
  .tabs__tab:focus-visible {
    outline-offset: -3px;
  }
  /* High Contrast drops the colour difference: mark the selected tab in system colours */
  @media (forced-colors: active) {
    .tabs__tab[aria-selected='true'] {
      forced-color-adjust: none;
      background: Highlight;
      color: HighlightText;
      border-block-end-color: CanvasText;
    }
  }
  /* no-JS: stacked panels with visible headings */
  .tabpanel + .tabpanel {
    margin-block-start: var(--sp-7);
  }
  .tabpanel__title {
    margin-block-end: var(--sp-3);
    font-size: var(--fs-lg);
    font-weight: var(--fw-bold);
  }
  .tabs[data-enhanced] .tabpanel {
    margin-block-start: 0;
  }
  .tabs[data-enhanced] .tabpanel__title {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>

<script>
  class SaTabs extends HTMLElement {
    connectedCallback() {
      const panels = [...this.querySelectorAll<HTMLElement>(':scope > .tabpanel')];
      if (panels.length < 2 || this.dataset.enhanced !== undefined) return;
      const list = document.createElement('div');
      list.className = 'tabs__list';
      list.setAttribute('role', 'tablist');
      list.setAttribute('aria-label', this.dataset.label ?? '');
      const fromHash = panels.findIndex((p) => `#${p.id}` === location.hash);
      const tabs = panels.map((panel, i) => {
        const tab = document.createElement('button');
        tab.type = 'button';
        tab.className = 'tabs__tab';
        tab.id = `${panel.id}-tab`;
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-controls', panel.id);
        tab.textContent = panel.dataset.label ?? '';
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', tab.id);
        panel.tabIndex = 0;
        tab.addEventListener('click', () => select(i, true));
        list.append(tab);
        return tab;
      });
      const select = (index: number, focus = false) => {
        tabs.forEach((tab, i) => {
          const on = i === index;
          tab.setAttribute('aria-selected', String(on));
          tab.tabIndex = on ? 0 : -1;
          panels[i].hidden = !on;
        });
        if (focus) tabs[index].focus();
      };
      list.addEventListener('keydown', (e) => {
        const cur = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
        const next = { ArrowRight: cur + 1, ArrowLeft: cur - 1, Home: 0, End: tabs.length - 1 }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        select((next + tabs.length) % tabs.length, true);
      });
      // where the strip scrolls, say so: an edge fade, and "2 / 7" under it, so a reader on a
      // phone can tell more tabs exist past the edge
      const count = document.createElement('p');
      count.className = 'tabs__count';
      count.setAttribute('aria-hidden', 'true'); // the tab list already announces "tab 2 of 7"
      const edges = () => {
        const more = [list.scrollLeft > 2 && 'start', list.scrollLeft + list.clientWidth < list.scrollWidth - 2 && 'end'].filter(Boolean).join(' ');
        if (more) list.dataset.more = more;
        else delete list.dataset.more;
        count.hidden = list.scrollWidth <= list.clientWidth + 2;
      };
      list.addEventListener('scroll', edges, { passive: true });
      new ResizeObserver(edges).observe(list);
      const select0 = select;
      const selectCounted = (index: number, focus = false) => {
        select0(index, focus);
        count.textContent = `${index + 1} / ${tabs.length}`;
        // bring the selected tab into the strip, sideways only (never scroll the page)
        const t = tabs[index];
        if (t.offsetLeft < list.scrollLeft) list.scrollLeft = t.offsetLeft;
        else if (t.offsetLeft + t.offsetWidth > list.scrollLeft + list.clientWidth) list.scrollLeft = t.offsetLeft + t.offsetWidth - list.clientWidth;
        edges();
      };
      tabs.forEach((tab, i) => tab.addEventListener('click', () => selectCounted(i)));
      list.addEventListener('keydown', () => requestAnimationFrame(() => selectCounted(Math.max(0, tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true')))));
      this.prepend(list, count);
      this.dataset.enhanced = '';
      selectCounted(fromHash >= 0 ? fromHash : 0);
    }
  }
  if (!customElements.get('sa-tabs')) customElements.define('sa-tabs', SaTabs);
</script>
