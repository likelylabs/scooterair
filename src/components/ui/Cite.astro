---
/**
 * Cite — a citation marker that links to the entry on the sources page
 * (/sources/#<id>). Every factual claim and every chart gets one.
 *
 * Props
 *   locale   Locale
 *   id       the source's id on /sources/ (e.g. 'iot-2025-scramble')
 *   n        the number shown; keep it stable per source across the site
 *   variant  'sup' (default, inline superscript) | 'chip' ("Source 3" pill, for
 *            figure footers, cards and chain links)
 *   static   true = the marker is shown but is not a link. For text inside an
 *            element that is itself a link (a card or row wrapped in <a>), where a
 *            nested link would be invalid HTML. The number still tells the reader
 *            the claim is sourced; the page the link leads to carries the live marker.
 *
 *   …暴露量顯著較高<Cite locale={locale} id="wu-2021" n={3} />。
 *
 * Inside <Card href>, whose title link is stretched over the whole card, a Cite
 * in the body or footer stays a working link of its own: it is raised above the
 * stretched link (see Card.astro). Only use `static` when the wrapper is an <a>.
 */
import { href, type Locale } from '@/i18n';
import { t, ui } from '@/i18n/ui';

interface Props {
  locale: Locale;
  id: string;
  n: number | string;
  variant?: 'sup' | 'chip';
  static?: boolean;
}
const { locale, id, n, variant = 'sup', static: isStatic = false } = Astro.props;
const url = href(`/sources/#${id}`, locale);
const label = t(ui.sourceN, locale, { n });
---

{variant === 'sup' ? (
  isStatic ? (
    <sup class="cite cite--static"><span class="cite__n"><span class="vh">{label}</span><span aria-hidden="true">{n}</span></span></sup>
  ) : (
    <sup class="cite"><a href={url} aria-label={label}>{n}</a></sup>
  )
) : isStatic ? (
  <span class="cite-chip cite-chip--static">{label}</span>
) : (
  <a class="cite-chip" href={url}>{label}</a>
)}

<style>
  .cite {
    /* 0.78em of the text it follows, never under the 14 px floor */
    font-size: max(0.78em, var(--fs-xs));
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    margin-inline-start: 0.1em;
  }
  /* neighbouring numbers ("13 15 16") are separate targets: keep their hit areas apart */
  .cite + .cite {
    margin-inline-start: 0.6em;
  }
  .cite a,
  .cite__n {
    position: relative;
    display: inline-block;
    min-inline-size: 1.5em;
    padding: 0 0.3em;
    border-radius: var(--radius-1);
    background: var(--bg-sunken);
    color: var(--accent);
    text-align: center;
    text-decoration: none;
    line-height: 1.5;
  }
  /* Enlarge the hit area to the full 44px height without disturbing the line. Sideways it
     grows 0.25em (to at least 24px wide), so two neighbours (0.6em apart) never overlap. */
  .cite a::after {
    content: '';
    position: absolute;
    inset: calc((var(--tap) - 1.5em) / -2) -0.25em;
  }
  .cite a:focus-visible {
    outline-offset: 1px;
  }
  .cite a:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  .cite-chip {
    display: inline-flex;
    align-items: center;
    /* a full tap target: chips sit in rows in figure footers, so they are not enlarged invisibly */
    min-block-size: var(--tap);
    padding: 0 0.85em;
    border: 1.5px solid currentColor;
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    font-weight: var(--fw-bold);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  a.cite-chip:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }
</style>
