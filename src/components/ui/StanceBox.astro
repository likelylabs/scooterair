---
/**
 * StanceBox — the two boxes that sit beside the site's own inference and are
 * always open (never a <details>): 「我們沒有說」 and 「什麼會讓我們改口」.
 * The reader should see what the conclusion does not claim, and what would
 * overturn it, without having to ask.
 *
 * Props
 *   locale  Locale
 *   kind    'not-saying' | 'change-mind' — sets the label and the edge
 *           (not-saying: a solid box with a struck corner; change-mind: the
 *           dashed edge of an inference, because it is a promise about one)
 *   label   override the label
 *   items   (not-saying) the statements as a list, each one sentence. They are
 *           set as a list of things NOT said, each prefixed for screen readers
 * Slot
 *   default  body text (use instead of, or after, `items`)
 */
import type { Locale } from '@/i18n';
import { board } from '@/i18n/ui';

interface Props {
  locale: Locale;
  kind: 'not-saying' | 'change-mind';
  label?: string;
  items?: string[];
  class?: string;
}
const { locale, kind, items = [], class: cls } = Astro.props;
const label = Astro.props.label ?? (kind === 'not-saying' ? board.notSaying[locale] : board.changeMind[locale]);
---

<aside class:list={['stance', `stance--${kind}`, cls]}>
  <p class="stance__label">{label}</p>
  {items.length > 0 && (
    <ul class="stance__list">
      {items.map((it) => (
        <li>
          <svg viewBox="0 0 16 16" width="1em" height="1em" aria-hidden="true" focusable="false"><path d="M3.5 3.5l9 9M12.5 3.5l-9 9" /></svg>
          <span>{it}</span>
        </li>
      ))}
    </ul>
  )}
  {Astro.slots.has('default') && <div class="stance__body"><slot /></div>}
</aside>

<style>
  .stance {
    position: relative;
    max-inline-size: var(--measure);
    margin-block-start: 0.75em;
    padding: var(--sp-5) var(--sp-4) var(--sp-4);
    border: var(--rule-paint) solid var(--ink);
    font-size: var(--fs-sm);
    line-height: var(--lh-snug);
  }
  .stance--change-mind {
    border-style: dashed;
  }
  .stance__label {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: var(--sp-3);
    transform: translateY(-55%);
    margin: 0;
    padding-inline: 0.5em;
    background: var(--here);
    font-size: var(--fs-sm);
    font-weight: var(--fw-black);
    line-height: 1.4;
  }
  .stance__list {
    display: grid;
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stance__list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.5em;
    align-items: start;
  }
  .stance__list svg {
    margin-block-start: 0.28em;
    fill: none;
    stroke: var(--signal-red-ink);
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .stance__list + .stance__body {
    margin-block-start: var(--sp-3);
  }
  .stance__body > :global(* + *) {
    margin-block-start: 0.7em;
  }
  @media (min-width: 48em) {
    .stance {
      padding: var(--sp-5);
    }
  }
</style>
