---
/**
 * Screen — the frame every screen of the home page shares (brief 3.1), also used once per
 * question page. One picture, one headline, at most two sentences, one optional quiet line,
 * then two rows of controls. Replaces Chapter.astro.
 *
 *   ┌ picture (slot `picture`; full-bleed on a phone) ───────────────┐
 *   │ the tag 示意圖｜… on a line of its own under the drawing          │
 *   │ slot `above`  — HTML over the picture: the number box           │
 *   │ slot `controls` — under the picture: a switch                    │
 *   ├ headline  27 px, weight 900, two lines, 22 Chinese characters ─┤
 *   │ body      18 px, two sentences, 45 characters                   │
 *   │ quiet     15 px, one line, 30 characters (caveats live here)     │
 *   │ row 1     chips (slot `chips`) ………………… [怎麼知道的？]              │
 *   │ row 2     slot `actions`, then the full-width next button        │
 *   └ slot `sheet` — the <HowSheet> (an open block here without JS) ──┘
 *
 * THE LAYOUT RULE: a reader arriving at a screen sees the whole picture and, with it, at least
 * the headline and the first line of words, at every width and height.
 *   - From 688 px wide (43em: a tablet held upright, a phone on its side, a laptop) a screen is
 *     two columns, picture left and words right, inside a 1,040 px column. The picture column is
 *     at most 55 % of the row and 560 px, and never taller than the window leaves room for: its
 *     width follows the window's height through the drawing's own proportions (--pic-ar), so a
 *     picture is shrunk whole, never cropped, and never letterboxed inside its column.
 *   - Narrower, the picture sits above the words, edge to edge on a phone. When the window is
 *     too short for the picture and the headline together, the whole screen (picture and words)
 *     is narrowed to the width at which they fit, so both keep the same edges.
 * --pic-ar is the width over the height of the first drawing in the picture slot (the viewBox
 * of its `scene__art`), read here at build time. --pic-extra (default 3rem) is how much the
 * picture's box holds besides the drawing (the tag, a key, a number box, a switch); a page sets
 * it per screen where that is more (home.css, questions/[slug].astro). A picture that is not
 * a scene (a chart, a table) has no --pic-ar and is never narrowed: those are short. Scrolling
 * is ordinary scrolling: nothing is pinned or snapped.
 *
 * THE LIMITS ARE ENFORCED. A headline over 22 Chinese characters, a body over 45 or a quiet
 * line over 30 throws, and the build fails. Han characters are counted; digits, units, Latin
 * and punctuation are free (src/components/ui/screen-limits.ts). The finer advice of brief 6.5
 * (two sentences, 30 characters and two commas a sentence) is printed as a build warning.
 *
 * Props
 *   locale        Locale
 *   n             position, 1-based
 *   total         number of screens on the page (default 15; a question page passes 1)
 *   id            anchor (default `s-${n}`)
 *   chapter       the short name the rail shows: 排出什麼
 *   phase         'red' (default) | 'green' — the rail's lamp while this screen is in view
 *   headline      '|' marks the phrase boundaries where a line may break: '那個味道，|你也聞過'
 *   as            'h2' (default) | 'h1' (a question page's one screen)
 *   body          the body text; or slot `body` when it needs markup (it is counted the same)
 *   quiet         the quiet line; or slot `quiet`
 *   illustration  true = print the tag 示意圖｜廢氣其實大多看不見 with the picture (brief 5.1).
 *                 'body' prints 示意圖・不是醫學圖. Scene components do not print it themselves.
 *                 The tag is the last line of the picture's box (.screen__pic), under the
 *                 drawing: laid over a corner it covered the scenes' own words at 320 px and
 *                 at 特大, where it is up to 300 × 60 px
 *   how           id of the sheet in the `sheet` slot (default `how-${n}`)
 *   next          { label, href?, primary? } — the question the next screen answers.
 *                 href defaults to `#s-${n + 1}`. Omit on the last screen
 * Slots
 *   picture (required) · above · controls · body · quiet · chips · actions · sheet
 *   default: rare extra content after the quiet line
 *
 * The <article> carries data-screen, data-n, data-chapter, data-phase (read by ScreenRail) and
 * data-pick-scope (the scope of any <Segmented> inside it).
 *
 *   <Screen locale={locale} n={2} chapter={t.s2.chapter} headline={t.s2.headline} body={t.s2.body}
 *           quiet={t.s2.quiet} illustration next={{ label: t.s2.next }}>
 *     <TailpipeMarks slot="picture" locale={locale} />
 *     <EstimateValue slot="chips" … sheet="how-2" />
 *     <HowSheet slot="sheet" id="how-2" … />
 *   </Screen>
 */
import type { Locale } from '@/i18n';
import { langHtml, screenText, t as fill, typeset } from '@/i18n/ui';
import HowButton from './HowButton.astro';
import IllustrationTag from './IllustrationTag.astro';
import NextButton from './NextButton.astro';
import Phrased from './Phrased.astro';
import { screenCopyProblems } from './screen-limits';

interface Props {
  locale: Locale;
  n: number;
  total?: number;
  id?: string;
  chapter: string;
  phase?: 'red' | 'green';
  headline: string;
  as?: 'h1' | 'h2';
  body?: string;
  quiet?: string;
  illustration?: boolean | 'body';
  how?: string;
  next?: { label: string; href?: string; primary?: boolean };
  class?: string;
}
const { locale, n, total = 15, chapter, phase = 'red', headline, as: Heading = 'h2', illustration = false, next, class: cls } = Astro.props;
const id = Astro.props.id ?? `s-${n}`;
if (!Astro.slots.has('picture')) throw new Error(`Screen ${id}: every screen has a picture (slot "picture").`);
if (!headline?.trim()) throw new Error(`Screen ${id}: no headline.`);

const render = async (name: string) => (Astro.slots.has(name) ? (await Astro.slots.render(name)).trim() : '');
const bodyHtml = Astro.props.body ? langHtml(typeset(Astro.props.body, locale), locale) : await render('body');
const quietHtml = Astro.props.quiet ? langHtml(typeset(Astro.props.quiet, locale), locale) : await render('quiet');

const problems = screenCopyProblems({ headline, body: bodyHtml, quiet: quietHtml });
const errors = problems.filter((p) => p.level === 'error');
if (errors.length) throw new Error(`Screen ${id} breaks the words-per-screen limits (brief 3.1):\n  ${errors.map((p) => p.message).join('\n  ')}\nAnything longer belongs in the sheet.`);
for (const p of problems) if (p.level === 'warn') console.warn(`[Screen ${id}] ${p.message}`);

// a slot may hand over its own <p>: then the wrapper is a <div>, never a <p> inside a <p>
const isBlock = (html: string) => /<(p|div|ul|ol|dl|table)\b/i.test(html);
const BodyTag = isBlock(bodyHtml) ? 'div' : 'p';
const QuietTag = isBlock(quietHtml) ? 'div' : 'p';

// the drawing's proportions, for the layout rule above (first <svg class="scene__art …" viewBox>)
const pictureHtml = await render('picture');
const artTag = pictureHtml.match(/<svg\b[^>]*\bclass="scene__art\b[^>]*>/)?.[0];
const viewBox = artTag?.match(/\bviewBox="\s*[-\d.]+[\s,]+[-\d.]+[\s,]+([\d.]+)[\s,]+([\d.]+)\s*"/);
const picAr = viewBox && Number(viewBox[2]) > 0 ? Number((Number(viewBox[1]) / Number(viewBox[2])).toFixed(4)) : null;

const hasSheet = Astro.slots.has('sheet');
const how = Astro.props.how ?? `how-${n}`;
const hasChips = Astro.slots.has('chips');
const hasAbove = Astro.slots.has('above');
const hasControls = Astro.slots.has('controls');
const phaseWord = phase === 'green' ? screenText.green[locale] : screenText.red[locale];
const position = fill(screenText.position, locale, { n, total });
---

<article class:list={['screen', `screen--${phase}`, cls]} id={id} data-screen data-n={n} data-chapter={chapter} data-phase={phase} data-solo={total === 1 ? '' : undefined} data-pick-scope aria-labelledby={`${id}-h`} style={picAr ? `--pic-ar:${picAr}` : undefined}>
  <div class="screen__stage">
    {hasAbove && <div class="screen__above"><slot name="above" /></div>}
    <div class="screen__pic">
      <Fragment set:html={pictureHtml} />
      {illustration && <IllustrationTag locale={locale} kind={illustration === 'body' ? 'body' : 'street'} />}
    </div>
    {hasControls && <div class="screen__controls"><slot name="controls" /></div>}
  </div>

  <div class="screen__text">
    {/* Where this screen is in the story. The rail says it while scripting runs; this line says
        it to a screen reader always, and to the eye when there is no script to move the rail. */}
    {total > 1 && (
      <p class="screen__kicker" data-nojs-only>
        <span class="screen__lamp" aria-hidden="true"></span>
        <span class="screen__phase">{phaseWord}</span><span aria-hidden="true">｜</span><span>{chapter}</span>
        <span class="screen__pos" aria-hidden="true">{position}</span>
        <span class="vh">{fill(screenText.positionSr, locale, { n, total })}</span>
      </p>
    )}
    <Heading class="screen__headline" id={`${id}-h`}><Phrased text={typeset(headline, locale)} locale={locale} /></Heading>
    {bodyHtml && <BodyTag class="screen__body" set:html={bodyHtml} />}
    {quietHtml && <QuietTag class="screen__quiet" set:html={quietHtml} />}
    <slot />

    {(hasChips || hasSheet) && (
      <div class="screen__foot">
        <div class="screen__chips">{hasChips && <slot name="chips" />}</div>
        {hasSheet && <HowButton locale={locale} sheet={how} />}
      </div>
    )}
    {(Astro.slots.has('actions') || next) && (
      <div class="screen__go">
        <slot name="actions" />
        {next && (
          <NextButton href={next.href ?? `#s-${n + 1}`} variant={next.primary ? 'primary' : 'next'}>{next.label}</NextButton>
        )}
      </div>
    )}
  </div>

  {hasSheet && <div class="screen__sheet"><slot name="sheet" /></div>}
</article>

<style>
  .screen {
    --pad: var(--gutter);
    /* the layout rule (see the top of this file). --pic-ar: the drawing's width over its height;
       9 (no drawing) never narrows anything. --chrome: the sticky header and screen rail. */
    --pic-ar: 9;
    --chrome: calc(var(--header-h) + var(--rail-h) + 2px);
    /* the window's height, less the chrome: svh where the browser knows it (a phone's toolbars
       shown), vh before */
    --win: calc(100vh - var(--chrome));
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-block-end: var(--sp-6);
    /* the next button lands the screen flush under the rail: undo the page's 1rem scroll padding */
    scroll-margin-block-start: -1rem;
  }
  @supports (height: 100svh) {
    .screen {
      --win: calc(100svh - var(--chrome));
    }
  }
  .screen + :global(.screen) {
    border-block-start: 1px solid var(--line);
  }

  /* ---- the picture ---- */
  .screen__stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-3);
    min-inline-size: 0;
  }
  .screen__above,
  .screen__controls {
    padding-inline: var(--pad);
  }
  .screen__above {
    padding-block-start: var(--sp-3);
  }
  .screen__pic {
    position: relative;
    min-inline-size: 0;
    overflow: hidden; /* a scene never widens the page */
  }
  /* one SVG per scene, as wide as the screen; words in it are HTML laid over it */
  .screen__pic > :global(svg),
  .screen__pic > :global(img),
  .screen__pic > :global(figure) {
    display: block;
    inline-size: 100%;
    max-inline-size: none;
    block-size: auto;
    margin: 0;
  }
  /* the tag: one quiet line under the drawing, still inside the picture's box. Never laid over
     the drawing, so it cannot cover a scene's words at any width, language or text size */
  .screen__pic > :global(.ill-tag) {
    display: block;
    padding: 0.2rem var(--pad) 0;
    border: 0;
    border-radius: 0;
    background: none;
  }

  /* ---- the words ---- */
  .screen__text {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-3);
    align-content: start;
    min-inline-size: 0;
    padding: var(--sp-4) var(--pad) 0;
  }
  .screen__kicker {
    display: flex;
    align-items: center;
    gap: 0.35em;
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    line-height: 1.4;
    color: var(--ink);
  }
  .screen__lamp {
    flex: none;
    inline-size: 0.7em;
    block-size: 0.7em;
    border-radius: 50%;
    background: var(--signal-red);
  }
  .screen__phase {
    color: var(--signal-red-ink);
  }
  .screen--green .screen__lamp {
    background: var(--clean);
  }
  .screen--green .screen__phase {
    color: var(--clean-ink);
  }
  .screen__pos {
    margin-inline-start: auto;
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }
  /* 27 px on a 390 px phone and up. Narrower, it follows the width (24.8 px at 360, 22 px at
     320), so a line always holds 13 full-width glyphs and a 22-character headline with its
     punctuation still makes two lines. In rem at both ends, so 字大 enlarges it. */
  .screen__headline {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.375rem, 6.9vw, var(--fs-headline));
    font-weight: var(--fw-black);
    font-stretch: 100%;
    line-height: var(--lh-headline);
    letter-spacing: 0;
    text-wrap: balance;
  }
  .screen__headline:lang(en) {
    font-stretch: 84%;
    font-weight: 800;
    line-height: 1.16;
  }
  .screen__body,
  .screen__body :global(p) {
    margin: 0;
    font-size: var(--fs-base);
    line-height: var(--lh-read);
    color: var(--ink);
  }
  .screen__quiet,
  .screen__quiet :global(p) {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-read);
    color: var(--ink-2);
  }

  /* ---- the two rows of controls ---- */
  .screen__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--tap-gap) var(--sp-3);
    margin-block-start: var(--sp-2);
  }
  .screen__chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--tap-gap);
    min-inline-size: 0;
  }
  .screen__foot > :global(.howbtn) {
    margin-inline-start: auto;
  }
  .screen__go {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--tap-gap);
  }
  .screen__sheet {
    padding-inline: var(--pad);
  }
  .screen__sheet:empty {
    display: none;
  }

  /* ---- one column (a phone): the picture above the words ----
     When the window is too short for the whole picture (the drawing, plus --pic-extra for what
     its box holds besides: the tag, a key, a number box, a switch) and 7rem under it (the
     headline and a first line), the screen narrows to the width at which they fit: picture and
     words narrow together and keep the same edges. Never below 24rem, so a phone held upright
     is never narrowed: there the picture runs edge to edge. */
  @media (max-width: 42.99em) {
    .screen {
      max-inline-size: max(24rem, calc((var(--win) - 7rem - var(--pic-extra, 3rem)) * var(--pic-ar)));
      margin-inline: auto;
    }
  }

  /* ---- two columns (from 688 px: a tablet held upright, a phone on its side, a desktop):
     picture left, words right. The picture column is at most 55 % of the row and 35rem, and
     narrow enough that the whole picture (the drawing plus --pic-extra) fits the window's height,
     but never under 14rem (--pic-min), where a drawing's words would crowd. The words take the rest, never
     less than 17rem (or 45 %). A window under 30em tall (a phone on its side) has less air
     around the screen. */
  @media (min-width: 43em) {
    .screen {
      --pad: 0px;
      --screen-pad: var(--sp-5);
      --pic-col: min(55%, 35rem, max(var(--pic-min, 14rem), calc((var(--win) - 2 * var(--screen-pad) - var(--pic-extra, 3rem)) * var(--pic-ar))));
      grid-template-columns: minmax(0, var(--pic-col)) minmax(min(17rem, 45%), 1fr);
      column-gap: var(--sp-5);
      align-items: center;
      inline-size: min(100% - 2 * var(--gutter), var(--screen-max));
      margin-inline: auto;
      padding-block: var(--screen-pad);
      scroll-margin-block-start: -1rem;
    }
    /* a question page's screen is as tall as its words: the picture starts level with the headline
       and does not float in the middle of a long column */
    .screen[data-solo] {
      align-items: start;
    }
    /* the drawing is rounded, not the box: the tag's line sits under it */
    .screen__pic > :global(:first-child) {
      border-radius: var(--radius-3);
      overflow: hidden;
    }
    .screen__text {
      padding-block-start: 0;
      gap: var(--sp-4);
    }
    .screen__sheet {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 43em) and (max-height: 30em) {
    .screen {
      --screen-pad: var(--sp-3);
    }
  }
  /* a desktop: more air between and around the two columns */
  @media (min-width: 56.25em) and (min-height: 37.5em) {
    .screen {
      --screen-pad: var(--sp-7);
      column-gap: var(--sp-7);
      scroll-margin-block-start: 0;
    }
  }
  @media print {
    .screen {
      break-inside: avoid;
    }
    .screen__go {
      display: none;
    }
  }
</style>
