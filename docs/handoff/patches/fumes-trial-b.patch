+/* ---- Words on a fume-only picture (air({ fume: true })) ---------------------
+ * A label names what the fume is or holds; a thin leader line (scene.ts leader()) runs from the
+ * label into the fume. The line is ink on a paper-coloured edge, so it reads over the darkest
+ * plume, in both themes, in greyscale and for every kind of colour vision.
+ */
+.fume-lead { pointer-events: none; }
+.fume-lead__edge { fill: none; stroke: var(--here, var(--bg)); stroke-linecap: round; opacity: 0.9; }
+.fume-lead__line { fill: none; stroke: var(--ink); stroke-linecap: round; }
+.fume-label { line-height: 1.2; }
 /* the one word inside the first picture never breaks */
 .hero-plume { white-space: nowrap; max-inline-size: none; }
 .air-glyph-plume__far { fill: var(--air-core-far); opacity: 0.7; }
